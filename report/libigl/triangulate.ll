  %not. = xor i1 %i.rp, true
  %i.rv = zext i1 %not. to i32
  %i.rw = select i1 %i.rn, i32 2, i32 %i.rv
  br label %.thread.sink.split

bb.co:                                            ; preds = %.loopexit
  store i32 0, ptr %3, align 4, !tbaa !271
  %i.rx = select i1 %i.rn, i32 %i.rq, i32 2
