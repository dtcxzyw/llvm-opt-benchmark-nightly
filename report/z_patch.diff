+; CHECK-NEXT:    [[B:%.*]] = shl nuw i8 [[Y:%.*]], 1
+; CHECK-NEXT:    [[B_1:%.*]] = add nuw i8 [[B]], 1
+; CHECK-NEXT:    [[C_1:%.*]] = icmp ule i8 [[A]], [[B_1]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C_1]])
