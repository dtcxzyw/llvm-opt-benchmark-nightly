--- /dev/null
+++ b/llvm/test/Transforms/CorrelatedValuePropagation/finite-values-vector-path.ll
@@ -0,0 +1,52 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt -passes='correlated-propagation<finite-values>,instcombine,verify' -S %s | FileCheck %s
+
+target triple = "x86_64-unknown-linux-gnu"
+declare i8 @llvm.vector.reduce.or.v8i8(<8 x i8>)
+
+; Earlier call folding can leave a helper with one caller, enabling inlining.
+; Find the same scalar input through its integer vector packing computation.
+define i8 @inlined_pack(i64 noundef %bits, i8 noundef %fallback) {
+; CHECK-LABEL: @inlined_pack(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    switch i64 [[BITS:%.*]], label [[INVALID:%.*]] [
+; CHECK-NEXT:      i64 2, label [[VALID:%.*]]
+; CHECK-NEXT:      i64 4, label [[VALID]]
+; CHECK-NEXT:    ]
+; CHECK:       valid:
+; CHECK-NEXT:    [[TMP0:%.*]] = icmp eq i64 [[BITS]], 2
+; CHECK-NEXT:    [[R_FINITE:%.*]] = select i1 [[TMP0]], i8 -86, i8 -120
+; CHECK-NEXT:    ret i8 [[R_FINITE]]
+; CHECK:       invalid:
+; CHECK-NEXT:    ret i8 [[FALLBACK:%.*]]
+;
+entry:
+  switch i64 %bits, label %invalid [
+  i64 2, label %valid
+  i64 4, label %valid
+  ]
+valid:
+  %k = trunc nuw nsw i64 %bits to i32
+  %count = add nsw i32 %k, -1
+  %one = shl nuw nsw i32 1, %count
+  %mask = shl nsw i32 -1, %k
+  %notmask = xor i32 %mask, -1
+  %field = and i32 %one, %notmask
+  %v0 = insertelement <8 x i32> poison, i32 %field, i64 0
+  %v = shufflevector <8 x i32> %v0, <8 x i32> poison, <8 x i32> zeroinitializer
+  %k0 = insertelement <8 x i32> poison, i32 %k, i64 0
+  %kv = shufflevector <8 x i32> %k0, <8 x i32> poison, <8 x i32> zeroinitializer
+  %shifts = mul nuw nsw <8 x i32> %kv, <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
+  %shifted = shl <8 x i32> %v, %shifts
+  %bytes = trunc <8 x i32> %shifted to <8 x i8>
+  %lanes = udiv i64 8, %bits
+  %last = add nsw i64 %lanes, -1
+  %l0 = insertelement <8 x i64> poison, i64 %last, i64 0
+  %lv = shufflevector <8 x i64> %l0, <8 x i64> poison, <8 x i32> zeroinitializer
+  %inactive = icmp ult <8 x i64> %lv, <i64 0, i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7>
+  %active = select <8 x i1> %inactive, <8 x i8> zeroinitializer, <8 x i8> %bytes
+  %r = call i8 @llvm.vector.reduce.or.v8i8(<8 x i8> %active)
+  ret i8 %r
+invalid:
+  ret i8 %fallback
+}
