+define { i64, i64 } @select_memcpy_to_select_operand_padding(i64 %a0, i64 %a1, i64 %b0, i64 %b1, i1 %c) {
+;
+;
+; CHECK-LABEL: define { i64, i64 } @select_memcpy_to_select_operand_padding(
+; CHECK-SAME: i64 [[A0:%.*]], i64 [[A1:%.*]], i64 [[B0:%.*]], i64 [[B1:%.*]], i1 [[C:%.*]]) {
+; CHECK-NEXT:    [[A:%.*]] = alloca { i32, i64 }, align 8
+; CHECK-NEXT:    [[B:%.*]] = alloca { i32, i64 }, align 8
+; CHECK-NEXT:    store i64 [[A0]], ptr [[A]], align 8
+; CHECK-NEXT:    [[A_HI:%.*]] = getelementptr inbounds i8, ptr [[A]], i64 8
