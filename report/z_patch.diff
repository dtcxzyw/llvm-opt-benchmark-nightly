+define i32 @rewrite_flags_only_hold_under_guard_exit_value(i32 %a, i32 %y) {
+; CHECK-LABEL: define i32 @rewrite_flags_only_hold_under_guard_exit_value(
+; CHECK-SAME: i32 [[A:%.*]], i32 [[Y:%.*]]) {
+; CHECK-NEXT:  entry:
