index 00000000000000..2a34db94bc327e
--- /dev/null
+++ b/llvm/test/Transforms/SimplifyCFG/switch-to-table-hang.ll
@@ -0,0 +1,43 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt -S -passes=simplifycfg < %s | FileCheck %s
+
+; Reduced test case from an actual program: `ConstantFoldTerminator` creates
+; the following cyclic GEP in an unreachable block:
+;
+;   %p.next = getelementptr i8, ptr %p.next, i64 1
+;
+; Which causes `decomposeLinearExpression` to loop.
+
+declare void @g()
+
+define void @f(ptr %base) {
+; CHECK-LABEL: @f(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %m
+
+m:
+  %c = phi i1 [ true, %entry ]
+  br i1 %c, label %exit, label %loop
+
+loop:
+  %p = phi ptr [ %base, %m ], [ %p.next, %latch ]
+  %v = load i8, ptr %p
+  switch i8 %v, label %side [
+  i8 0, label %latch
+  i8 1, label %latch
+  ]
+
+side:
+  call void @g()
+  br label %latch
+
+latch:
+  %p.next = getelementptr i8, ptr %p, i64 1
+  br label %loop
+
+exit:
+  ret void
+}
