+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %loop.header
+
+loop.header:
+  %iv = phi i64 [ 3, %entry ], [ %iv.next, %loop.latch ]
+  %c = icmp sge i64 %iv, 3
+  call void @use(i1 %c)
+  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %iv, i64 1)
+  %iv.next = extractvalue { i64, i1 } %s, 0
+  %ov = extractvalue { i64, i1 } %s, 1
+  br i1 %ov, label %exit, label %loop.latch
+
+loop.latch:
+  %ec = icmp ne i64 %iv.next, %n
+  br i1 %ec, label %loop.header, label %exit
+
+exit:
