diff --git a/llvm/test/Transforms/SROA/non-integral-pointer-vector-memset.ll b/llvm/test/Transforms/SROA/non-integral-pointer-vector-memset.ll
new file mode 100644
index 0000000000000..5a5c75a2edd03
--- /dev/null
+++ b/llvm/test/Transforms/SROA/non-integral-pointer-vector-memset.ll
@@ -0,0 +1,20 @@
+; RUN: opt -passes=sroa -S %s | FileCheck %s
+
+; Do not convert a memset byte pattern to a non-integral pointer when
+; vector-promoting an alloca partition.
+
+; CHECK-LABEL: define void @vector_memset(
+; CHECK-NOT: inttoptr
+; CHECK-NOT: ptrtoint
+
+target datalayout = "e-ni:10"
+
+declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)
+
+define void @vector_memset() {
+  %a = alloca [14 x ptr addrspace(10)], align 8
+  %p = getelementptr inbounds i8, ptr %a, i64 16
+  call void @llvm.memset.p0.i64(ptr %p, i8 0, i64 96, i1 false)
+  store <2 x ptr addrspace(10)> zeroinitializer, ptr %p, align 8
+  ret void
+}
