+        // If neither the wide shift nor the truncate wrap, then A << C is the
+        // exact product and it fits the destination type, so A also fits and
+        // the narrow shift does not wrap either. Both flags are needed: for a
+        // wide shift that wraps, a non-wrapping truncate says nothing about the
+        // narrow shift.
+        auto *WideShl = cast<OverflowingBinaryOperator>(Src);
+        bool NUW = Trunc.hasNoUnsignedWrap() && WideShl->hasNoUnsignedWrap();
+        bool NSW = Trunc.hasNoSignedWrap() && WideShl->hasNoSignedWrap();
