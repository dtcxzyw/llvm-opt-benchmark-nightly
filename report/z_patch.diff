+static Decomposition decomposeConstant(Value *V, bool IsSigned) {
+  Type *Ty = V->getType()->getScalarType();
+  if (Ty->isPointerTy() && !IsSigned) {
+    if (isa<ConstantPointerNull>(V))
+      return int64_t(0);
+    return V;
+  }
+
+  if (!Ty->isIntegerTy() || Ty->getIntegerBitWidth() > 64)
+    return V;
