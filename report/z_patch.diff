   // Match X to (A + C1)<ExpectedFlags> and Y to (A + C2)<ExpectedFlags>, where
@@ -13652,6 +13731,12 @@ ScalarEvolution::howManyLessThans(const SCEV *LHS, const SCEV *RHS,
             isKnownPredicate(CondGE, GuardedRHS, GuardedStart))
           return true;
 
+        // OrigStart may be the IV of another loop, in which case that loop's
+        // own trip count bounds it from above.
+        auto CondLE = IsSigned ? ICmpInst::ICMP_SLE : ICmpInst::ICMP_ULE;
+        if (isKnownPredicateViaOuterIVRange(CondLE, OrigStart, OrigRHS))
+          return true;
+
         // (RHS > Start - 1) implies RHS >= Start.
         // * "RHS >= Start" is trivially equivalent to "RHS > Start - 1" if
         //   "Start - 1" doesn't overflow.
@@ -13843,8 +13928,10 @@ ScalarEvolution::ExitLimit ScalarEvolution::howManyGreaterThans(
   if (!isLoopEntryGuardedByCond(L, Cond, getAddExpr(Start, Stride), RHS)) {
     // If we know that Start >= RHS in the context of loop, then we know that
     // min(RHS, Start) = RHS at this point.
-    if (isLoopEntryGuardedByCond(
-            L, IsSigned ? ICmpInst::ICMP_SGE : ICmpInst::ICMP_UGE, Start, RHS))
+    ICmpInst::Predicate GEPred =
+        IsSigned ? ICmpInst::ICMP_SGE : ICmpInst::ICMP_UGE;
+    if (isLoopEntryGuardedByCond(L, GEPred, Start, RHS) ||
+        isKnownPredicateViaOuterIVRange(GEPred, Start, RHS))
       End = RHS;
     else
       End = IsSigned ? getSMinExpr(RHS, Start) : getUMinExpr(RHS, Start);
diff --git a/llvm/test/Analysis/ScalarEvolution/exit-count-start-is-outer-decreasing-iv.ll b/llvm/test/Analysis/ScalarEvolution/exit-count-start-is-outer-decreasing-iv.ll
new file mode 100644
index 0000000000000..ad7f4b3366487
--- /dev/null
+++ b/llvm/test/Analysis/ScalarEvolution/exit-count-start-is-outer-decreasing-iv.ll
@@ -0,0 +1,247 @@
+; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py
+; RUN: opt < %s -disable-output "-passes=print<scalar-evolution>" -scalar-evolution-classify-expressions=0 2>&1 | FileCheck %s
+
+; Tests for computing the exit count of a loop whose counting IV starts at the
+; value of a decreasing IV of another loop. That start value is bounded from
+; below by the other loop's own maximum trip count, so the exit count needs no
+; umin/smin clamp guarding against a zero-trip entry.
+
+; %loop2 starts at %loop1's IV, which is in [1, %n] because %loop1 steps by -1
+; at most %n - 1 times. So %loop2 is entered with a value above the bound 1 and
+; its backedge-taken count is exact.
+define void @exit_count_start_is_outer_decreasing_iv(ptr %p, i32 %n) {
+; CHECK-LABEL: 'exit_count_start_is_outer_decreasing_iv'
+; CHECK-NEXT:  Determining loop execution counts for: @exit_count_start_is_outer_decreasing_iv
+; CHECK-NEXT:  Loop %loop2: backedge-taken count is {(-1 + %n),+,-1}<nw><%loop1>
+; CHECK-NEXT:  Loop %loop2: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop2: symbolic max backedge-taken count is {(-1 + %n),+,-1}<nw><%loop1>
+; CHECK-NEXT:  Loop %loop2: Trip multiple is 1
+; CHECK-NEXT:  Loop %loop1: <multiple exits> Unpredictable backedge-taken count.
+; CHECK-NEXT:    exit count for loop1: ***COULDNOTCOMPUTE***
+; CHECK-NEXT:    exit count for loop1.latch: (-1 + %n)
+; CHECK-NEXT:  Loop %loop1: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop1: symbolic max backedge-taken count is (-1 + %n)
+; CHECK-NEXT:    symbolic max exit count for loop1: ***COULDNOTCOMPUTE***
+; CHECK-NEXT:    symbolic max exit count for loop1.latch: (-1 + %n)
+;
+entry:
+  %n.nz = icmp eq i32 %n, 0
+  br i1 %n.nz, label %exit, label %loop1
+
+loop1:
+  %i = phi i32 [ %n, %entry ], [ %i.dec, %loop1.latch ]
+  %c = load i8, ptr %p, align 1
+  %c.z = icmp eq i8 %c, 0
+  br i1 %c.z, label %loop1.latch, label %loop2
+
+loop1.latch:
+  %i.dec = add nsw i32 %i, -1
+  %done = icmp eq i32 %i.dec, 0
+  br i1 %done, label %exit, label %loop1
+
+loop2:
+  %j = phi i32 [ %i, %loop1 ], [ %j.dec, %loop2 ]
+  %j.dec = add nsw i32 %j, -1
+  %cont = icmp ugt i32 %j, 1
+  br i1 %cont, label %loop2, label %exit
+
+exit:
+  ret void
+}
+
+; Negative test: %loop1 steps by -1 but may wrap, so its IV is not bounded
+; below by 1 and the clamp must be kept.
+define void @exit_count_start_is_outer_decreasing_iv_may_wrap(ptr %p, i32 %n) {
+; CHECK-LABEL: 'exit_count_start_is_outer_decreasing_iv_may_wrap'
+; CHECK-NEXT:  Determining loop execution counts for: @exit_count_start_is_outer_decreasing_iv_may_wrap
+; CHECK-NEXT:  Loop %loop2: backedge-taken count is ((-1 * (1 umin {%n,+,-1}<%loop1>))<nuw><nsw> + {%n,+,-1}<%loop1>)
+; CHECK-NEXT:  Loop %loop2: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop2: symbolic max backedge-taken count is ((-1 * (1 umin {%n,+,-1}<%loop1>))<nuw><nsw> + {%n,+,-1}<%loop1>)
+; CHECK-NEXT:  Loop %loop2: Trip multiple is 1
+; CHECK-NEXT:  Loop %loop1: <multiple exits> Unpredictable backedge-taken count.
+; CHECK-NEXT:    exit count for loop1: ***COULDNOTCOMPUTE***
+; CHECK-NEXT:    exit count for loop1.latch: (99 + %n)
+; CHECK-NEXT:  Loop %loop1: constant max backedge-taken count is i32 -1
+; CHECK-NEXT:  Loop %loop1: symbolic max backedge-taken count is (99 + %n)
+; CHECK-NEXT:    symbolic max exit count for loop1: ***COULDNOTCOMPUTE***
+; CHECK-NEXT:    symbolic max exit count for loop1.latch: (99 + %n)
+;
+entry:
+  br label %loop1
+
+loop1:
+  %i = phi i32 [ %n, %entry ], [ %i.dec, %loop1.latch ]
+  %c = load i8, ptr %p, align 1
+  %c.z = icmp eq i8 %c, 0
+  br i1 %c.z, label %loop1.latch, label %loop2
+
+loop1.latch:
+  %i.dec = add i32 %i, -1
+  %done = icmp eq i32 %i.dec, -100
+  br i1 %done, label %exit, label %loop1
+
+loop2:
+  %j = phi i32 [ %i, %loop1 ], [ %j.dec, %loop2 ]
+  %j.dec = add nsw i32 %j, -1
+  %cont = icmp ugt i32 %j, 1
+  br i1 %cont, label %loop2, label %exit
+
+exit:
+  ret void
+}
+
+; Mirror image, for the umax clamp in howManyLessThans: %loop1 counts up, so its
+; IV is bounded from above by %n, and %loop2's exit count needs no clamp either.
+define void @exit_count_start_is_outer_increasing_iv(ptr %p, i32 %n) {
+; CHECK-LABEL: 'exit_count_start_is_outer_increasing_iv'
+; CHECK-NEXT:  Determining loop execution counts for: @exit_count_start_is_outer_increasing_iv
+; CHECK-NEXT:  Loop %loop2: backedge-taken count is {(-1 + %n),+,-1}<nw><%loop1>
+; CHECK-NEXT:  Loop %loop2: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop2: symbolic max backedge-taken count is {(-1 + %n),+,-1}<nw><%loop1>
+; CHECK-NEXT:  Loop %loop2: Trip multiple is 1
+; CHECK-NEXT:  Loop %loop1: <multiple exits> Unpredictable backedge-taken count.
+; CHECK-NEXT:    exit count for loop1: ***COULDNOTCOMPUTE***
+; CHECK-NEXT:    exit count for loop1.latch: (-1 + %n)
+; CHECK-NEXT:  Loop %loop1: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop1: symbolic max backedge-taken count is (-1 + %n)
+; CHECK-NEXT:    symbolic max exit count for loop1: ***COULDNOTCOMPUTE***
+; CHECK-NEXT:    symbolic max exit count for loop1.latch: (-1 + %n)
+;
+entry:
+  %nz = icmp eq i32 %n, 0
+  br i1 %nz, label %exit, label %loop1
+
+loop1:
+  %i = phi i32 [ 0, %entry ], [ %i.inc, %loop1.latch ]
+  %c = load i8, ptr %p, align 1
+  %cz = icmp eq i8 %c, 0
+  br i1 %cz, label %loop1.latch, label %loop2
+
+loop1.latch:
+  %i.inc = add nsw i32 %i, 1
+  %done = icmp eq i32 %i.inc, %n
+  br i1 %done, label %exit, label %loop1
+
+loop2:
+  %j = phi i32 [ %i, %loop1 ], [ %j.inc, %loop2 ]
+  %j.inc = add nsw i32 %j, 1
+  %cont = icmp ult i32 %j.inc, %n
+  br i1 %cont, label %loop2, label %exit
+
+exit:
+  ret void
+}
