+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
+; RUN: opt -S -passes=instcombine < %s | FileCheck %s
+
+target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"
+
+; A variable extract from a table of pointers into one object at a constant
+; stride is address arithmetic, so it folds to a single GEP.
+define ptr @strided(ptr %b, i32 %i) {
+; CHECK-LABEL: define ptr @strided(
+; CHECK-SAME: ptr [[B:%.*]], i32 [[I:%.*]]) {
+; CHECK-NEXT:    [[TMP1:%.*]] = zext i32 [[I]] to i64
+; CHECK-NEXT:    [[TMP2:%.*]] = shl nuw nsw i64 [[TMP1]], 3
+; CHECK-NEXT:    [[R:%.*]] = getelementptr i8, ptr [[B]], i64 [[TMP2]]
+; CHECK-NEXT:    ret ptr [[R]]
+;
+  %g1 = getelementptr i8, ptr %b, i64 8
+  %g2 = getelementptr i8, ptr %b, i64 16
+  %g3 = getelementptr i8, ptr %b, i64 24
+  %v0 = insertelement <4 x ptr> poison, ptr %b, i64 0
+  %v1 = insertelement <4 x ptr> %v0, ptr %g1, i64 1
+  %v2 = insertelement <4 x ptr> %v1, ptr %g2, i64 2
+  %v3 = insertelement <4 x ptr> %v2, ptr %g3, i64 3
+  %r = extractelement <4 x ptr> %v3, i32 %i
+  ret ptr %r
+}
+
+; The base element may itself sit at a non-zero offset.
+define ptr @strided_nonzero_base(ptr %b, i32 %i) {
+; CHECK-LABEL: define ptr @strided_nonzero_base(
+; CHECK-SAME: ptr [[B:%.*]], i32 [[I:%.*]]) {
+; CHECK-NEXT:    [[TMP1:%.*]] = zext i32 [[I]] to i64
+; CHECK-NEXT:    [[TMP2:%.*]] = shl nuw nsw i64 [[TMP1]], 2
+; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr i8, ptr [[B]], i64 [[TMP2]]
+; CHECK-NEXT:    [[R:%.*]] = getelementptr i8, ptr [[TMP3]], i64 4
+; CHECK-NEXT:    ret ptr [[R]]
+;
+  %g0 = getelementptr i8, ptr %b, i64 4
+  %g1 = getelementptr i8, ptr %b, i64 8
+  %v0 = insertelement <2 x ptr> poison, ptr %g0, i64 0
+  %v1 = insertelement <2 x ptr> %v0, ptr %g1, i64 1
+  %r = extractelement <2 x ptr> %v1, i32 %i
+  ret ptr %r
+}
+
+; The stride may be negative. The address is rebuilt from the common base, not
+; from element 0: an inbounds GEP that leaves the object is poison, and lane 0
+; must not hand that poison to a lane the extract actually selects.
+define ptr @strided_negative_poison_base(ptr %b, i32 %i) {
+; CHECK-LABEL: define ptr @strided_negative_poison_base(
+; CHECK-SAME: ptr [[B:%.*]], i32 [[I:%.*]]) {
+; CHECK-NEXT:    [[TMP1:%.*]] = zext i32 [[I]] to i64
+; CHECK-NEXT:    [[TMP2:%.*]] = shl nuw nsw i64 [[TMP1]], 1
+; CHECK-NEXT:    [[TMP3:%.*]] = sub nsw i64 6, [[TMP2]]
+; CHECK-NEXT:    [[R:%.*]] = getelementptr i8, ptr [[B]], i64 [[TMP3]]
+; CHECK-NEXT:    ret ptr [[R]]
+;
+  %g0 = getelementptr inbounds i8, ptr %b, i64 6
+  %g1 = getelementptr inbounds i8, ptr %b, i64 4
+  %v0 = insertelement <2 x ptr> poison, ptr %g0, i64 0
+  %v1 = insertelement <2 x ptr> %v0, ptr %g1, i64 1
+  %r = extractelement <2 x ptr> %v1, i32 %i
+  ret ptr %r
+}
+
+; Same, with a zero stride: every element holds the same address, but only the
+; base is known to be defined.
+define ptr @zero_stride_poison_base(ptr %b, i32 %i) {
+; CHECK-LABEL: define ptr @zero_stride_poison_base(
+; CHECK-SAME: ptr [[B:%.*]], i32 [[I:%.*]]) {
+; CHECK-NEXT:    [[R:%.*]] = getelementptr i8, ptr [[B]], i64 4
+; CHECK-NEXT:    ret ptr [[R]]
+;
+  %g0 = getelementptr inbounds i8, ptr %b, i64 4
+  %g1 = getelementptr i8, ptr %b, i64 4
+  %v0 = insertelement <2 x ptr> poison, ptr %g0, i64 0
+  %v1 = insertelement <2 x ptr> %v0, ptr %g1, i64 1
+  %r = extractelement <2 x ptr> %v1, i32 %i
+  ret ptr %r
+}
+
+; Negative: stripping the addrspacecast leaves a base in another address space.
+define ptr @addrspacecast_base(ptr addrspace(1) %b, i32 %i) {
+; CHECK-LABEL: define ptr @addrspacecast_base(
+; CHECK-SAME: ptr addrspace(1) [[B:%.*]], i32 [[I:%.*]]) {
+; CHECK-NEXT:    [[C:%.*]] = addrspacecast ptr addrspace(1) [[B]] to ptr
+; CHECK-NEXT:    [[G1:%.*]] = getelementptr i8, ptr [[C]], i64 8
+; CHECK-NEXT:    [[V0:%.*]] = insertelement <2 x ptr> poison, ptr [[C]], i64 0
+; CHECK-NEXT:    [[V1:%.*]] = insertelement <2 x ptr> [[V0]], ptr [[G1]], i64 1
+; CHECK-NEXT:    [[R:%.*]] = extractelement <2 x ptr> [[V1]], i32 [[I]]
+; CHECK-NEXT:    ret ptr [[R]]
+;
+  %c = addrspacecast ptr addrspace(1) %b to ptr
+  %g1 = getelementptr i8, ptr %c, i64 8
+  %v0 = insertelement <2 x ptr> poison, ptr %c, i64 0
+  %v1 = insertelement <2 x ptr> %v0, ptr %g1, i64 1
+  %r = extractelement <2 x ptr> %v1, i32 %i
+  ret ptr %r
+}
+
+; Inserts need not appear in index order.
+define ptr @strided_out_of_order(ptr %b, i32 %i) {
+; CHECK-LABEL: define ptr @strided_out_of_order(
+; CHECK-SAME: ptr [[B:%.*]], i32 [[I:%.*]]) {
+; CHECK-NEXT:    [[TMP1:%.*]] = zext i32 [[I]] to i64
+; CHECK-NEXT:    [[TMP2:%.*]] = shl nuw nsw i64 [[TMP1]], 3
+; CHECK-NEXT:    [[R:%.*]] = getelementptr i8, ptr [[B]], i64 [[TMP2]]
+; CHECK-NEXT:    ret ptr [[R]]
+;
+  %g1 = getelementptr i8, ptr %b, i64 8
+  %v0 = insertelement <2 x ptr> poison, ptr %g1, i64 1
+  %v1 = insertelement <2 x ptr> %v0, ptr %b, i64 0
+  %r = extractelement <2 x ptr> %v1, i32 %i
+  ret ptr %r
+}
+
+; All elements equal: the extract is just that pointer.
+define ptr @zero_stride(ptr %b, i32 %i) {
+; CHECK-LABEL: define ptr @zero_stride(
+; CHECK-SAME: ptr [[B:%.*]], i32 [[I:%.*]]) {
+; CHECK-NEXT:    ret ptr [[B]]
+;
+  %v0 = insertelement <2 x ptr> poison, ptr %b, i64 0
+  %v1 = insertelement <2 x ptr> %v0, ptr %b, i64 1
+  %r = extractelement <2 x ptr> %v1, i32 %i
+  ret ptr %r
+}
+
+; Negative: offsets 0, 8, 12, 24 are not an arithmetic sequence.
+define ptr @irregular_stride(ptr %b, i32 %i) {
+; CHECK-LABEL: define ptr @irregular_stride(
+; CHECK-SAME: ptr [[B:%.*]], i32 [[I:%.*]]) {
+; CHECK-NEXT:    [[G1:%.*]] = getelementptr i8, ptr [[B]], i64 8
+; CHECK-NEXT:    [[G2:%.*]] = getelementptr i8, ptr [[B]], i64 12
+; CHECK-NEXT:    [[G3:%.*]] = getelementptr i8, ptr [[B]], i64 24
+; CHECK-NEXT:    [[V0:%.*]] = insertelement <4 x ptr> poison, ptr [[B]], i64 0
+; CHECK-NEXT:    [[V1:%.*]] = insertelement <4 x ptr> [[V0]], ptr [[G1]], i64 1
+; CHECK-NEXT:    [[V2:%.*]] = insertelement <4 x ptr> [[V1]], ptr [[G2]], i64 2
+; CHECK-NEXT:    [[V3:%.*]] = insertelement <4 x ptr> [[V2]], ptr [[G3]], i64 3
+; CHECK-NEXT:    [[R:%.*]] = extractelement <4 x ptr> [[V3]], i32 [[I]]
+; CHECK-NEXT:    ret ptr [[R]]
+;
+  %g1 = getelementptr i8, ptr %b, i64 8
+  %g2 = getelementptr i8, ptr %b, i64 12
+  %g3 = getelementptr i8, ptr %b, i64 24
+  %v0 = insertelement <4 x ptr> poison, ptr %b, i64 0
+  %v1 = insertelement <4 x ptr> %v0, ptr %g1, i64 1
+  %v2 = insertelement <4 x ptr> %v1, ptr %g2, i64 2
+  %v3 = insertelement <4 x ptr> %v2, ptr %g3, i64 3
+  %r = extractelement <4 x ptr> %v3, i32 %i
+  ret ptr %r
+}
+
+; Negative: elements point into two unrelated objects.
+define ptr @two_bases(ptr %b, ptr %c, i32 %i) {
+; CHECK-LABEL: define ptr @two_bases(
+; CHECK-SAME: ptr [[B:%.*]], ptr [[C:%.*]], i32 [[I:%.*]]) {
+; CHECK-NEXT:    [[V0:%.*]] = insertelement <2 x ptr> poison, ptr [[B]], i64 0
+; CHECK-NEXT:    [[V1:%.*]] = insertelement <2 x ptr> [[V0]], ptr [[C]], i64 1
+; CHECK-NEXT:    [[R:%.*]] = extractelement <2 x ptr> [[V1]], i32 [[I]]
+; CHECK-NEXT:    ret ptr [[R]]
+;
+  %v0 = insertelement <2 x ptr> poison, ptr %b, i64 0
+  %v1 = insertelement <2 x ptr> %v0, ptr %c, i64 1
+  %r = extractelement <2 x ptr> %v1, i32 %i
+  ret ptr %r
+}
+
+; Negative: element 3 is never defined, so the sequence is unknown.
+define ptr @partially_defined(ptr %b, i32 %i) {
+; CHECK-LABEL: define ptr @partially_defined(
+; CHECK-SAME: ptr [[B:%.*]], i32 [[I:%.*]]) {
+; CHECK-NEXT:    [[G1:%.*]] = getelementptr i8, ptr [[B]], i64 8
+; CHECK-NEXT:    [[G2:%.*]] = getelementptr i8, ptr [[B]], i64 16
+; CHECK-NEXT:    [[V0:%.*]] = insertelement <4 x ptr> poison, ptr [[B]], i64 0
+; CHECK-NEXT:    [[V1:%.*]] = insertelement <4 x ptr> [[V0]], ptr [[G1]], i64 1
+; CHECK-NEXT:    [[V2:%.*]] = insertelement <4 x ptr> [[V1]], ptr [[G2]], i64 2
+; CHECK-NEXT:    [[R:%.*]] = extractelement <4 x ptr> [[V2]], i32 [[I]]
+; CHECK-NEXT:    ret ptr [[R]]
+;
+  %g1 = getelementptr i8, ptr %b, i64 8
+  %g2 = getelementptr i8, ptr %b, i64 16
+  %v0 = insertelement <4 x ptr> poison, ptr %b, i64 0
+  %v1 = insertelement <4 x ptr> %v0, ptr %g1, i64 1
+  %v2 = insertelement <4 x ptr> %v1, ptr %g2, i64 2
+  %r = extractelement <4 x ptr> %v2, i32 %i
+  ret ptr %r
+}
+
+; Negative: a non-pointer vector is left to the existing folds.
+define i32 @not_pointers(i32 %a, i32 %b, i32 %i) {
+; CHECK-LABEL: define i32 @not_pointers(
+; CHECK-SAME: i32 [[A:%.*]], i32 [[B:%.*]], i32 [[I:%.*]]) {
+; CHECK-NEXT:    [[V0:%.*]] = insertelement <2 x i32> poison, i32 [[A]], i64 0
+; CHECK-NEXT:    [[V1:%.*]] = insertelement <2 x i32> [[V0]], i32 [[B]], i64 1
+; CHECK-NEXT:    [[R:%.*]] = extractelement <2 x i32> [[V1]], i32 [[I]]
+; CHECK-NEXT:    ret i32 [[R]]
+;
+  %v0 = insertelement <2 x i32> poison, i32 %a, i64 0
+  %v1 = insertelement <2 x i32> %v0, i32 %b, i64 1
+  %r = extractelement <2 x i32> %v1, i32 %i
+  ret i32 %r
+}
