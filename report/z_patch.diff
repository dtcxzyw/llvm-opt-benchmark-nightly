+  %lhs = call i32 @llvm.smax.i32(i32 %l0, i32 %l1)
+  %r0 = call i32 @llvm.smin.i32(i32 %a1, i32 %b1)
+  %r1 = call i32 @llvm.smin.i32(i32 %c1, i32 %d1)
+  %rhs = call i32 @llvm.smax.i32(i32 %r0, i32 %r1)
+  %entry.guard = icmp slt i32 %start, %lhs
