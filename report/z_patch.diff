+  %cmp = icmp sgt <2 x i4> %x, %y
+  %b0 = extractelement <2 x i1> %cmp, i64 0
+  %b1 = extractelement <2 x i1> %cmp, i64 1
+  %b = select i1 %b0, i1 1, i1 %b1
+  ret i1 %b
+}
