@@ -338,6 +338,275 @@ define void @test_gpu_reduction(ptr %blockdim.ptr) {
   ret void
 }
 
+; lshr by 3 with an unknown start, which may have the top bit set: %iv is 0
+; after at most ceil(32 / 3) = 11 shifts.
+define void @test_lshr_shift3(i32 %init) {
+; CHECK-LABEL: 'test_lshr_shift3'
+; CHECK-NEXT:  Determining loop execution counts for: @test_lshr_shift3
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 11
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 11
+;
+ entry:
+  br label %loop
+
+ loop:
+  %iv = phi i32 [ %init, %entry ], [ %iv.shift, %loop ]
+  %iv.shift = lshr i32 %iv, 3
+  %exit.cond = icmp eq i32 %iv, 0
+  br i1 %exit.cond, label %leave, label %loop
+
+ leave:
+  ret void
+}
+
+; Varint-style loop comparing the shifted value: an i64 is 0 after at most
+; ceil(64 / 7) = 10 shifts.
+define void @test_lshr_shift7_shifted_cond(i64 %init) {
+; CHECK-LABEL: 'test_lshr_shift7_shifted_cond'
+; CHECK-NEXT:  Determining loop execution counts for: @test_lshr_shift7_shifted_cond
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 10
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i64 10
+;
+ entry:
+  br label %loop
+
+ loop:
+  %iv = phi i64 [ %init, %entry ], [ %iv.shift, %loop ]
+  %iv.shift = lshr i64 %iv, 7
+  %exit.cond = icmp eq i64 %iv.shift, 0
+  br i1 %exit.cond, label %leave, label %loop
+
+ leave:
+  ret void
+}
+
+; The tested value is shifted by a different amount than the recurrence. It is
+; 0 no later than %iv, after at most ceil(32 / 3) = 11 shifts.
+define void @test_lshr_shift3_test_shift1(i32 %init) {
+; CHECK-LABEL: 'test_lshr_shift3_test_shift1'
+; CHECK-NEXT:  Determining loop execution counts for: @test_lshr_shift3_test_shift1
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 11
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 11
+;
+ entry:
+  br label %loop
+
+ loop:
+  %iv = phi i32 [ %init, %entry ], [ %iv.shift, %loop ]
+  %iv.shift = lshr i32 %iv, 3
+  %iv.test = lshr i32 %iv, 1
+  %exit.cond = icmp eq i32 %iv.test, 0
+  br i1 %exit.cond, label %leave, label %loop
+
+ leave:
+  ret void
+}
+
+; The start is known to be 0, so the backedge is never taken.
+define void @test_lshr_zero_start(ptr %init.ptr) {
+; CHECK-LABEL: 'test_lshr_zero_start'
+; CHECK-NEXT:  Determining loop execution counts for: @test_lshr_zero_start
+; CHECK-NEXT:  Loop %loop: backedge-taken count is i32 0
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 0
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 0
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+ entry:
+  %init = load i32, ptr %init.ptr, !range !3
+  br label %loop
+
+ loop:
+  %iv = phi i32 [ %init, %entry ], [ %iv.shift, %loop ]
+  %iv.shift = lshr i32 %iv, 1
+  %exit.cond = icmp eq i32 %iv, 0
+  br i1 %exit.cond, label %leave, label %loop
+
+ leave:
+  ret void
+}
+
+; A negative start has all 32 bits active and stabilizes to -1 after at most
+; ceil(32 / 2) = 16 shifts.
+define void @test_ashr_shift2_negative(ptr %init.ptr) {
+; CHECK-LABEL: 'test_ashr_shift2_negative'
+; CHECK-NEXT:  Determining loop execution counts for: @test_ashr_shift2_negative
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 16
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 16
+;
+ entry:
+  %init = load i32, ptr %init.ptr, !range !1
+  br label %loop
+
+ loop:
+  %iv = phi i32 [ %init, %entry ], [ %iv.shift, %loop ]
+  %iv.shift = ashr i32 %iv, 2
+  %exit.cond = icmp eq i32 %iv, -1
+  br i1 %exit.cond, label %leave, label %loop
+
+ leave:
+  ret void
+}
+
+; The start is only known to be non-negative via the assume, so %iv stabilizes
+; to 0. Its range is unknown, giving at most ceil(32 / 3) = 11 shifts.
+define void @test_ashr_shift3_assume_nonneg(i32 %init) {
+; CHECK-LABEL: 'test_ashr_shift3_assume_nonneg'
+; CHECK-NEXT:  Determining loop execution counts for: @test_ashr_shift3_assume_nonneg
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 11
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 11
+;
+ entry:
+  %nonneg = icmp sgt i32 %init, -1
+  call void @llvm.assume(i1 %nonneg)
+  br label %loop
+
+ loop:
+  %iv = phi i32 [ %init, %entry ], [ %iv.shift, %loop ]
+  %iv.shift = ashr i32 %iv, 3
+  %exit.cond = icmp eq i32 %iv, 0
+  br i1 %exit.cond, label %leave, label %loop
+
+ leave:
+  ret void
+}
+
+; Dividing by 10 reaches 0 after at most 10 steps, as in digit-counting loops.
+define void @test_udiv(i32 %init) {
+; CHECK-LABEL: 'test_udiv'
+; CHECK-NEXT:  Determining loop execution counts for: @test_udiv
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 10
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 10
+;
+ entry:
+  br label %loop
+
+ loop:
+  %iv = phi i32 [ %init, %entry ], [ %iv.div, %loop ]
+  %iv.div = udiv i32 %iv, 10
+  %exit.cond = icmp eq i32 %iv.div, 0
+  br i1 %exit.cond, label %leave, label %loop
+
+ leave:
+  ret void
+}
+
+; The range of the start bounds the number of divisions: 49999 reaches 0
+; after 5 divisions by 10.
+define void @test_udiv_range(ptr %init.ptr) {
+; CHECK-LABEL: 'test_udiv_range'
+; CHECK-NEXT:  Determining loop execution counts for: @test_udiv_range
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 5
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 5
+;
+ entry:
+  %init = load i32, ptr %init.ptr, !range !0
+  br label %loop
+
+ loop:
+  %iv = phi i32 [ %init, %entry ], [ %iv.div, %loop ]
+  %iv.div = udiv i32 %iv, 10
+  %exit.cond = icmp eq i32 %iv, 0
+  br i1 %exit.cond, label %leave, label %loop
+
+ leave:
+  ret void
+}
+
+; Signed division by 2 truncates towards 0, so the magnitude of any start
+; reaches 0 after at most 32 steps.
+define void @test_sdiv(i32 %init) {
+; CHECK-LABEL: 'test_sdiv'
+; CHECK-NEXT:  Determining loop execution counts for: @test_sdiv
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 32
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 32
+;
+ entry:
+  br label %loop
+
+ loop:
+  %iv = phi i32 [ %init, %entry ], [ %iv.div, %loop ]
+  %iv.div = sdiv i32 %iv, 2
+  %exit.cond = icmp eq i32 %iv.div, 0
+  br i1 %exit.cond, label %leave, label %loop
+
+ leave:
+  ret void
+}
+
+; The largest magnitude in [-5000, -2] reaches 0 after 13 divisions by 2.
+define void @test_sdiv_range(ptr %init.ptr) {
+; CHECK-LABEL: 'test_sdiv_range'
+; CHECK-NEXT:  Determining loop execution counts for: @test_sdiv_range
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 13
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 13
+;
+ entry:
+  %init = load i32, ptr %init.ptr, !range !1
+  br label %loop
+
+ loop:
+  %iv = phi i32 [ %init, %entry ], [ %iv.div, %loop ]
+  %iv.div = sdiv i32 %iv, 2
+  %exit.cond = icmp eq i32 %iv, 0
+  br i1 %exit.cond, label %leave, label %loop
+
+ leave:
+  ret void
+}
+
+; Dividing by 1 does not change %iv, so the loop may be infinite.
+define void @test_udiv_by_one(i32 %init) {
+; CHECK-LABEL: 'test_udiv_by_one'
+; CHECK-NEXT:  Determining loop execution counts for: @test_udiv_by_one
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: Unpredictable constant max backedge-taken count.
+; CHECK-NEXT:  Loop %loop: Unpredictable symbolic max backedge-taken count.
+;
+ entry:
+  br label %loop
+
+ loop:
+  %iv = phi i32 [ %init, %entry ], [ %iv.div, %loop ]
+  %iv.div = udiv i32 %iv, 1
+  %exit.cond = icmp eq i32 %iv.div, 0
+  br i1 %exit.cond, label %leave, label %loop
+
+ leave:
+  ret void
+}
+
+; Dividing an i128 by 10 shifts out at least 3 bits, so it reaches 0 after at
+; most 43 steps.
+define void @test_udiv_i128(i128 %init) {
+; CHECK-LABEL: 'test_udiv_i128'
+; CHECK-NEXT:  Determining loop execution counts for: @test_udiv_i128
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i128 43
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i128 43
+;
+ entry:
+  br label %loop
+
+ loop:
+  %iv = phi i128 [ %init, %entry ], [ %iv.div, %loop ]
+  %iv.div = udiv i128 %iv, 10
+  %exit.cond = icmp eq i128 %iv, 0
+  br i1 %exit.cond, label %leave, label %loop
+
+ leave:
+  ret void
+}
