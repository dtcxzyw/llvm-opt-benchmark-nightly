+define i1 @icmp_add20_uge_add57(i8 %x, i8 %y) {
+; CHECK-LABEL: define i1 @icmp_add20_uge_add57(
+; CHECK-SAME: i8 [[X:%.*]], i8 [[Y:%.*]]) {
+; CHECK-NEXT:    [[TMP1:%.*]] = add nuw i8 [[Y]], 37
+; CHECK-NEXT:    [[CMP:%.*]] = icmp uge i8 [[X]], [[TMP1]]
+; CHECK-NEXT:    ret i1 [[CMP]]
+;
