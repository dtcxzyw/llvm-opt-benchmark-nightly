+define i8 @swapped_arms_umin(i8 %x) {
+; CHECK-LABEL: @swapped_arms_umin(
+; CHECK-NEXT:    [[TMP1:%.*]] = call i8 @llvm.umin.i8(i8 [[X:%.*]], i8 4)
+; CHECK-NEXT:    [[R:%.*]] = lshr i8 -1, [[TMP1]]
+; CHECK-NEXT:    ret i8 [[R]]
+;
+  %c = icmp ult i8 %x, 4
+  %s = lshr i8 -1, %x
+  %r = select i1 %c, i8 %s, i8 15
+  ret i8 %r
+}
+
+; Negative test: the compare constant is not a valid shift amount for the type,
+; so clamping to it would make the shift poison at e.g. %x == 10, where the
+; original selected the constant arm.
+define i8 @negative_cmp_constant_out_of_range(i8 %x) {
+; CHECK-LABEL: @negative_cmp_constant_out_of_range(
+; CHECK-NEXT:    [[C:%.*]] = icmp ult i8 [[X:%.*]], 20
+; CHECK-NEXT:    [[S:%.*]] = lshr i8 -1, [[X]]
+; CHECK-NEXT:    [[R:%.*]] = select i1 [[C]], i8 0, i8 [[S]]
+; CHECK-NEXT:    ret i8 [[R]]
+;
+  %c = icmp ult i8 %x, 20
+  %s = lshr i8 -1, %x
+  %r = select i1 %c, i8 0, i8 %s
+  ret i8 %r
+}
+
+; Negative test: the constant arm is not the shift evaluated at the boundary
+; (255 >> 3 is 31, not 30).
+define i8 @negative_not_boundary_value(i8 %x) {
+; CHECK-LABEL: @negative_not_boundary_value(
+; CHECK-NEXT:    [[C:%.*]] = icmp ult i8 [[X:%.*]], 3
+; CHECK-NEXT:    [[S:%.*]] = lshr i8 -1, [[X]]
+; CHECK-NEXT:    [[R:%.*]] = select i1 [[C]], i8 30, i8 [[S]]
+; CHECK-NEXT:    ret i8 [[R]]
+;
+  %c = icmp ult i8 %x, 3
+  %s = lshr i8 -1, %x
+  %r = select i1 %c, i8 30, i8 %s
+  ret i8 %r
+}
+
+; Negative test: signed predicate.
+define i8 @negative_signed_predicate(i8 %x) {
+; CHECK-LABEL: @negative_signed_predicate(
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i8 [[X:%.*]], 3
+; CHECK-NEXT:    [[S:%.*]] = lshr i8 -1, [[X]]
+; CHECK-NEXT:    [[R:%.*]] = select i1 [[C]], i8 31, i8 [[S]]
