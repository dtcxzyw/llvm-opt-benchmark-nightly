diff --git a/llvm/test/Analysis/ScalarEvolution/implied-via-negation.ll b/llvm/test/Analysis/ScalarEvolution/implied-via-negation.ll
new file mode 100644
index 0000000000000..819e7a767ba8d
--- /dev/null
+++ b/llvm/test/Analysis/ScalarEvolution/implied-via-negation.ll
@@ -0,0 +1,60 @@
+; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -disable-output -passes="print<scalar-evolution>" \
+; RUN:   -scalar-evolution-classify-expressions=0 2>&1 | FileCheck %s
+
+; (n s> 0) ===> (11 - n s< 11), via 11 - n == ~(n - 12).
+define void @guard_sub_from_constant(i32 %n) {
+; CHECK-LABEL: 'guard_sub_from_constant'
+; CHECK-NEXT:  Determining loop execution counts for: @guard_sub_from_constant
+; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-1 + (sext i32 %n to i64))<nsw> /u 4)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 536870911
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-1 + (sext i32 %n to i64))<nsw> /u 4)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %guard = icmp sgt i32 %n, 0
+  br i1 %guard, label %ph, label %exit
+
+ph:
+  %sub = sub nsw i32 15, %n
+  %start = sext i32 %sub to i64
+  br label %loop
+
+loop:
+  %iv = phi i64 [ %start, %ph ], [ %iv.next, %loop ]
+  %iv.next = add i64 %iv, 4
+  %cmp = icmp slt i64 %iv, 11
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; (sext x s< 0) ===> (8 - sext x s> -1). Needs the range of sext x to exclude
+; INT_MIN.
+define void @guard_sext_negative(i16 %x) {
+; CHECK-LABEL: 'guard_sext_negative'
+; CHECK-NEXT:  Determining loop execution counts for: @guard_sext_negative
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (9 + (-1 * (sext i16 %x to i32))<nsw>)<nsw>
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 32777
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (9 + (-1 * (sext i16 %x to i32))<nsw>)<nsw>
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %s = sext i16 %x to i32
+  %guard = icmp slt i32 %s, 0
+  br i1 %guard, label %ph, label %exit
+
+ph:
+  %start = sub nsw i32 8, %s
+  br label %loop
+
+loop:
+  %iv = phi i32 [ %start, %ph ], [ %iv.next, %loop ]
+  %iv.next = add nsw i32 %iv, -1
+  %cmp = icmp sgt i32 %iv, -1
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
+}
diff --git a/llvm/test/Transforms/IndVarSimplify/implied-via-negation.ll b/llvm/test/Transforms/IndVarSimplify/implied-via-negation.ll
new file mode 100644
index 0000000000000..79bffb9c65321
--- /dev/null
+++ b/llvm/test/Transforms/IndVarSimplify/implied-via-negation.ll
@@ -0,0 +1,39 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=indvars -S < %s | FileCheck %s
+
+; %j == 8 - %i, so (%i u< 7) ===> (%j u> 1).
+define void @addrec_negated_addrec(ptr %p) {
+; CHECK-LABEL: define void @addrec_negated_addrec(
+; CHECK-SAME: ptr [[P:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LATCH:.*]] ]
+; CHECK-NEXT:    [[C:%.*]] = icmp samesign ult i32 [[I]], 7
+; CHECK-NEXT:    br i1 [[C]], label %[[LATCH]], label %[[EXIT:.*]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    store i1 true, ptr [[P]], align 1
+; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I]], 1
+; CHECK-NEXT:    br label %[[LOOP]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %loop
+
+loop:
+  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
+  %j = phi i32 [ 8, %entry ], [ %j.next, %latch ]
+  %c = icmp ult i32 %i, 7
+  br i1 %c, label %latch, label %exit
+
+latch:
+  %d = icmp ugt i32 %j, 1
+  store i1 %d, ptr %p
+  %i.next = add nuw nsw i32 %i, 1
+  %j.next = add nsw i32 %j, -1
+  br label %loop
+
+exit:
+  ret void
+}
