+define void @phi_incoming_from_merge_in_other_loop(ptr %p, i32 %a, i32 %b, i1 %c, i1 %d, i1 %e, i1 %x) {
+; CHECK-LABEL: 'phi_incoming_from_merge_in_other_loop'
+; CHECK-NEXT:  Determining loop execution counts for: @phi_incoming_from_merge_in_other_loop
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-2 + %n)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-2 + %n)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+; CHECK-NEXT:  Loop %l0.header: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %l0.header: Unpredictable constant max backedge-taken count.
+; CHECK-NEXT:  Loop %l0.header: Unpredictable symbolic max backedge-taken count.
+;
+entry:
+  br i1 %c, label %l0.ph, label %then.b
+
+then.b:
+  %gb = icmp ugt i32 %b, 1
+  br i1 %gb, label %merge, label %exit
+
+l0.ph:
+  %ga = icmp ugt i32 %a, 1
+  br i1 %ga, label %l0.header, label %exit
+
+l0.header:
+  br i1 %d, label %l0.split, label %l0.latch
+
+l0.split:
+  br i1 %e, label %l0.then, label %l0.else
+
+l0.then:
+  br label %l0.exiting
+
+l0.else:
+  br label %l0.exiting
+
+l0.exiting:
+  br i1 %x, label %merge, label %l0.latch
+
+l0.latch:
+  br label %l0.header
+
+merge:
+  %n = phi i32 [ %a, %l0.exiting ], [ %b, %then.b ]
+  br label %ph
+
+ph:
+  %m = add i32 %n, -1
+  br label %loop
+
+loop:
+  %i = phi i32 [ 0, %ph ], [ %iv.next, %loop ]
+  store i32 %i, ptr %p, align 4
+  %iv.next = add nuw i32 %i, 1
+  %ec = icmp ult i32 %iv.next, %m
+  br i1 %ec, label %loop, label %exit
+
+exit:
