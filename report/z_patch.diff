+; CHECK-NEXT:  Determining loop execution counts for: @dec_to_start_of_nsw_addrec_unsigned_clamp
+; CHECK-NEXT:  Loop %down: backedge-taken count is ((-1 * ({%start,+,(zext i3 (trunc i64 %step.raw to i3) to i64)}<nsw><%up> umin %start)) + {%start,+,(zext i3 (trunc i64 %step.raw to i3) to i64)}<nsw><%up>)
+; CHECK-NEXT:  Loop %down: constant max backedge-taken count is i64 -1
+; CHECK-NEXT:  Loop %down: symbolic max backedge-taken count is ((-1 * ({%start,+,(zext i3 (trunc i64 %step.raw to i3) to i64)}<nsw><%up> umin %start)) + {%start,+,(zext i3 (trunc i64 %step.raw to i3) to i64)}<nsw><%up>)
+; CHECK-NEXT:  Loop %down: Trip multiple is 1
+; CHECK-NEXT:  Loop %up: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %up: Unpredictable constant max backedge-taken count.
+; CHECK-NEXT:  Loop %up: Unpredictable symbolic max backedge-taken count.
+;
+entry:
+  %step = and i64 %step.raw, 7
+  br label %up
+
+up:
+  %x = phi i64 [ %start, %entry ], [ %x.next, %up.latch ]
+  %v = phi i32 [ %n, %entry ], [ %v.next, %up.latch ]
+  %pos = icmp sgt i32 %v, 0
+  br i1 %pos, label %up.latch, label %down
+
+up.latch:
+  %x.next = add nsw i64 %x, %step
+  %v.next = mul i32 %v, 10
+  br label %up
+
+down:
+  %y = phi i64 [ %x, %up ], [ %y.next, %down.latch ]
+  %in.range = icmp ugt i64 %y, %start
+  br i1 %in.range, label %down.latch, label %exit
+
+down.latch:
+  %y.next = add i64 %y, -1
+  br label %down
+
+exit:
+  ret void
+}
