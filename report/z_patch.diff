+; CHECK-NEXT:    [[O:%.*]] = getelementptr inbounds i8, ptr [[OUT]], i64 16
+; CHECK-NEXT:    store <32 x i4> [[A_16_VEC_EXTRACT]], ptr [[O]], align 16
+; CHECK-NEXT:    ret void
+;
+  %a = alloca <64 x i4>, align 64
+  store <64 x i4> %v, ptr %a, align 64
+  %lo = load <32 x i4>, ptr %a, align 64
+  %p = getelementptr inbounds i8, ptr %a, i64 16
+  %hi = load <32 x i4>, ptr %p, align 16
+  store <32 x i4> %lo, ptr %out, align 16
+  %o = getelementptr inbounds i8, ptr %out, i64 16
+  store <32 x i4> %hi, ptr %o, align 16
+  ret void
+}
+
+; A one-byte read at offset 1 is lanes 2 and 3.
+define <2 x i4> @byte_slice(<16 x i4> %v) {
+; CHECK-LABEL: define <2 x i4> @byte_slice(
+; CHECK-SAME: <16 x i4> [[V:%.*]]) {
+; CHECK-NEXT:    [[A_1_VEC_EXTRACT:%.*]] = shufflevector <16 x i4> [[V]], <16 x i4> poison, <2 x i32> <i32 2, i32 3>
+; CHECK-NEXT:    ret <2 x i4> [[A_1_VEC_EXTRACT]]
+;
+  %a = alloca <16 x i4>, align 8
+  store <16 x i4> %v, ptr %a, align 8
+  %p = getelementptr inbounds i8, ptr %a, i64 1
+  %b = load <2 x i4>, ptr %p, align 1
+  ret <2 x i4> %b
+}
+
+; A mask vector read back by halves.
+define <8 x i1> @i1_mask(<16 x i1> %m) {
+; CHECK-LABEL: define <8 x i1> @i1_mask(
+; CHECK-SAME: <16 x i1> [[M:%.*]]) {
+; CHECK-NEXT:    [[A_1_VEC_EXTRACT:%.*]] = shufflevector <16 x i1> [[M]], <16 x i1> poison, <8 x i32> <i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
+; CHECK-NEXT:    ret <8 x i1> [[A_1_VEC_EXTRACT]]
