+  %ec = icmp ne i64 %iv.next, %n
+  br i1 %ec, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Same, but the bound is on zext(%k) to i64 itself. Not finalizing
+; zext(%k) to i32 first would lose the bound on %m.
+define void @narrow_zext_dep_k64_ne_0(i64 %n, i32 %m, i8 %k) {
+; CHECK-LABEL: 'narrow_zext_dep_k64_ne_0'
+; CHECK-NEXT:  Determining loop execution counts for: @narrow_zext_dep_k64_ne_0
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (zext i8 %k to i64))<nsw>
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 10
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (zext i8 %k to i64))<nsw>
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %m.ule = icmp ule i32 %m, 10
+  br i1 %m.ule, label %guard.k64, label %exit
+
+guard.k64:
+  %k64 = zext i8 %k to i64
+  %n.ule = icmp ule i64 %n, %k64
+  br i1 %n.ule, label %guard.k32, label %exit
+
+guard.k32:
+  %k32 = zext i8 %k to i32
+  %m1 = add i32 %m, 1
+  %k32.ule = icmp ule i32 %k32, %m1
+  br i1 %k32.ule, label %guard.ne, label %exit
+
+guard.ne:
+  %k.ne = icmp ne i64 %k64, 0
+  br i1 %k.ne, label %loop, label %exit
+
+loop:
+  %iv = phi i64 [ 0, %guard.ne ], [ %iv.next, %loop ]
+  %iv.next = add i64 %iv, 1
+  %ec = icmp ne i64 %iv.next, %k64
+  br i1 %ec, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; The rewrite of %n contains %k64 + %j64, whose rewrite uses the rewrite of the
+; narrower zext(%k) to i32. Finalizing it first must not lose the range of %k.
+define void @rewritten_zext_range(i64 %n, i32 %m, i8 %k, i8 %j) {
+; CHECK-LABEL: 'rewritten_zext_range'
+; CHECK-NEXT:  Determining loop execution counts for: @rewritten_zext_range
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + %n)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 509
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + %n)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %k32 = zext i8 %k to i32
+  %m1 = add i32 %m, 1
+  %k.ugt = icmp ugt i32 %k32, %m1
+  br i1 %k.ugt, label %guard.n, label %exit
+
+guard.n:
+  %k64 = zext i8 %k to i64
+  %j64 = zext i8 %j to i64
+  %kj = add i64 %k64, %j64
+  %n.sle = icmp sle i64 %n, %kj
+  br i1 %n.sle, label %guard.n.pos, label %exit
+
+guard.n.pos:
+  %n.sgt = icmp sgt i64 %n, 0
+  br i1 %n.sgt, label %loop, label %exit
+
+loop:
+  %iv = phi i64 [ 0, %guard.n.pos ], [ %iv.next, %loop ]
+  %iv.next = add i64 %iv, 1
+  %ec = icmp ne i64 %iv.next, %n
+  br i1 %ec, label %loop, label %exit
+
+exit:
+  ret void
+}
