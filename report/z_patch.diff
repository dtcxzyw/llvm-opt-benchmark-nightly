+define void @nested_increasing(ptr %p, i32 %n) {
+; CHECK-LABEL: 'nested_increasing'
+; CHECK-NEXT:  Determining loop execution counts for: @nested_increasing
+; CHECK-NEXT:  Loop %loop2: backedge-taken count is {(-1 + %n),+,-1}<nw><%loop1>
+; CHECK-NEXT:  Loop %loop2: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop2: symbolic max backedge-taken count is {(-1 + %n),+,-1}<nw><%loop1>
+; CHECK-NEXT:  Loop %loop2: Trip multiple is 1
+; CHECK-NEXT:  Loop %loop1: backedge-taken count is (-1 + %n)
+; CHECK-NEXT:  Loop %loop1: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop1: symbolic max backedge-taken count is (-1 + %n)
+; CHECK-NEXT:  Loop %loop1: Trip multiple is 1
