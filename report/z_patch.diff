+
+define void @stride2_decreasing_rhs_ne_smin(i8 %n) {
+; CHECK-LABEL: 'stride2_decreasing_rhs_ne_smin'
+; CHECK-NEXT:  Determining loop execution counts for: @stride2_decreasing_rhs_ne_smin
