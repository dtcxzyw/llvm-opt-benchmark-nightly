+target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"
+
+; Tests for dropping the min(RHS, Start) clamp in howManyGreaterThans when RHS
+; is a unit-stride induction variable of a surrounding loop whose maximum value
+; is provably <= the countdown's start value. Folding the clamp keeps the
+; backedge-taken count an affine recurrence (enabling e.g. runtime unrolling)
+; instead of an expensive smin expression.
+
+; Positive, signed: countdown start is the zero-extended trip count, RHS is the
+; surrounding loop's IV which reaches at most trip-count-1. The clamp is dropped.
+define void @signed_zext_tripcount(i32 %n) {
+; CHECK-LABEL: 'signed_zext_tripcount'
+; CHECK-NEXT:  Classifying expressions for: @signed_zext_tripcount
+; CHECK-NEXT:    %wtc = zext nneg i32 %n to i64
+; CHECK-NEXT:    --> (zext i32 %n to i64) U: [0,4294967296) S: [0,4294967296)
+; CHECK-NEXT:    %j = phi i64 [ 0, %outer.ph ], [ %j.next, %outer.latch ]
+; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%outer> U: [0,2147483647) S: [0,2147483647) Exits: <<Unknown>> LoopDispositions: { %outer: Computable }
+; CHECK-NEXT:    %pos = call i1 @cond()
+; CHECK-NEXT:    --> %pos U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %outer: Variant }
+; CHECK-NEXT:    %j.next = add nuw nsw i64 %j, 1
+; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%outer> U: [1,2147483648) S: [1,2147483648) Exits: <<Unknown>> LoopDispositions: { %outer: Computable }
+; CHECK-NEXT:    %k = phi i64 [ %k.next, %countdown ], [ %wtc, %outer ]
+; CHECK-NEXT:    --> {(zext i32 %n to i64),+,-1}<nsw><%countdown> U: [-4294967294,4294967296) S: [-4294967294,4294967296) Exits: {1,+,1}<nuw><nsw><%outer> LoopDispositions: { %countdown: Computable }
+; CHECK-NEXT:    %k.next = add nsw i64 %k, -1
+; CHECK-NEXT:    --> {(-1 + (zext i32 %n to i64))<nsw>,+,-1}<nsw><%countdown> U: [-4294967295,4294967295) S: [-4294967295,4294967295) Exits: {0,+,1}<nuw><nsw><%outer> LoopDispositions: { %countdown: Computable }
+; CHECK-NEXT:  Determining loop execution counts for: @signed_zext_tripcount
+; CHECK-NEXT:  Loop %countdown: backedge-taken count is {(-1 + (zext i32 %n to i64))<nsw>,+,-1}<nw><%outer>
+; CHECK-NEXT:  Loop %countdown: constant max backedge-taken count is i64 4294967294
+; CHECK-NEXT:  Loop %countdown: symbolic max backedge-taken count is {(-1 + (zext i32 %n to i64))<nsw>,+,-1}<nw><%outer>
+; CHECK-NEXT:  Loop %countdown: Trip multiple is 1
+; CHECK-NEXT:  Loop %outer: <multiple exits> Unpredictable backedge-taken count.
+; CHECK-NEXT:    exit count for outer: ***COULDNOTCOMPUTE***
+; CHECK-NEXT:    exit count for outer.latch: (-1 + (zext i32 %n to i64))<nsw>
+; CHECK-NEXT:  Loop %outer: constant max backedge-taken count is i64 2147483646
+; CHECK-NEXT:  Loop %outer: symbolic max backedge-taken count is (-1 + (zext i32 %n to i64))<nsw>
+; CHECK-NEXT:    symbolic max exit count for outer: ***COULDNOTCOMPUTE***
+; CHECK-NEXT:    symbolic max exit count for outer.latch: (-1 + (zext i32 %n to i64))<nsw>
+;
+entry:
+  %c = icmp sgt i32 %n, 0
+  br i1 %c, label %outer.ph, label %exit
+
+outer.ph:
+  %wtc = zext nneg i32 %n to i64
+  br label %outer
+
+outer:
+  %j = phi i64 [ 0, %outer.ph ], [ %j.next, %outer.latch ]
+  %pos = call i1 @cond()
+  br i1 %pos, label %outer.latch, label %countdown
+
+outer.latch:
+  %j.next = add nuw nsw i64 %j, 1
+  %done = icmp eq i64 %j.next, %wtc
+  br i1 %done, label %exit, label %outer
+
+countdown:
+  %k = phi i64 [ %k.next, %countdown ], [ %wtc, %outer ]
+  %k.next = add nsw i64 %k, -1
+  store i64 %k.next, ptr null, align 8
+  %gt = icmp sgt i64 %k.next, %j
+  br i1 %gt, label %countdown, label %exit
+
+exit:
+  ret void
+}
