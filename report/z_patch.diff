+
+; lshr 1, X --> zext (X == 0)
+
+define i32 @lshr_one_i32(i32 %x) {
+; CHECK-LABEL: @lshr_one_i32(
+; CHECK-NEXT:    [[TMP1:%.*]] = icmp eq i32 [[X:%.*]], 0
+; CHECK-NEXT:    [[SHR:%.*]] = zext i1 [[TMP1]] to i32
