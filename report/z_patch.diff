+define i32 @scaled_nuw_nested(ptr %dst, i32 %a, i32 %b, i32 %outer_n, i32 %inner_n, i1 %enter) {
+; CHECK-LABEL: define i32 @scaled_nuw_nested(
+; CHECK-SAME: ptr [[DST:%.*]], i32 [[A:%.*]], i32 [[B:%.*]], i32 [[OUTER_N:%.*]], i32 [[INNER_N:%.*]], i1 [[ENTER:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[TMP0:%.*]] = mul i32 [[B]], [[A]]
+; CHECK-NEXT:    [[TMP1:%.*]] = zext i32 [[TMP0]] to i64
+; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[DST]], i64 [[TMP1]]
+; CHECK-NEXT:    [[TMP2:%.*]] = zext i32 [[B]] to i64
+; CHECK-NEXT:    [[TMP3:%.*]] = mul i32 [[OUTER_N]], [[B]]
+; CHECK-NEXT:    [[TMP4:%.*]] = mul i32 [[TMP3]], [[A]]
+; CHECK-NEXT:    br label %[[OUTER:.*]]
+; CHECK:       [[OUTER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
+; CHECK-NEXT:    br i1 [[ENTER]], label %[[INNER_PH:.*]], label %[[OUTER_LATCH]]
+; CHECK:       [[INNER_PH]]:
+; CHECK-NEXT:    br label %[[INNER:.*]]
+; CHECK:       [[INNER]]:
+; CHECK-NEXT:    [[LSR_IV2:%.*]] = phi i32 [ [[LSR_IV_NEXT:%.*]], %[[INNER]] ], [ [[INNER_N]], %[[INNER_PH]] ]
+; CHECK-NEXT:    [[LSR_IV:%.*]] = phi ptr [ [[SCEVGEP1:%.*]], %[[INNER]] ], [ [[SCEVGEP]], %[[INNER_PH]] ]
+; CHECK-NEXT:    store i8 0, ptr [[LSR_IV]], align 1
+; CHECK-NEXT:    [[SCEVGEP1]] = getelementptr i8, ptr [[LSR_IV]], i64 [[TMP2]]
+; CHECK-NEXT:    [[LSR_IV_NEXT]] = add i32 [[LSR_IV2]], -1
+; CHECK-NEXT:    [[EC:%.*]] = icmp eq i32 [[LSR_IV_NEXT]], 0
+; CHECK-NEXT:    br i1 [[EC]], label %[[OUTER_LATCH_LOOPEXIT:.*]], label %[[INNER]]
+; CHECK:       [[OUTER_LATCH_LOOPEXIT]]:
+; CHECK-NEXT:    br label %[[OUTER_LATCH]]
+; CHECK:       [[OUTER_LATCH]]:
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw i32 [[IV]], 1
+; CHECK-NEXT:    [[OUTER_EC:%.*]] = icmp eq i32 [[IV_NEXT]], [[OUTER_N]]
+; CHECK-NEXT:    br i1 [[OUTER_EC]], label %[[EXIT:.*]], label %[[OUTER]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i32 [[TMP4]]
+;
+entry:
+  br label %outer
+
+outer:
+  %iv = phi i32 [ 0, %entry ], [ %iv.next, %outer.latch ]
+  %red = phi i32 [ 0, %entry ], [ %red.next, %outer.latch ]
+  %bare = mul i32 %a, %b
+  %red.next = add i32 %red, %bare
+  br i1 %enter, label %inner.ph, label %outer.latch
+
+inner.ph:
+  br label %inner
+
+inner:
+  %iv.1 = phi i32 [ %a, %inner.ph ], [ %iv.1.next, %inner ]
+  %iv.2 = phi i32 [ 0, %inner.ph ], [ %iv.2.next, %inner ]
+  %idx = mul nuw i32 %iv.1, %b
+  %wide = zext i32 %idx to i64
