diff --git a/llvm/lib/Analysis/ConstraintSystem.cpp b/llvm/lib/Analysis/ConstraintSystem.cpp
index 56cb646093f83..85ac780b5f720 100644
--- a/llvm/lib/Analysis/ConstraintSystem.cpp
+++ b/llvm/lib/Analysis/ConstraintSystem.cpp
@@ -219,6 +219,8 @@ bool ConstraintSystem::mayHaveSolution() {
 
 std::pair<ConstraintSystem, ConstraintSystem::RowTy>
 ConstraintSystem::getSubSystem(ArrayRef<Entry> R) const {
+  assert((R.empty() || R.back().Id <= NumVariables) &&
+         "query must only use variables of the system");
   // Only constraints that share a variable (transitively) with a query R can
   // affect whether system + !R has a solution.
   //
diff --git a/llvm/lib/Transforms/Scalar/ConstraintElimination.cpp b/llvm/lib/Transforms/Scalar/ConstraintElimination.cpp
index 658b027820a84..dd2b7ceda8137 100644
--- a/llvm/lib/Transforms/Scalar/ConstraintElimination.cpp
+++ b/llvm/lib/Transforms/Scalar/ConstraintElimination.cpp
@@ -1803,9 +1803,82 @@ static std::optional<bool> checkCondition(CmpInst::Predicate Pred, Value *A,
     return std::nullopt;
   };
 
+  // Whether an expression can be looked through depends on the facts currently
+  // on the stack, so a value may be opaque when a fact about it is recorded and
+  // decomposable by the time it is queried. The query then talks about the
+  // operands while the fact talks about the value itself, and the two no longer
+  // connect. Detect that by checking whether \p V, despite being a variable in
+  // the system, has no coefficient in the constraint we just built.
+  auto WasDecomposedAway = [&Info](Value *V, const ConstraintTy &C) {
+    const auto &Value2Index = Info.getValue2Index(C.IsSigned);
+    auto It = Value2Index.find(V);
+    return It != Value2Index.end() &&
+           none_of(C.Coefficients,
+                   [&It](const Entry &E) { return E.Id == It->second; });
+  };
+
+  // Re-connect the two representations instead: temporarily tell the system
+  // that the variable and its decomposition denote the same value, so facts
+  // recorded about either form can be used together, then drop the extra rows.
+  // \p C must only use variables that are already part of the system; see
+  // ConstraintSystem::getSubSystem.
+  auto TryWithLinkedRepresentation =
+      [&](const ConstraintTy &C) -> std::optional<bool> {
+    if (C.empty())
+      return std::nullopt;
+
+    const DataLayout &DL = CheckInst->getDataLayout();
+    const auto &Value2Index = Info.getValue2Index(C.IsSigned);
+    SmallVector<RowTy, 4> LinkRows;
+    for (Value *V : {A, B}) {
+      if (!WasDecomposedAway(V, C))
+        continue;
+      // Build the rows for V - decompose(V) <= 0 and its negation.
+      auto D = decompose(V, Info, C.IsSigned, DL);
+      SmallMapVector<unsigned, int64_t, 4> Coeffs;
+      Coeffs[Value2Index.find(V)->second] += 1;
+      for (const DecompEntry &E : D.Vars) {
+        auto It = Value2Index.find(E.Variable);
+        if (It == Value2Index.end())
+          return std::nullopt;
+        if (SubOverflow(Coeffs[It->second], E.Coefficient, Coeffs[It->second]))
+          return std::nullopt;
+      }
+      RowTy Row(1, Entry(D.Offset, 0));
+      for (auto &KV : Coeffs)
+        if (KV.second != 0)
+          Row.emplace_back(KV.second, KV.first);
+      if (Row.size() == 1)
+        return std::nullopt;
+      sort(drop_begin(Row),
+           [](const Entry &X, const Entry &Y) { return X.Id < Y.Id; });
+      RowTy Negated = ConstraintSystem::negateOrEqual(Row);
+      if (Negated.empty())
+        return std::nullopt;
+      LinkRows.push_back(std::move(Row));
+      LinkRows.push_back(std::move(Negated));
+    }
+    if (LinkRows.empty())
+      return std::nullopt;
+
+    auto &CS = Info.getCS(C.IsSigned);
+    unsigned NumPushed = 0;
+    for (const RowTy &Row : LinkRows)
+      if (CS.addRow(Row, Value2Index.size()))
+        NumPushed++;
+    std::optional<bool> Res;
+    if (NumPushed != 0)
+      Res = TryWithConstraint(C);
+    while (NumPushed--)
+      CS.popLastConstraint();
+    return Res;
+  };
+
   auto R = Info.getConstraintForSolving(Pred, A, B);
   if (auto ImpliedCondition = TryWithConstraint(R))
     return ImpliedCondition;
+  if (auto ImpliedCondition = TryWithLinkedRepresentation(R))
+    return ImpliedCondition;
 
   // For non-negative operands unsigned queries can also be checked against the
   // signed system.
@@ -1829,9 +1902,15 @@ static std::optional<bool> checkCondition(CmpInst::Predicate Pred, Value *A,
     SmallVector<Value *> NewVariables;
     auto SR = Info.getConstraint(Pred, A, B, NewVariables,
                                  /*ForceSignedSystem=*/true);
-    if (NewVariables.empty())
-      if (auto ImpliedCondition = TryWithConstraint(SR))
-        return ImpliedCondition;
+    // A value the system does not know about is completely unconstrained, so
+    // solving for SR cannot prove anything (and the solvers require queries to
+    // only use variables of the system).
+    if (!NewVariables.empty())
+      return std::nullopt;
+    if (auto ImpliedCondition = TryWithConstraint(SR))
+      return ImpliedCondition;
+    if (auto ImpliedCondition = TryWithLinkedRepresentation(SR))
+      return ImpliedCondition;
   }
   return std::nullopt;
 }
diff --git a/llvm/test/Transforms/ConstraintElimination/decomposition-stability.ll b/llvm/test/Transforms/ConstraintElimination/decomposition-stability.ll
new file mode 100644
index 0000000000000..01fecf6ed5bea
--- /dev/null
+++ b/llvm/test/Transforms/ConstraintElimination/decomposition-stability.ll
@@ -0,0 +1,137 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s
+
+define i1 @eq_after_unsigned_sub_becomes_decomposable(i64 %a, i64 %y, i64 %z) {
+; CHECK-LABEL: define i1 @eq_after_unsigned_sub_becomes_decomposable(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[Y:%.*]], i64 [[Z:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[S:%.*]] = sub i64 [[Y]], [[Z]]
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i64 [[A]], [[S]]
+; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    [[PRECOND:%.*]] = icmp uge i64 [[Y]], [[Z]]
+; CHECK-NEXT:    br i1 [[PRECOND]], label %[[QUERY:.*]], label %[[EXIT]]
+; CHECK:       [[QUERY]]:
+; CHECK-NEXT:    ret i1 false
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %s = sub i64 %y, %z
+  %c = icmp ugt i64 %a, %s
+  br i1 %c, label %then, label %exit
+
+then:
+  %precond = icmp uge i64 %y, %z
+  br i1 %precond, label %query, label %exit
+
+query:
+  %eq = icmp eq i64 %a, %s
+  ret i1 %eq
+
+exit:
+  ret i1 false
+}
+
+; %add is opaque when %a > %add is recorded and decomposable to %b + 1 by the
+; time it is queried, so only linking the two representations proves %a != %add.
+define i1 @eq_after_signed_add_becomes_decomposable(i64 %a, i64 %b) {
+; CHECK-LABEL: define i1 @eq_after_signed_add_becomes_decomposable(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[ADD:%.*]] = add i64 [[B]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp sgt i64 [[A]], [[ADD]]
+; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    [[PRECOND:%.*]] = icmp slt i64 [[B]], 100
+; CHECK-NEXT:    br i1 [[PRECOND]], label %[[QUERY:.*]], label %[[EXIT]]
+; CHECK:       [[QUERY]]:
+; CHECK-NEXT:    ret i1 false
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %add = add i64 %b, 1
+  %c = icmp sgt i64 %a, %add
+  br i1 %c, label %then, label %exit
+
+then:
+  %precond = icmp slt i64 %b, 100
+  br i1 %precond, label %query, label %exit
+
+query:
+  %eq = icmp eq i64 %a, %add
+  ret i1 %eq
+
+exit:
+  ret i1 false
+}
+
+; Same shape, but the query also mentions %opaque, which no fact refers to. It
+; is not a variable of the signed system, so the query cannot be solved there.
+define i1 @eq_with_new_variable_in_signed_system(i64 %a, i64 %b) {
+; CHECK-LABEL: define i1 @eq_with_new_variable_in_signed_system(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[ADD:%.*]] = add i64 [[A]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp sgt i64 [[ADD]], 10
+; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    [[PRECOND:%.*]] = icmp slt i64 [[A]], 100
+; CHECK-NEXT:    br i1 [[PRECOND]], label %[[QUERY:.*]], label %[[EXIT]]
+; CHECK:       [[QUERY]]:
+; CHECK-NEXT:    [[OPAQUE:%.*]] = mul i64 [[B]], [[B]]
+; CHECK-NEXT:    [[EQ:%.*]] = icmp eq i64 [[ADD]], [[OPAQUE]]
+; CHECK-NEXT:    ret i1 [[EQ]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %add = add i64 %a, 1
+  %c = icmp sgt i64 %add, 10
+  br i1 %c, label %then, label %exit
+
+then:
+  %precond = icmp slt i64 %a, 100
+  br i1 %precond, label %query, label %exit
+
+query:
+  %opaque = mul i64 %b, %b
+  %eq = icmp eq i64 %add, %opaque
+  ret i1 %eq
+
+exit:
+  ret i1 false
+}
+
+define i1 @eq_with_stable_decomposition(i64 %a, i64 %y, i64 %z) {
+; CHECK-LABEL: define i1 @eq_with_stable_decomposition(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[Y:%.*]], i64 [[Z:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[S:%.*]] = sub nuw i64 [[Y]], [[Z]]
+; CHECK-NEXT:    [[PRECOND:%.*]] = icmp uge i64 [[Y]], [[Z]]
+; CHECK-NEXT:    br i1 [[PRECOND]], label %[[THEN:.*]], label %[[EXIT:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i64 [[A]], [[S]]
+; CHECK-NEXT:    br i1 [[C]], label %[[QUERY:.*]], label %[[EXIT]]
+; CHECK:       [[QUERY]]:
+; CHECK-NEXT:    ret i1 false
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %s = sub i64 %y, %z
+  %precond = icmp uge i64 %y, %z
+  br i1 %precond, label %then, label %exit
+
+then:
+  %c = icmp ugt i64 %a, %s
+  br i1 %c, label %query, label %exit
+
+query:
+  %eq = icmp eq i64 %a, %s
+  ret i1 %eq
+
+exit:
+  ret i1 false
+}
