   }
 
+  // Directly use any cached values.
+  if (auto K = Q.getCachedKnownBits(V)) {
+    Known = *K;
+    return;
+  }
+
   // Start out not knowing anything.
   Known.resetAll();
 
@@ -2685,6 +2691,10 @@ void computeKnownBits(const Value *V, const APInt &DemandedElts,
 
