+bool ConstraintInfo::isKnownNonPositive(Value *V) const {
+  return doesHold(CmpInst::ICMP_SLE, V, ConstantInt::get(V->getType(), 0)) ||
+         computeKnownBits(V, DL, /*Depth=*/MaxAnalysisRecursionDepth - 1)
+             .isNonPositive();
+}
