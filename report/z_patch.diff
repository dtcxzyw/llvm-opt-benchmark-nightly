+++ b/llvm/test/Transforms/ConstraintElimination/induction-phi-compare-header-bound.ll
@@ -0,0 +1,916 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s
+
+; Tests for bounds on an induction phi in the header, derived from a continuing
+; compare of the phi or its increment against a loop-invariant bound.
+
+declare void @use(i1)
+declare void @llvm.assume(i1)
+
+; Header-tested iv u< %n: in the header, iv u<= %n.
+define void @header_tested_ult(i8 %n) {
+;
+;
+; CHECK-LABEL: define void @header_tested_ult(
+; CHECK-SAME: i8 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
+; CHECK:       [[LOOP_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i8 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
+; CHECK-NEXT:    call void @use(i1 true)
+; CHECK-NEXT:    [[C_1:%.*]] = icmp ult i8 [[IV]], [[N]]
+; CHECK-NEXT:    call void @use(i1 [[C_1]])
+; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i8 [[IV]], [[N]]
+; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP_LATCH]], label %[[EXIT:.*]]
+; CHECK:       [[LOOP_LATCH]]:
+; CHECK-NEXT:    [[IV_NEXT]] = add i8 [[IV]], 1
+; CHECK-NEXT:    br label %[[LOOP_HEADER]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    call void @use(i1 true)
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %loop.header
+
+loop.header:
+  %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop.latch ]
+  %t.1 = icmp ule i8 %iv, %n
+  call void @use(i1 %t.1)
+  %c.1 = icmp ult i8 %iv, %n
+  call void @use(i1 %c.1)
+  %cmp = icmp ult i8 %iv, %n
+  br i1 %cmp, label %loop.latch, label %exit
+
+loop.latch:
+  %iv.next = add i8 %iv, 1
+  br label %loop.header
+
+exit:
+  %t.2 = icmp ule i8 %iv, %n
+  call void @use(i1 %t.2)
+  ret void
+}
+
