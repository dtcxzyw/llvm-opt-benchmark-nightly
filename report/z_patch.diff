+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt -passes=instcombine -S %s | FileCheck %s
+
+declare void @use8(i8)
+
+; select (icmp ult X, C), (shl A, C), (shl A, X)  ==  shl A, umax(X, C)
+; 36 == 9 << 2, so this is "shl 9, umax(%x, 2)".
+define i32 @clamped_shl(i32 %x) {
+; CHECK-LABEL: @clamped_shl(
+; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @llvm.umax.i32(i32 [[X:%.*]], i32 2)
+; CHECK-NEXT:    [[R:%.*]] = shl i32 9, [[TMP1]]
+; CHECK-NEXT:    ret i32 [[R]]
+;
+  %c = icmp ult i32 %x, 2
+  %s = shl i32 9, %x
+  %r = select i1 %c, i32 36, i32 %s
+  ret i32 %r
+}
+
+; select (icmp ugt X, C), (lshr A, C), (lshr A, X)  ==  lshr A, umin(X, C)
+; 31 == 255 >> 3.
+define i8 @clamped_lshr_umin(i8 %x) {
+; CHECK-LABEL: @clamped_lshr_umin(
+; CHECK-NEXT:    [[TMP1:%.*]] = call i8 @llvm.umin.i8(i8 [[X:%.*]], i8 3)
+; CHECK-NEXT:    [[R:%.*]] = lshr i8 -1, [[TMP1]]
+; CHECK-NEXT:    ret i8 [[R]]
+;
+  %c = icmp ugt i8 %x, 3
+  %s = lshr i8 -1, %x
+  %r = select i1 %c, i8 31, i8 %s
+  ret i8 %r
+}
+
+; ashr with a negative shifted constant. -2 == -8 >> 2.
+define i8 @clamped_ashr_umin(i8 %x) {
+; CHECK-LABEL: @clamped_ashr_umin(
+; CHECK-NEXT:    [[TMP1:%.*]] = call i8 @llvm.umin.i8(i8 [[X:%.*]], i8 2)
+; CHECK-NEXT:    [[R:%.*]] = ashr exact i8 -8, [[TMP1]]
+; CHECK-NEXT:    ret i8 [[R]]
+;
+  %c = icmp ugt i8 %x, 2
+  %s = ashr i8 -8, %x
+  %r = select i1 %c, i8 -2, i8 %s
+  ret i8 %r
+}
+
+; lshr in the umax direction.
+define i8 @clamped_lshr_umax(i8 %x) {
+; CHECK-LABEL: @clamped_lshr_umax(
+; CHECK-NEXT:    [[TMP1:%.*]] = call i8 @llvm.umax.i8(i8 [[X:%.*]], i8 3)
+; CHECK-NEXT:    [[R:%.*]] = lshr i8 -1, [[TMP1]]
+; CHECK-NEXT:    ret i8 [[R]]
+;
+  %c = icmp ult i8 %x, 3
+  %s = lshr i8 -1, %x
+  %r = select i1 %c, i8 31, i8 %s
+  ret i8 %r
+}
+
+; The boundary value can be reached by more than one shift amount: 4 >> K is 0
+; for every K in [3, 8). The fold still holds.
+define i8 @clamped_saturated_boundary(i8 %x) {
+; CHECK-LABEL: @clamped_saturated_boundary(
+; CHECK-NEXT:    [[TMP1:%.*]] = call i8 @llvm.umax.i8(i8 [[X:%.*]], i8 3)
+; CHECK-NEXT:    [[R:%.*]] = lshr i8 4, [[TMP1]]
+; CHECK-NEXT:    ret i8 [[R]]
+;
+  %c = icmp ult i8 %x, 3
+  %s = lshr i8 4, %x
+  %r = select i1 %c, i8 0, i8 %s
+  ret i8 %r
+}
+
+; Vector splat.
+define <2 x i8> @clamped_lshr_vector(<2 x i8> %x) {
+; CHECK-LABEL: @clamped_lshr_vector(
+; CHECK-NEXT:    [[TMP1:%.*]] = call <2 x i8> @llvm.umax.v2i8(<2 x i8> [[X:%.*]], <2 x i8> splat (i8 3))
+; CHECK-NEXT:    [[R:%.*]] = lshr <2 x i8> splat (i8 -1), [[TMP1]]
+; CHECK-NEXT:    ret <2 x i8> [[R]]
+;
+  %c = icmp ult <2 x i8> %x, splat (i8 3)
+  %s = lshr <2 x i8> splat (i8 -1), %x
+  %r = select <2 x i1> %c, <2 x i8> splat (i8 31), <2 x i8> %s
+  ret <2 x i8> %r
+}
+
+; The shifted value and the constant arm need not be splats, as long as the
+; compare is against a single shift amount: 255 >> 3 is 31 and 4 >> 3 is 0.
