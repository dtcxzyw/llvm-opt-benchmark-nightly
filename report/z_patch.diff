+/// Give shuffle reconstruction a chance before shrinking its source loads.
+bool VectorCombine::foldShuffleTreeFromLoad(Instruction &I) {
+  auto *Load = cast<LoadInst>(&I);
+  if (!Load->isSimple() || !Load->hasOneUse())
+    return false;
+  Instruction *Root = Load;
+  unsigned NumVisited = 0;
+  while (Root->hasOneUse()) {
+    auto *Shuf = dyn_cast<ShuffleVectorInst>(*Root->user_begin());
+    if (!Shuf || Shuf->getParent() != Load->getParent())
+      break;
+    if (++NumVisited > Opts.vector_combine_max_scan_instrs)
+      return false;
+    Root = Shuf;
+  }
+  return Root != Load && foldShuffleTree(*Root, /*RequireConcat=*/true);
+}
