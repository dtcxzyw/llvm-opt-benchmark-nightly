+; %delayed holds %iv from the previous iteration, so it is %iv - 32. The latch
+; bounds %iv, which then bounds %delayed and discharges the guard.
+define void @delayed_phi_add_nsw(i64 %count) {
+; CHECK-LABEL: define void @delayed_phi_add_nsw(
+; CHECK-SAME: i64 [[COUNT:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[G:%.*]] = icmp sgt i64 [[COUNT]], 31
+; CHECK-NEXT:    br i1 [[G]], label %[[LOOP:.*]], label %[[EXIT:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[DELAYED:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV:%.*]], %[[LATCH:.*]] ]
+; CHECK-NEXT:    [[IV]] = phi i64 [ 32, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LATCH]] ]
+; CHECK-NEXT:    br i1 true, label %[[LATCH]], label %[[TRAP:.*]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 32
