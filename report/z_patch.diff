+; CHECK-NEXT:    [[OUTER_EC:%.*]] = icmp eq i32 [[IV_NEXT]], [[OUTER_N]]
+; CHECK-NEXT:    br i1 [[OUTER_EC]], label %[[EXIT:.*]], label %[[OUTER]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i32 [[TMP4]]
+;
+entry:
+  br label %outer
+
+outer:
+  %iv = phi i32 [ 0, %entry ], [ %iv.next, %outer.latch ]
+  %red = phi i32 [ 0, %entry ], [ %red.next, %outer.latch ]
+  %bare = mul i32 %a, %b
+  %red.next = add i32 %red, %bare
+  br i1 %enter, label %inner.ph, label %outer.latch
+
+inner.ph:
+  br label %inner
+
+inner:
+  %iv.1 = phi i32 [ %a, %inner.ph ], [ %iv.1.next, %inner ]
+  %iv.2 = phi i32 [ 0, %inner.ph ], [ %iv.2.next, %inner ]
+  %idx = mul nuw i32 %iv.1, %b
+  %wide = zext i32 %idx to i64
+  %ptr = getelementptr i8, ptr %dst, i64 %wide
+  store i8 0, ptr %ptr
+  %iv.1.next = add nuw i32 %iv.1, 1
+  %iv.2.next = add nuw i32 %iv.2, 1
+  %ec = icmp eq i32 %iv.2.next, %inner_n
+  br i1 %ec, label %outer.latch, label %inner
+
+outer.latch:
+  %iv.next = add nuw i32 %iv, 1
+  %outer.ec = icmp eq i32 %iv.next, %outer_n
+  br i1 %outer.ec, label %exit, label %outer
+
+exit:
+  ret i32 %red.next
+}
