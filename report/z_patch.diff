@@ -0,0 +1,348 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=instcombine -S %s | FileCheck %s
+
+; If every use of the value component of a *.with.overflow intrinsic is only
+; reachable when the operation did not overflow, the operation is known not to
+; wrap there, which sharpens its known bits and its constant range.
+
+declare void @use(i32)
+declare void @use.agg({ i32, i1 })
+
+; add nuw %x, 100 --> the sum is at least 100.
+define i1 @uadd_const_range(i32 %x) {
+; CHECK-LABEL: define i1 @uadd_const_range(
+; CHECK-SAME: i32 [[X:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[WO:%.*]] = call { i32, i1 } @llvm.uadd.with.overflow.i32(i32 [[X]], i32 100)
+; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i32, i1 } [[WO]], 1
+; CHECK-NEXT:    br i1 [[OV]], label %[[ERR:.*]], label %[[OK:.*]]
+; CHECK:       [[OK]]:
+; CHECK-NEXT:    [[V:%.*]] = extractvalue { i32, i1 } [[WO]], 0
+; CHECK-NEXT:    call void @use(i32 [[V]])
+; CHECK-NEXT:    ret i1 false
+; CHECK:       [[ERR]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %wo = call { i32, i1 } @llvm.uadd.with.overflow.i32(i32 %x, i32 100)
+  %ov = extractvalue { i32, i1 } %wo, 1
+  br i1 %ov, label %err, label %ok
+
+ok:
+  %v = extractvalue { i32, i1 } %wo, 0
+  call void @use(i32 %v)
+  %c = icmp ult i32 %v, 100
+  ret i1 %c
+
+err:
+  ret i1 false
+}
+
+; add nsw %x, 100 --> the sum is at least INT_MIN + 100.
+define i1 @sadd_const_range(i32 %x) {
+; CHECK-LABEL: define i1 @sadd_const_range(
+; CHECK-SAME: i32 [[X:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[WO:%.*]] = call { i32, i1 } @llvm.sadd.with.overflow.i32(i32 [[X]], i32 100)
+; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i32, i1 } [[WO]], 1
+; CHECK-NEXT:    br i1 [[OV]], label %[[ERR:.*]], label %[[OK:.*]]
+; CHECK:       [[OK]]:
+; CHECK-NEXT:    [[V:%.*]] = extractvalue { i32, i1 } [[WO]], 0
+; CHECK-NEXT:    call void @use(i32 [[V]])
+; CHECK-NEXT:    ret i1 false
+; CHECK:       [[ERR]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %wo = call { i32, i1 } @llvm.sadd.with.overflow.i32(i32 %x, i32 100)
+  %ov = extractvalue { i32, i1 } %wo, 1
+  br i1 %ov, label %err, label %ok
+
+ok:
+  %v = extractvalue { i32, i1 } %wo, 0
+  call void @use(i32 %v)
+  %c = icmp slt i32 %v, -2147483548
+  ret i1 %c
+
+err:
+  ret i1 false
+}
+
+; sub nsw %x, 100 --> the difference is at most INT_MAX - 100.
+define i1 @ssub_const_range(i32 %x) {
+; CHECK-LABEL: define i1 @ssub_const_range(
+; CHECK-SAME: i32 [[X:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[WO:%.*]] = call { i32, i1 } @llvm.sadd.with.overflow.i32(i32 [[X]], i32 -100)
+; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i32, i1 } [[WO]], 1
+; CHECK-NEXT:    br i1 [[OV]], label %[[ERR:.*]], label %[[OK:.*]]
+; CHECK:       [[OK]]:
+; CHECK-NEXT:    [[V:%.*]] = extractvalue { i32, i1 } [[WO]], 0
+; CHECK-NEXT:    call void @use(i32 [[V]])
+; CHECK-NEXT:    ret i1 false
+; CHECK:       [[ERR]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %wo = call { i32, i1 } @llvm.ssub.with.overflow.i32(i32 %x, i32 100)
+  %ov = extractvalue { i32, i1 } %wo, 1
+  br i1 %ov, label %err, label %ok
+
+ok:
+  %v = extractvalue { i32, i1 } %wo, 0
+  call void @use(i32 %v)
+  %c = icmp sgt i32 %v, 2147483547
+  ret i1 %c
+
+err:
+  ret i1 false
+}
