-      AddRegionToWorklist(Child);
+    BasicBlock *BB = DTN->getBlock();
+    // Filter blocks in subloops.
+    if (LI->getLoopFor(BB) == CurLoop)
+      Result.push_back(BB);
   }
 
-  return Worklist;
+  return Result;
 }
 
