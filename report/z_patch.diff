+  ret i32 %zext
+}
+
+; Negative cases
+
+define i32 @neg_zext_ne_range_too_wide(i32 range(i32 7, 10) %x) {
+; CHECK-LABEL: @neg_zext_ne_range_too_wide(
+; CHECK-NEXT:    [[TMP1:%.*]] = icmp ne i32 [[X:%.*]], 7
+; CHECK-NEXT:    [[TMP2:%.*]] = zext i1 [[TMP1]] to i32
+; CHECK-NEXT:    ret i32 [[TMP2]]
+;
