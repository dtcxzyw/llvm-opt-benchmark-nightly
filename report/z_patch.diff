diff --git a/llvm/test/Transforms/SCCP/or-disjoint.ll b/llvm/test/Transforms/SCCP/or-disjoint.ll
new file mode 100644
index 0000000000000..b1d2307120a74
--- /dev/null
+++ b/llvm/test/Transforms/SCCP/or-disjoint.ll
@@ -0,0 +1,72 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt < %s -passes=ipsccp -S | FileCheck %s
+
+declare void @use(i1)
+
+; A disjoint or cannot carry, so it computes the same value as an add nuw nsw.
+; With %p in {8, 12}, %o = %p + 32 is in [40, 45) -> the compare is true. The
+; bit-wise range of a plain or is too coarse to tell.
+define void @or_disjoint(i1 %c) {
+; CHECK-LABEL: @or_disjoint(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br i1 [[C:%.*]], label [[A:%.*]], label [[B:%.*]]
+; CHECK:       a:
+; CHECK-NEXT:    br label [[JOIN:%.*]]
+; CHECK:       b:
+; CHECK-NEXT:    br label [[JOIN]]
+; CHECK:       join:
+; CHECK-NEXT:    [[P:%.*]] = phi i8 [ 8, [[A]] ], [ 12, [[B]] ]
+; CHECK-NEXT:    [[O:%.*]] = or disjoint i8 [[P]], 32
+; CHECK-NEXT:    call void @use(i1 true)
+; CHECK-NEXT:    ret void
+;
+entry:
+  br i1 %c, label %a, label %b
+
+a:
+  br label %join
+
+b:
+  br label %join
+
+join:
+  %p = phi i8 [ 8, %a ], [ 12, %b ]
+  %o = or disjoint i8 %p, 32
+  %r = icmp ult i8 %o, 45
+  call void @use(i1 %r)
+  ret void
+}
+
+; Negative test: without disjoint the or may carry, so the range is too coarse
+; and the compare must stay.
+define void @or_not_disjoint(i1 %c) {
+; CHECK-LABEL: @or_not_disjoint(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br i1 [[C:%.*]], label [[A:%.*]], label [[B:%.*]]
+; CHECK:       a:
+; CHECK-NEXT:    br label [[JOIN:%.*]]
+; CHECK:       b:
+; CHECK-NEXT:    br label [[JOIN]]
+; CHECK:       join:
+; CHECK-NEXT:    [[P:%.*]] = phi i8 [ 8, [[A]] ], [ 12, [[B]] ]
+; CHECK-NEXT:    [[O:%.*]] = or i8 [[P]], 32
+; CHECK-NEXT:    [[R:%.*]] = icmp ult i8 [[O]], 45
+; CHECK-NEXT:    call void @use(i1 [[R]])
+; CHECK-NEXT:    ret void
+;
+entry:
+  br i1 %c, label %a, label %b
+
+a:
+  br label %join
+
+b:
+  br label %join
+
+join:
+  %p = phi i8 [ 8, %a ], [ 12, %b ]
+  %o = or i8 %p, 32
+  %r = icmp ult i8 %o, 45
+  call void @use(i1 %r)
+  ret void
+}
diff --git a/llvm/unittests/IR/ConstantRangeTest.cpp b/llvm/unittests/IR/ConstantRangeTest.cpp
index 099a43bba34c4..64b4679508943 100644
--- a/llvm/unittests/IR/ConstantRangeTest.cpp
+++ b/llvm/unittests/IR/ConstantRangeTest.cpp
@@ -2969,6 +2969,36 @@ TEST_F(ConstantRangeTest, binaryOr) {
       CheckSingleElementsOnly);
 }
 
+TEST_F(ConstantRangeTest, binaryOpDisjointOr) {
+  // TestBinaryOpExhaustive enumerates 1- and 4-bit ranges, so a disjoint or is
+  // needed for each of those widths.
+  LLVMContext Ctx;
+  std::unique_ptr<BinaryOperator> DisjointOr[2];
+  for (auto [Idx, Bits] : enumerate(ArrayRef<unsigned>({1, 4}))) {
+    Value *Poison = PoisonValue::get(Type::getIntNTy(Ctx, Bits));
+    DisjointOr[Idx].reset(
+        BinaryOperator::CreateDisjoint(Instruction::Or, Poison, Poison));
+  }
+
+  // A disjoint or computes the same value as an add nuw nsw, so the range may
+  // be refined accordingly. Operand pairs that are not actually disjoint make
+  // the result poison and are excluded from the reference computation.
+  TestBinaryOpExhaustive(
+      [&](const ConstantRange &CR1, const ConstantRange &CR2) {
+        const BinaryOperator &BO = *DisjointOr[CR1.getBitWidth() == 1 ? 0 : 1];
+        return CR1.binaryOp(BO, CR2);
+      },
+      [](const APInt &N1, const APInt &N2) -> std::optional<APInt> {
+        if (N1.intersects(N2))
+          return std::nullopt;
+        return N1 | N2;
+      },
+      PreferSmallest,
+      [](const ConstantRange &, const ConstantRange &) {
+        return false; // Check correctness only.
+      });
+}
