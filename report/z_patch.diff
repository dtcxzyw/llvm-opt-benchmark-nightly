index 0000000000000..89e17f4769ae2
--- /dev/null
+++ b/llvm/test/Transforms/PhaseOrdering/X86/cleanup-loop-after-early-exit.ll
@@ -0,0 +1,98 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt -passes="default<O3>" -S %s | FileCheck %s
+
+target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
+target triple = "x86_64-unknown-linux-gnu"
+
+; The cleanup loop counting down from the exit value of the first loop should
+; be widened to an i64 IV with a simple exit compare.
+define void @f(i32 %n, i1 %c0, i1 %c1, ptr %bh) {
+; CHECK-LABEL: @f(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[C3:%.*]] = icmp sgt i32 [[N:%.*]], 0
+; CHECK-NEXT:    br i1 [[C3]], label [[BODY_LR_PH:%.*]], label [[EXIT:%.*]]
+; CHECK:       body.lr.ph:
+; CHECK-NEXT:    [[C0_FR:%.*]] = freeze i1 [[C0:%.*]]
+; CHECK-NEXT:    br i1 [[C0_FR]], label [[BODY_US:%.*]], label [[BODY_LR_PH_SPLIT:%.*]]
+; CHECK:       body.us:
+; CHECK-NEXT:    [[F_US:%.*]] = tail call i1 @fail()
+; CHECK-NEXT:    br label [[EXIT]]
+; CHECK:       body.lr.ph.split:
+; CHECK-NEXT:    [[C1_FR:%.*]] = freeze i1 [[C1:%.*]]
+; CHECK-NEXT:    br i1 [[C1_FR]], label [[BODY_US5:%.*]], label [[BODY:%.*]]
+; CHECK:       body.us5:
+; CHECK-NEXT:    [[F_US7:%.*]] = tail call i1 @fail()
+; CHECK-NEXT:    br i1 [[F_US7]], label [[EXIT]], label [[INNER:%.*]]
+; CHECK:       body:
+; CHECK-NEXT:    [[I4:%.*]] = phi i32 [ [[I_NEXT:%.*]], [[INNER_PREHEADER:%.*]] ], [ 0, [[BODY_LR_PH_SPLIT]] ]
+; CHECK-NEXT:    [[F:%.*]] = tail call i1 @fail()
+; CHECK-NEXT:    br i1 [[F]], label [[CLEANUP_PREHEADER:%.*]], label [[INNER_PREHEADER]]
+; CHECK:       inner.preheader:
+; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i32 [[I4]], 1
+; CHECK-NEXT:    [[EXITCOND_NOT:%.*]] = icmp eq i32 [[I_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[EXITCOND_NOT]], label [[EXIT]], label [[BODY]]
+; CHECK:       cleanup.preheader:
+; CHECK-NEXT:    [[MORE11_NOT:%.*]] = icmp eq i32 [[I4]], 0
+; CHECK-NEXT:    br i1 [[MORE11_NOT]], label [[EXIT]], label [[CLEANUP_BODY_PREHEADER:%.*]]
+; CHECK:       cleanup.body.preheader:
+; CHECK-NEXT:    [[J10:%.*]] = add nsw i32 [[I4]], -1
+; CHECK-NEXT:    [[TMP0:%.*]] = zext i32 [[J10]] to i64
+; CHECK-NEXT:    [[TMP1:%.*]] = zext nneg i32 [[I4]] to i64
+; CHECK-NEXT:    br label [[CLEANUP_BODY:%.*]]
+; CHECK:       inner:
+; CHECK-NEXT:    br label [[INNER]]
+; CHECK:       cleanup.body:
+; CHECK-NEXT:    [[INDVARS_IV17:%.*]] = phi i64 [ [[TMP1]], [[CLEANUP_BODY_PREHEADER]] ], [ [[INDVARS_IV_NEXT18:%.*]], [[CLEANUP_BODY]] ]
+; CHECK-NEXT:    [[INDVARS_IV:%.*]] = phi i64 [ [[TMP0]], [[CLEANUP_BODY_PREHEADER]] ], [ [[INDVARS_IV_NEXT:%.*]], [[CLEANUP_BODY]] ]
+; CHECK-NEXT:    [[GEP:%.*]] = getelementptr [16 x i8], ptr [[BH:%.*]], i64 [[INDVARS_IV17]]
+; CHECK-NEXT:    store i32 0, ptr [[GEP]], align 4
+; CHECK-NEXT:    [[INDVARS_IV_NEXT]] = add nsw i64 [[INDVARS_IV]], -1
+; CHECK-NEXT:    [[MORE_NOT:%.*]] = icmp eq i64 [[INDVARS_IV]], 0
+; CHECK-NEXT:    [[INDVARS_IV_NEXT18]] = add nsw i64 [[INDVARS_IV17]], -1
+; CHECK-NEXT:    br i1 [[MORE_NOT]], label [[EXIT]], label [[CLEANUP_BODY]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %loop
+
+loop:
+  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
+  %x = phi i32 [ %n, %entry ], [ %x.inner, %latch ]
+  %c = icmp slt i32 %i, %n
+  br i1 %c, label %body, label %exit
+
+body:
+  %f = call i1 @fail()
+  %bail = select i1 %f, i1 true, i1 %c0
+  br i1 %bail, label %cleanup, label %inner
+
+inner:
+  %x.inner = phi i32 [ %x.or, %inner.body ], [ 0, %body ]
+  br i1 %c1, label %inner.body, label %latch
+
+inner.body:
+  %x.or = or i32 %x, 1
+  br label %inner
+
+latch:
+  %i.next = add i32 %i, 1
+  br label %loop
+
+cleanup:
+  %j.in = phi i32 [ %j, %cleanup.body ], [ %i, %body ]
+  %j = add i32 %j.in, -1
+  %more = icmp sgt i32 %j, -1
+  br i1 %more, label %cleanup.body, label %exit
+
+cleanup.body:
+  %idx = zext i32 %j.in to i64
+  %gep = getelementptr [16 x i8], ptr %bh, i64 %idx
+  store i32 0, ptr %gep, align 4
+  br label %cleanup
+
+exit:
+  ret void
+}
+
+declare i1 @fail()
