+; The phi's only user is an inttoptr: foldIntegerTypedPHI is tried first and
+; replaces the inttoptr with %iv instead of forming inttoptr(ptrtoint %iv)
+; (which is not folded with -disable-i2p-p2i-opt).
+define void @inttoptr_user(ptr %start) {
+; CHECK-LABEL: define void @inttoptr_user(
+; CHECK-SAME: ptr [[START:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[START_INT:%.*]] = ptrtoint ptr [[START]] to i64
+; CHECK-NEXT:    call void @use(i64 [[START_INT]])
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi ptr [ [[START]], %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    store i8 0, ptr [[IV]], align 1
+; CHECK-NEXT:    [[IV_NEXT]] = getelementptr inbounds nuw i8, ptr [[IV]], i64 8
+; CHECK-NEXT:    [[IV_NEXT_INT:%.*]] = ptrtoint ptr [[IV_NEXT]] to i64
+; CHECK-NEXT:    call void @use(i64 [[IV_NEXT_INT]])
+; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
+; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT:.*]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %start.int = ptrtoint ptr %start to i64
+  call void @use(i64 %start.int)
+  br label %loop
+
+loop:
+  %iv = phi ptr [ %start, %entry ], [ %iv.next, %loop ]
+  %iv.int = phi i64 [ %start.int, %entry ], [ %iv.next.int, %loop ]
+  %p = inttoptr i64 %iv.int to ptr
+  store i8 0, ptr %p
+  %iv.next = getelementptr inbounds i8, ptr %iv, i64 8
+  %iv.next.int = ptrtoint ptr %iv.next to i64
+  call void @use(i64 %iv.next.int)
+  %c = call i1 @cond()
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
