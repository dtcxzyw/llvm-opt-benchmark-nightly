diff --git a/llvm/lib/Transforms/InstCombine/InstCombineLoadStoreAlloca.cpp b/llvm/lib/Transforms/InstCombine/InstCombineLoadStoreAlloca.cpp
index 60331a3d37b05b..1308a740f38f4a 100644
--- a/llvm/lib/Transforms/InstCombine/InstCombineLoadStoreAlloca.cpp
+++ b/llvm/lib/Transforms/InstCombine/InstCombineLoadStoreAlloca.cpp
@@ -1384,9 +1384,33 @@ static bool combineStoreToValueType(InstCombinerImpl &IC, StoreInst &SI) {
       return true;
     }
 
-  // FIXME: We should also canonicalize stores of vectors when their elements
-  // are cast to other types.
-  return false;
+  // Change the types of the AND and the store to eliminate a bitcast.
+  Value *X;
+  Constant *Mask;
+  Type *AndTy = V->getType();
+  if (!SI.isSimple() || !isa<FixedVectorType>(AndTy) ||
+      !match(V, m_OneUse(
+                    m_And(m_OneUse(m_BitCast(m_Value(X))), m_Constant(Mask)))))
+    return false;
+
+  Type *XTy = X->getType();
+  if (!isa<FixedVectorType>(XTy) || !XTy->isIntOrIntVectorTy() ||
+      isa<Constant>(X) || AndTy->getScalarSizeInBits() % 8 != 0 ||
+      XTy->getScalarSizeInBits() % 8 != 0)
+    return false;
+
+  // A mask with poison lanes may make more bits poison after regrouping.
+  if (isa<ConstantExpr>(Mask) || Mask->containsUndefOrPoisonElement())
+    return false;
+
+  Constant *NewMask = ConstantFoldCastOperand(Instruction::BitCast, Mask, XTy,
+                                              IC.getDataLayout());
+  if (isa<ConstantExpr>(NewMask))
+    return false;
+
+  combineStoreToNewValue(IC, SI,
+                         IC.Builder.CreateAnd(X, NewMask, V->getName()));
+  return true;
 }
 
