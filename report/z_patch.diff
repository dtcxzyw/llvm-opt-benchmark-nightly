+  ret i1 %c
+}
+
+; The condition does not hinge on the extreme alone, so the rule does not apply
+; (and the ordinary solver cannot prove it either).
+define i1 @neg_condition_not_at_extreme(i64 %a, i64 %w) {
+; CHECK-LABEL: define i1 @neg_condition_not_at_extreme(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[W:%.*]]) {
+; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i64 [[A]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[C:%.*]] = icmp sgt i64 [[A]], 100
+; CHECK-NEXT:    ret i1 [[C]]
+;
+  %pre = icmp slt i64 %a, %w
+  call void @llvm.assume(i1 %pre)
+  %c = icmp sgt i64 %a, 100
+  ret i1 %c
+}
+
+; The unsigned extreme is not covered: A s< W says nothing about A ==u UMAX.
+define i1 @neg_unsigned_extreme(i64 %a, i64 %w) {
+; CHECK-LABEL: define i1 @neg_unsigned_extreme(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[W:%.*]]) {
+; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i64 [[A]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i64 [[A]], -2
+; CHECK-NEXT:    ret i1 [[C]]
+;
+  %pre = icmp slt i64 %a, %w
+  call void @llvm.assume(i1 %pre)
+  %c = icmp ugt i64 %a, -2
+  ret i1 %c
+}
