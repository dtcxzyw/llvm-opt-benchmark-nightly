+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes='default<O3>' -S %s | FileCheck %s
+
+declare void @use(i32)
+
+define i32 @exit_value_with_two_eq_checks(i32 %n) {
+; CHECK-LABEL: define range(i32 8, 7) i32 @exit_value_with_two_eq_checks(
+; CHECK-SAME: i32 [[N:%.*]]) local_unnamed_addr {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    switch i32 [[N]], label %[[LOOP:.*]] [
+; CHECK-NEXT:      i32 0, label %[[COMMON_RET:.*]]
+; CHECK-NEXT:      i32 7, label %[[COMMON_RET]]
+; CHECK-NEXT:    ]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[IV_NEXT:%.*]], %[[LOOP]] ], [ 0, %[[ENTRY]] ]
+; CHECK-NEXT:    tail call void @use(i32 [[IV]])
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw i32 [[IV]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp ult i32 [[IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[COMMON_RET]]
+; CHECK:       [[COMMON_RET]]:
+; CHECK-NEXT:    [[COMMON_RET_OP:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ 0, %[[ENTRY]] ], [ [[N]], %[[LOOP]] ]
+; CHECK-NEXT:    ret i32 [[COMMON_RET_OP]]
+;
+entry:
+  %is.zero = icmp eq i32 %n, 0
+  br i1 %is.zero, label %ret.zero, label %check.seven
+
+check.seven:
+  %is.seven = icmp eq i32 %n, 7
+  br i1 %is.seven, label %ret.zero, label %loop
+
+loop:
+  %iv = phi i32 [ 0, %check.seven ], [ %iv.next, %loop ]
+  call void @use(i32 %iv)
+  %iv.next = add nuw i32 %iv, 1
+  %c = icmp ult i32 %iv.next, %n
+  br i1 %c, label %loop, label %done
+
+done:
+  ret i32 %iv.next
+
+ret.zero:
+  ret i32 0
+}
