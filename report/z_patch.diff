 /// Combine stores to match the type of value being stored.
 ///
 /// The core idea here is that the memory does not have any intrinsic type and
@@ -1362,6 +1412,8 @@ static bool combineStoreToValueType(InstCombinerImpl &IC, StoreInst &SI) {
     return false;
 
   Value *V = SI.getValueOperand();
+  if (!isa<BitCastInst, InsertValueInst, BinaryOperator>(V))
+    return false;
 
   // Fold away bit casts of the stored value by storing the original type.
   if (auto *BC = dyn_cast<BitCastInst>(V)) {
@@ -1384,6 +1436,12 @@ static bool combineStoreToValueType(InstCombinerImpl &IC, StoreInst &SI) {
       return true;
     }
 
+  if (SI.isSimple())
+    if (Value *U = foldBitwiseOpOfBitCast(IC, V)) {
+      combineStoreToNewValue(IC, SI, U);
+      return true;
+    }
+
   // FIXME: We should also canonicalize stores of vectors when their elements
   // are cast to other types.
   return false;
