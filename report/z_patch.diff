+; CHECK-NEXT:    br i1 [[COND]], label [[EXIT:%.*]], label [[BODY:%.*]]
+; CHECK:       body:
+; CHECK-NEXT:    [[REM:%.*]] = urem i64 [[X]], [[Y]]
+; CHECK-NEXT:    [[SUB:%.*]] = sub i64 [[X]], [[REM]]
+; CHECK-NEXT:    ret i64 [[SUB]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret i64 0
+;
+entry:
+  %cond = icmp ult i64 %x, %y
+  br i1 %cond, label %exit, label %body
+
+body:
+  %rem = urem i64 %x, %y
+  %sub = sub i64 %x, %rem
+  %max = call i64 @llvm.umax.i64(i64 %sub, i64 1)
+  ret i64 %max
+
+exit:
+  ret i64 0
+}
