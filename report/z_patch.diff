diff --git a/llvm/test/Transforms/GVN/nonescaping.ll b/llvm/test/Transforms/GVN/nonescaping.ll
index 5db807fb95942..61f45e6b83bdd 100644
--- a/llvm/test/Transforms/GVN/nonescaping.ll
+++ b/llvm/test/Transforms/GVN/nonescaping.ll
@@ -50,6 +50,49 @@ define i8 @test_opnew(ptr %p) {
   call void @escape(ptr %obj)
   ret i8 %sub
 }
+declare void @opaque()
+declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)
+
+; The call to @opaque cannot modify the alloca, which has not escaped yet, so the
+; clobbering access of %b is the (non-local) memcpy. %a is a user of it in the
+; same block and must still be found.
+define i32 @test_load_across_call_before_escape(ptr %src, i1 %c) {
+; CHECK-LABEL: @test_load_across_call_before_escape(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[AL:%.*]] = alloca i32, align 4
+; CHECK-NEXT:    call void @llvm.memcpy.p0.p0.i64(ptr [[AL]], ptr [[SRC:%.*]], i64 4, i1 false)
+; CHECK-NEXT:    br i1 [[C:%.*]], label [[P1:%.*]], label [[P2:%.*]]
+; CHECK:       p1:
+; CHECK-NEXT:    br label [[BB:%.*]]
+; CHECK:       p2:
+; CHECK-NEXT:    br label [[BB]]
+; CHECK:       bb:
+; CHECK-NEXT:    [[A:%.*]] = load i32, ptr [[AL]], align 4
+; CHECK-NEXT:    call void @opaque()
+; CHECK-NEXT:    [[R:%.*]] = add i32 [[A]], [[A]]
+; CHECK-NEXT:    call void @escape(ptr [[AL]])
+; CHECK-NEXT:    ret i32 [[R]]
+;
+entry:
+  %al = alloca i32
+  call void @llvm.memcpy.p0.p0.i64(ptr %al, ptr %src, i64 4, i1 false)
+  br i1 %c, label %p1, label %p2
+
+p1:
+  br label %bb
+
+p2:
+  br label %bb
+
+bb:
+  %a = load i32, ptr %al
+  call void @opaque()
+  %b = load i32, ptr %al
+  %r = add i32 %a, %b
+  call void @escape(ptr %al)
+  ret i32 %r
+}
