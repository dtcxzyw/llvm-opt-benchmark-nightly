+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes='default<O3>' -S < %s | FileCheck %s
+
+define void @fill_rows(ptr %p, i64 %n, i64 %m, i64 %k) {
+; CHECK-LABEL: define void @fill_rows(
+; CHECK-SAME: ptr nofree writeonly captures(none) [[P:%.*]], i64 [[N:%.*]], i64 [[M:%.*]], i64 [[K:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[M_FR:%.*]] = freeze i64 [[M]]
+; CHECK-NEXT:    [[ENTER:%.*]] = icmp sgt i64 [[N]], 0
+; CHECK-NEXT:    [[MORE1:%.*]] = icmp sgt i64 [[M_FR]], 0
+; CHECK-NEXT:    [[OR_COND:%.*]] = and i1 [[ENTER]], [[MORE1]]
+; CHECK-NEXT:    br i1 [[OR_COND]], label %[[OUTER_PREHEADER:.*]], label %[[EXIT:.*]]
+; CHECK:       [[OUTER_PREHEADER]]:
+; CHECK-NEXT:    [[SMAX:%.*]] = tail call i64 @llvm.smax.i64(i64 [[K]], i64 0)
+; CHECK-NEXT:    [[TMP0:%.*]] = add nsw i64 [[M_FR]], -1
+; CHECK-NEXT:    [[DOTNOT_NOT:%.*]] = icmp samesign ugt i64 [[SMAX]], [[TMP0]]
+; CHECK-NEXT:    br i1 [[DOTNOT_NOT]], label %[[OUTER_PREHEADER_SPLIT:.*]], label %[[TRAP:.*]]
+; CHECK:       [[OUTER_PREHEADER_SPLIT]]:
+; CHECK-NEXT:    [[TMP1:%.*]] = mul nuw i64 [[M_FR]], [[N]]
+; CHECK-NEXT:    tail call void @llvm.memset.p0.i64(ptr align 1 [[P]], i8 0, i64 [[TMP1]], i1 false)
+; CHECK-NEXT:    br label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+; CHECK:       [[TRAP]]:
+; CHECK-NEXT:    tail call void @llvm.trap()
+; CHECK-NEXT:    unreachable
+;
+entry:
+  %enter = icmp sgt i64 %n, 0
+  br i1 %enter, label %outer, label %exit
+
+outer:
+  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
+  %row = mul i64 %i, %m
+  br label %inner.header
+
+inner.header:
+  %j = phi i64 [ 0, %outer ], [ %j.next, %inner.latch ]
+  %more = icmp slt i64 %j, %m
+  br i1 %more, label %inner.body, label %outer.latch
+
+inner.body:
+  %oob = icmp sge i64 %j, %k
+  br i1 %oob, label %trap, label %inner.latch
+
+inner.latch:
+  %idx = add i64 %row, %j
+  %gep = getelementptr i8, ptr %p, i64 %idx
+  store i8 0, ptr %gep
+  %j.next = add i64 %j, 1
+  br label %inner.header
+
+outer.latch:
+  %i.next = add i64 %i, 1
+  %done = icmp eq i64 %i.next, %n
+  br i1 %done, label %exit, label %outer
+
+exit:
+  ret void
+
+trap:
+  call void @llvm.trap()
+  unreachable
+}
