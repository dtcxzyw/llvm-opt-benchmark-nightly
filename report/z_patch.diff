                                        SCEVUse RHS);
 
+  /// Prove LHS Pred RHS by bounding an unsigned-nowrap affine AddRec LHS by its
+  /// value at the maximum iteration count.
+  bool isKnownPredicateViaMaxValue(CmpPredicate Pred, SCEVUse LHS, SCEVUse RHS);
