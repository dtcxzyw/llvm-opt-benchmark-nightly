+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -passes=instcombine -S | FileCheck %s
+
+; Fold an extractelement of a vector of GEPs that differ only in their pointer
+; operand into a scalar GEP of the extracted base pointer.
+
+define ptr @extractelt_of_gep_vector(ptr %p0, ptr %p1, i32 %n, i64 %off) {
+; CHECK-LABEL: define ptr @extractelt_of_gep_vector(
+; CHECK-SAME: ptr [[P0:%.*]], ptr [[P1:%.*]], i32 [[N:%.*]], i64 [[OFF:%.*]]) {
+; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <2 x ptr> poison, ptr [[P0]], i64 0
+; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <2 x ptr> [[TMP1]], ptr [[P1]], i64 1
+; CHECK-NEXT:    [[TMP3:%.*]] = extractelement <2 x ptr> [[TMP2]], i32 [[N]]
+; CHECK-NEXT:    [[E:%.*]] = getelementptr i8, ptr [[TMP3]], i64 [[OFF]]
+; CHECK-NEXT:    ret ptr [[E]]
+;
+  %g0 = getelementptr i8, ptr %p0, i64 %off
+  %g1 = getelementptr i8, ptr %p1, i64 %off
+  %v0 = insertelement <2 x ptr> poison, ptr %g0, i64 0
+  %v1 = insertelement <2 x ptr> %v0, ptr %g1, i64 1
+  %e = extractelement <2 x ptr> %v1, i32 %n
+  ret ptr %e
+}
+
+; Negative: GEPs differ in their index operands, so there is no common GEP.
+define ptr @extractelt_of_gep_vector_mismatched_index(ptr %p0, ptr %p1, i32 %n, i64 %o0, i64 %o1) {
+; CHECK-LABEL: define ptr @extractelt_of_gep_vector_mismatched_index(
+; CHECK-SAME: ptr [[P0:%.*]], ptr [[P1:%.*]], i32 [[N:%.*]], i64 [[O0:%.*]], i64 [[O1:%.*]]) {
+; CHECK-NEXT:    [[G0:%.*]] = getelementptr i8, ptr [[P0]], i64 [[O0]]
+; CHECK-NEXT:    [[G1:%.*]] = getelementptr i8, ptr [[P1]], i64 [[O1]]
+; CHECK-NEXT:    [[V0:%.*]] = insertelement <2 x ptr> poison, ptr [[G0]], i64 0
+; CHECK-NEXT:    [[V1:%.*]] = insertelement <2 x ptr> [[V0]], ptr [[G1]], i64 1
+; CHECK-NEXT:    [[E:%.*]] = extractelement <2 x ptr> [[V1]], i32 [[N]]
+; CHECK-NEXT:    ret ptr [[E]]
+;
+  %g0 = getelementptr i8, ptr %p0, i64 %o0
+  %g1 = getelementptr i8, ptr %p1, i64 %o1
+  %v0 = insertelement <2 x ptr> poison, ptr %g0, i64 0
+  %v1 = insertelement <2 x ptr> %v0, ptr %g1, i64 1
+  %e = extractelement <2 x ptr> %v1, i32 %n
+  ret ptr %e
+}
+
+; Negative: the vector has a non-extractelement use, so folding would duplicate IR.
+define ptr @extractelt_of_gep_vector_multiuse(ptr %p0, ptr %p1, i32 %n, i64 %off, ptr %sink) {
+; CHECK-LABEL: define ptr @extractelt_of_gep_vector_multiuse(
+; CHECK-SAME: ptr [[P0:%.*]], ptr [[P1:%.*]], i32 [[N:%.*]], i64 [[OFF:%.*]], ptr [[SINK:%.*]]) {
+; CHECK-NEXT:    [[G0:%.*]] = getelementptr i8, ptr [[P0]], i64 [[OFF]]
+; CHECK-NEXT:    [[G1:%.*]] = getelementptr i8, ptr [[P1]], i64 [[OFF]]
+; CHECK-NEXT:    [[V0:%.*]] = insertelement <2 x ptr> poison, ptr [[G0]], i64 0
+; CHECK-NEXT:    [[V1:%.*]] = insertelement <2 x ptr> [[V0]], ptr [[G1]], i64 1
+; CHECK-NEXT:    [[E:%.*]] = extractelement <2 x ptr> [[V1]], i32 [[N]]
+; CHECK-NEXT:    store <2 x ptr> [[V1]], ptr [[SINK]], align 16
+; CHECK-NEXT:    ret ptr [[E]]
+;
+  %g0 = getelementptr i8, ptr %p0, i64 %off
+  %g1 = getelementptr i8, ptr %p1, i64 %off
+  %v0 = insertelement <2 x ptr> poison, ptr %g0, i64 0
+  %v1 = insertelement <2 x ptr> %v0, ptr %g1, i64 1
+  %e = extractelement <2 x ptr> %v1, i32 %n
+  store <2 x ptr> %v1, ptr %sink
+  ret ptr %e
+}
+
+; The same vector feeding multiple extractelements still folds.
+define void @extractelt_of_gep_vector_two_extracts(ptr %p0, ptr %p1, i32 %n, i32 %m, i64 %off) {
+; CHECK-LABEL: define void @extractelt_of_gep_vector_two_extracts(
+; CHECK-SAME: ptr [[P0:%.*]], ptr [[P1:%.*]], i32 [[N:%.*]], i32 [[M:%.*]], i64 [[OFF:%.*]]) {
+; CHECK-NEXT:    [[TMP1:%.*]] = insertelement <2 x ptr> poison, ptr [[P0]], i64 0
+; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <2 x ptr> [[TMP1]], ptr [[P1]], i64 1
+; CHECK-NEXT:    [[TMP3:%.*]] = extractelement <2 x ptr> [[TMP2]], i32 [[N]]
+; CHECK-NEXT:    [[E0:%.*]] = getelementptr i8, ptr [[TMP3]], i64 [[OFF]]
+; CHECK-NEXT:    [[TMP4:%.*]] = insertelement <2 x ptr> poison, ptr [[P0]], i64 0
+; CHECK-NEXT:    [[TMP5:%.*]] = insertelement <2 x ptr> [[TMP4]], ptr [[P1]], i64 1
+; CHECK-NEXT:    [[TMP6:%.*]] = extractelement <2 x ptr> [[TMP5]], i32 [[M]]
+; CHECK-NEXT:    [[E1:%.*]] = getelementptr i8, ptr [[TMP6]], i64 [[OFF]]
+; CHECK-NEXT:    call void @use2(ptr [[E0]], ptr [[E1]])
+; CHECK-NEXT:    ret void
+;
+  %g0 = getelementptr i8, ptr %p0, i64 %off
+  %g1 = getelementptr i8, ptr %p1, i64 %off
+  %v0 = insertelement <2 x ptr> poison, ptr %g0, i64 0
+  %v1 = insertelement <2 x ptr> %v0, ptr %g1, i64 1
+  %e0 = extractelement <2 x ptr> %v1, i32 %n
+  %e1 = extractelement <2 x ptr> %v1, i32 %m
+  call void @use2(ptr %e0, ptr %e1)
+  ret void
+}
+
+declare void @use2(ptr, ptr)
diff --git a/llvm/test/Transforms/PhaseOrdering/extractelement-gep-licm.ll b/llvm/test/Transforms/PhaseOrdering/extractelement-gep-licm.ll
new file mode 100644
index 0000000000000..40df4b9161ea1
--- /dev/null
+++ b/llvm/test/Transforms/PhaseOrdering/extractelement-gep-licm.ll
@@ -0,0 +1,46 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes='instcombine,loop-simplify,loop-mssa(licm)' -S < %s | FileCheck %s
+
+; InstCombine scalarizes the extractelement of a vector of GEPs, exposing the
+; loop-invariant base pointer selection so that LICM can hoist it out of the
+; loop, leaving only the varying-offset GEP and the load inside the loop.
+
+@g = external addrspace(3) global [0 x i8]
+declare void @use(i8)
+
+define void @extractelement_gep_hoist(i32 %idx, i64 %n) {
+; CHECK-LABEL: define void @extractelement_gep_hoist(
+; CHECK-SAME: i32 [[IDX:%.*]], i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[TMP0:%.*]] = extractelement <2 x ptr addrspace(3)> <ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @g, i64 100), ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @g, i64 200)>, i32 [[IDX]]
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    [[OFF:%.*]] = shl i64 [[I]], 6
+; CHECK-NEXT:    [[SEL:%.*]] = getelementptr i8, ptr addrspace(3) [[TMP0]], i64 [[OFF]]
+; CHECK-NEXT:    [[VAL:%.*]] = load i8, ptr addrspace(3) [[SEL]], align 1
+; CHECK-NEXT:    call void @use(i8 [[VAL]])
+; CHECK-NEXT:    [[I_NEXT]] = add i64 [[I]], 1
+; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %loop
+loop:
+  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
+  %off = shl i64 %i, 6
+  %a = getelementptr i8, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @g, i64 100), i64 %off
+  %b = getelementptr i8, ptr addrspace(3) getelementptr (i8, ptr addrspace(3) @g, i64 200), i64 %off
+  %v0 = insertelement <2 x ptr addrspace(3)> poison, ptr addrspace(3) %a, i64 0
+  %v1 = insertelement <2 x ptr addrspace(3)> %v0, ptr addrspace(3) %b, i64 1
+  %sel = extractelement <2 x ptr addrspace(3)> %v1, i32 %idx
+  %val = load i8, ptr addrspace(3) %sel
+  call void @use(i8 %val)
+  %i.next = add i64 %i, 1
+  %done = icmp eq i64 %i.next, %n
+  br i1 %done, label %exit, label %loop
+exit:
+  ret void
+}
