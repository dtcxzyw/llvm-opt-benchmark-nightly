diff --git a/llvm/test/Transforms/ConstraintElimination/add-negative-constant-signed.ll b/llvm/test/Transforms/ConstraintElimination/add-negative-constant-signed.ll
new file mode 100644
index 0000000000000..bb176113ab3dc
--- /dev/null
+++ b/llvm/test/Transforms/ConstraintElimination/add-negative-constant-signed.ll
@@ -0,0 +1,135 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s
+
+; Tests for decomposing `add %x, -C` in the *signed* system. Adding a negative
+; constant only overflows signed when %x is near SMIN, so a non-negative %x is
+; always safe. Without this the decrement is opaque to every signed query, even
+; though the same shape is already handled in the unsigned system.
+
+declare void @llvm.assume(i1)
+
+; x >=s 0, x <s b  ==>  x - 1 <s b.
+define i1 @add_neg_1_slt(i64 %x, i64 %b) {
+; CHECK-LABEL: define i1 @add_neg_1_slt(
+; CHECK-SAME: i64 [[X:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[NN:%.*]] = icmp sge i64 [[X]], 0
+; CHECK-NEXT:    br i1 [[NN]], label %[[BB:.*]], label %[[EXIT:.*]]
+; CHECK:       [[BB]]:
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[X]], [[B]]
+; CHECK-NEXT:    br i1 [[C]], label %[[CHK:.*]], label %[[EXIT]]
+; CHECK:       [[CHK]]:
+; CHECK-NEXT:    [[SUB:%.*]] = add i64 [[X]], -1
+; CHECK-NEXT:    ret i1 true
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %nn = icmp sge i64 %x, 0
+  br i1 %nn, label %bb, label %exit
+
+bb:
+  %c = icmp slt i64 %x, %b
+  br i1 %c, label %chk, label %exit
+
+chk:
+  %sub = add i64 %x, -1
+  %t = icmp slt i64 %sub, %b
+  ret i1 %t
+
+exit:
+  ret i1 false
+}
+
+; The same for a larger constant: x >=s 0, x <s b ==> x - 20 <s b.
+define i1 @add_neg_20_slt(i64 %x, i64 %b) {
+; CHECK-LABEL: define i1 @add_neg_20_slt(
+; CHECK-SAME: i64 [[X:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[NN:%.*]] = icmp sge i64 [[X]], 0
+; CHECK-NEXT:    br i1 [[NN]], label %[[BB:.*]], label %[[EXIT:.*]]
+; CHECK:       [[BB]]:
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[X]], [[B]]
+; CHECK-NEXT:    br i1 [[C]], label %[[CHK:.*]], label %[[EXIT]]
+; CHECK:       [[CHK]]:
+; CHECK-NEXT:    [[SUB:%.*]] = add i64 [[X]], -20
+; CHECK-NEXT:    ret i1 true
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %nn = icmp sge i64 %x, 0
+  br i1 %nn, label %bb, label %exit
+
+bb:
+  %c = icmp slt i64 %x, %b
+  br i1 %c, label %chk, label %exit
+
+chk:
+  %sub = add i64 %x, -20
+  %t = icmp slt i64 %sub, %b
+  ret i1 %t
+
+exit:
+  ret i1 false
+}
+
+; Non-negativity may also come from an unsigned upper bound: x <u c with
+; c >=s 0 puts x in [0, c], so the decrement is decomposable. This is the shape
+; Swift produces for a loop's `n - 1` under a `n - 1 <u count` guard.
+define i1 @add_neg_1_nonneg_from_ult(i64 %x, i64 %c) {
+; CHECK-LABEL: define i1 @add_neg_1_nonneg_from_ult(
+; CHECK-SAME: i64 [[X:%.*]], i64 [[C:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[NN:%.*]] = icmp sge i64 [[C]], 0
+; CHECK-NEXT:    call void @llvm.assume(i1 [[NN]])
+; CHECK-NEXT:    [[B:%.*]] = icmp ult i64 [[X]], [[C]]
+; CHECK-NEXT:    br i1 [[B]], label %[[CHK:.*]], label %[[EXIT:.*]]
+; CHECK:       [[CHK]]:
+; CHECK-NEXT:    [[SUB:%.*]] = add i64 [[X]], -1
+; CHECK-NEXT:    ret i1 true
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %nn = icmp sge i64 %c, 0
+  call void @llvm.assume(i1 %nn)
+  %b = icmp ult i64 %x, %c
+  br i1 %b, label %chk, label %exit
+
+chk:
+  %sub = add i64 %x, -1
+  %t = icmp slt i64 %sub, %c
+  ret i1 %t
+
+exit:
+  ret i1 false
+}
+
+; Negative test: without a non-negativity fact for %x the decrement may wrap
+; (x == SMIN), so it must stay opaque.
+define i1 @add_neg_1_no_nonneg(i64 %x, i64 %b) {
+; CHECK-LABEL: define i1 @add_neg_1_no_nonneg(
+; CHECK-SAME: i64 [[X:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[X]], [[B]]
+; CHECK-NEXT:    br i1 [[C]], label %[[CHK:.*]], label %[[EXIT:.*]]
+; CHECK:       [[CHK]]:
+; CHECK-NEXT:    [[SUB:%.*]] = add i64 [[X]], -1
+; CHECK-NEXT:    [[T:%.*]] = icmp slt i64 [[SUB]], [[B]]
+; CHECK-NEXT:    ret i1 [[T]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %c = icmp slt i64 %x, %b
+  br i1 %c, label %chk, label %exit
+
+chk:
+  %sub = add i64 %x, -1
+  %t = icmp slt i64 %sub, %b
+  ret i1 %t
+
+exit:
+  ret i1 false
+}
