-        if (!L || !L->isSimple())
-          continue;
-        auto *GEP = dyn_cast<GetElementPtrInst>(L->getPointerOperand());
-        if (!GEP ||
-            (!GEP->hasNoUnsignedWrap() && !GEP->hasNoUnsignedSignedWrap()))
-          continue;
-        auto *PtrTy = dyn_cast<PointerType>(L->getType());
