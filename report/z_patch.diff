+; CHECK-NEXT:   call void @llvm.assume(i1 %0)
+; CHECK-NEXT:   %check = icmp ne i8 %x, 0
+; CHECK-NEXT:   ret i1 %check
+; CHECK-NEXT: }
+;
+entry:
+  %iszero = trunc nuw i8 %x to i1
+  br i1 %iszero, label %else, label %then
+
+then:
+  %check = icmp ne i8 %x, 0
+  call void @use(i1 %check)
+  ret i1 %check
+
+else:
+  ret i1 false
+}
