+; Same, with %loop2 nested inside %loop1 rather than in one of its exit blocks.
+define void @nested_decreasing(ptr %p, i32 %n) {
+; CHECK-LABEL: 'nested_decreasing'
+; CHECK-NEXT:  Determining loop execution counts for: @nested_decreasing
+; CHECK-NEXT:  Loop %loop2: backedge-taken count is {(-1 + %n),+,-1}<nsw><%loop1>
+; CHECK-NEXT:  Loop %loop2: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop2: symbolic max backedge-taken count is {(-1 + %n),+,-1}<nsw><%loop1>
+; CHECK-NEXT:  Loop %loop2: Trip multiple is 1
+; CHECK-NEXT:  Loop %loop1: backedge-taken count is (-1 + %n)
+; CHECK-NEXT:  Loop %loop1: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop1: symbolic max backedge-taken count is (-1 + %n)
+; CHECK-NEXT:  Loop %loop1: Trip multiple is 1
+;
+entry:
+  %nz = icmp eq i32 %n, 0
+  br i1 %nz, label %exit, label %loop1
+
+loop1:
+  %i = phi i32 [ %n, %entry ], [ %i.dec, %loop1.latch ]
+  br label %loop2
+
+loop2:
+  %j = phi i32 [ %i, %loop1 ], [ %j.dec, %loop2 ]
+  %j.dec = add nsw i32 %j, -1
+  store i8 0, ptr %p, align 1
+  %cont = icmp ugt i32 %j, 1
+  br i1 %cont, label %loop2, label %loop1.latch
+
+loop1.latch:
+  %i.dec = add nsw i32 %i, -1
+  %done = icmp eq i32 %i.dec, 0
+  br i1 %done, label %exit, label %loop1
+
+exit:
+  ret void
+}
