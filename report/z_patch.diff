+; CHECK-NEXT:    call void @llvm.assume(i1 [[C_0]])
+; CHECK-NEXT:    [[C_1:%.*]] = icmp ult i64 [[X]], [[N]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C_1]])
+; CHECK-NEXT:    [[MUL:%.*]] = mul nuw nsw i64 [[X]], 3
+; CHECK-NEXT:    ret i64 [[MUL]]
