+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
+; RUN: opt < %s -passes='sroa<modify-cfg>' -S | FileCheck %s
+
+target datalayout = "e-p:64:64-n8:16:32:64"
+
+declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1 immarg)
+
+define void @forward_pointer_as_integer(i1 %cond, ptr %source, ptr %other,
+                                        ptr %destination) {
+; CHECK-LABEL: define void @forward_pointer_as_integer(
+; CHECK-SAME: i1 [[COND:%.*]], ptr [[SOURCE:%.*]], ptr [[OTHER:%.*]], ptr [[DESTINATION:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[TEMPORARY_SROA_0_0_COPYLOAD:%.*]] = load i64, ptr [[SOURCE]], align 8
+; CHECK-NEXT:    [[TMP0:%.*]] = inttoptr i64 [[TEMPORARY_SROA_0_0_COPYLOAD]] to ptr
+; CHECK-NEXT:    br i1 [[COND]], label %[[THEN:.*]], label %[[CONT:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    [[ADDRESS_SROA_SPECULATE_LOAD_THEN:%.*]] = load ptr, ptr [[OTHER]], align 8
+; CHECK-NEXT:    br label %[[CONT]]
+; CHECK:       [[CONT]]:
+; CHECK-NEXT:    [[ADDRESS_SROA_SPECULATED:%.*]] = phi ptr [ [[ADDRESS_SROA_SPECULATE_LOAD_THEN]], %[[THEN]] ], [ [[TMP0]], %[[ENTRY]] ]
+; CHECK-NEXT:    store ptr [[ADDRESS_SROA_SPECULATED]], ptr [[DESTINATION]], align 8
+; CHECK-NEXT:    ret void
+;
+entry:
+  %temporary = alloca { ptr }, align 8
+  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %temporary, ptr align 8 %source,
+                                  i64 8, i1 false)
+  br i1 %cond, label %then, label %cont
+
+then:
+  br label %cont
+
+cont:
+  %address = phi ptr [ %other, %then ], [ %temporary, %entry ]
+  %value = load ptr, ptr %address, align 8
+  store ptr %value, ptr %destination, align 8
+  ret void
+}
+
+define i8 @do_not_forward_semantic_pointer(i1 %cond, ptr %source, ptr %other) {
+; CHECK-LABEL: define i8 @do_not_forward_semantic_pointer(
+; CHECK-SAME: i1 [[COND:%.*]], ptr [[SOURCE:%.*]], ptr [[OTHER:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[TEMPORARY_SROA_0_0_COPYLOAD:%.*]] = load ptr, ptr [[SOURCE]], align 8
+; CHECK-NEXT:    br i1 [[COND]], label %[[THEN:.*]], label %[[CONT:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    [[ADDRESS_SROA_SPECULATE_LOAD_THEN:%.*]] = load ptr, ptr [[OTHER]], align 8
+; CHECK-NEXT:    br label %[[CONT]]
+; CHECK:       [[CONT]]:
+; CHECK-NEXT:    [[ADDRESS_SROA_SPECULATED:%.*]] = phi ptr [ [[ADDRESS_SROA_SPECULATE_LOAD_THEN]], %[[THEN]] ], [ [[TEMPORARY_SROA_0_0_COPYLOAD]], %[[ENTRY]] ]
+; CHECK-NEXT:    [[RESULT:%.*]] = load i8, ptr [[ADDRESS_SROA_SPECULATED]], align 1
+; CHECK-NEXT:    ret i8 [[RESULT]]
+;
+entry:
+  %temporary = alloca { ptr }, align 8
+  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %temporary, ptr align 8 %source,
+                                  i64 8, i1 false)
+  br i1 %cond, label %then, label %cont
+
+then:
+  br label %cont
+
+cont:
+  %address = phi ptr [ %other, %then ], [ %temporary, %entry ]
+  %value = load ptr, ptr %address, align 8
+  %result = load i8, ptr %value
+  ret i8 %result
+}
+
+define void @forward_shifted_pointer_pair(i1 %cond, ptr %source,
+                                          ptr %destination) {
+; CHECK-LABEL: define void @forward_shifted_pointer_pair(
+; CHECK-SAME: i1 [[COND:%.*]], ptr [[SOURCE:%.*]], ptr [[DESTINATION:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[TEMPORARY_SROA_0_0_COPYLOAD:%.*]] = load i64, ptr [[SOURCE]], align 8
+; CHECK-NEXT:    [[TEMPORARY_SROA_2_0_SOURCE_SROA_IDX:%.*]] = getelementptr inbounds i8, ptr [[SOURCE]], i64 8
+; CHECK-NEXT:    [[TEMPORARY_SROA_2_0_COPYLOAD:%.*]] = load i64, ptr [[TEMPORARY_SROA_2_0_SOURCE_SROA_IDX]], align 8
+; CHECK-NEXT:    [[TEMPORARY_SROA_4_0_SOURCE_SROA_IDX:%.*]] = getelementptr inbounds i8, ptr [[SOURCE]], i64 16
+; CHECK-NEXT:    [[TEMPORARY_SROA_4_0_COPYLOAD:%.*]] = load i64, ptr [[TEMPORARY_SROA_4_0_SOURCE_SROA_IDX]], align 8
+; CHECK-NEXT:    br i1 [[COND]], label %[[ORDINARY:.*]], label %[[SHIFTED:.*]]
+; CHECK:       [[ORDINARY]]:
+; CHECK-NEXT:    [[TMP0:%.*]] = inttoptr i64 [[TEMPORARY_SROA_4_0_COPYLOAD]] to ptr
+; CHECK-NEXT:    [[TMP1:%.*]] = inttoptr i64 [[TEMPORARY_SROA_2_0_COPYLOAD]] to ptr
+; CHECK-NEXT:    br label %[[MERGE:.*]]
+; CHECK:       [[SHIFTED]]:
+; CHECK-NEXT:    [[TMP2:%.*]] = inttoptr i64 [[TEMPORARY_SROA_2_0_COPYLOAD]] to ptr
+; CHECK-NEXT:    [[TMP3:%.*]] = inttoptr i64 [[TEMPORARY_SROA_0_0_COPYLOAD]] to ptr
+; CHECK-NEXT:    br label %[[MERGE]]
+; CHECK:       [[MERGE]]:
+; CHECK-NEXT:    [[ADDRESS0_SROA_SPECULATED:%.*]] = phi ptr [ [[TMP1]], %[[ORDINARY]] ], [ [[TMP3]], %[[SHIFTED]] ]
+; CHECK-NEXT:    [[ADDRESS1_SROA_SPECULATED:%.*]] = phi ptr [ [[TMP0]], %[[ORDINARY]] ], [ [[TMP2]], %[[SHIFTED]] ]
+; CHECK-NEXT:    [[DESTINATION1:%.*]] = getelementptr inbounds i8, ptr [[DESTINATION]], i64 8
+; CHECK-NEXT:    store ptr [[ADDRESS0_SROA_SPECULATED]], ptr [[DESTINATION]], align 8
+; CHECK-NEXT:    store ptr [[ADDRESS1_SROA_SPECULATED]], ptr [[DESTINATION1]], align 8
+; CHECK-NEXT:    ret void
+;
+entry:
+  %temporary = alloca [6 x i32], align 8
+  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %temporary, ptr align 8 %source,
+                                  i64 24, i1 false)
+  %slot1 = getelementptr inbounds i8, ptr %temporary, i64 8
+  %slot2 = getelementptr inbounds i8, ptr %temporary, i64 16
+  br i1 %cond, label %ordinary, label %shifted
+
+ordinary:
+  br label %merge
+
+shifted:
+  br label %merge
+
+merge:
+  %address0 = phi ptr [ %slot1, %ordinary ], [ %temporary, %shifted ]
+  %address1 = phi ptr [ %slot2, %ordinary ], [ %slot1, %shifted ]
+  %value0 = load ptr, ptr %address0, align 8
+  %value1 = load ptr, ptr %address1, align 8
+  %destination1 = getelementptr inbounds i8, ptr %destination, i64 8
+  store ptr %value0, ptr %destination, align 8
+  store ptr %value1, ptr %destination1, align 8
+  ret void
+}
