+; CHECK-NEXT:    [[P:%.*]] = load ptr, ptr @g, align 8
+; CHECK-NEXT:    [[Q:%.*]] = getelementptr i8, ptr [[P]], i64 8
+; CHECK-NEXT:    store i64 [[V]], ptr [[Q]], align 16
+; CHECK-NEXT:    ret void
+;
+  %p = load ptr, ptr @g, align 8
