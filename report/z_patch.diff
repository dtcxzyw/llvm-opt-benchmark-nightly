+target triple = "x86_64-unknown-linux-gnu"
+
+declare void @sink(i64)
+
+; Legalizing a non-native width can add masks and extensions.
+define i7 @narrow_odd_type(i1 noundef %c, i32 noundef %v, i7 %d, i7 %e, ptr %out, ptr %out2) optsize "target-cpu"="x86-64" {
+; CHECK-LABEL: define range(i7 2, 17) i7 @narrow_odd_type(
+; CHECK-SAME: i1 noundef [[C:%.*]], i32 noundef [[V:%.*]], i7 [[D:%.*]], i7 [[E:%.*]], ptr [[OUT:%.*]], ptr [[OUT2:%.*]]) #[[ATTR0:[0-9]+]] {
+; CHECK-NEXT:    [[COND:%.*]] = trunc i32 [[V]] to i1
+; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i7 2, i7 5
+; CHECK-NEXT:    [[OTHER:%.*]] = select i1 [[COND]], i7 0, i7 3
+; CHECK-NEXT:    [[S:%.*]] = sub i7 [[OTHER]], [[D]]
