--- /dev/null
+++ b/llvm/test/Transforms/InstCombine/icmp-urem.ll
@@ -0,0 +1,118 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -passes=instcombine -S | FileCheck %s
+
+; (urem X, Y) == X --> X ult Y
+; (urem X, Y) != X --> X uge Y
+
+; Scalar tests.
+
+define i1 @icmp_eq_urem_dividend(i32 %x, i32 %y) {
+; CHECK-LABEL: define i1 @icmp_eq_urem_dividend(
+; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
+; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i32 [[X]], [[Y]]
+; CHECK-NEXT:    ret i1 [[CMP]]
+;
+  %rem = urem i32 %x, %y
+  %cmp = icmp eq i32 %rem, %x
+  ret i1 %cmp
+}
+
+; The compare operands may be commuted.
+
+define i1 @icmp_ne_urem_dividend_commuted(i32 %x, i32 %y) {
+; CHECK-LABEL: define i1 @icmp_ne_urem_dividend_commuted(
+; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
+; CHECK-NEXT:    [[CMP:%.*]] = icmp uge i32 [[X]], [[Y]]
+; CHECK-NEXT:    ret i1 [[CMP]]
+;
+  %rem = urem i32 %x, %y
+  %cmp = icmp ne i32 %x, %rem
+  ret i1 %cmp
+}
+
+; Vector tests.
+
+define <2 x i1> @icmp_eq_urem_dividend_v2i32(<2 x i32> %x, <2 x i32> %y) {
+; CHECK-LABEL: define <2 x i1> @icmp_eq_urem_dividend_v2i32(
+; CHECK-SAME: <2 x i32> [[X:%.*]], <2 x i32> [[Y:%.*]]) {
+; CHECK-NEXT:    [[CMP:%.*]] = icmp ult <2 x i32> [[X]], [[Y]]
+; CHECK-NEXT:    ret <2 x i1> [[CMP]]
+;
+  %rem = urem <2 x i32> %x, %y
+  %cmp = icmp eq <2 x i32> %rem, %x
+  ret <2 x i1> %cmp
+}
+
+define <vscale x 2 x i1> @icmp_ne_urem_dividend_nxv2i32(
+; CHECK-LABEL: define <vscale x 2 x i1> @icmp_ne_urem_dividend_nxv2i32(
+; CHECK-SAME: <vscale x 2 x i32> [[X:%.*]], <vscale x 2 x i32> [[Y:%.*]]) {
+; CHECK-NEXT:    [[CMP:%.*]] = icmp uge <vscale x 2 x i32> [[X]], [[Y]]
+; CHECK-NEXT:    ret <vscale x 2 x i1> [[CMP]]
+;
+  <vscale x 2 x i32> %x, <vscale x 2 x i32> %y) {
+  %rem = urem <vscale x 2 x i32> %x, %y
+  %cmp = icmp ne <vscale x 2 x i32> %rem, %x
+  ret <vscale x 2 x i1> %cmp
+}
+
+; The fold does not require the urem to have one use.
+
+declare void @use_i32(i32)
+
+define i1 @icmp_eq_urem_dividend_extra_use(i32 %x, i32 %y) {
+; CHECK-LABEL: define i1 @icmp_eq_urem_dividend_extra_use(
+; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
+; CHECK-NEXT:    [[REM:%.*]] = urem i32 [[X]], [[Y]]
+; CHECK-NEXT:    call void @use_i32(i32 [[REM]])
+; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i32 [[X]], [[Y]]
+; CHECK-NEXT:    ret i1 [[CMP]]
+;
+  %rem = urem i32 %x, %y
+  call void @use_i32(i32 %rem)
+  %cmp = icmp eq i32 %rem, %x
+  ret i1 %cmp
+}
+
+; Tests that must not fold.
+
+; The value compared with the remainder must be its dividend.
+
+define i1 @not_icmp_eq_urem_different_dividend(i32 %x, i32 %y, i32 %z) {
+; CHECK-LABEL: define i1 @not_icmp_eq_urem_different_dividend(
+; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]], i32 [[Z:%.*]]) {
+; CHECK-NEXT:    [[REM:%.*]] = urem i32 [[X]], [[Y]]
+; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[REM]], [[Z]]
+; CHECK-NEXT:    ret i1 [[CMP]]
+;
+  %rem = urem i32 %x, %y
+  %cmp = icmp eq i32 %rem, %z
+  ret i1 %cmp
+}
+
+; The analogous signed-remainder fold requires comparing magnitudes.
+
+define i1 @not_icmp_eq_srem_dividend(i32 %x, i32 %y) {
+; CHECK-LABEL: define i1 @not_icmp_eq_srem_dividend(
+; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
+; CHECK-NEXT:    [[REM:%.*]] = srem i32 [[X]], [[Y]]
+; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[REM]], [[X]]
+; CHECK-NEXT:    ret i1 [[CMP]]
+;
+  %rem = srem i32 %x, %y
+  %cmp = icmp eq i32 %rem, %x
+  ret i1 %cmp
+}
+
+; This fold is only valid for equality predicates.
+
+define i1 @not_icmp_slt_urem_dividend(i32 %x, i32 %y) {
+; CHECK-LABEL: define i1 @not_icmp_slt_urem_dividend(
+; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]]) {
+; CHECK-NEXT:    [[REM:%.*]] = urem i32 [[X]], [[Y]]
+; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i32 [[REM]], [[X]]
+; CHECK-NEXT:    ret i1 [[CMP]]
+;
+  %rem = urem i32 %x, %y
+  %cmp = icmp slt i32 %rem, %x
+  ret i1 %cmp
+}
