diff --git a/llvm/test/Analysis/ScalarEvolution/shift-op.ll b/llvm/test/Analysis/ScalarEvolution/shift-op.ll
index a0188ee40ab73..a560154bc7d94 100644
--- a/llvm/test/Analysis/ScalarEvolution/shift-op.ll
