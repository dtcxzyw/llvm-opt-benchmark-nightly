+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -passes="default<O3>" -S | FileCheck %s
+; REQUIRES: x86-registered-target
+
+; Original loop input: loads become adjacent only after partial unrolling.
+; The unroll count keeps this pipeline integration test deterministic.
+target triple = "x86_64-unknown-linux-gnu"
+
+define i64 @pack_loop(ptr %p, i32 %n, i64 %s, i64 %seed) {
+; CHECK-LABEL: define i64 @pack_loop(
+; CHECK-SAME: ptr nofree readonly captures(none) [[P:%.*]], i32 [[N:%.*]], i64 [[S:%.*]], i64 [[SEED:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[EMPTY:%.*]] = icmp eq i32 [[N]], 0
+; CHECK-NEXT:    br i1 [[EMPTY]], label %[[EXIT:.*]], label %[[LOOP_PREHEADER:.*]]
+; CHECK:       [[LOOP_PREHEADER]]:
+; CHECK-NEXT:    [[XTRAITER:%.*]] = and i32 [[N]], 3
+; CHECK-NEXT:    [[TMP0:%.*]] = icmp ult i32 [[N]], 4
+; CHECK-NEXT:    br i1 [[TMP0]], label %[[LOOP_EPIL_PREHEADER:.*]], label %[[LOOP_PREHEADER_NEW:.*]]
+; CHECK:       [[LOOP_PREHEADER_NEW]]:
+; CHECK-NEXT:    [[UNROLL_ITER:%.*]] = and i32 [[N]], -4
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[CURSOR:%.*]] = phi ptr [ [[P]], %[[LOOP_PREHEADER_NEW]] ], [ [[P_NEXT_3:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    [[SHIFT:%.*]] = phi i64 [ [[S]], %[[LOOP_PREHEADER_NEW]] ], [ [[SHIFT_NEXT_3:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    [[VALUE_2:%.*]] = phi i64 [ [[SEED]], %[[LOOP_PREHEADER_NEW]] ], [ [[VALUE_3:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    [[NITER:%.*]] = phi i32 [ 0, %[[LOOP_PREHEADER_NEW]] ], [ [[NITER_NEXT_3:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    [[BYTE:%.*]] = load i8, ptr [[CURSOR]], align 1
+; CHECK-NEXT:    [[WIDE:%.*]] = zext i8 [[BYTE]] to i64
+; CHECK-NEXT:    [[P_NEXT:%.*]] = getelementptr i8, ptr [[CURSOR]], i64 1
+; CHECK-NEXT:    [[BYTE_1:%.*]] = load i8, ptr [[P_NEXT]], align 1
+; CHECK-NEXT:    [[WIDE_1:%.*]] = zext i8 [[BYTE_1]] to i64
+; CHECK-NEXT:    [[TMP1:%.*]] = shl nuw nsw i64 [[WIDE_1]], 8
+; CHECK-NEXT:    [[TMP2:%.*]] = or disjoint i64 [[TMP1]], [[WIDE]]
+; CHECK-NEXT:    [[P_NEXT_1:%.*]] = getelementptr i8, ptr [[CURSOR]], i64 2
+; CHECK-NEXT:    [[BYTE_2:%.*]] = load i8, ptr [[P_NEXT_1]], align 1
+; CHECK-NEXT:    [[WIDE_2:%.*]] = zext i8 [[BYTE_2]] to i64
+; CHECK-NEXT:    [[TMP3:%.*]] = shl nuw nsw i64 [[WIDE_2]], 16
+; CHECK-NEXT:    [[TMP4:%.*]] = or disjoint i64 [[TMP2]], [[TMP3]]
+; CHECK-NEXT:    [[P_NEXT_2:%.*]] = getelementptr i8, ptr [[CURSOR]], i64 3
+; CHECK-NEXT:    [[BYTE_3:%.*]] = load i8, ptr [[P_NEXT_2]], align 1
+; CHECK-NEXT:    [[WIDE_3:%.*]] = zext i8 [[BYTE_3]] to i64
+; CHECK-NEXT:    [[TMP5:%.*]] = shl nuw nsw i64 [[WIDE_3]], 24
+; CHECK-NEXT:    [[TMP6:%.*]] = or disjoint i64 [[TMP4]], [[TMP5]]
+; CHECK-NEXT:    [[BITS_3:%.*]] = shl i64 [[TMP6]], [[SHIFT]]
+; CHECK-NEXT:    [[VALUE_3]] = or i64 [[BITS_3]], [[VALUE_2]]
+; CHECK-NEXT:    [[P_NEXT_3]] = getelementptr i8, ptr [[CURSOR]], i64 4
+; CHECK-NEXT:    [[SHIFT_NEXT_3]] = add nsw i64 [[SHIFT]], 32
+; CHECK-NEXT:    [[NITER_NEXT_3]] = add nuw i32 [[NITER]], 4
+; CHECK-NEXT:    [[NITER_NCMP_3:%.*]] = icmp eq i32 [[NITER_NEXT_3]], [[UNROLL_ITER]]
+; CHECK-NEXT:    br i1 [[NITER_NCMP_3]], label %[[EXIT_LOOPEXIT_UNR_LCSSA:.*]], label %[[LOOP]], !llvm.loop [[LOOP0:![0-9]+]]
+; CHECK:       [[EXIT_LOOPEXIT_UNR_LCSSA]]:
+; CHECK-NEXT:    [[LCMP_MOD_NOT:%.*]] = icmp eq i32 [[XTRAITER]], 0
+; CHECK-NEXT:    br i1 [[LCMP_MOD_NOT]], label %[[EXIT]], label %[[LOOP_EPIL_PREHEADER]]
+; CHECK:       [[LOOP_EPIL_PREHEADER]]:
+; CHECK-NEXT:    [[CURSOR_EPIL_INIT:%.*]] = phi ptr [ [[P]], %[[LOOP_PREHEADER]] ], [ [[P_NEXT_3]], %[[EXIT_LOOPEXIT_UNR_LCSSA]] ]
+; CHECK-NEXT:    [[SHIFT_EPIL_INIT:%.*]] = phi i64 [ [[S]], %[[LOOP_PREHEADER]] ], [ [[SHIFT_NEXT_3]], %[[EXIT_LOOPEXIT_UNR_LCSSA]] ]
+; CHECK-NEXT:    [[ACC_EPIL_INIT:%.*]] = phi i64 [ [[SEED]], %[[LOOP_PREHEADER]] ], [ [[VALUE_3]], %[[EXIT_LOOPEXIT_UNR_LCSSA]] ]
+; CHECK-NEXT:    [[LCMP_MOD2:%.*]] = icmp ne i32 [[XTRAITER]], 0
+; CHECK-NEXT:    tail call void @llvm.assume(i1 [[LCMP_MOD2]])
+; CHECK-NEXT:    br label %[[LOOP_EPIL:.*]]
+; CHECK:       [[LOOP_EPIL]]:
+; CHECK-NEXT:    [[CURSOR_EPIL:%.*]] = phi ptr [ [[P_NEXT_EPIL:%.*]], %[[LOOP_EPIL]] ], [ [[CURSOR_EPIL_INIT]], %[[LOOP_EPIL_PREHEADER]] ]
+; CHECK-NEXT:    [[SHIFT_EPIL:%.*]] = phi i64 [ [[SHIFT_NEXT_EPIL:%.*]], %[[LOOP_EPIL]] ], [ [[SHIFT_EPIL_INIT]], %[[LOOP_EPIL_PREHEADER]] ]
+; CHECK-NEXT:    [[ACC_EPIL:%.*]] = phi i64 [ [[VALUE_EPIL:%.*]], %[[LOOP_EPIL]] ], [ [[ACC_EPIL_INIT]], %[[LOOP_EPIL_PREHEADER]] ]
+; CHECK-NEXT:    [[EPIL_ITER:%.*]] = phi i32 [ [[EPIL_ITER_NEXT:%.*]], %[[LOOP_EPIL]] ], [ 0, %[[LOOP_EPIL_PREHEADER]] ]
+; CHECK-NEXT:    [[BYTE_EPIL:%.*]] = load i8, ptr [[CURSOR_EPIL]], align 1
+; CHECK-NEXT:    [[WIDE_EPIL:%.*]] = zext i8 [[BYTE_EPIL]] to i64
+; CHECK-NEXT:    [[BITS_EPIL:%.*]] = shl i64 [[WIDE_EPIL]], [[SHIFT_EPIL]]
+; CHECK-NEXT:    [[VALUE_EPIL]] = or i64 [[BITS_EPIL]], [[ACC_EPIL]]
+; CHECK-NEXT:    [[P_NEXT_EPIL]] = getelementptr i8, ptr [[CURSOR_EPIL]], i64 1
+; CHECK-NEXT:    [[SHIFT_NEXT_EPIL]] = add nsw i64 [[SHIFT_EPIL]], 8
+; CHECK-NEXT:    [[EPIL_ITER_NEXT]] = add i32 [[EPIL_ITER]], 1
+; CHECK-NEXT:    [[EPIL_ITER_CMP_NOT:%.*]] = icmp eq i32 [[EPIL_ITER_NEXT]], [[XTRAITER]]
+; CHECK-NEXT:    br i1 [[EPIL_ITER_CMP_NOT]], label %[[EXIT]], label %[[LOOP_EPIL]], !llvm.loop [[LOOP2:![0-9]+]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    [[RESULT:%.*]] = phi i64 [ [[SEED]], %[[ENTRY]] ], [ [[VALUE_3]], %[[EXIT_LOOPEXIT_UNR_LCSSA]] ], [ [[VALUE_EPIL]], %[[LOOP_EPIL]] ]
+; CHECK-NEXT:    ret i64 [[RESULT]]
+;
+entry:
+  %empty = icmp eq i32 %n, 0
+  br i1 %empty, label %exit, label %loop
+
+loop:
+  %i = phi i32 [ 0, %entry ], [ %next, %loop ]
+  %cursor = phi ptr [ %p, %entry ], [ %p.next, %loop ]
+  %shift = phi i64 [ %s, %entry ], [ %shift.next, %loop ]
+  %acc = phi i64 [ %seed, %entry ], [ %value, %loop ]
+  %byte = load i8, ptr %cursor, align 1
+  %wide = zext i8 %byte to i64
+  %bits = shl i64 %wide, %shift
+  %value = or i64 %acc, %bits
+  %p.next = getelementptr i8, ptr %cursor, i64 1
+  %shift.next = add nsw i64 %shift, 8
+  %next = add nuw i32 %i, 1
+  %done = icmp eq i32 %next, %n
+  br i1 %done, label %exit, label %loop, !llvm.loop !0
+
+exit:
+  %result = phi i64 [ %seed, %entry ], [ %value, %loop ]
+  ret i64 %result
+}
+
+!0 = distinct !{!0, !1}
+!1 = !{!"llvm.loop.unroll.count", i32 4}
+;.
+; CHECK: [[LOOP0]] = distinct !{[[LOOP0]], [[META1:![0-9]+]]}
+; CHECK: [[META1]] = !{!"llvm.loop.unroll.disable"}
+; CHECK: [[LOOP2]] = distinct !{[[LOOP2]], [[META1]]}
+;.
