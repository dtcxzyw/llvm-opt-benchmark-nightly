-         isKnownViaNonRecursiveReasoning(Pred, LHS, RHS);
+  if (isKnownViaInduction(Pred, LHS, RHS) ||
+      isKnownPredicateViaSplitting(Pred, LHS, RHS) ||
+      isKnownViaNonRecursiveReasoning(Pred, LHS, RHS))
+    return true;
+
+  // Limit the nesting of min/max decompositions.
+  if (Depth == 2)
