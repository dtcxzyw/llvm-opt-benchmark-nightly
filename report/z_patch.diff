diff --git a/llvm/test/Analysis/ScalarEvolution/guards-in-dominating-blocks.ll b/llvm/test/Analysis/ScalarEvolution/guards-in-dominating-blocks.ll
new file mode 100644
index 0000000000000..3537e2b502aad
--- /dev/null
+++ b/llvm/test/Analysis/ScalarEvolution/guards-in-dominating-blocks.ll
@@ -0,0 +1,138 @@
+; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -disable-output "-passes=print<scalar-evolution>" < %s 2>&1 | FileCheck %s
+
+; Tests for conditions that guard the loop but are only reachable by walking up
+; the dominator tree, because the chain from the preheader to the guarding
+; branch passes through a block with multiple predecessors.
+
+; The loop preheader has a unique predecessor chain up to the guarding branch,
+; so '%n >u 1' is found and the backedge-taken count is exact.
+define void @single_predecessor_chain(ptr %p) {
+; CHECK-LABEL: 'single_predecessor_chain'
+; CHECK-NEXT:  Classifying expressions for: @single_predecessor_chain
+; CHECK-NEXT:    %n = load i32, ptr %p, align 4
+; CHECK-NEXT:    --> %n U: full-set S: full-set
+; CHECK-NEXT:    %m = add i32 %n, -1
+; CHECK-NEXT:    --> (-1 + %n) U: full-set S: full-set
+; CHECK-NEXT:    %i = phi i32 [ 0, %ph ], [ %inc, %loop ]
+; CHECK-NEXT:    --> {0,+,1}<nuw><%loop> U: [0,-1) S: [0,-1) Exits: (-2 + %n) LoopDispositions: { %loop: Computable }
+; CHECK-NEXT:    %inc = add nuw i32 %i, 1
+; CHECK-NEXT:    --> {1,+,1}<nuw><%loop> U: [1,0) S: [1,0) Exits: (-1 + %n) LoopDispositions: { %loop: Computable }
+; CHECK-NEXT:  Determining loop execution counts for: @single_predecessor_chain
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-2 + %n)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-2 + %n)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %n = load i32, ptr %p, align 4
+  %big = icmp ugt i32 %n, 1
+  br i1 %big, label %ph, label %exit
+
+ph:
+  %m = add i32 %n, -1
+  br label %loop
+
+loop:
+  %i = phi i32 [ 0, %ph ], [ %inc, %loop ]
+  store volatile i32 %i, ptr %p, align 4
+  %inc = add nuw i32 %i, 1
+  %cmp = icmp ult i32 %inc, %m
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Same, but %ph is reached from two blocks and has no PHI, so the
+; unique-predecessor climb stops there. '%n >u 1' still dominates %ph.
+define void @merge_block_without_phi(ptr %p, i1 %c) {
+; CHECK-LABEL: 'merge_block_without_phi'
+; CHECK-NEXT:  Classifying expressions for: @merge_block_without_phi
+; CHECK-NEXT:    %n = load i32, ptr %p, align 4
+; CHECK-NEXT:    --> %n U: full-set S: full-set
+; CHECK-NEXT:    %m = add i32 %n, -1
+; CHECK-NEXT:    --> (-1 + %n) U: full-set S: full-set
+; CHECK-NEXT:    %i = phi i32 [ 0, %ph ], [ %inc, %loop ]
+; CHECK-NEXT:    --> {0,+,1}<nuw><%loop> U: [0,-1) S: [0,-1) Exits: (-2 + %n) LoopDispositions: { %loop: Computable }
+; CHECK-NEXT:    %inc = add nuw i32 %i, 1
+; CHECK-NEXT:    --> {1,+,1}<nuw><%loop> U: [1,0) S: [1,0) Exits: (-1 + %n) LoopDispositions: { %loop: Computable }
+; CHECK-NEXT:  Determining loop execution counts for: @merge_block_without_phi
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-2 + %n)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-2 + %n)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %n = load i32, ptr %p, align 4
+  %big = icmp ugt i32 %n, 1
+  br i1 %big, label %split, label %exit
+
+split:
+  br i1 %c, label %a, label %b
+
+a:
+  br label %ph
+
+b:
+  br label %ph
+
+ph:
+  %m = add i32 %n, -1
+  br label %loop
+
+loop:
+  %i = phi i32 [ 0, %ph ], [ %inc, %loop ]
+  store volatile i32 %i, ptr %p, align 4
+  %inc = add nuw i32 %i, 1
+  %cmp = icmp ult i32 %inc, %m
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; The condition does not dominate the loop: only one of the two paths to %ph
+; goes through it, so nothing may be inferred.
+define void @merge_block_condition_does_not_dominate(ptr %p, i1 %c) {
+; CHECK-LABEL: 'merge_block_condition_does_not_dominate'
+; CHECK-NEXT:  Classifying expressions for: @merge_block_condition_does_not_dominate
+; CHECK-NEXT:    %n = load i32, ptr %p, align 4
+; CHECK-NEXT:    --> %n U: full-set S: full-set
+; CHECK-NEXT:    %n2 = load i32, ptr %p, align 4
+; CHECK-NEXT:    --> %n2 U: full-set S: full-set
+; CHECK-NEXT:    %m = add i32 %n2, -1
+; CHECK-NEXT:    --> (-1 + %n2) U: full-set S: full-set
+; CHECK-NEXT:    %i = phi i32 [ 0, %ph ], [ %inc, %loop ]
+; CHECK-NEXT:    --> {0,+,1}<nuw><%loop> U: [0,-1) S: [0,-1) Exits: (-1 + (1 umax (-1 + %n2))) LoopDispositions: { %loop: Computable }
+; CHECK-NEXT:    %inc = add nuw i32 %i, 1
+; CHECK-NEXT:    --> {1,+,1}<nuw><%loop> U: [1,0) S: [1,0) Exits: (1 umax (-1 + %n2)) LoopDispositions: { %loop: Computable }
+; CHECK-NEXT:  Determining loop execution counts for: @merge_block_condition_does_not_dominate
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (1 umax (-1 + %n2)))
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (1 umax (-1 + %n2)))
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  br i1 %c, label %check, label %ph
+
+check:
+  %n = load i32, ptr %p, align 4
+  %big = icmp ugt i32 %n, 1
+  br i1 %big, label %ph, label %exit
+
+ph:
+  %n2 = load i32, ptr %p, align 4
+  %m = add i32 %n2, -1
+  br label %loop
+
+loop:
+  %i = phi i32 [ 0, %ph ], [ %inc, %loop ]
+  store volatile i32 %i, ptr %p, align 4
+  %inc = add nuw i32 %i, 1
+  %cmp = icmp ult i32 %inc, %m
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
+}
