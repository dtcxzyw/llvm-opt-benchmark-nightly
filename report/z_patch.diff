--- /dev/null
+++ b/llvm/test/Analysis/ScalarEvolution/shl-by-variable-amount.ll
@@ -0,0 +1,207 @@
+; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -disable-output "-passes=print<scalar-evolution>" < %s 2>&1 | FileCheck %s
+
+; A shift left by a variable amount is modelled as a multiply by a power of
+; two, so that expressions differing only by a constant factor stay
+; comparable. Previously such a shift produced an opaque SCEVUnknown.
+
+define void @shl_by_variable(i32 %x, i32 %v) {
+; CHECK-LABEL: 'shl_by_variable'
+; CHECK-NEXT:  Classifying expressions for: @shl_by_variable
+; CHECK-NEXT:    %shl = shl i32 %x, %v
+; CHECK-NEXT:    --> ((2 ^ %v) * %x) U: full-set S: full-set
+; CHECK-NEXT:  Determining loop execution counts for: @shl_by_variable
+;
+  %shl = shl i32 %x, %v
+  ret void
+}
+
+; `C << V` and `C * (1 << V)` must produce the same expression. Instcombine
+; canonicalizes the latter into the former, so without modelling the shift the
+; two forms are opaque and unrelated.
+define void @shl_and_mul_agree(i32 %v) {
+; CHECK-LABEL: 'shl_and_mul_agree'
+; CHECK-NEXT:  Classifying expressions for: @shl_and_mul_agree
+; CHECK-NEXT:    %one.shl = shl i32 1, %v
+; CHECK-NEXT:    --> (2 ^ %v) U: [1,-2147483647) S: [1,-2147483647)
+; CHECK-NEXT:    %mul = mul i32 5, %one.shl
+; CHECK-NEXT:    --> (5 * (2 ^ %v)) U: full-set S: full-set
+; CHECK-NEXT:    %shl = shl i32 5, %v
+; CHECK-NEXT:    --> (5 * (2 ^ %v)) U: full-set S: full-set
+; CHECK-NEXT:  Determining loop execution counts for: @shl_and_mul_agree
+;
+  %one.shl = shl i32 1, %v
+  %mul = mul i32 5, %one.shl
+  %shl = shl i32 5, %v
+  ret void
+}
+
+; Unlike a use-list based approach, no `1 << V` needs to exist in the IR, and
+; the shift amount does not need to be an instruction.
+define void @shl_amount_is_argument(i32 %v) {
+; CHECK-LABEL: 'shl_amount_is_argument'
+; CHECK-NEXT:  Classifying expressions for: @shl_amount_is_argument
+; CHECK-NEXT:    %shl = shl i32 3, %v
+; CHECK-NEXT:    --> (3 * (2 ^ %v)) U: full-set S: full-set
+; CHECK-NEXT:  Determining loop execution counts for: @shl_amount_is_argument
+;
+  %shl = shl i32 3, %v
+  ret void
+}
+
+; The two shifts differ by a constant factor, so their difference folds to
+; (2 ^ %v) instead of staying an opaque ((-1 * %a) + %b).
+define i32 @shl_difference(i32 %v) {
+; CHECK-LABEL: 'shl_difference'
+; CHECK-NEXT:  Classifying expressions for: @shl_difference
+; CHECK-NEXT:    %a = shl i32 3, %v
+; CHECK-NEXT:    --> (3 * (2 ^ %v)) U: full-set S: full-set
+; CHECK-NEXT:    %b = shl i32 4, %v
+; CHECK-NEXT:    --> (4 * (2 ^ %v)) U: [0,-3) S: [-2147483648,2147483645)
+; CHECK-NEXT:    %sub = sub i32 %b, %a
+; CHECK-NEXT:    --> (2 ^ %v) U: [1,-2147483647) S: [1,-2147483647)
+; CHECK-NEXT:  Determining loop execution counts for: @shl_difference
+;
+  %a = shl i32 3, %v
+  %b = shl i32 4, %v
+  %sub = sub i32 %b, %a
+  ret i32 %sub
+}
+
+; Branching on the result makes poison immediate UB, which is what lets the
+; no-wrap flags reach the SCEV at all.
+
+; A nuw shift is a nuw multiply.
+define void @shl_nuw(i32 %x, i32 %v) {
+; CHECK-LABEL: 'shl_nuw'
+; CHECK-NEXT:  Classifying expressions for: @shl_nuw
+; CHECK-NEXT:    %shl = shl nuw i32 %x, %v
+; CHECK-NEXT:    --> ((2 ^ %v) * %x)<nuw> U: full-set S: full-set
+; CHECK-NEXT:  Determining loop execution counts for: @shl_nuw
+;
+  %shl = shl nuw i32 %x, %v
+  %c = icmp eq i32 %shl, 0
+  br i1 %c, label %t, label %f
+t:
+  ret void
+f:
+  ret void
+}
+
+; `nsw` on its own cannot be preserved for an unknown amount, because that
+; would require knowing the amount is not bitwidth - 1.
+define void @shl_nsw_alone(i32 %x, i32 %v) {
+; CHECK-LABEL: 'shl_nsw_alone'
+; CHECK-NEXT:  Classifying expressions for: @shl_nsw_alone
+; CHECK-NEXT:    %shl = shl nsw i32 %x, %v
+; CHECK-NEXT:    --> ((2 ^ %v) * %x) U: full-set S: full-set
+; CHECK-NEXT:  Determining loop execution counts for: @shl_nsw_alone
+;
+  %shl = shl nsw i32 %x, %v
+  %c = icmp eq i32 %shl, 0
+  br i1 %c, label %t, label %f
+t:
+  ret void
+f:
+  ret void
+}
+
+; `nsw` alone is preserved once the amount is known to be small enough that the
+; multiplier 2^V stays positive.
+define void @shl_nsw_small_amount(i32 %x, i32 %v) {
+; CHECK-LABEL: 'shl_nsw_small_amount'
+; CHECK-NEXT:  Classifying expressions for: @shl_nsw_small_amount
+; CHECK-NEXT:    %amt = and i32 %v, 7
+; CHECK-NEXT:    --> (zext i3 (trunc i32 %v to i3) to i32) U: [0,8) S: [0,8)
+; CHECK-NEXT:    %shl = shl nsw i32 %x, %amt
+; CHECK-NEXT:    --> ((2 ^ (zext i3 (trunc i32 %v to i3) to i32)) * %x)<nsw> U: full-set S: full-set
+; CHECK-NEXT:  Determining loop execution counts for: @shl_nsw_small_amount
+;
+  %amt = and i32 %v, 7
+  %shl = shl nsw i32 %x, %amt
+  %c = icmp eq i32 %shl, 0
+  br i1 %c, label %t, label %f
+t:
+  ret void
+f:
+  ret void
+}
+
+; With nuw present, nsw can be preserved as well.
+define void @shl_nuw_nsw(i32 %x, i32 %v) {
+; CHECK-LABEL: 'shl_nuw_nsw'
+; CHECK-NEXT:  Classifying expressions for: @shl_nuw_nsw
+; CHECK-NEXT:    %shl = shl nuw nsw i32 %x, %v
+; CHECK-NEXT:    --> ((2 ^ %v) * %x)<nuw><nsw> U: full-set S: full-set
+; CHECK-NEXT:  Determining loop execution counts for: @shl_nuw_nsw
+;
+  %shl = shl nuw nsw i32 %x, %v
+  %c = icmp eq i32 %shl, 0
+  br i1 %c, label %t, label %f
+t:
+  ret void
+f:
+  ret void
+}
+
+; A constant shift amount is still folded to a constant multiply by the
+; pre-existing path, not via a power-of-two expression.
+define void @shl_by_constant(i32 %x) {
+; CHECK-LABEL: 'shl_by_constant'
+; CHECK-NEXT:  Classifying expressions for: @shl_by_constant
+; CHECK-NEXT:    %shl = shl i32 %x, 3
+; CHECK-NEXT:    --> (8 * %x) U: [0,-7) S: [-2147483648,2147483641)
+; CHECK-NEXT:  Determining loop execution counts for: @shl_by_constant
+;
+  %shl = shl i32 %x, 3
+  ret void
+}
+
+; An amount that is not a literal but folds to a constant that is not less than
+; the bit width must stay poison. Refining it to a value here would contradict
+; the range reported for the same expression, which assumes the amount is in
+; range.
+define void @shl_amount_folds_out_of_range(i32 %x) {
+; CHECK-LABEL: 'shl_amount_folds_out_of_range'
+; CHECK-NEXT:  Classifying expressions for: @shl_amount_folds_out_of_range
+; CHECK-NEXT:    %amt = udiv i32 400, 10
+; CHECK-NEXT:    --> 40 U: [40,41) S: [40,41)
+; CHECK-NEXT:    %shl = shl i32 %x, %amt
+; CHECK-NEXT:    --> (poison * %x) U: full-set S: full-set
+; CHECK-NEXT:  Determining loop execution counts for: @shl_amount_folds_out_of_range
+;
+  %amt = udiv i32 400, 10
+  %shl = shl i32 %x, %amt
+  ret void
+}
+
+; The same case reached by substituting the exit value of the amount. The range
+; and the exit value below must not disagree about whether the result is zero.
+define i32 @shl_exit_value_out_of_range() {
+; CHECK-LABEL: 'shl_exit_value_out_of_range'
+; CHECK-NEXT:  Classifying expressions for: @shl_exit_value_out_of_range
+; CHECK-NEXT:    %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
+; CHECK-NEXT:    --> {0,+,1}<nuw><nsw><%loop> U: [0,40) S: [0,40) Exits: 39 LoopDispositions: { %loop: Computable }
+; CHECK-NEXT:    %shl = shl i32 1, %iv
+; CHECK-NEXT:    --> (2 ^ {0,+,1}<nuw><nsw><%loop>) U: [1,-2147483647) S: [1,-2147483647) Exits: poison LoopDispositions: { %loop: Computable }
+; CHECK-NEXT:    %iv.next = add nuw nsw i32 %iv, 1
+; CHECK-NEXT:    --> {1,+,1}<nuw><nsw><%loop> U: [1,41) S: [1,41) Exits: 40 LoopDispositions: { %loop: Computable }
+; CHECK-NEXT:  Determining loop execution counts for: @shl_exit_value_out_of_range
+; CHECK-NEXT:  Loop %loop: backedge-taken count is i32 39
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 39
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i32 39
+; CHECK-NEXT:  Loop %loop: Trip multiple is 40
+;
+entry:
+  br label %loop
+
+loop:
+  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
+  %shl = shl i32 1, %iv
+  %iv.next = add nuw nsw i32 %iv, 1
+  %c = icmp eq i32 %iv.next, 40
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret i32 %shl
+}
diff --git a/llvm/test/Transforms/IndVarSimplify/shl-by-variable-amount.ll b/llvm/test/Transforms/IndVarSimplify/shl-by-variable-amount.ll
new file mode 100644
index 0000000000000..8c0d39e40ec4f
--- /dev/null
+++ b/llvm/test/Transforms/IndVarSimplify/shl-by-variable-amount.ll
@@ -0,0 +1,31 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=indvars -S < %s | FileCheck %s
+
+; The exit value of %shl is (%n * 2^%v). Expanding a power of two that feeds a
+; multiply must recover the single shift the expression was created from,
+; rather than materializing `shl 1, %v` and multiplying by it.
+
+define i32 @exit_value_of_shift(i32 %n, i32 %v) {
+; CHECK-LABEL: define i32 @exit_value_of_shift(
+; CHECK-SAME: i32 [[N:%.*]], i32 [[V:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    br i1 true, label %[[EXIT:.*]], label %[[LOOP]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    [[TMP0:%.*]] = shl i32 [[N]], [[V]]
+; CHECK-NEXT:    ret i32 [[TMP0]]
+;
+entry:
+  br label %loop
+
+loop:
+  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
+  %shl = shl i32 %iv, %v
+  %iv.next = add nuw nsw i32 %iv, 1
+  %c = icmp ugt i32 %iv.next, %n
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret i32 %shl
+}
diff --git a/llvm/test/Transforms/LoopVectorize/induction-step-power-of-two.ll b/llvm/test/Transforms/LoopVectorize/induction-step-power-of-two.ll
new file mode 100644
index 0000000000000..c0ecbb0f4e850
--- /dev/null
+++ b/llvm/test/Transforms/LoopVectorize/induction-step-power-of-two.ll
@@ -0,0 +1,76 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=loop-vectorize -force-vector-width=4 -force-vector-interleave=1 -S < %s | FileCheck %s
+
+; The induction step is (2 * (2 ^ %v)), so widening the induction requires
+; expanding a power of two through VPlan. The step already in the IR is reused
+; rather than rebuilt from `shl 1, %v`.
+
+define void @induction_step_is_power_of_two(ptr %p, i64 %v, i64 %n) {
+; CHECK-LABEL: define void @induction_step_is_power_of_two(
+; CHECK-SAME: ptr [[P:%.*]], i64 [[V:%.*]], i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[STEP:%.*]] = shl i64 2, [[V]]
+; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
+; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
+; CHECK:       [[VECTOR_PH]]:
+; CHECK-NEXT:    [[TMP2:%.*]] = and i64 [[N]], 3
+; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[N]], [[TMP2]]
+; CHECK-NEXT:    [[TMP1:%.*]] = mul i64 [[N_VEC]], [[STEP]]
+; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i64> poison, i64 [[STEP]], i64 0
+; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i64> [[BROADCAST_SPLATINSERT]], <4 x i64> poison, <4 x i32> zeroinitializer
+; CHECK-NEXT:    [[TMP4:%.*]] = mul <4 x i64> <i64 0, i64 1, i64 2, i64 3>, [[BROADCAST_SPLAT]]
+; CHECK-NEXT:    [[TMP5:%.*]] = shl i64 [[STEP]], 2
+; CHECK-NEXT:    [[BROADCAST_SPLATINSERT1:%.*]] = insertelement <4 x i64> poison, i64 [[TMP5]], i64 0
+; CHECK-NEXT:    [[BROADCAST_SPLAT2:%.*]] = shufflevector <4 x i64> [[BROADCAST_SPLATINSERT1]], <4 x i64> poison, <4 x i32> zeroinitializer
+; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
+; CHECK:       [[VECTOR_BODY]]:
+; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
+; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <4 x i64> [ [[TMP4]], %[[VECTOR_PH]] ], [ [[VEC_IND_NEXT:%.*]], %[[VECTOR_BODY]] ]
+; CHECK-NEXT:    [[TMP6:%.*]] = getelementptr inbounds i64, ptr [[P]], i64 [[INDEX]]
+; CHECK-NEXT:    store <4 x i64> [[VEC_IND]], ptr [[TMP6]], align 8
+; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
+; CHECK-NEXT:    [[VEC_IND_NEXT]] = add <4 x i64> [[VEC_IND]], [[BROADCAST_SPLAT2]]
+; CHECK-NEXT:    [[TMP7:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
+; CHECK-NEXT:    br i1 [[TMP7]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
+; CHECK:       [[MIDDLE_BLOCK]]:
+; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
+; CHECK-NEXT:    br i1 [[CMP_N]], label %[[EXIT:.*]], label %[[SCALAR_PH]]
+; CHECK:       [[SCALAR_PH]]:
+; CHECK-NEXT:    [[BC_RESUME_VAL:%.*]] = phi i64 [ [[N_VEC]], %[[MIDDLE_BLOCK]] ], [ 0, %[[ENTRY]] ]
+; CHECK-NEXT:    [[BC_RESUME_VAL3:%.*]] = phi i64 [ [[TMP1]], %[[MIDDLE_BLOCK]] ], [ 0, %[[ENTRY]] ]
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[BC_RESUME_VAL]], %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    [[IDX:%.*]] = phi i64 [ [[BC_RESUME_VAL3]], %[[SCALAR_PH]] ], [ [[IDX_NEXT:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i64, ptr [[P]], i64 [[IV]]
+; CHECK-NEXT:    store i64 [[IDX]], ptr [[GEP]], align 8
+; CHECK-NEXT:    [[IDX_NEXT]] = add i64 [[IDX]], [[STEP]]
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label %[[EXIT]], label %[[LOOP]], !llvm.loop [[LOOP3:![0-9]+]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %step = shl i64 2, %v
+  br label %loop
+
+loop:
+  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
+  %idx = phi i64 [ 0, %entry ], [ %idx.next, %loop ]
+  %gep = getelementptr inbounds i64, ptr %p, i64 %iv
+  store i64 %idx, ptr %gep, align 8
+  %idx.next = add i64 %idx, %step
+  %iv.next = add nuw nsw i64 %iv, 1
+  %c = icmp eq i64 %iv.next, %n
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret void
+}
+;.
+; CHECK: [[LOOP0]] = distinct !{[[LOOP0]], [[META1:![0-9]+]], [[META2:![0-9]+]]}
+; CHECK: [[META1]] = !{!"llvm.loop.isvectorized", i32 1}
+; CHECK: [[META2]] = !{!"llvm.loop.unroll.runtime.disable"}
+; CHECK: [[LOOP3]] = distinct !{[[LOOP3]], [[META2]], [[META1]]}
+;.
diff --git a/llvm/test/Transforms/LoopVectorize/reuse-shift-by-variable-amount.ll b/llvm/test/Transforms/LoopVectorize/reuse-shift-by-variable-amount.ll
new file mode 100644
index 0000000000000..99cd07ece447c
--- /dev/null
+++ b/llvm/test/Transforms/LoopVectorize/reuse-shift-by-variable-amount.ll
@@ -0,0 +1,163 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=loop-vectorize -force-vector-width=4 -force-vector-interleave=1 -S < %s | FileCheck %s
+
+; A shift by a variable amount may be reused for an expression that models it
+; as a multiply by a power of two, because expanding that model emits a shift
+; by the same amount. It may not be reused once the shift has cancelled out of
+; the expression, since what remains expands to something that is not poison.
+;
+; %x and %v are noundef in both tests so that the shift is the only possible
+; source of poison. Without that the poison walk stops at %x, a possibly-poison
+; value absent from the expression, and never judges the shift at all, which
+; would leave these passing while testing nothing.
+
+; %t is ((%x << %v) + %a1 + %a2) - (%x << %v), so its SCEV is (%a1 + %a2) and no
+; power of two survives. %t is the only value with that SCEV, so expanding the
+; induction step tries to reuse it, and must be refused: %t is poison for a
+; large %v where (%a1 + %a2) is not.
+define void @step_where_shift_cancels(ptr %p, i64 noundef %x, i64 noundef %v, i64 %a1, i64 %a2, i64 %n) {
+; CHECK-LABEL: define void @step_where_shift_cancels(
+; CHECK-SAME: ptr [[P:%.*]], i64 noundef [[X:%.*]], i64 noundef [[V:%.*]], i64 [[A1:%.*]], i64 [[A2:%.*]], i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[S:%.*]] = shl i64 [[X]], [[V]]
+; CHECK-NEXT:    [[P1:%.*]] = add i64 [[S]], [[A1]]
+; CHECK-NEXT:    [[P2:%.*]] = add i64 [[P1]], [[A2]]
+; CHECK-NEXT:    [[T:%.*]] = sub i64 [[P2]], [[S]]
+; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[A2]], [[A1]]
+; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
+; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
+; CHECK:       [[VECTOR_PH]]:
+; CHECK-NEXT:    [[TMP1:%.*]] = and i64 [[N]], 3
+; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[N]], [[TMP1]]
+; CHECK-NEXT:    [[TMP2:%.*]] = mul i64 [[N_VEC]], [[TMP0]]
+; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i64> poison, i64 [[TMP0]], i64 0
+; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i64> [[BROADCAST_SPLATINSERT]], <4 x i64> poison, <4 x i32> zeroinitializer
+; CHECK-NEXT:    [[TMP3:%.*]] = mul <4 x i64> <i64 0, i64 1, i64 2, i64 3>, [[BROADCAST_SPLAT]]
+; CHECK-NEXT:    [[TMP4:%.*]] = shl i64 [[TMP0]], 2
+; CHECK-NEXT:    [[BROADCAST_SPLATINSERT1:%.*]] = insertelement <4 x i64> poison, i64 [[TMP4]], i64 0
+; CHECK-NEXT:    [[BROADCAST_SPLAT2:%.*]] = shufflevector <4 x i64> [[BROADCAST_SPLATINSERT1]], <4 x i64> poison, <4 x i32> zeroinitializer
+; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
+; CHECK:       [[VECTOR_BODY]]:
+; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
+; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <4 x i64> [ [[TMP3]], %[[VECTOR_PH]] ], [ [[VEC_IND_NEXT:%.*]], %[[VECTOR_BODY]] ]
+; CHECK-NEXT:    [[TMP5:%.*]] = getelementptr inbounds i64, ptr [[P]], i64 [[INDEX]]
+; CHECK-NEXT:    store <4 x i64> [[VEC_IND]], ptr [[TMP5]], align 8
+; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
+; CHECK-NEXT:    [[VEC_IND_NEXT]] = add <4 x i64> [[VEC_IND]], [[BROADCAST_SPLAT2]]
+; CHECK-NEXT:    [[TMP6:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
+; CHECK-NEXT:    br i1 [[TMP6]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
+; CHECK:       [[MIDDLE_BLOCK]]:
+; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
+; CHECK-NEXT:    br i1 [[CMP_N]], label %[[EXIT:.*]], label %[[SCALAR_PH]]
+; CHECK:       [[SCALAR_PH]]:
+; CHECK-NEXT:    [[BC_RESUME_VAL:%.*]] = phi i64 [ [[N_VEC]], %[[MIDDLE_BLOCK]] ], [ 0, %[[ENTRY]] ]
+; CHECK-NEXT:    [[BC_RESUME_VAL3:%.*]] = phi i64 [ [[TMP2]], %[[MIDDLE_BLOCK]] ], [ 0, %[[ENTRY]] ]
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[BC_RESUME_VAL]], %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    [[IDX:%.*]] = phi i64 [ [[BC_RESUME_VAL3]], %[[SCALAR_PH]] ], [ [[IDX_NEXT:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i64, ptr [[P]], i64 [[IV]]
+; CHECK-NEXT:    store i64 [[IDX]], ptr [[GEP]], align 8
+; CHECK-NEXT:    [[IDX_NEXT]] = add i64 [[IDX]], [[T]]
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label %[[EXIT]], label %[[LOOP]], !llvm.loop [[LOOP3:![0-9]+]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %s = shl i64 %x, %v
+  %p1 = add i64 %s, %a1
+  %p2 = add i64 %p1, %a2
+  %t = sub i64 %p2, %s
+  br label %loop
+
+loop:
+  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
+  %idx = phi i64 [ 0, %entry ], [ %idx.next, %loop ]
+  %gep = getelementptr inbounds i64, ptr %p, i64 %iv
+  store i64 %idx, ptr %gep, align 8
+  %idx.next = add i64 %idx, %t
+  %iv.next = add nuw nsw i64 %iv, 1
+  %c = icmp eq i64 %iv.next, %n
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret void
+}
+
+; The shift survives into the SCEV of %t, so the power of two is present and %t
+; is reused as the step.
+define void @step_where_shift_survives(ptr %p, i64 noundef %x, i64 noundef %v, i64 %a1, i64 %n) {
+; CHECK-LABEL: define void @step_where_shift_survives(
+; CHECK-SAME: ptr [[P:%.*]], i64 noundef [[X:%.*]], i64 noundef [[V:%.*]], i64 [[A1:%.*]], i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[S:%.*]] = shl i64 [[X]], [[V]]
+; CHECK-NEXT:    [[T:%.*]] = add i64 [[S]], [[A1]]
+; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
+; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
+; CHECK:       [[VECTOR_PH]]:
+; CHECK-NEXT:    [[TMP0:%.*]] = and i64 [[N]], 3
+; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[N]], [[TMP0]]
+; CHECK-NEXT:    [[TMP1:%.*]] = mul i64 [[N_VEC]], [[T]]
+; CHECK-NEXT:    [[BROADCAST_SPLATINSERT:%.*]] = insertelement <4 x i64> poison, i64 [[T]], i64 0
+; CHECK-NEXT:    [[BROADCAST_SPLAT:%.*]] = shufflevector <4 x i64> [[BROADCAST_SPLATINSERT]], <4 x i64> poison, <4 x i32> zeroinitializer
+; CHECK-NEXT:    [[TMP2:%.*]] = mul <4 x i64> <i64 0, i64 1, i64 2, i64 3>, [[BROADCAST_SPLAT]]
+; CHECK-NEXT:    [[TMP3:%.*]] = shl i64 [[T]], 2
+; CHECK-NEXT:    [[BROADCAST_SPLATINSERT1:%.*]] = insertelement <4 x i64> poison, i64 [[TMP3]], i64 0
+; CHECK-NEXT:    [[BROADCAST_SPLAT2:%.*]] = shufflevector <4 x i64> [[BROADCAST_SPLATINSERT1]], <4 x i64> poison, <4 x i32> zeroinitializer
+; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
+; CHECK:       [[VECTOR_BODY]]:
+; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
+; CHECK-NEXT:    [[VEC_IND:%.*]] = phi <4 x i64> [ [[TMP2]], %[[VECTOR_PH]] ], [ [[VEC_IND_NEXT:%.*]], %[[VECTOR_BODY]] ]
+; CHECK-NEXT:    [[TMP4:%.*]] = getelementptr inbounds i64, ptr [[P]], i64 [[INDEX]]
+; CHECK-NEXT:    store <4 x i64> [[VEC_IND]], ptr [[TMP4]], align 8
+; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
+; CHECK-NEXT:    [[VEC_IND_NEXT]] = add <4 x i64> [[VEC_IND]], [[BROADCAST_SPLAT2]]
+; CHECK-NEXT:    [[TMP5:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
+; CHECK-NEXT:    br i1 [[TMP5]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP4:![0-9]+]]
+; CHECK:       [[MIDDLE_BLOCK]]:
+; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
+; CHECK-NEXT:    br i1 [[CMP_N]], label %[[EXIT:.*]], label %[[SCALAR_PH]]
+; CHECK:       [[SCALAR_PH]]:
+; CHECK-NEXT:    [[BC_RESUME_VAL:%.*]] = phi i64 [ [[N_VEC]], %[[MIDDLE_BLOCK]] ], [ 0, %[[ENTRY]] ]
+; CHECK-NEXT:    [[BC_RESUME_VAL3:%.*]] = phi i64 [ [[TMP1]], %[[MIDDLE_BLOCK]] ], [ 0, %[[ENTRY]] ]
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[BC_RESUME_VAL]], %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    [[IDX:%.*]] = phi i64 [ [[BC_RESUME_VAL3]], %[[SCALAR_PH]] ], [ [[IDX_NEXT:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i64, ptr [[P]], i64 [[IV]]
+; CHECK-NEXT:    store i64 [[IDX]], ptr [[GEP]], align 8
+; CHECK-NEXT:    [[IDX_NEXT]] = add i64 [[IDX]], [[T]]
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label %[[EXIT]], label %[[LOOP]], !llvm.loop [[LOOP5:![0-9]+]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %s = shl i64 %x, %v
+  %t = add i64 %s, %a1
+  br label %loop
+
+loop:
+  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
+  %idx = phi i64 [ 0, %entry ], [ %idx.next, %loop ]
+  %gep = getelementptr inbounds i64, ptr %p, i64 %iv
+  store i64 %idx, ptr %gep, align 8
+  %idx.next = add i64 %idx, %t
+  %iv.next = add nuw nsw i64 %iv, 1
+  %c = icmp eq i64 %iv.next, %n
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret void
+}
+;.
+; CHECK: [[LOOP0]] = distinct !{[[LOOP0]], [[META1:![0-9]+]], [[META2:![0-9]+]]}
+; CHECK: [[META1]] = !{!"llvm.loop.isvectorized", i32 1}
+; CHECK: [[META2]] = !{!"llvm.loop.unroll.runtime.disable"}
+; CHECK: [[LOOP3]] = distinct !{[[LOOP3]], [[META2]], [[META1]]}
+; CHECK: [[LOOP4]] = distinct !{[[LOOP4]], [[META1]], [[META2]]}
+; CHECK: [[LOOP5]] = distinct !{[[LOOP5]], [[META2]], [[META1]]}
+;.
