+; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes='print<access-info>' -disable-output %s 2>&1 | FileCheck %s
+
+; Induction detection for PHIs with casts adds a no-wrap predicate for the
+; narrow AddRec {trunc(Start),+,trunc(Step)}, plus Equal predicates for Start
+; and Step if needed. Under those, the wide AddRec of the PHI is
+; {ext(trunc(Start)),+,sext(trunc(Step))}, which evaluates to ext of the narrow
+; AddRec, so the narrow predicate implies the same predicate for the wide one.
+
+; The step of the i32 IV is added to zext(trunc %iv.1 to i8), and the step is
+; an i8 value sign-extended to i32.
+define void @narrow_nusw_implies_wide_zext_nusw(ptr %src, ptr %dst, i8 %s, i64 %n) {
+; CHECK-LABEL: 'narrow_nusw_implies_wide_zext_nusw'
+; CHECK-NEXT:    loop:
+; CHECK-NEXT:      Memory dependences are safe with run-time checks
+; CHECK-NEXT:      Dependences:
+; CHECK-NEXT:      Run-time memory checks:
+; CHECK-NEXT:      Check 0:
+; CHECK-NEXT:        Comparing group GRP0:
+; CHECK-NEXT:          %gep.dst = getelementptr float, ptr %dst, i64 %iv.0
+; CHECK-NEXT:        Against group GRP1:
+; CHECK-NEXT:          %gep.src = getelementptr float, ptr %src, i64 %iv.ext
+; CHECK-NEXT:      Grouped accesses:
+; CHECK-NEXT:        Group GRP0:
+; CHECK-NEXT:          (Low: %dst High: ((4 * %n) + %dst))
+; CHECK-NEXT:            Member: {%dst,+,4}<%loop>
+; CHECK-NEXT:        Group GRP1:
+; CHECK-NEXT:          (Low: (((4 * (sext i8 %s to i64) * (-1 + %n)) + %src) umin %src) High: (4 + (((4 * (sext i8 %s to i64) * (-1 + %n)) + %src) umax %src)))
+; CHECK-NEXT:            Member: {%src,+,(4 * (sext i8 %s to i64))<nsw>}<%loop>
+; CHECK-EMPTY:
+; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
+; CHECK-NEXT:      SCEV assumptions:
+; CHECK-NEXT:      {0,+,%s}<%loop> Added Flags: <nusw>
+; CHECK-NEXT:      {%src,+,(4 * (sext i8 %s to i64))<nsw>}<%loop> Added Flags: <nusw>
+; CHECK-EMPTY:
+; CHECK-NEXT:      Expressions re-written:
+; CHECK-NEXT:      [PSE] %gep.src = getelementptr float, ptr %src, i64 %iv.ext:
+; CHECK-NEXT:        ((4 * (zext i32 %iv.1 to i64))<nuw><nsw> + %src)
+; CHECK-NEXT:        --> {%src,+,(4 * (sext i8 %s to i64))<nsw>}<%loop>
+;
+entry:
+  %step = sext i8 %s to i32
+  br label %loop
+
+loop:
+  %iv.0 = phi i64 [ 0, %entry ], [ %iv.0.next, %loop ]
+  %iv.1 = phi i32 [ 0, %entry ], [ %iv.1.next, %loop ]
+  %iv.ext = zext i32 %iv.1 to i64
+  %gep.src = getelementptr float, ptr %src, i64 %iv.ext
+  %l = load float, ptr %gep.src, align 4
+  %gep.dst = getelementptr float, ptr %dst, i64 %iv.0
+  store float %l, ptr %gep.dst, align 4
+  %iv.1.and = and i32 %iv.1, 255
+  %iv.1.next = add i32 %iv.1.and, %step
+  %iv.0.next = add i64 %iv.0, 1
+  %ec = icmp eq i64 %iv.0.next, %n
+  br i1 %ec, label %exit, label %loop
+
+exit:
+  ret void
+}
