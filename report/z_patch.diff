+bool llvm::isLoopNestFinite(Loop *L, ScalarEvolution &SE, const LoopInfo &LI) {
+  // Unlike isFinite(), which only consults willreturn, a loop counts as finite
+  // here if it is either finite by assumption or has a bounded trip count.
+  //
+  // "Finite by assumption" means willreturn, or mustprogress with no side
+  // effects in SCEV's sense.
+  //
+  // The result only guarantees that no cycle takes its backedge forever; an
+  // instruction inside an iteration may still never return. Per LangRef, a
+  // mustprogress caller that calls a non-mustprogress function which never
+  // returns is well-defined, and SCEV's side-effect check does not reject
+  // such calls (e.g. a readnone call that is not willreturn).
+  //
+  // If L is finite by assumption, so is every cycle inside it. SCEV's
+  // side-effect scan covers every block of L, sub-loops included. So if a
+  // sub-loop or irreducible cycle spun forever, L would never terminate while
+  // having no side effects, which violates L's forward-progress guarantee and
+  // is UB.
+  if (SE.loopIsFiniteByAssumption(L))
+    return true;
+
+  // Otherwise finiteness has to be proven structurally, and an irreducible
+  // cycle has no Loop to hang a proof or an assumption on.
+  LoopBlocksRPO RPOT(L);
+  RPOT.perform(&LI);
+  if (containsIrreducibleCFG<const BasicBlock *>(RPOT, LI))
+    return false;
+
+  // Each loop in the nest is either assumed finite, which covers its sub-loops
+  // as above, or needs a computable constant max backedge-taken count.
+  if (isa<SCEVCouldNotCompute>(SE.getConstantMaxBackedgeTakenCount(L)))
+    return false;
+  SmallVector<Loop *, 8> WorkList(L->begin(), L->end());
+  while (!WorkList.empty()) {
+    Loop *Current = WorkList.pop_back_val();
+    if (SE.loopIsFiniteByAssumption(Current))
+      continue;
+    if (isa<SCEVCouldNotCompute>(SE.getConstantMaxBackedgeTakenCount(Current)))
+      return false;
+    WorkList.append(Current->begin(), Current->end());
+  }
+
+  return true;
+}
+
 static const char *LLVMLoopMustProgress = "llvm.loop.mustprogress";
 
