diff --git a/llvm/test/Analysis/ScalarEvolution/trip-count-switch-default-guard.ll b/llvm/test/Analysis/ScalarEvolution/trip-count-switch-default-guard.ll
new file mode 100644
index 0000000000000..520ccd1cfd165
--- /dev/null
+++ b/llvm/test/Analysis/ScalarEvolution/trip-count-switch-default-guard.ll
@@ -0,0 +1,102 @@
+; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -disable-output "-passes=print<scalar-evolution>" -scalar-evolution-classify-expressions=0 < %s 2>&1 | FileCheck %s
+
+; The switch default edge implies %n != 0, so the exit count is %n - 1.
+define void @switch_default_ne_zero(i8 %n) {
+; CHECK-LABEL: 'switch_default_ne_zero'
+; CHECK-NEXT:  Determining loop execution counts for: @switch_default_ne_zero
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + %n)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 -2
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + %n)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  switch i8 %n, label %loop [
+    i8 0, label %exit
+  ]
+
+loop:
+  %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop ]
+  %iv.next = add i8 %iv, 1
+  %c = icmp ult i8 %iv.next, %n
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; %n == 0 also reaches the loop through a case edge.
+define void @switch_case_to_loop(i8 %n) {
+; CHECK-LABEL: 'switch_case_to_loop'
+; CHECK-NEXT:  Determining loop execution counts for: @switch_case_to_loop
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (1 umax %n))
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 -2
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (1 umax %n))
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  switch i8 %n, label %loop [
+    i8 0, label %loop
+    i8 1, label %exit
+  ]
+
+loop:
+  %iv = phi i8 [ 0, %entry ], [ 0, %entry ], [ %iv.next, %loop ]
+  %iv.next = add i8 %iv, 1
+  %c = icmp ult i8 %iv.next, %n
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+define void @switch_five_cases_default_ne_zero(i8 %n) {
+; CHECK-LABEL: 'switch_five_cases_default_ne_zero'
+; CHECK-NEXT:  Determining loop execution counts for: @switch_five_cases_default_ne_zero
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (1 umax %n))
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 -2
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (1 umax %n))
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  switch i8 %n, label %loop [
+    i8 0, label %exit
+    i8 1, label %exit
+    i8 2, label %exit
+    i8 3, label %exit
+    i8 4, label %exit
+  ]
+
+loop:
+  %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop ]
+  %iv.next = add i8 %iv, 1
+  %c = icmp ult i8 %iv.next, %n
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+define void @switch_on_wider_value(i16 %w) {
+; CHECK-LABEL: 'switch_on_wider_value'
+; CHECK-NEXT:  Determining loop execution counts for: @switch_on_wider_value
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (1 umax (trunc i16 %w to i8)))
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 -2
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (1 umax (trunc i16 %w to i8)))
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %n = trunc i16 %w to i8
+  switch i16 %w, label %loop [
+    i16 0, label %exit
+  ]
+
+loop:
+  %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop ]
+  %iv.next = add i8 %iv, 1
+  %c = icmp ult i8 %iv.next, %n
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
