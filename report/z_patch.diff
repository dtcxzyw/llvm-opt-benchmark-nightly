-void State::addInfoForInductions(BasicBlock &BB) {
+/// Splits the induction phi \p PN into the start value, coming from the loop
+/// predecessor \p LoopPred, and the step value, coming from inside the loop.
+/// Returns {nullptr, nullptr} if \p PN has other incoming values.
+static std::pair<Value *, Value *> getStartAndStep(const PHINode &PN,
+                                                   const BasicBlock *LoopPred) {
+  assert(PN.getBasicBlockIndex(LoopPred) >= 0 &&
+         "LoopPred must be a predecessor of the phi's block");
+  if (PN.getNumIncomingValues() != 2)
+    return {nullptr, nullptr};
+  unsigned StartIdx = PN.getIncomingBlock(0) == LoopPred ? 0 : 1;
+  return {PN.getIncomingValue(StartIdx), PN.getIncomingValue(1 - StartIdx)};
+}
+
+/// Returns the senses, {unsigned, signed}, in which stepping the induction phi
+/// \p PN to \p Step cannot decrease it, based on the no-wrap flags of the step.
+static std::pair<bool, bool>
+getNonDecreasingInfoFromFlags(const PHINode &PN, const Value *Step) {
+  // PN + C with C >= 0: the no-wrap flags of the add carry over.
+  const APInt *Offset;
+  if (!match(Step, m_c_Add(m_Specific(&PN), m_APInt(Offset))) ||
+      Offset->isNegative())
+    return {false, false};
+  const auto *Add = cast<OverflowingBinaryOperator>(Step);
+  return {Add->hasNoUnsignedWrap(), Add->hasNoSignedWrap()};
+}
+
+void State::addStartLowerBound(DomTreeNode *DTN, PHINode &PN, Value *Start,
+                               bool Unsigned, bool Signed) {
+  // Every variable in the unsigned system already has a `V >= 0` row, so a zero
+  // start value would just duplicate it.
+  if (match(Start, m_Zero()))
+    Unsigned = false;
+  if (!Unsigned && !Signed)
+    return;
+
+  // A bound holding in both senses becomes a single samesign fact, which enters
+  // both systems directly, instead of two facts that each re-derive the other
+  // one via the signed <-> unsigned transfer.
+  CmpPredicate Pred(Unsigned ? CmpInst::ICMP_UGE : CmpInst::ICMP_SGE,
+                    /*HasSameSign=*/Unsigned && Signed);
+  WorkList.push_back(FactOrCheck::getConditionFact(DTN, Pred, &PN, Start));
+}
+
+void State::addLowerBoundsForHeaderInductions(BasicBlock &BB) {
+  Loop *L = LI.getLoopFor(&BB);
+  if (!L || L->getHeader() != &BB)
+    return;
+  BasicBlock *LoopPred = L->getLoopPredecessor();
+  if (!LoopPred)
+    return;
+
+  DomTreeNode *DTN = DT.getNode(&BB);
+  for (PHINode &PN : BB.phis()) {
+    auto [Start, Step] = getStartAndStep(PN, LoopPred);
+    if (!Start)
+      continue;
+    auto [Unsigned, Signed] = getNonDecreasingInfoFromFlags(PN, Step);
+    addStartLowerBound(DTN, PN, Start, Unsigned, Signed);
+  }
+}
