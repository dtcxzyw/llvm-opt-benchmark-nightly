diff --git a/llvm/lib/Analysis/LazyValueInfo.cpp b/llvm/lib/Analysis/LazyValueInfo.cpp
index a62d195036258..9adbda858c577 100644
--- a/llvm/lib/Analysis/LazyValueInfo.cpp
+++ b/llvm/lib/Analysis/LazyValueInfo.cpp
@@ -1167,18 +1167,24 @@ std::optional<ValueLatticeElement>
 LazyValueInfoImpl::solveBlockValueBinaryOp(BinaryOperator *BO, BasicBlock *BB) {
   assert(BO->getOperand(0)->getType()->isSized() &&
          "all operands to binary operators are sized");
+
+  Instruction::BinaryOps Opcode = BO->getOpcode();
+  unsigned NoWrapKind = OverflowingBinaryOperator::AnyWrap;
   if (auto *OBO = dyn_cast<OverflowingBinaryOperator>(BO)) {
-    unsigned NoWrapKind = OBO->getNoWrapKind();
-    return solveBlockValueBinaryOpImpl(
-        BO, BB,
-        [BO, NoWrapKind](const ConstantRange &CR1, const ConstantRange &CR2) {
-          return CR1.overflowingBinaryOp(BO->getOpcode(), CR2, NoWrapKind);
-        });
+    NoWrapKind = OBO->getNoWrapKind();
+  } else if (match(BO, m_DisjointOr(m_Value(), m_Value()))) {
+    // A disjoint or carries no bits between its operands, so it is an add that
+    // neither signed nor unsigned wraps. That is far more precise than
+    // binaryOr()'s bit-wise approximation.
+    Opcode = Instruction::Add;
+    NoWrapKind = OverflowingBinaryOperator::NoSignedWrap |
+                 OverflowingBinaryOperator::NoUnsignedWrap;
   }
 
   return solveBlockValueBinaryOpImpl(
-      BO, BB, [BO](const ConstantRange &CR1, const ConstantRange &CR2) {
-        return CR1.binaryOp(BO->getOpcode(), CR2);
+      BO, BB,
+      [Opcode, NoWrapKind](const ConstantRange &CR1, const ConstantRange &CR2) {
+        return CR1.overflowingBinaryOp(Opcode, CR2, NoWrapKind);
       });
 }
 
diff --git a/llvm/test/Transforms/CorrelatedValuePropagation/or-disjoint.ll b/llvm/test/Transforms/CorrelatedValuePropagation/or-disjoint.ll
new file mode 100644
index 0000000000000..96480b7dc5163
--- /dev/null
+++ b/llvm/test/Transforms/CorrelatedValuePropagation/or-disjoint.ll
@@ -0,0 +1,86 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt < %s -passes=correlated-propagation -S | FileCheck %s
+
+declare void @use(i64)
+
+; A disjoint or cannot carry, so it is an add nuw nsw. With %x in [17, 2^31),
+; %o is in [-2305843009213693935, -2305843009213693921], so the compare is
+; known false. Without the disjoint fact the bit-wise range of the or is far
+; too coarse to tell.
+define i1 @or_disjoint_range(i32 %x) {
+; CHECK-LABEL: @or_disjoint_range(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[X:%.*]], 16
+; CHECK-NEXT:    br i1 [[C]], label [[BB:%.*]], label [[EXIT:%.*]]
+; CHECK:       bb:
+; CHECK-NEXT:    [[Z:%.*]] = zext nneg i32 [[X]] to i64
+; CHECK-NEXT:    [[O:%.*]] = or disjoint i64 [[Z]], -2305843009213693952
+; CHECK-NEXT:    call void @use(i64 [[O]])
+; CHECK-NEXT:    ret i1 false
+; CHECK:       exit:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %c = icmp ugt i32 %x, 16
+  br i1 %c, label %bb, label %exit
+
+bb:
+  %z = zext nneg i32 %x to i64
+  %o = or disjoint i64 %z, -2305843009213693952
+  call void @use(i64 %o)
+  %cmp = icmp samesign ult i64 %o, -2305843009213693936
+  ret i1 %cmp
+
+exit:
+  ret i1 false
+}
+
+; Negative test: without disjoint the or may carry, so the range is unknown and
+; the compare must stay.
+define i1 @or_not_disjoint(i32 %x) {
+; CHECK-LABEL: @or_not_disjoint(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[X:%.*]], 16
+; CHECK-NEXT:    br i1 [[C]], label [[BB:%.*]], label [[EXIT:%.*]]
+; CHECK:       bb:
+; CHECK-NEXT:    [[Z:%.*]] = zext nneg i32 [[X]] to i64
+; CHECK-NEXT:    [[O:%.*]] = or i64 [[Z]], -2305843009213693952
+; CHECK-NEXT:    call void @use(i64 [[O]])
+; CHECK-NEXT:    [[CMP:%.*]] = icmp samesign ult i64 [[O]], -2305843009213693936
+; CHECK-NEXT:    ret i1 [[CMP]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %c = icmp ugt i32 %x, 16
+  br i1 %c, label %bb, label %exit
+
+bb:
+  %z = zext nneg i32 %x to i64
+  %o = or i64 %z, -2305843009213693952
+  call void @use(i64 %o)
+  %cmp = icmp samesign ult i64 %o, -2305843009213693936
+  ret i1 %cmp
+
+exit:
+  ret i1 false
+}
+
+; The disjoint range is also usable for small positive constants.
+define i1 @or_disjoint_small(i8 %x) {
+; CHECK-LABEL: @or_disjoint_small(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[A:%.*]] = and i8 [[X:%.*]], 3
+; CHECK-NEXT:    [[O:%.*]] = or disjoint i8 [[A]], 8
+; CHECK-NEXT:    call void @use8(i8 [[O]])
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %a = and i8 %x, 3
+  %o = or disjoint i8 %a, 8
+  call void @use8(i8 %o)
+  %cmp = icmp ugt i8 %o, 11
+  ret i1 %cmp
+}
+
+declare void @use8(i8)
