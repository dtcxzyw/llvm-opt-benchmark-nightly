+; A bitwise consumer can combine better with the original shift.
+define i16 @bitwise_consumer_i16(i1 noundef %c, i32 noundef %v, i16 %d, i16 %e, ptr %out, ptr %out2) optsize "target-cpu"="x86-64-v4" {
+; CHECK-LABEL: define range(i16 0, 4096) i16 @bitwise_consumer_i16(
+; CHECK-SAME: i1 noundef [[C:%.*]], i32 noundef [[V:%.*]], i16 [[D:%.*]], i16 [[E:%.*]], ptr [[OUT:%.*]], ptr [[OUT2:%.*]]) #[[ATTR1]] {
