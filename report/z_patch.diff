       MadeChange |= foldPatternedLoads(I, DL);
       MadeChange |= foldICmpOrChain(I, DL, TTI, AA, DT);
       MadeChange |= foldMulHigh(I);
+      MadeChange |=
+          foldMemSetZeroOrOneLength(I, DL, TLI, AC, DT, MadeCFGChange);
