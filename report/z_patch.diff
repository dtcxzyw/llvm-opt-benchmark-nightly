diff --git a/llvm/lib/Analysis/KnownBitsAnalysis.cpp b/llvm/lib/Analysis/KnownBitsAnalysis.cpp
new file mode 100644
index 00000000000000..b7d1c8514ba67e
--- /dev/null
+++ b/llvm/lib/Analysis/KnownBitsAnalysis.cpp
@@ -0,0 +1,218 @@
+//===- KnownBitsAnalysis.cpp - Cache and invalidate KnownBits -------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "llvm/Analysis/KnownBitsAnalysis.h"
+#include "llvm/ADT/DepthFirstIterator.h"
+#include "llvm/ADT/GraphTraits.h"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/ADT/SetVector.h"
+#include "llvm/ADT/Statistic.h"
+#include "llvm/Analysis/SimplifyQuery.h"
+#include "llvm/IR/DataLayout.h"
+#include "llvm/IR/Function.h"
+#include "llvm/Support/Debug.h"
+#include "llvm/Support/KnownBits.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "known-bits-dataflow"
+
+STATISTIC(KnownBitsCacheHits, "Number of hits in the KnownBits Cache");
+
+namespace llvm {
+template <typename NodeRef, typename ChildIteratorType>
+struct NodeGraphTraitsBase {
+  static NodeRef getEntryNode(NodeRef N) { return N; }
+  static ChildIteratorType child_begin(NodeRef N) { // NOLINT
+    return N->user_begin();
+  }
+  static ChildIteratorType child_end(NodeRef N) { // NOLINT
+    return N->user_end();
+  }
+};
+
+template <>
+struct GraphTraits<const Value *>
+    : public NodeGraphTraitsBase<const Value *, Value::const_user_iterator> {
+  using NodeRef = const Value *;
+  using ChildIteratorType = Value::const_user_iterator;
+};
+} // namespace llvm
+
+SQCompatibility::SQCompatibility(const SimplifyQuery &SQ)
+    : CxtI(const_cast<Instruction *>(SQ.CxtI)),
+      UseInstrInfo(SQ.IIQ.UseInstrInfo) {}
+
+bool SQCompatibility::isRefinementOf(const SQCompatibility &Other) const {
+  return (!CxtI || CxtI == Other.CxtI) &&
+         (!UseInstrInfo || UseInstrInfo == Other.UseInstrInfo);
+}
+
+void KnownBitsVH::deleted() {
+  // erase calls the destructor of the ValueHandle, and putting setValPtr after
+  // it would assert. Carefully erase underlying nullptr Value pointers after
+  // setting it.
+  setValPtr(nullptr);
+  KBD->cleanup();
+}
+
+void KnownBitsVH::allUsesReplacedWith(Value *New) {
+  KBD->invalidate(*this);
+  setValPtr(New);
+}
+
+/// We represent uninitialized KnownBits as an all-conflict value. This is
+/// different from a KnownBits that is computed as as an unknown value.
+static KnownBits getAllConflict(unsigned BitWidth) {
+  KnownBits Ret(BitWidth);
+  Ret.setAllConflict();
+  return Ret;
+}
+
+static bool isAllConflict(const KnownBits &Known) {
+  return Known.Zero.isAllOnes() && Known.One.isAllOnes();
+}
+
+KnownBitsVH KnownBitsDataflow::getVH(const Value *V) const {
+  auto It = find_as(V);
+  assert(It != end() && "Expected to find ValueHandle");
+  return It->first;
+}
+
+KnownBitsVH KnownBitsDataflow::getOrCreateVH(const Value *V) const {
+  auto It = find_as(V);
+  if (It != end())
+    return It->first;
+  return {V, this};
+}
+
+/// A wrapper around make_filter_range, that filters \p R on scalar types that
+/// are either integer or pointer type, as these are the only types handled by
+/// computeKnownBits.
+template <typename RangeT>
+static auto make_knownbits_range(RangeT &&R) { // NOLINT
+  return make_filter_range(R, [](const auto &V) {
+    return V->getType()->getScalarType()->isIntOrPtrTy();
+  });
+}
+
+SmallVector<KnownBitsVH>
+KnownBitsDataflow::forwardDataflow(ArrayRef<KnownBitsVH> R, bool Create) const {
+  SetVector<KnownBitsVH> Collected;
+  for (const auto &V : R)
+    for (const Value *N : make_knownbits_range(depth_first(V.getValue())))
+      if (!Create && contains(N))
+        Collected.insert(getVH(N));
+      else if (Create)
+        Collected.insert(getOrCreateVH(N));
+  return Collected.takeVector();
+}
+
+void KnownBitsDataflow::invalidate(const KnownBitsVH &V) {
+  for (const KnownBitsVH &N : forwardDataflow(V))
+    at(N).setAllConflict();
+}
+
+void KnownBitsDataflow::insert_range(ArrayRef<KnownBitsVH> R) {
+  for (const KnownBitsVH &V : make_knownbits_range(R))
+    insert(V, getAllConflict(getBitWidth(V->getType(), getDataLayout())));
+}
+
+SmallVector<KnownBitsVH> KnownBitsDataflow::computeRoots(bool Create) const {
+  SmallVector<KnownBitsVH> Roots;
+
+  // First, collect function arguments.
+  for (const Value *V : make_knownbits_range(make_pointer_range(F.args())))
+    if (!Create && contains(V))
+      Roots.push_back(getVH(V));
+    else if (Create)
+      Roots.push_back(getOrCreateVH(V));
+
+  // A helper to find out whether a Value is reachable from Roots that computes
+  // the reachability information just in time, as Roots are updated.
+  auto IsReachableFromRoots = [&](const Value *V) {
+    for (const auto &R : Roots)
+      for (const Value *N : make_knownbits_range(depth_first(R.getValue())))
+        if (N == V)
+          return true;
+    return false;
+  };
+
+  // Now collect all Instructions that aren't reachable from the function's
+  // arguments, updating Roots, as we test for unreachability.
+  for (const BasicBlock &BB : F)
+    for (const Value *V : make_knownbits_range(make_pointer_range(BB)))
+      if (!IsReachableFromRoots(V)) {
+        if (!Create && contains(V))
+          Roots.push_back(getVH(V));
+        else if (Create)
+          Roots.push_back(getOrCreateVH(V));
+      }
+
+  return Roots;
+}
+
+bool KnownBitsDataflow::isLeaf(const KnownBitsVH &V) const {
+  return make_knownbits_range(V->users()).empty();
+}
+
+void KnownBitsDataflow::print(raw_ostream &OS) const {
+  auto Roots = computeRoots();
+  for (const KnownBitsVH &V : forwardDataflow(Roots)) {
+    if (is_contained(Roots, V))
+      OS << "^ ";
+    else if (isLeaf(V))
+      OS << "$ ";
+    else
+      OS << "  ";
+    V->print(OS);
+    OS << " | ";
+    at(V).print(OS);
+    OS << "\n";
+  }
+}
+
+#if !defined(NDEBUG) || defined(LLVM_ENABLE_DUMP)
+LLVM_DUMP_METHOD void KnownBitsDataflow::dump() const { print(dbgs()); }
+#endif
+
+std::optional<KnownBits>
+KnownBitsDataflow::lookup(const Value *V,
+                          std::optional<SQCompatibility> Info) const {
+  auto It = find_as(V);
+  if (It == end())
+    return std::nullopt;
+  // If we had a context-instruction or UseInstrInfo in the cached result,
+  // re-using that result will produce a better optimization result.
+  if (Info && !Info->isRefinementOf(It->second))
+    return std::nullopt;
+  const KnownBits &Known = It->second;
+  if (isAllConflict(Known))
+    return std::nullopt;
+  ++KnownBitsCacheHits;
+  return Known;
+}
+
+void KnownBitsDataflow::insert(const Value *V, const KnownBits &Known,
+                               std::optional<SQCompatibility> Info) {
+  insert_or_assign(getOrCreateVH(V), AugmentedKnownBits(Known, Info));
+}
+
+std::optional<KnownBits>
+SimplifyQuery::getCachedKnownBits(const Value *V) const {
+  // We do not bother with checking compatibility of context-functions.
+  if (!KBCache || CxtF)
+    return std::nullopt;
+  return KBCache->lookup(V, *this);
+}
+
+void SimplifyQuery::cacheKnownBits(const Value *V, const KnownBits &Known) {
+  if (!KBCache)
+    return;
+  KBCache->insert(V, Known, *this);
+}
diff --git a/llvm/lib/Analysis/ValueTracking.cpp b/llvm/lib/Analysis/ValueTracking.cpp
index 44ba5bdc4c6028..9b4d484913ebb9 100644
--- a/llvm/lib/Analysis/ValueTracking.cpp
+++ b/llvm/lib/Analysis/ValueTracking.cpp
@@ -2640,6 +2640,12 @@ void computeKnownBits(const Value *V, const APInt &DemandedElts,
     return;
   }
 
+  // Directly use any cached values.
+  if (auto K = Q.getCachedKnownBits(V)) {
+    Known = *K;
+    return;
+  }
+
   // Start out not knowing anything.
   Known.resetAll();
 
