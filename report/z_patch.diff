     }
+
+    // Split the classes where we detected unknown dependencies.
+    for (MemAccessInfo Leader : UnknownDepClasses)
+      splitClass(DepCands, Leader, UnknownDeps, PSE, TheLoop);
   } else {
     CheckDeps.clear();
     DepCands = {};
