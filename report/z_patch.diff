+; CHECK-NEXT:    [[C:%.*]] = icmp samesign uge i8 [[END]], [[START:%.*]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
+; CHECK-NEXT:    ret i1 true
+;
+entry:
+  %end = or i8 %v, -128
+  %c = icmp samesign uge i8 %end, %start
+  call void @llvm.assume(i1 %c)
