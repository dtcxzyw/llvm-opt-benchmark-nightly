+; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i64 23, i64 15
+; CHECK-NEXT:    [[OTHER:%.*]] = select i1 [[COND]], i64 4, i64 -4
+; CHECK-NEXT:    [[LEFT:%.*]] = add i64 [[BITS]], [[X]]
