+; Direct isKnownNonEqual tests.
+
+; X != X urem Y is true if X u>= Y.
+define i1 @urem_not_equal_domcondition(i64 %x, i64 %y) {
+; CHECK-LABEL: @urem_not_equal_domcondition(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[COND:%.*]] = icmp uge i64 [[X:%.*]], [[Y:%.*]]
+; CHECK-NEXT:    br i1 [[COND]], label [[KNOWN:%.*]], label [[EXIT:%.*]]
+; CHECK:       known:
+; CHECK-NEXT:    ret i1 true
+; CHECK:       exit:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %cond = icmp uge i64 %x, %y
+  br i1 %cond, label %known, label %exit
+
+known:
+  %rem = urem i64 %x, %y
+  %cmp = icmp ne i64 %x, %rem
+  ret i1 %cmp
+
+exit:
+  ret i1 false
+}
+
+; X urem Y == X is false if X u>= Y.
