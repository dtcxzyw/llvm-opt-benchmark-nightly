+; Induction detection for PHIs with casts adds a no-wrap predicate for the
+; narrow AddRec {trunc(Start),+,trunc(Step)}, plus Equal predicates for Start
+; and Step if needed. Under those, the wide AddRec of the PHI is
+; {ext(trunc(Start)),+,sext(trunc(Step))}, which evaluates to ext of the narrow
+; AddRec, so the narrow predicate implies the same predicate for the wide one.
+
+; %iv.2 is updated as zext(trunc %iv.2 to i8) + sext(%s).
+define void @narrow_i8_nusw_implies_wide_i32_nusw(ptr %src, ptr %dst, i8 %s, i64 %n) {
+; CHECK-LABEL: 'narrow_i8_nusw_implies_wide_i32_nusw'
+; CHECK-NEXT:    loop:
+; CHECK-NEXT:      Memory dependences are safe with run-time checks
+; CHECK-NEXT:      Dependences:
+; CHECK-NEXT:      Run-time memory checks:
+; CHECK-NEXT:      Check 0:
+; CHECK-NEXT:        Comparing group GRP0:
+; CHECK-NEXT:          %gep.dst = getelementptr float, ptr %dst, i64 %iv
+; CHECK-NEXT:        Against group GRP1:
+; CHECK-NEXT:          %gep.src = getelementptr float, ptr %src, i64 %iv.2.ext
+; CHECK-NEXT:      Grouped accesses:
+; CHECK-NEXT:        Group GRP0:
+; CHECK-NEXT:          (Low: %dst High: ((4 * %n) + %dst))
+; CHECK-NEXT:            Member: {%dst,+,4}<%loop>
+; CHECK-NEXT:        Group GRP1:
+; CHECK-NEXT:          (Low: ((800 + %src) umin (800 + (4 * (sext i8 %s to i64) * (-1 + %n)) + %src)) High: (4 + ((800 + %src) umax (800 + (4 * (sext i8 %s to i64) * (-1 + %n)) + %src))))
+; CHECK-NEXT:            Member: {(800 + %src),+,(4 * (sext i8 %s to i64))<nsw>}<%loop>
+; CHECK-EMPTY:
+; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
+; CHECK-NEXT:      SCEV assumptions:
+; CHECK-NEXT:      {-56,+,%s}<%loop> Added Flags: <nusw>
+; CHECK-NEXT:      {(800 + %src),+,(4 * (sext i8 %s to i64))<nsw>}<%loop> Added Flags: <nusw>
+; CHECK-EMPTY:
+; CHECK-NEXT:      Expressions re-written:
+; CHECK-NEXT:      [PSE] %gep.src = getelementptr float, ptr %src, i64 %iv.2.ext:
+; CHECK-NEXT:        ((4 * (zext i32 %iv.2 to i64))<nuw><nsw> + %src)
+; CHECK-NEXT:        --> {(800 + %src),+,(4 * (sext i8 %s to i64))<nsw>}<%loop>
+;
+entry:
+  %step = sext i8 %s to i32
+  br label %loop
+
+loop:
+  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
+  %iv.2 = phi i32 [ 200, %entry ], [ %iv.2.next, %loop ]
+  %iv.2.ext = zext i32 %iv.2 to i64
+  %gep.src = getelementptr float, ptr %src, i64 %iv.2.ext
+  %l = load float, ptr %gep.src, align 4
+  %gep.dst = getelementptr float, ptr %dst, i64 %iv
+  store float %l, ptr %gep.dst, align 4
+  %iv.2.and = and i32 %iv.2, 255
+  %iv.2.next = add i32 %iv.2.and, %step
+  %iv.next = add i64 %iv, 1
+  %ec = icmp eq i64 %iv.next, %n
+  br i1 %ec, label %exit, label %loop
+
+exit:
+  ret void
