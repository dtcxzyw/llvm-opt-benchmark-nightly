diff --git a/llvm/lib/Transforms/InstCombine/InstCombineSelect.cpp b/llvm/lib/Transforms/InstCombine/InstCombineSelect.cpp
index 39f0d11df4db9..8151f8284b884 100644
--- a/llvm/lib/Transforms/InstCombine/InstCombineSelect.cpp
+++ b/llvm/lib/Transforms/InstCombine/InstCombineSelect.cpp
@@ -1528,6 +1528,103 @@ static Instruction *foldSelectCtlzToCttz(ICmpInst *ICI, Value *TrueVal,
   return CallInst::Create(F, {X, Builder.getFalse()});
 }
 
+static Value *foldSelectCtlzWithNonZeroInput(ICmpInst *ICI, Value *TrueVal,
+                                             Value *FalseVal,
+                                             InstCombinerImpl &IC) {
+  if (!ICI->isEquality() || !ICI->hasOneUse())
+    return nullptr;
+
+  ICmpInst::Predicate Pred = ICI->getPredicate();
+  Value *X;
+
+  if (match(ICI->getOperand(1), m_Zero())) {
+    X = ICI->getOperand(0);
+  } else if (match(ICI->getOperand(0), m_Zero())) {
+    X = ICI->getOperand(1);
+    Pred = ICmpInst::getSwappedCmpPredicate(Pred);
+  } else {
+    return nullptr;
+  }
+
+  // Normalize the select arms so SelectArg is selected for X != 0 and
+  // ValueOnZero is selected for X == 0.
+  Value *SelectArg = FalseVal;
+  Value *ValueOnZero = TrueVal;
+
+  if (Pred == ICmpInst::ICMP_NE)
+    std::swap(SelectArg, ValueOnZero);
+
+  if (!X->getType()->isIntegerTy())
+    return nullptr;
+
+  auto *LShr = dyn_cast<BinaryOperator>(SelectArg);
+  if (!LShr || LShr->getOpcode() != Instruction::LShr)
+    return nullptr;
+
+  auto *Sub = dyn_cast<BinaryOperator>(LShr->getOperand(0));
+  auto *ShiftC = dyn_cast<ConstantInt>(LShr->getOperand(1));
+
+  if (!Sub || Sub->getOpcode() != Instruction::Sub || !ShiftC)
+    return nullptr;
+
+  auto *BiasC = dyn_cast<ConstantInt>(Sub->getOperand(0));
+  auto *II = dyn_cast<IntrinsicInst>(Sub->getOperand(1));
+  auto *ValueOnZeroC = dyn_cast<ConstantInt>(ValueOnZero);
+
+  if (!BiasC || !II || !ValueOnZeroC ||
+      II->getIntrinsicID() != Intrinsic::ctlz || II->getArgOperand(0) != X ||
+      !match(II->getArgOperand(1), m_One()))
+    return nullptr;
+
+  unsigned BitWidth = X->getType()->getIntegerBitWidth();
+
+  // Clamp an oversized shift constant to BitWidth so it is rejected below
+  // without requiring the APInt to fit in an unsigned integer.
+  unsigned ShiftAmt = ShiftC->getValue().getLimitedValue(BitWidth);
+
+  if (ShiftAmt >= BitWidth)
+    return nullptr;
+
+  APInt CtlzAtZero(BitWidth, BitWidth - 1);
+
+  const APInt &Bias = BiasC->getValue();
+  APInt SubAtZero = Bias - CtlzAtZero;
+
+  bool UnsignedOverflow;
+  bool SignedOverflow;
+
+  (void)Bias.usub_ov(CtlzAtZero, UnsignedOverflow);
+  (void)Bias.ssub_ov(CtlzAtZero, SignedOverflow);
+
+  // Removing the select exposes the arithmetic to X == 0. Preserve the
+  // original no-wrap guarantees by rejecting a newly poisonous subtraction.
+  if ((Sub->hasNoUnsignedWrap() && UnsignedOverflow) ||
+      (Sub->hasNoSignedWrap() && SignedOverflow))
+    return nullptr;
+
+  // An exact right shift requires every shifted-out low bit to be zero.
+  if (LShr->isExact() && SubAtZero.countr_zero() < ShiftAmt)
+    return nullptr;
+
+  if (SubAtZero.lshr(ShiftAmt) != ValueOnZeroC->getValue())
+    return nullptr;
+
+  InstCombiner::BuilderTy::InsertPointGuard Guard(IC.Builder);
+  IC.Builder.SetInsertPoint(II);
+
+  // X | 1 has the same number of leading zeros as X when X is nonzero, and
+  // turns the zero input into 1 so ctlz(..., true) is always well-defined.
+  Value *NonZero =
+      IC.Builder.CreateOr(X, ConstantInt::get(X->getType(), 1), "ctlz.nonzero");
+
+  IC.replaceOperand(*II, 0, NonZero);
+
+  II->dropPoisonGeneratingAnnotations();
+
+  IC.addToWorklist(II);
+  return SelectArg;
+}
+
 /// Attempt to fold a cttz/ctlz followed by a icmp plus select into a single
 /// call to cttz/ctlz with flag 'is_zero_poison' cleared.
 ///
@@ -2463,6 +2560,9 @@ Instruction *InstCombinerImpl::foldSelectInstWithICmp(SelectInst &SI,
   if (Value *V = foldSelectICmpLshrAshr(ICI, TrueVal, FalseVal, Builder))
     return replaceInstUsesWith(SI, V);
 
+  if (Value *V = foldSelectCtlzWithNonZeroInput(ICI, TrueVal, FalseVal, *this))
+    return replaceInstUsesWith(SI, V);
+
   if (Value *V = foldSelectCttzCtlz(ICI, TrueVal, FalseVal, *this))
     return replaceInstUsesWith(SI, V);
 
