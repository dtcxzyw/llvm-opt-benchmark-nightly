+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s
+
+
+; %add = add nsw %x, %y decomposes to %x + %y, which requires %x >=s 0 and
+; %y >=s 0. Those preconditions are unknown here, so %add is used as-is, which
+; still allows proving %t.
+define i1 @precondition_unknown_operand_used_as_is(i16 %x, i16 %y, i16 %z) {
+; CHECK-LABEL: define i1 @precondition_unknown_operand_used_as_is(
+; CHECK-SAME: i16 [[X:%.*]], i16 [[Y:%.*]], i16 [[Z:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[ADD:%.*]] = add nsw i16 [[X]], [[Y]]
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i16 [[ADD]], [[Z]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
+; CHECK-NEXT:    ret i1 true
+;
+entry:
+  %add = add nsw i16 %x, %y
+  %c = icmp ugt i16 %add, %z
+  call void @llvm.assume(i1 %c)
+  %t = icmp uge i16 %add, %z
+  ret i1 %t
+}
+
+; Same as @precondition_unknown_operand_used_as_is, but with preconditions
+; holding.
+define i1 @decompose_used_when_precondition_holds(i16 %x, i16 %y, i16 %z) {
+; CHECK-LABEL: define i1 @decompose_used_when_precondition_holds(
+; CHECK-SAME: i16 [[X:%.*]], i16 [[Y:%.*]], i16 [[Z:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[X_POS:%.*]] = and i16 [[X]], 127
+; CHECK-NEXT:    [[Y_POS:%.*]] = and i16 [[Y]], 127
+; CHECK-NEXT:    [[ADD:%.*]] = add nsw i16 [[X_POS]], [[Y_POS]]
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i16 [[ADD]], [[Z]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
+; CHECK-NEXT:    ret i1 true
+;
+entry:
+  %x.pos = and i16 %x, 127
+  %y.pos = and i16 %y, 127
+  %add = add nsw i16 %x.pos, %y.pos
+  %c = icmp ugt i16 %add, %z
+  call void @llvm.assume(i1 %c)
+  %t = icmp uge i16 %add, %z
+  ret i1 %t
+}
+
+; Constant operands are still folded into the offset when an operand is used
+; as-is, otherwise the constants become opaque variables and %t.1 cannot be
+; proven. %t.2 must not be folded.
+define void @constants_folded_for_opaque_operand(i16 %x, i16 %y) {
+; CHECK-LABEL: define void @constants_folded_for_opaque_operand(
+; CHECK-SAME: i16 [[X:%.*]], i16 [[Y:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[ADD:%.*]] = add nsw i16 [[X]], [[Y]]
+; CHECK-NEXT:    [[C:%.*]] = icmp ult i16 [[ADD]], 100
+; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    call void @use(i1 true)
+; CHECK-NEXT:    [[T_2:%.*]] = icmp ult i16 [[ADD]], 50
+; CHECK-NEXT:    call void @use(i1 [[T_2]])
+; CHECK-NEXT:    ret void
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %add = add nsw i16 %x, %y
+  %c = icmp ult i16 %add, 100
+  br i1 %c, label %then, label %exit
+
+then:
+  %t.1 = icmp ult i16 %add, 200
+  call void @use(i1 %t.1)
+  %t.2 = icmp ult i16 %add, 50
+  call void @use(i1 %t.2)
+  ret void
+
+exit:
+  ret void
+}
+
+; The precondition of %add does not hold, so %add is used as-is, but the offset
