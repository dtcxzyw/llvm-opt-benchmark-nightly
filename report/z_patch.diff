+
+; ---- POS lower-no-nsz: lower select does not need nsz, still folds ----
+define float @pos_lower_no_nsz(float %x, float %fallback) {
+; CHECK-LABEL: define float @pos_lower_no_nsz(
+; CHECK-SAME: float [[X:%.*]], float [[FALLBACK:%.*]]) {
