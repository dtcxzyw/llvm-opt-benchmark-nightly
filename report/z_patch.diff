@@ -4029,10 +4036,12 @@ Instruction *InstCombinerImpl::visitCallInst(CallInst &CI) {
 
       // TODO: Drop these assumes when they are redundant
       case BundleAttr::DereferenceableOrNull:
+        ShouldMoveAllAssumes = false;
