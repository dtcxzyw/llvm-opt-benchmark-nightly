+
+; Lane 0 is poison and lane 1 is %x. They share a byte but stay separate
+; lanes, so lane 1 of the result is still %x.
+define <2 x i4> @poison_lane(i4 %x) {
+; CHECK-LABEL: define <2 x i4> @poison_lane(
