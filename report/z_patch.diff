+; CHECK-NEXT:    [[MUL:%.*]] = mul i16 [[X:%.*]], [[TMP1]]
+; CHECK-NEXT:    ret i16 [[MUL]]
+;
+  %shl = shl  i16 %x, 2
+  %sel = select i1 %cond, i16 5, i16 3
+  %mul = mul  i16 %sel, %shl
+  ret i16 %mul
+}
