diff --git a/llvm/test/Transforms/LoopVectorize/X86/small-max-trip-count-ne-exit.ll b/llvm/test/Transforms/LoopVectorize/X86/small-max-trip-count-ne-exit.ll
new file mode 100644
index 0000000000000..577d67eadff80
--- /dev/null
+++ b/llvm/test/Transforms/LoopVectorize/X86/small-max-trip-count-ne-exit.ll
@@ -0,0 +1,55 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=loop-vectorize -S %s | FileCheck %s
+;
+; The loop runs at most 4 iterations (%start in [0, 4), %S = smin(%n, 4)), but
+; its exit is `ne` rather than `slt`, e.g. after LFTR. The trip count bound must
+; still reach LV, which then does not vectorize the tiny loop.
+
+target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
+target triple = "x86_64-unknown-linux-gnu"
+
+define void @ne_exit_small_max_tc(ptr %A, ptr %B, i64 %n, i64 range(i64 0, 4) %start) {
+; CHECK-LABEL: define void @ne_exit_small_max_tc(
+; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]], i64 [[N:%.*]], i64 range(i64 0, 4) [[START:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[S:%.*]] = call i64 @llvm.smin.i64(i64 [[N]], i64 4)
+; CHECK-NEXT:    [[G:%.*]] = icmp slt i64 [[START]], [[S]]
+; CHECK-NEXT:    br i1 [[G]], label %[[SCALAR_PH:.*]], label %[[EXIT:.*]]
+; CHECK:       [[SCALAR_PH]]:
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[IV_NEXT:%.*]], %[[LOOP]] ], [ [[START]], %[[SCALAR_PH]] ]
+; CHECK-NEXT:    [[GEP_B:%.*]] = getelementptr double, ptr [[B]], i64 [[IV]]
+; CHECK-NEXT:    [[B:%.*]] = load double, ptr [[GEP_B]], align 8
+; CHECK-NEXT:    [[GEP_A:%.*]] = getelementptr double, ptr [[A]], i64 [[IV]]
+; CHECK-NEXT:    [[A:%.*]] = load double, ptr [[GEP_A]], align 8
+; CHECK-NEXT:    [[ADD:%.*]] = fadd double [[A]], [[B]]
+; CHECK-NEXT:    store double [[ADD]], ptr [[GEP_A]], align 8
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp ne i64 [[IV_NEXT]], [[S]]
+; CHECK-NEXT:    br i1 [[C]], label %[[LOOP]], label %[[EXIT_LOOPEXIT:.*]]
+; CHECK:       [[EXIT_LOOPEXIT]]:
+; CHECK-NEXT:    br label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %S = call i64 @llvm.smin.i64(i64 %n, i64 4)
+  %g = icmp slt i64 %start, %S
+  br i1 %g, label %loop, label %exit
+
+loop:
+  %iv = phi i64 [ %start, %entry ], [ %iv.next, %loop ]
+  %gep.b = getelementptr double, ptr %B, i64 %iv
+  %b = load double, ptr %gep.b, align 8
+  %gep.a = getelementptr double, ptr %A, i64 %iv
+  %a = load double, ptr %gep.a, align 8
+  %add = fadd double %a, %b
+  store double %add, ptr %gep.a, align 8
+  %iv.next = add nuw nsw i64 %iv, 1
+  %c = icmp ne i64 %iv.next, %S
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
