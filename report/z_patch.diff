+  %sub = add i16 %x, -4
+  %add = add nuw i16 %sub, 2
+  %c = icmp ugt i16 %sub, %z
+  call void @llvm.assume(i1 %c)
+  %t = icmp ugt i16 %add, %z
+  ret i1 %t
