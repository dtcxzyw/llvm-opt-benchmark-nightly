+define ptr @gep_sel_const_two_uses(i1 %c) {
+; CHECK-LABEL: @gep_sel_const_two_uses(
+; CHECK-NEXT:    [[GEP1:%.*]] = select i1 [[C:%.*]], ptr getelementptr nuw (i8, ptr @A, i64 5), ptr getelementptr nuw (i8, ptr @B, i64 5)
+; CHECK-NEXT:    [[GEP2:%.*]] = select i1 [[C]], ptr getelementptr nuw (i8, ptr @A, i64 9), ptr getelementptr nuw (i8, ptr @B, i64 9)
+; CHECK-NEXT:    call void @use(ptr nonnull [[GEP1]])
+; CHECK-NEXT:    ret ptr [[GEP2]]
+;
+  %sel = select i1 %c, ptr @A, ptr @B
+  %gep1 = getelementptr nuw i8, ptr %sel, i64 5
+  %gep2 = getelementptr nuw i8, ptr %sel, i64 9
+  call void @use(ptr %gep1)
+  ret ptr %gep2
+}
+
