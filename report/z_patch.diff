+  auto *Br = dyn_cast<CondBrInst>(BB.getTerminator());
+  if (!Br)
     return;
+  // The condition is the counting compare, possibly combined with extra exit
+  // conditions: an overflow-checked increment yields `or(overflow, A s>= B)`
+  // or `and(not overflow, A s< B)`, depending on the exit polarity. Peel those
+  // off, remembering on which edge the combined condition implies the compare:
+  // an `and` forces all its operands where it is true, an `or` where it is
+  // false. Use the logical matchers, so the select forms are handled too.
+  auto CountingCmp = m_c_ICmp(Pred, IndValue, m_Value(B));
+  std::optional<bool> PeeledOnEdge;
+  if (!match(Br->getCondition(), CountingCmp)) {
+    if (match(Br->getCondition(), m_c_LogicalAnd(CountingCmp, m_Value())))
+      PeeledOnEdge = true;
+    else if (match(Br->getCondition(), m_c_LogicalOr(CountingCmp, m_Value())))
+      PeeledOnEdge = false;
+    else
+      return;
+  }
+
