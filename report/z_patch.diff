diff --git a/llvm/test/Analysis/BasicAA/phi-underlying-objects-local.ll b/llvm/test/Analysis/BasicAA/phi-underlying-objects-local.ll
new file mode 100644
index 00000000000000..8922ec159548c3
--- /dev/null
+++ b/llvm/test/Analysis/BasicAA/phi-underlying-objects-local.ll
@@ -0,0 +1,505 @@
+; RUN: opt -aa-pipeline=basic-aa -passes=aa-eval -print-all-alias-modref-info -disable-output %s 2>&1 | FileCheck %s
+
+; Pointers carried through nested-loop phis (including LCSSA phis) whose
+; underlying objects are all known not to alias a non-escaping local object.
+
+declare void @escape(ptr)
+
+; %data.inner is based on %data through an inner-loop phi, an outer-loop phi and
+; an LCSSA phi, so it cannot alias the non-escaping alloca %buf.
+; CHECK-LABEL: Function: nested_loop_arg:
+; CHECK:         NoAlias:  i8* %buf.gep, i8* %data.inner
+define void @nested_loop_arg(ptr %data, i64 %n) {
+entry:
+  %buf = alloca [16 x i8]
+  br label %outer
+
+outer:
+  %outer.iv = phi i64 [ 0, %entry ], [ %outer.iv.next, %outer.latch ]
+  %data.outer = phi ptr [ %data, %entry ], [ %data.next.lcssa, %outer.latch ]
+  br label %inner
+
+inner:
+  %iv = phi i64 [ 0, %outer ], [ %iv.next, %inner ]
+  %data.inner = phi ptr [ %data.outer, %outer ], [ %data.next, %inner ]
+  %buf.gep = getelementptr inbounds i8, ptr %buf, i64 %iv
+  %l = load i8, ptr %buf.gep
+  store i8 %l, ptr %data.inner
+  %data.next = getelementptr inbounds i8, ptr %data.inner, i64 1
+  %iv.next = add nuw nsw i64 %iv, 1
+  %ec = icmp eq i64 %iv.next, 16
+  br i1 %ec, label %outer.latch, label %inner
+
+outer.latch:
+  %data.next.lcssa = phi ptr [ %data.next, %inner ]
+  %outer.iv.next = add nuw i64 %outer.iv, 1
+  %outer.ec = icmp eq i64 %outer.iv.next, %n
+  br i1 %outer.ec, label %exit, label %outer
+
+exit:
+  ret void
+}
+
+; The pointer is loaded from memory, but %buf is never captured.
+; CHECK-LABEL: Function: nested_loop_load_not_captured:
+; CHECK:         NoAlias:  i8* %buf.gep, i8* %data.inner
+define void @nested_loop_load_not_captured(ptr %pp, i64 %n) {
+entry:
+  %buf = alloca [16 x i8]
+  %init = load ptr, ptr %pp
+  br label %outer
+
+outer:
+  %outer.iv = phi i64 [ 0, %entry ], [ %outer.iv.next, %outer.latch ]
+  %data.outer = phi ptr [ %init, %entry ], [ %data.next.lcssa, %outer.latch ]
+  br label %inner
+
+inner:
+  %iv = phi i64 [ 0, %outer ], [ %iv.next, %inner ]
+  %data.inner = phi ptr [ %data.outer, %outer ], [ %data.next, %inner ]
+  %buf.gep = getelementptr inbounds i8, ptr %buf, i64 %iv
+  %l = load i8, ptr %buf.gep
+  store i8 %l, ptr %data.inner
+  %data.next = getelementptr inbounds i8, ptr %data.inner, i64 1
+  %iv.next = add nuw nsw i64 %iv, 1
+  %ec = icmp eq i64 %iv.next, 16
+  br i1 %ec, label %outer.latch, label %inner
+
+outer.latch:
+  %data.next.lcssa = phi ptr [ %data.next, %inner ]
+  %outer.iv.next = add nuw i64 %outer.iv, 1
+  %outer.ec = icmp eq i64 %outer.iv.next, %n
+  br i1 %outer.ec, label %exit, label %outer
+
+exit:
+  ret void
+}
