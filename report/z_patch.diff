diff --git a/llvm/include/llvm/Analysis/KnownBitsAnalysis.h b/llvm/include/llvm/Analysis/KnownBitsAnalysis.h
new file mode 100644
index 00000000000000..1d4832cbf648a1
--- /dev/null
+++ b/llvm/include/llvm/Analysis/KnownBitsAnalysis.h
@@ -0,0 +1,220 @@
+//===- KnownBitsAnalysis.h - Cache and invalidate KnownBits ---------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_ANALYSIS_KNOWNBITSANALYSIS_H
+#define LLVM_ANALYSIS_KNOWNBITSANALYSIS_H
+
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/Support/Compiler.h"
+#include "llvm/Support/KnownBits.h"
+
+namespace llvm {
+class Value;
+class User;
+class Function;
+class DataLayout;
+class raw_ostream;
+class KnownBitsDataflow;
+struct SimplifyQuery;
+
+/// A custom ValueHandle with callback to erase KnownBits in the cache when a
+/// Value is deleted, or invalidate dependent KnownBits when RAUW'ed.
+class LLVM_ABI KnownBitsVH final : public CallbackVH {
+  friend class KnownBitsDataflow;
+  KnownBitsDataflow *KBD;
+
+  virtual void deleted() override;
+  virtual void allUsesReplacedWith(Value *New) override;
+
+  /// We must never produce duplicate ValueHandles.
+  KnownBitsVH(const Value *V, const KnownBitsDataflow *KBD)
+      : CallbackVH(V), KBD(const_cast<KnownBitsDataflow *>(KBD)) {}
+
+public:
+  /// Forbid implict conversions to underlying Value. Use getValue explicitly.
+  const Value *getValue() const { return getValPtr(); }
+  operator const Value *() = delete;
+  bool operator==(const KnownBitsVH &Other) const {
+    return getValue() == Other.getValue();
+  }
+};
+
+// The DenseMapInfo for our KnownBits ValueHandle is just the DenseMapInfo on
+// the Value pointer: there is no other information in the ValueHandle that's
+// relevant for a DenseMap.
+template <> struct DenseMapInfo<KnownBitsVH> {
+  static unsigned getHashValue(const KnownBitsVH &Val) {
+    return DenseMapInfo<const Value *>::getHashValue(Val.getValue());
+  }
+
+  static bool isEqual(const KnownBitsVH &LHS, const KnownBitsVH &RHS) {
+    return DenseMapInfo<const Value *>::isEqual(LHS.getValue(), RHS.getValue());
+  }
+};
+
+/// A custom DenseMap for our KnownBits ValueHandle, to enable its use as a
+/// DenseMap key effectively. The issue we address is that the DenseMap's key is
+/// a KnownBitsVH, and all lookups must be based on such a type: however,
+/// constructing a duplicate ValueHandle lookup trivially is an error, as it
+/// would not have the associated use-list. It is also expensive and wasteful to
+/// search through the DenseMap's keys for a matching ValueHandle. We directly
+/// write a specialized doFind, to look up Buckets based on underlying Values:
+/// this allows us to translate from an underlying Value to a ValueHandle
+/// cheaply.
+template <typename ValueT>
+class LLVM_ABI DenseMapForVH : public DenseMap<KnownBitsVH, ValueT> {
+  using BaseT = DenseMap<KnownBitsVH, ValueT>;
+  using KeyInfoT = DenseMapInfo<KnownBitsVH>;
+  using BucketT = llvm::detail::DenseMapPair<KnownBitsVH, ValueT>;
+
+protected:
+  /// The core custom DenseMap routine that does an equivalent doFind on an
+  /// underlying Value instead of a ValueHandle.
+  const BucketT *doFind(const Value *V) const {
+    if (BaseT::empty())
+      return nullptr;
+    auto [BucketsPtr, U, NumBuckets] = BaseT::getRep();
+
+    const unsigned Mask = NumBuckets - 1;
+    unsigned BucketNo = DenseMapInfo<const Value *>::getHashValue(V) & Mask;
+    while (true) {
+      // An empty bucket terminates the probe: the key isn't in the map.
+      if (LLVM_LIKELY(!llvm::densemap::detail::used(U, BucketNo)))
+        return nullptr;
+      const BucketT *Bucket = BucketsPtr + BucketNo;
+      if (LLVM_LIKELY(DenseMapInfo<const Value *>::isEqual(
+              V, Bucket->getFirst().getValue())))
+        return Bucket;
+
+      // Hash collision: continue linear probing.
+      BucketNo = (BucketNo + 1) & Mask;
+    }
+  }
+
+  [[nodiscard]] typename BaseT::const_iterator
+  find_as(const Value *V) const { // NOLINT
+    if (const BucketT *Bucket = doFind(V))
+      return BaseT::makeConstIterator(Bucket);
+    return BaseT::end();
+  }
+};
+
+/// Distillation of compatibility of two different SimplifyQueries: the
+/// context-instruction and UseInstrInfo boolean.
+struct SQCompatibility {
+  WeakVH CxtI;
+  unsigned short UseInstrInfo : 1;
+
+public:
+  SQCompatibility() = default;
+  SQCompatibility(const SimplifyQuery &SQ);
+  bool isRefinementOf(const SQCompatibility &Other) const;
+};
+
+/// The ValueT of our DenseMap is actually a KnownBits augmented with
+/// SimplifyQuery-compatability information.
+struct AugmentedKnownBits : public KnownBits, public SQCompatibility {
+  AugmentedKnownBits() = default;
+  AugmentedKnownBits(const KnownBits &Known,
+                     std::optional<SQCompatibility> Info = {})
+      : KnownBits(Known), SQCompatibility(Info ? *Info : SQCompatibility()) {}
+};
+
+/// A structure keeps a mapping between a custom ValueHandle and KnownBits, with
+/// core functionality to do forward dataflow analysis on the use-def graph.
+/// Used to cache information from computeKnownBits calls. It is populated
+/// on-demand.
+class LLVM_ABI KnownBitsDataflow : protected DenseMapForVH<AugmentedKnownBits> {
+  friend class KnownBitsVH;
+
+  /// This is only extra data we keep.
+  const Function &F;
+  const DataLayout &getDataLayout() const { return F.getDataLayout(); }
+
+  /// Helper to insert ValueHandles in the entire subgraph starting at \p R,
+  /// with all-conflict KnownBits information. Used for testing purposes.
+  void insert_range(ArrayRef<KnownBitsVH> R); // NOLINT
+
+  /// Used to clean up after an IR Value is erased.
+  void cleanup() {
+    remove_if([&](const auto &KV) { return KV.first.getValue() == nullptr; });
+  }
+
+  /// Do a forward data-flow walk, and find all Values in the map whose
+  /// KnownBits depeends on the KnownBits of \p Root, skipping any nodes not in
+  /// the map. Pass \p Create to create fresh ValueHandles from the walk, for
+  /// insertion purposes.
+  SmallVector<KnownBitsVH> forwardDataflow(ArrayRef<KnownBitsVH> Roots,
+                                           bool Create = false) const;
+
+protected:
+  using BaseT = DenseMapForVH<AugmentedKnownBits>;
+
+  /// Get an existing ValueHandle.
+  KnownBitsVH getVH(const Value *V) const;
+
+  /// Get an existing ValueHandle or create a fresh one, for insertion purposes.
+  KnownBitsVH getOrCreateVH(const Value *V) const;
+
+  /// Invalidates KnownBits in the entire subgraph found from the
+  /// forwardDataflow walk starting from \p V. Used on IR manipulation.
+  LLVM_ABI_FOR_TEST void invalidate(const KnownBitsVH &V);
+
+  /// We compute the roots to walk KnownBits information on-demand, and this is
+  /// used in print, skipping any nodes not in the map. Pass \p Create to create
+  /// fresh ValueHandles from the walk, for insertion purposes.
+  LLVM_ABI_FOR_TEST SmallVector<KnownBitsVH>
+  computeRoots(bool Create = false) const;
+
+  /// A leaf is a Value whose users filtered on a KnownBits range is empty. Used
+  /// in print.
+  LLVM_ABI_FOR_TEST bool isLeaf(const KnownBitsVH &V) const;
+
+  /// Initializing the entire graph if the Function is expensive, and is used
+  /// only for testing purposes.
+  LLVM_ABI_FOR_TEST void initializeEntireGraph() {
+    insert_range(
+        forwardDataflow(computeRoots(/*Create=*/true), /*Create=*/true));
+  }
+
+public:
+  LLVM_ABI KnownBitsDataflow(const Function &F) : F(F) {}
+  LLVM_ABI KnownBitsDataflow(const KnownBitsDataflow &) = delete;
+  LLVM_ABI KnownBitsDataflow &operator=(const KnownBitsDataflow &) = delete;
+
+  /// A small helper extracted from ValueTracking.
+  static unsigned getBitWidth(Type *Ty, const DataLayout &DL) {
+    if (unsigned BitWidth = Ty->getScalarSizeInBits())
+      return BitWidth;
+    return DL.getPointerTypeSizeInBits(Ty);
+  }
+
+  LLVM_ABI bool empty() const { return BaseT::empty(); }
+  LLVM_ABI size_t size() const { return BaseT::size(); }
+  LLVM_ABI bool contains(const Value *V) const { return doFind(V); }
+
+  /// Looks up \p V if it is present in the map, and returns a valid
+  /// previously cached KnownBits that is not all-conflict, or std::nullopt.
+  /// Pass \p Info to filter on compatibility info.
+  LLVM_ABI std::optional<KnownBits>
+  lookup(const Value *V, std::optional<SQCompatibility> Info = {}) const;
+
+  /// Registers that \p V has KnownBits information \p Known, with
+  /// compatibility info \p Info, overwriting any existing value.
+  LLVM_ABI void insert(const Value *V, const KnownBits &Known,
+                       std::optional<SQCompatibility> Info = {});
+
+  LLVM_ABI void print(raw_ostream &OS) const;
+#if !defined(NDEBUG) || defined(LLVM_ENABLE_DUMP)
+  LLVM_DUMP_METHOD void dump() const;
+#endif
+};
+} // end namespace llvm
+
+#endif // LLVM_ANALYSIS_KNOWNBITSANALYSIS_H
