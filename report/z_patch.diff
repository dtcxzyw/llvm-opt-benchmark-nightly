+; CHECK-NEXT:    br i1 [[IS0]], label %[[CALL0:.*]], label %[[CALL1:.*]]
+; CHECK:       [[CALL0]]:
+; CHECK-NEXT:    call void @fun0(ptr [[STORAGE]], i32 [[IDX]])
+; CHECK-NEXT:    br label %[[DONE]]
+; CHECK:       [[CALL1]]:
+; CHECK-NEXT:    call void @fun1(ptr [[STORAGE]], i32 [[IDX]])
+; CHECK-NEXT:    br label %[[DONE]]
+; CHECK:       [[DONE]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %valueless = icmp eq i32 %idx, -1
+  br i1 %valueless, label %done, label %dispatch
+
+dispatch:
+  %is0 = icmp eq i32 %idx, 0
+  %or = or i1 %is0, %x
+  call void @llvm.assume(i1 %or)
+  br i1 %is0, label %call0, label %call1
+
+call0:
+  call void @fun0(ptr %storage, i32 %idx)
+  br label %done
+
+call1:
+  call void @fun1(ptr %storage, i32 %idx)
+  br label %done
+
+done:
+  ret void
+}
