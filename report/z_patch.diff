index 0000000000000..79a4f6141e7c0
--- /dev/null
+++ b/llvm/test/Transforms/ConstraintElimination/induction-inequality-latch.ll
@@ -0,0 +1,453 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s
+
+; A loop controlled by an inequality on the post-increment (continue while
+; i + step </<= B, or exit while i + step >=/> B) bounds the header value:
+; continuing implies i + step is below B, and the next header value *is* that
+; value, so PN stays below B in the loop. The first iteration is covered by a
+; precondition on the start value. This is the shape of a strided loop such as
+; `for (i = 0; ; i += 2) { ...; if (i + 2 >= n) break; }`.
+
+declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)
+declare void @use(i1)
+
+; Continue-while-true `slt(i + 2, n)` latch: the bound check i u< n folds.
+define void @stride2_slt_latch(i64 %n) {
+; CHECK-LABEL: define void @stride2_slt_latch(
+; CHECK-SAME: i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[EZ:%.*]] = icmp eq i64 [[N]], 0
+; CHECK-NEXT:    br i1 [[EZ]], label %[[EXIT:.*]], label %[[PH:.*]]
+; CHECK:       [[PH]]:
+; CHECK-NEXT:    br label %[[H:.*]]
+; CHECK:       [[H]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[PH]] ], [ [[INEXT:%.*]], %[[LATCH:.*]] ]
+; CHECK-NEXT:    call void @use(i1 true)
+; CHECK-NEXT:    br label %[[LATCH]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    [[INEXT]] = add nsw i64 [[I]], 2
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[INEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label %[[H]], label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %ez = icmp eq i64 %n, 0
+  br i1 %ez, label %exit, label %ph
+
+ph:
+  br label %h
+
+h:
+  %i = phi i64 [ 0, %ph ], [ %inext, %latch ]
+  %oob = icmp ult i64 %i, %n
+  call void @use(i1 %oob)
+  br label %latch
+
+latch:
+  %inext = add nsw i64 %i, 2
+  %c = icmp slt i64 %inext, %n
+  br i1 %c, label %h, label %exit
+
+exit:
+  ret void
+}
+
+; Exit-while-true `sge(i + 2, n)` latch: the reversed polarity is recognised via
+; the inverse predicate, so the bound check still folds.
+define void @stride2_sge_latch(i64 %n) {
+; CHECK-LABEL: define void @stride2_sge_latch(
+; CHECK-SAME: i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[EZ:%.*]] = icmp eq i64 [[N]], 0
+; CHECK-NEXT:    br i1 [[EZ]], label %[[EXIT:.*]], label %[[PH:.*]]
+; CHECK:       [[PH]]:
+; CHECK-NEXT:    br label %[[H:.*]]
+; CHECK:       [[H]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[PH]] ], [ [[INEXT:%.*]], %[[LATCH:.*]] ]
+; CHECK-NEXT:    call void @use(i1 true)
+; CHECK-NEXT:    br label %[[LATCH]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    [[INEXT]] = add nsw i64 [[I]], 2
+; CHECK-NEXT:    [[EXITC:%.*]] = icmp sge i64 [[INEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[EXITC]], label %[[EXIT]], label %[[H]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %ez = icmp eq i64 %n, 0
+  br i1 %ez, label %exit, label %ph
+
+ph:
+  br label %h
+
+h:
+  %i = phi i64 [ 0, %ph ], [ %inext, %latch ]
+  %oob = icmp ult i64 %i, %n
+  call void @use(i1 %oob)
+  br label %latch
+
+latch:
+  %inext = add nsw i64 %i, 2
+  %exitc = icmp sge i64 %inext, %n
+  br i1 %exitc, label %exit, label %h
+
+exit:
+  ret void
+}
+
+; The counting compare OR-ed with an overflow flag, and a checked add as the
+; step: the shape an overflow-checked strided counter produces. The `or` is
+; peeled (its other disjuncts only make the loop exit earlier) and the bound
+; check folds.
+define void @stride2_sadd_or_latch(i64 %n) {
+; CHECK-LABEL: define void @stride2_sadd_or_latch(
+; CHECK-SAME: i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[EZ:%.*]] = icmp eq i64 [[N]], 0
+; CHECK-NEXT:    br i1 [[EZ]], label %[[EXIT:.*]], label %[[PH:.*]]
+; CHECK:       [[PH]]:
+; CHECK-NEXT:    br label %[[H:.*]]
+; CHECK:       [[H]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[PH]] ], [ [[INEXT:%.*]], %[[LATCH:.*]] ]
+; CHECK-NEXT:    call void @use(i1 true)
+; CHECK-NEXT:    br label %[[LATCH]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    [[S:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[I]], i64 2)
+; CHECK-NEXT:    [[INEXT]] = extractvalue { i64, i1 } [[S]], 0
+; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i64, i1 } [[S]], 1
+; CHECK-NEXT:    [[EXITC:%.*]] = icmp sge i64 [[INEXT]], [[N]]
+; CHECK-NEXT:    [[COND:%.*]] = or i1 [[OV]], [[EXITC]]
+; CHECK-NEXT:    br i1 [[COND]], label %[[EXIT]], label %[[H]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %ez = icmp eq i64 %n, 0
+  br i1 %ez, label %exit, label %ph
+
+ph:
+  br label %h
+
+h:
+  %i = phi i64 [ 0, %ph ], [ %inext, %latch ]
+  %oob = icmp ult i64 %i, %n
+  call void @use(i1 %oob)
+  br label %latch
+
+latch:
+  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %i, i64 2)
+  %inext = extractvalue { i64, i1 } %s, 0
+  %ov = extractvalue { i64, i1 } %s, 1
+  %exitc = icmp sge i64 %inext, %n
+  %cond = or i1 %ov, %exitc
+  br i1 %cond, label %exit, label %h
+
+exit:
+  ret void
+}
+
+; A non-constant start value works too: the precondition is a compare against
+; StartValue itself, discharged here by the `start s< n` guard.
+define void @symbolic_start(i64 %start, i64 %n) {
+; CHECK-LABEL: define void @symbolic_start(
+; CHECK-SAME: i64 [[START:%.*]], i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[NN:%.*]] = icmp slt i64 [[START]], [[N]]
+; CHECK-NEXT:    br i1 [[NN]], label %[[PH:.*]], label %[[EXIT:.*]]
+; CHECK:       [[PH]]:
+; CHECK-NEXT:    br label %[[H:.*]]
+; CHECK:       [[H]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[START]], %[[PH]] ], [ [[INEXT:%.*]], %[[LATCH:.*]] ]
+; CHECK-NEXT:    call void @use(i1 true)
+; CHECK-NEXT:    br label %[[LATCH]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    [[INEXT]] = add nsw i64 [[I]], 3
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[INEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label %[[H]], label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %nn = icmp slt i64 %start, %n
+  br i1 %nn, label %ph, label %exit
+
+ph:
+  br label %h
+
+h:
+  %i = phi i64 [ %start, %ph ], [ %inext, %latch ]
+  %oob = icmp slt i64 %i, %n
+  call void @use(i1 %oob)
+  br label %latch
+
+latch:
+  %inext = add nsw i64 %i, 3
+  %c = icmp slt i64 %inext, %n
+  br i1 %c, label %h, label %exit
+
+exit:
+  ret void
+}
+
+; Negative test: a wrapping step (no nsw, not signed-monotonic) must not derive
+; the bound. With i8, start 0, step 2 and n 127 the induction reaches 126, and
+; 126 + 2 == -128 s< 127 continues, so the header value is *not* below n.
+define void @neg_wrapping_step(i8 %n) {
+; CHECK-LABEL: define void @neg_wrapping_step(
+; CHECK-SAME: i8 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[EZ:%.*]] = icmp eq i8 [[N]], 0
+; CHECK-NEXT:    br i1 [[EZ]], label %[[EXIT:.*]], label %[[PH:.*]]
+; CHECK:       [[PH]]:
+; CHECK-NEXT:    br label %[[H:.*]]
+; CHECK:       [[H]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i8 [ 0, %[[PH]] ], [ [[INEXT:%.*]], %[[LATCH:.*]] ]
+; CHECK-NEXT:    [[OOB:%.*]] = icmp ult i8 [[I]], [[N]]
+; CHECK-NEXT:    call void @use(i1 [[OOB]])
+; CHECK-NEXT:    br label %[[LATCH]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    [[INEXT]] = add i8 [[I]], 2
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i8 [[INEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label %[[H]], label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %ez = icmp eq i8 %n, 0
+  br i1 %ez, label %exit, label %ph
+
+ph:
+  br label %h
+
+h:
+  %i = phi i8 [ 0, %ph ], [ %inext, %latch ]
+  %oob = icmp ult i8 %i, %n
+  call void @use(i1 %oob)
+  br label %latch
+
+latch:
+  %inext = add i8 %i, 2
+  %c = icmp slt i8 %inext, %n
+  br i1 %c, label %h, label %exit
+
+exit:
+  ret void
+}
+
+; Negative test: the compared value is not the phi's backedge value. The latch
+; tests i + 2 but the induction advances by 4, so continuing says nothing about
+; the next header value.
+define void @neg_compared_value_not_backedge(i64 %n) {
+; CHECK-LABEL: define void @neg_compared_value_not_backedge(
+; CHECK-SAME: i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[EZ:%.*]] = icmp eq i64 [[N]], 0
+; CHECK-NEXT:    br i1 [[EZ]], label %[[EXIT:.*]], label %[[PH:.*]]
+; CHECK:       [[PH]]:
+; CHECK-NEXT:    br label %[[H:.*]]
+; CHECK:       [[H]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[PH]] ], [ [[INEXT:%.*]], %[[LATCH:.*]] ]
+; CHECK-NEXT:    [[OOB:%.*]] = icmp ult i64 [[I]], [[N]]
+; CHECK-NEXT:    call void @use(i1 [[OOB]])
+; CHECK-NEXT:    br label %[[LATCH]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    [[PROBE:%.*]] = add nsw i64 [[I]], 2
+; CHECK-NEXT:    [[INEXT]] = add nsw i64 [[I]], 4
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[PROBE]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label %[[H]], label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %ez = icmp eq i64 %n, 0
+  br i1 %ez, label %exit, label %ph
+
+ph:
+  br label %h
+
+h:
+  %i = phi i64 [ 0, %ph ], [ %inext, %latch ]
+  %oob = icmp ult i64 %i, %n
+  call void @use(i1 %oob)
+  br label %latch
+
+latch:
+  %probe = add nsw i64 %i, 2
+  %inext = add nsw i64 %i, 4
+  %c = icmp slt i64 %probe, %n
+  br i1 %c, label %h, label %exit
+
+exit:
+  ret void
+}
+
+; Negative test: B is not loop-invariant, so `PN s< B` in one iteration says
+; nothing about the next.
+define void @neg_variant_bound(ptr %p) {
+; CHECK-LABEL: define void @neg_variant_bound(
