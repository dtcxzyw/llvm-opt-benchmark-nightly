diff --git a/llvm/test/Transforms/PhaseOrdering/hoist-loop-invariant-guarded-trap.ll b/llvm/test/Transforms/PhaseOrdering/hoist-loop-invariant-guarded-trap.ll
new file mode 100644
index 0000000000000..62c3c66f91b30
--- /dev/null
+++ b/llvm/test/Transforms/PhaseOrdering/hoist-loop-invariant-guarded-trap.ll
@@ -0,0 +1,86 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes='default<O2>' -S < %s | FileCheck %s
+
+; A loop-invariant exit branch, made invariant by IndVarSimplify exit
+; predication, is hoisted out of the surviving outer loop rather than
+; re-evaluated every iteration.
+
+define void @nested_guarded_trap(ptr %p, i64 %bp0, i64 %n, i64 %umax, i64 %rows) {
+; CHECK-LABEL: define void @nested_guarded_trap(
+; CHECK-SAME: ptr nofree writeonly captures(none) [[P:%.*]], i64 [[BP0:%.*]], i64 [[N:%.*]], i64 [[UMAX:%.*]], i64 [[ROWS:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[SUM:%.*]] = add i64 [[N]], [[BP0]]
+; CHECK-NEXT:    [[BAD:%.*]] = icmp ugt i64 [[SUM]], [[UMAX]]
+; CHECK-NEXT:    br i1 [[BAD]], label %[[GUARD_TRAP:.*]], label %[[OUTER_PREHEADER:.*]]
+; CHECK:       [[OUTER_PREHEADER]]:
+; CHECK-NEXT:    [[N0:%.*]] = icmp eq i64 [[N]], 0
+; CHECK-NEXT:    br i1 [[N0]], label %[[EXIT_SPLIT:.*]], label %[[OUTER_PREHEADER1:.*]]
+; CHECK:       [[OUTER_PREHEADER1]]:
+; CHECK-NEXT:    [[TMP0:%.*]] = sub i64 [[UMAX]], [[BP0]]
+; CHECK-NEXT:    [[TMP1:%.*]] = add i64 [[N]], -1
+; CHECK-NEXT:    [[DOTNOT:%.*]] = icmp ugt i64 [[TMP0]], [[TMP1]]
+; CHECK-NEXT:    [[TMP2:%.*]] = getelementptr i8, ptr [[P]], i64 [[BP0]]
+; CHECK-NEXT:    br i1 [[DOTNOT]], label %[[OUTER:.*]], label %[[OOB_TRAP:.*]]
+; CHECK:       [[OUTER]]:
+; CHECK-NEXT:    [[R:%.*]] = phi i64 [ [[R_NEXT:%.*]], %[[OUTER]] ], [ 0, %[[OUTER_PREHEADER1]] ]
+; CHECK-NEXT:    [[V:%.*]] = trunc i64 [[R]] to i8
+; CHECK-NEXT:    [[TMP3:%.*]] = mul i64 [[N]], [[R]]
+; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr [[TMP2]], i64 [[TMP3]]
+; CHECK-NEXT:    tail call void @llvm.memset.p0.i64(ptr align 1 [[SCEVGEP]], i8 [[V]], i64 [[N]], i1 false)
+; CHECK-NEXT:    [[R_NEXT]] = add i64 [[R]], 1
+; CHECK-NEXT:    [[ODONE:%.*]] = icmp eq i64 [[R_NEXT]], [[ROWS]]
+; CHECK-NEXT:    br i1 [[ODONE]], label %[[EXIT_SPLIT]], label %[[OUTER]]
+; CHECK:       [[GUARD_TRAP]]:
+; CHECK-NEXT:    tail call void @llvm.trap()
+; CHECK-NEXT:    unreachable
+; CHECK:       [[OOB_TRAP]]:
+; CHECK-NEXT:    tail call void @llvm.trap()
+; CHECK-NEXT:    unreachable
+; CHECK:       [[EXIT_SPLIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %sum = add i64 %bp0, %n
+  %bad = icmp ugt i64 %sum, %umax
+  br i1 %bad, label %guard.trap, label %outer          ; dominating guard
+
+outer:
+  %r = phi i64 [ 0, %entry ], [ %r.next, %inner.done ]
+  %n0 = icmp eq i64 %n, 0
+  br i1 %n0, label %inner.done, label %inner
+
+inner:
+  %bp = phi i64 [ %bp0, %outer ], [ %bp.next, %cont ]
+  %cnt = phi i64 [ %n, %outer ], [ %cnt.next, %cont ]
+  %oob = icmp eq i64 %bp, %umax
+  br i1 %oob, label %oob.trap, label %cont             ; guard-dead per-element check
+
+cont:
+  %roff = mul i64 %r, %n
+  %aidx = add i64 %roff, %bp
+  %gep = getelementptr i8, ptr %p, i64 %aidx
+  %v = trunc i64 %r to i8
+  store i8 %v, ptr %gep                                 ; distinct window per row
+  %bp.next = add i64 %bp, 1
+  %cnt.next = add i64 %cnt, -1
+  %idone = icmp eq i64 %cnt.next, 0
+  br i1 %idone, label %inner.done, label %inner
+
+inner.done:
+  %r.next = add i64 %r, 1
+  %odone = icmp eq i64 %r.next, %rows
+  br i1 %odone, label %exit, label %outer
+
+guard.trap:
+  tail call void @llvm.trap()
+  unreachable
+
+oob.trap:
+  tail call void @llvm.trap()
+  unreachable
+
+exit:
+  ret void
+}
+
+declare void @llvm.trap()
