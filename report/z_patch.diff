diff --git a/llvm/test/Transforms/ConstraintElimination/add-nsw.ll b/llvm/test/Transforms/ConstraintElimination/add-nsw.ll
index 34a6ea0910e03..05b5b04f545e0 100644
--- a/llvm/test/Transforms/ConstraintElimination/add-nsw.ll
+++ b/llvm/test/Transforms/ConstraintElimination/add-nsw.ll
@@ -1166,3 +1166,43 @@ define i8 @add_nsw_no_nuw(i8 %x) {
   %add = add nsw i8 %x, 20
   ret i8 %add
 }
+
+; %x <=u 100 implies %x + 3 does not wrap unsigned, even though the exact
+; bound (UMAX - 3) is too large to be used as a constraint coefficient.
+define i64 @add_i64_gains_nuw_with_large_bound(i64 %x) {
+; CHECK-LABEL: @add_i64_gains_nuw_with_large_bound(
+; CHECK-NEXT:    [[C:%.*]] = icmp ule i64 [[X:%.*]], 100
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
+; CHECK-NEXT:    [[ADD:%.*]] = add nuw nsw i64 [[X]], 3
+; CHECK-NEXT:    ret i64 [[ADD]]
+;
+  %c = icmp ule i64 %x, 100
+  call void @llvm.assume(i1 %c)
+  %add = add i64 %x, 3
+  ret i64 %add
+}
+
+; No bound on %x, so no flags can be added.
+define i64 @add_i64_no_bound(i64 %x) {
+; CHECK-LABEL: @add_i64_no_bound(
+; CHECK-NEXT:    [[ADD:%.*]] = add i64 [[X:%.*]], 3
+; CHECK-NEXT:    ret i64 [[ADD]]
+;
+  %add = add i64 %x, 3
+  ret i64 %add
+}
+
+; %x <=u 2^63 also implies %x + 3 does not wrap unsigned, but neither the exact
+; bound nor the assumed one can be used as a constraint coefficient.
+define i64 @add_i64_bound_above_max_constraint_value(i64 %x) {
+; CHECK-LABEL: @add_i64_bound_above_max_constraint_value(
+; CHECK-NEXT:    [[C:%.*]] = icmp ule i64 [[X:%.*]], -9223372036854775808
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
+; CHECK-NEXT:    [[ADD:%.*]] = add i64 [[X]], 3
+; CHECK-NEXT:    ret i64 [[ADD]]
+;
+  %c = icmp ule i64 %x, -9223372036854775808
+  call void @llvm.assume(i1 %c)
+  %add = add i64 %x, 3
+  ret i64 %add
+}
