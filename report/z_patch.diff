+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt < %s -passes=instcombine -S | FileCheck %s
+
+declare void @llvm.assume(i1)
+
+define i32 @sdiv_nonnegative_sum_by_2(i32 noundef %x, i32 noundef %y) {
+; CHECK-LABEL: @sdiv_nonnegative_sum_by_2(
+; CHECK-NEXT:    [[TMP1:%.*]] = or i32 [[X:%.*]], [[Y:%.*]]
+; CHECK-NEXT:    [[OR_COND_NOT1:%.*]] = icmp sgt i32 [[TMP1]], -1
+; CHECK-NEXT:    call void @llvm.assume(i1 [[OR_COND_NOT1]])
+; CHECK-NEXT:    [[ADD:%.*]] = add nuw nsw i32 [[X]], [[Y]]
+; CHECK-NEXT:    [[DIV2:%.*]] = lshr i32 [[ADD]], 1
+; CHECK-NEXT:    ret i32 [[DIV2]]
+;
+  %cmp = icmp slt i32 %x, 0
+  %cmp1 = icmp slt i32 %y, 0
+  %or.cond = select i1 %cmp, i1 true, i1 %cmp1
+  %or.cond.not = xor i1 %or.cond, true
+  call void @llvm.assume(i1 %or.cond.not)
+  %add = add nsw i32 %x, %y
+  %div = sdiv i32 %add, 2
+  ret i32 %div
+}
+
+define i32 @sdiv_nonnegative_sum_by_4_three_operands(i32 noundef %x, i32 noundef %y, i32 noundef %z) local_unnamed_addr #0 {
+; CHECK-LABEL: @sdiv_nonnegative_sum_by_4_three_operands(
+; CHECK-NEXT:    [[CMP:%.*]] = icmp sgt i32 [[X:%.*]], 0
+; CHECK-NEXT:    [[TMP1:%.*]] = or i32 [[Z:%.*]], [[Y:%.*]]
+; CHECK-NEXT:    [[TMP2:%.*]] = icmp sgt i32 [[TMP1]], -1
+; CHECK-NEXT:    call void @llvm.assume(i1 [[CMP]])
+; CHECK-NEXT:    call void @llvm.assume(i1 [[TMP2]])
+; CHECK-NEXT:    [[ADD:%.*]] = add nuw nsw i32 [[X]], [[Y]]
+; CHECK-NEXT:    [[ADD4:%.*]] = add nuw nsw i32 [[ADD]], [[Z]]
+; CHECK-NEXT:    [[DIV2:%.*]] = lshr i32 [[ADD4]], 2
+; CHECK-NEXT:    ret i32 [[DIV2]]
+;
+  %cmp = icmp sle i32 %x, 0
+  %cmp1 = icmp slt i32 %y, 0
+  %or.cond = select i1 %cmp, i1 true, i1 %cmp1
+  %cmp3 = icmp slt i32 %z, 0
+  %or.cond5 = select i1 %or.cond, i1 true, i1 %cmp3
+  %or.cond5.not = xor i1 %or.cond5, true
+  call void @llvm.assume(i1 %or.cond5.not)
+  %add = add nsw i32 %x, %y
+  %add4 = add nsw i32 %add, %z
+  %div = sdiv i32 %add4, 4
+  ret i32 %div
+}
