diff --git a/llvm/test/Transforms/SROA/select-common-type.ll b/llvm/test/Transforms/SROA/select-common-type.ll
new file mode 100644
index 0000000000000..8be1f1695fa27
--- /dev/null
+++ b/llvm/test/Transforms/SROA/select-common-type.ll
@@ -0,0 +1,69 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
+; RUN: opt < %s -passes='sroa<modify-cfg>' -S | FileCheck %s
+
+%pair = type { i32, i32 }
+
+define i64 @load_same_type(i1 %cond, ptr %other) {
+; CHECK-LABEL: define i64 @load_same_type(
+; CHECK-SAME: i1 [[COND:%.*]], ptr [[OTHER:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    br i1 [[COND]], label %[[ENTRY_THEN:.*]], label %[[ENTRY_CONT:.*]]
+; CHECK:       [[ENTRY_THEN]]:
+; CHECK-NEXT:    [[VALUE_THEN_VAL:%.*]] = load i64, ptr [[OTHER]], align 8
+; CHECK-NEXT:    br label %[[ENTRY_CONT]]
+; CHECK:       [[ENTRY_CONT]]:
+; CHECK-NEXT:    [[VALUE:%.*]] = phi i64 [ [[VALUE_THEN_VAL]], %[[ENTRY_THEN]] ], [ 0, %[[ENTRY]] ]
+; CHECK-NEXT:    ret i64 [[VALUE]]
+;
+entry:
+  %zero = alloca %pair, align 8
+  store i64 0, ptr %zero, align 8
+  %addr = select i1 %cond, ptr %other, ptr %zero
+  %value = load i64, ptr %addr, align 8
+  ret i64 %value
+}
+
+define i64 @store_same_type(i64 %initial, i64 %value, i1 %cond, ptr %other) {
+; CHECK-LABEL: define i64 @store_same_type(
+; CHECK-SAME: i64 [[INITIAL:%.*]], i64 [[VALUE:%.*]], i1 [[COND:%.*]], ptr [[OTHER:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    br i1 [[COND]], label %[[ENTRY_THEN:.*]], label %[[ENTRY_ELSE:.*]]
+; CHECK:       [[ENTRY_THEN]]:
+; CHECK-NEXT:    br label %[[ENTRY_CONT:.*]]
+; CHECK:       [[ENTRY_ELSE]]:
+; CHECK-NEXT:    store i64 [[VALUE]], ptr [[OTHER]], align 8
+; CHECK-NEXT:    br label %[[ENTRY_CONT]]
+; CHECK:       [[ENTRY_CONT]]:
+; CHECK-NEXT:    [[TEMPORARY_SROA_0_0:%.*]] = phi i64 [ [[VALUE]], %[[ENTRY_THEN]] ], [ [[INITIAL]], %[[ENTRY_ELSE]] ]
+; CHECK-NEXT:    ret i64 [[TEMPORARY_SROA_0_0]]
+;
+entry:
+  %temporary = alloca %pair, align 8
+  store i64 %initial, ptr %temporary, align 8
+  %addr = select i1 %cond, ptr %temporary, ptr %other
+  store i64 %value, ptr %addr, align 8
+  %result = load i64, ptr %temporary, align 8
+  ret i64 %result
+}
+
+define i64 @mixed_types(i1 %cond, ptr %other) {
+; CHECK-LABEL: define i64 @mixed_types(
+; CHECK-SAME: i1 [[COND:%.*]], ptr [[OTHER:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[TEMPORARY:%.*]] = alloca [[PAIR:%.*]], align 8
+; CHECK-NEXT:    store i64 0, ptr [[TEMPORARY]], align 8
+; CHECK-NEXT:    [[ADDR:%.*]] = select i1 [[COND]], ptr [[TEMPORARY]], ptr [[OTHER]]
+; CHECK-NEXT:    [[LOW:%.*]] = load i32, ptr [[ADDR]], align 4
+; CHECK-NEXT:    store i32 [[LOW]], ptr [[ADDR]], align 4
+; CHECK-NEXT:    [[WHOLE:%.*]] = load i64, ptr [[ADDR]], align 8
+; CHECK-NEXT:    ret i64 [[WHOLE]]
+;
+entry:
+  %temporary = alloca %pair, align 8
+  store i64 0, ptr %temporary, align 8
+  %addr = select i1 %cond, ptr %temporary, ptr %other
+  %low = load i32, ptr %addr, align 4
+  store i32 %low, ptr %addr, align 4
+  %whole = load i64, ptr %addr, align 8
+  ret i64 %whole
+}
