+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=indvars -S < %s | FileCheck %s
+
+define i1 @bounds_check_sle_sub_rhs(i64 %n) {
+; CHECK-LABEL: define i1 @bounds_check_sle_sub_rhs(
+; CHECK-SAME: i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[GUARD:%.*]] = icmp sgt i64 [[N]], 31
+; CHECK-NEXT:    br i1 [[GUARD]], label %[[LOOP_PREHEADER:.*]], label %[[EXIT:.*]]
+; CHECK:       [[LOOP_PREHEADER]]:
+; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[N]], 31
+; CHECK-NEXT:    [[TMP1:%.*]] = lshr i64 [[TMP0]], 5
+; CHECK-NEXT:    [[TMP2:%.*]] = add i64 [[N]], -32
+; CHECK-NEXT:    [[TMP3:%.*]] = lshr i64 [[TMP2]], 5
+; CHECK-NEXT:    [[UMIN:%.*]] = call i64 @llvm.umin.i64(i64 [[TMP3]], i64 [[TMP1]])
+; CHECK-NEXT:    [[TMP4:%.*]] = icmp ne i64 [[TMP1]], [[UMIN]]
+; CHECK-NEXT:    [[TMP5:%.*]] = icmp eq i64 [[TMP3]], [[UMIN]]
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    br i1 [[TMP4]], label %[[LATCH:.*]], label %[[OUT_OF_BOUNDS:.*]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    br i1 [[TMP5]], label %[[EXIT_LOOPEXIT:.*]], label %[[LOOP]]
+; CHECK:       [[EXIT_LOOPEXIT]]:
+; CHECK-NEXT:    br label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 true
+; CHECK:       [[OUT_OF_BOUNDS]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %guard = icmp sgt i64 %n, 31
+  br i1 %guard, label %loop, label %exit
+
+loop:
+  %iv = phi i64 [ %iv.next, %latch ], [ 0, %entry ]
+  %inbounds = icmp ult i64 %iv, %n
+  br i1 %inbounds, label %latch, label %out.of.bounds
+
+latch:
+  %iv.next = add nuw nsw i64 %iv, 32
+  %end = add i64 %n, -32
+  %done = icmp slt i64 %end, %iv.next
+  br i1 %done, label %exit, label %loop
+
+exit:
+  ret i1 true
+
+out.of.bounds:
+  ret i1 false
+}
