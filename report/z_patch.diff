+bool ScheduleDAGDependencyBuilder::addChainDependency(SUnit *SUa, SUnit *SUb,
+                                                      unsigned Latency) {
+  if (!SUa->getInstr()->mayAlias(AA, *SUb->getInstr(), UseTBAA))
+    return false;
+
+  SDep Dep(SUa, SDep::MayAliasMem);
+  Dep.setLatency(Latency);
+  SUb->addPred(Dep);
+  return true;
