+; CHECK-NEXT:    br i1 [[COND]], label %[[CALL1:.*]], label %[[CALL0:.*]]
+; CHECK:       [[CALL0]]:
+; CHECK-NEXT:    [[VALUELESS:%.*]] = icmp eq i32 [[IDX]], -1
+; CHECK-NEXT:    br i1 [[VALUELESS]], label %[[DONE:.*]], label %[[DISPATCH:.*]]
+; CHECK:       [[DISPATCH]]:
+; CHECK-NEXT:    [[IS0:%.*]] = icmp eq i32 [[IDX]], 0
+; CHECK-NEXT:    [[INRANGE1:%.*]] = icmp ult i32 [[IDX]], 2
+; CHECK-NEXT:    call void @llvm.assume(i1 [[INRANGE1]])
+; CHECK-NEXT:    br i1 [[IS0]], label %[[CALL2:.*]], label %[[CALL1]]
+; CHECK:       [[CALL2]]:
+; CHECK-NEXT:    call void @fun0(i32 [[IDX]])
+; CHECK-NEXT:    br label %[[DONE]]
+; CHECK:       [[CALL1]]:
+; CHECK-NEXT:    call void @fun1(i32 [[IDX]])
+; CHECK-NEXT:    br label %[[DONE]]
+; CHECK:       [[DONE]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %cond = call i1 @dynamic_cond()
+  br i1 %cond, label %call1, label %original_entry
+
+original_entry:
+  %valueless = icmp eq i32 %idx, -1
+  br i1 %valueless, label %done, label %dispatch
+
+dispatch:
+  %is0 = icmp eq i32 %idx, 0
+  %inrange = icmp ult i32 %idx, 2
+  call void @llvm.assume(i1 %inrange)
+  br i1 %is0, label %call0, label %call1
+
+call0:
+  call void @fun0(i32 %idx)
+  br label %done
+
+call1:
+  call void @fun1(i32 %idx)
+  br label %done
+
+done:
+  ret void
