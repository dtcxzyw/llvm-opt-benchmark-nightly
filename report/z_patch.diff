+define void @retry_folds_constants(i16 %x, i16 %y) {
+; CHECK-LABEL: define void @retry_folds_constants(
+; CHECK-SAME: i16 [[X:%.*]], i16 [[Y:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[ADD:%.*]] = add nsw i16 [[X]], [[Y]]
+; CHECK-NEXT:    [[C:%.*]] = icmp ult i16 [[ADD]], 100
+; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    call void @use(i1 true)
+; CHECK-NEXT:    [[T_2:%.*]] = icmp ult i16 [[ADD]], 50
+; CHECK-NEXT:    call void @use(i1 [[T_2]])
+; CHECK-NEXT:    ret void
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %add = add nsw i16 %x, %y
+  %c = icmp ult i16 %add, 100
+  br i1 %c, label %then, label %exit
+
+then:
+  %t.1 = icmp ult i16 %add, 200
+  call void @use(i1 %t.1)
+  %t.2 = icmp ult i16 %add, 50
+  call void @use(i1 %t.2)
+  ret void
+
+exit:
+  ret void
+}
