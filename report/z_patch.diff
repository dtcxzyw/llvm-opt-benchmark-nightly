diff --git a/llvm/lib/Transforms/InstCombine/InstCombineLoadStoreAlloca.cpp b/llvm/lib/Transforms/InstCombine/InstCombineLoadStoreAlloca.cpp
index 0e917fb55aa1e..e04eaa66fb9c3 100644
--- a/llvm/lib/Transforms/InstCombine/InstCombineLoadStoreAlloca.cpp
+++ b/llvm/lib/Transforms/InstCombine/InstCombineLoadStoreAlloca.cpp
@@ -1466,6 +1466,26 @@ Instruction *InstCombinerImpl::visitStoreInst(StoreInst &SI) {
   Value *Val = SI.getOperand(0);
   Value *Ptr = SI.getOperand(1);
 
+  // If the stored value is a zext or sext of an i1 that is implied by a
+  // dominating branch condition, fold to the known constant value.
+  // e.g. given: br i1 %cond, label %true, label %false
+  //      in %false: store i8 (zext i1 %cond to i8) --> store i8 0
+  {
+    Value *Src;
+    bool IsZExt = match(Val, m_ZExt(m_Value(Src)));
+    bool IsSExt = !IsZExt && match(Val, m_SExt(m_Value(Src)));
+    if ((IsZExt || IsSExt) && Src->getType()->isIntegerTy(1)) {
+      if (auto Known = isImpliedByDomCondition(Src, &SI, DL)) {
+        unsigned Width = Val->getType()->getScalarSizeInBits();
+        APInt ConstVal =
+            *Known ? (IsZExt ? APInt(Width, 1) : APInt::getAllOnes(Width))
+                   : APInt::getZero(Width);
+        return replaceOperand(SI, 0,
+                              ConstantInt::get(Val->getType(), ConstVal));
+      }
+    }
+  }
+
   // Try to canonicalize the stored type.
   if (combineStoreToValueType(*this, SI))
     return eraseInstFromFunction(SI);
diff --git a/llvm/test/Transforms/CorrelatedValuePropagation/store-const-fold.ll b/llvm/test/Transforms/CorrelatedValuePropagation/store-const-fold.ll
new file mode 100644
index 0000000000000..7b97f6d56f7b4
--- /dev/null
+++ b/llvm/test/Transforms/CorrelatedValuePropagation/store-const-fold.ll
@@ -0,0 +1,258 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt -S -passes=instcombine < %s | FileCheck %s
+
+; Basic case from issue #138636: zext(i1) stored in the false-branch successor
+; should be folded to 0 because the branch condition is known false there.
+define void @zext_i1_false_branch(ptr writeonly %p0, i1 %cond, ptr writeonly %p1) {
+; CHECK-LABEL: @zext_i1_false_branch(
+; CHECK-NEXT:    [[EXT:%.*]] = zext i1 [[COND:%.*]] to i8
+; CHECK-NEXT:    store i8 [[EXT]], ptr [[P0:%.*]], align 1
+; CHECK-NEXT:    br i1 [[COND]], label [[TRUE:%.*]], label [[FALSE:%.*]]
+; CHECK:       false:
+; CHECK-NEXT:    store i8 0, ptr [[P1:%.*]], align 1
+; CHECK-NEXT:    br label [[END:%.*]]
+; CHECK:       true:
+; CHECK-NEXT:    br label [[END]]
+; CHECK:       end:
+; CHECK-NEXT:    ret void
+;
+  %ext = zext i1 %cond to i8
+  store i8 %ext, ptr %p0, align 1
+  br i1 %cond, label %true, label %false
+
+false:
+  store i8 %ext, ptr %p1, align 1
+  br label %end
+
+true:
+  br label %end
+
+end:
+  ret void
+}
+
+; In the true-branch, zext(i1 true) == 1.
+define void @zext_i1_true_branch(ptr writeonly %p0, i1 %cond, ptr writeonly %p1) {
+; CHECK-LABEL: @zext_i1_true_branch(
+; CHECK-NEXT:    [[EXT:%.*]] = zext i1 [[COND:%.*]] to i8
+; CHECK-NEXT:    store i8 [[EXT]], ptr [[P0:%.*]], align 1
+; CHECK-NEXT:    br i1 [[COND]], label [[TRUE:%.*]], label [[FALSE:%.*]]
+; CHECK:       false:
+; CHECK-NEXT:    br label [[END:%.*]]
+; CHECK:       true:
+; CHECK-NEXT:    store i8 1, ptr [[P1:%.*]], align 1
+; CHECK-NEXT:    br label [[END]]
+; CHECK:       end:
+; CHECK-NEXT:    ret void
+;
+  %ext = zext i1 %cond to i8
+  store i8 %ext, ptr %p0, align 1
+  br i1 %cond, label %true, label %false
+
+false:
+  br label %end
+
+true:
+  store i8 %ext, ptr %p1, align 1
+  br label %end
+
+end:
+  ret void
+}
+
+; The entry block store cannot be folded — %cond is not yet known there.
+define void @no_fold_in_entry(ptr writeonly %p0, i1 %cond) {
+; CHECK-LABEL: @no_fold_in_entry(
+; CHECK-NEXT:    [[EXT:%.*]] = zext i1 [[COND:%.*]] to i8
+; CHECK-NEXT:    store i8 [[EXT]], ptr [[P0:%.*]], align 1
+; CHECK-NEXT:    br i1 [[COND]], label [[TRUE:%.*]], label [[FALSE:%.*]]
+; CHECK:       false:
+; CHECK-NEXT:    br label [[END:%.*]]
+; CHECK:       true:
+; CHECK-NEXT:    br label [[END]]
+; CHECK:       end:
+; CHECK-NEXT:    ret void
+;
+  %ext = zext i1 %cond to i8
+  store i8 %ext, ptr %p0, align 1
+  br i1 %cond, label %true, label %false
+
+false:
+  br label %end
+
+true:
+  br label %end
+
+end:
+  ret void
+}
+
+; zext i1 to i32 variant.
+define void @zext_i1_to_i32_false_branch(ptr writeonly %p0, i1 %cond, ptr writeonly %p1) {
+; CHECK-LABEL: @zext_i1_to_i32_false_branch(
+; CHECK-NEXT:    [[EXT:%.*]] = zext i1 [[COND:%.*]] to i32
+; CHECK-NEXT:    store i32 [[EXT]], ptr [[P0:%.*]], align 4
+; CHECK-NEXT:    br i1 [[COND]], label [[TRUE:%.*]], label [[FALSE:%.*]]
+; CHECK:       false:
+; CHECK-NEXT:    store i32 0, ptr [[P1:%.*]], align 4
+; CHECK-NEXT:    br label [[END:%.*]]
+; CHECK:       true:
+; CHECK-NEXT:    br label [[END]]
+; CHECK:       end:
+; CHECK-NEXT:    ret void
+;
+  %ext = zext i1 %cond to i32
+  store i32 %ext, ptr %p0, align 4
+  br i1 %cond, label %true, label %false
+
+false:
+  store i32 %ext, ptr %p1, align 4
+  br label %end
+
+true:
+  br label %end
+
+end:
+  ret void
+}
+
+; sext i1: false -> 0, true -> -1.
+define void @sext_i1_false_branch(ptr writeonly %p0, i1 %cond, ptr writeonly %p1) {
+; CHECK-LABEL: @sext_i1_false_branch(
+; CHECK-NEXT:    [[EXT:%.*]] = sext i1 [[COND:%.*]] to i8
+; CHECK-NEXT:    store i8 [[EXT]], ptr [[P0:%.*]], align 1
+; CHECK-NEXT:    br i1 [[COND]], label [[TRUE:%.*]], label [[FALSE:%.*]]
+; CHECK:       false:
+; CHECK-NEXT:    store i8 0, ptr [[P1:%.*]], align 1
+; CHECK-NEXT:    br label [[END:%.*]]
+; CHECK:       true:
+; CHECK-NEXT:    br label [[END]]
+; CHECK:       end:
+; CHECK-NEXT:    ret void
+;
+  %ext = sext i1 %cond to i8
+  store i8 %ext, ptr %p0, align 1
+  br i1 %cond, label %true, label %false
+
+false:
+  store i8 %ext, ptr %p1, align 1
+  br label %end
+
+true:
+  br label %end
+
+end:
+  ret void
+}
+
+define void @sext_i1_true_branch(ptr writeonly %p0, i1 %cond, ptr writeonly %p1) {
+; CHECK-LABEL: @sext_i1_true_branch(
+; CHECK-NEXT:    [[EXT:%.*]] = sext i1 [[COND:%.*]] to i8
+; CHECK-NEXT:    store i8 [[EXT]], ptr [[P0:%.*]], align 1
+; CHECK-NEXT:    br i1 [[COND]], label [[TRUE:%.*]], label [[FALSE:%.*]]
+; CHECK:       false:
+; CHECK-NEXT:    br label [[END:%.*]]
+; CHECK:       true:
+; CHECK-NEXT:    store i8 -1, ptr [[P1:%.*]], align 1
+; CHECK-NEXT:    br label [[END]]
+; CHECK:       end:
+; CHECK-NEXT:    ret void
+;
+  %ext = sext i1 %cond to i8
+  store i8 %ext, ptr %p0, align 1
+  br i1 %cond, label %true, label %false
+
+false:
+  br label %end
+
+true:
+  store i8 %ext, ptr %p1, align 1
+  br label %end
+
+end:
+  ret void
+}
+
+; icmp-derived condition: zext(icmp eq %x, 0) stored in the false block -> 0.
+define void @zext_icmp_false_branch(ptr writeonly %p0, i32 %x, ptr writeonly %p1) {
+; CHECK-LABEL: @zext_icmp_false_branch(
+; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[X:%.*]], 0
+; CHECK-NEXT:    [[EXT:%.*]] = zext i1 [[CMP]] to i8
+; CHECK-NEXT:    store i8 [[EXT]], ptr [[P0:%.*]], align 1
+; CHECK-NEXT:    br i1 [[CMP]], label [[TRUE:%.*]], label [[FALSE:%.*]]
+; CHECK:       false:
+; CHECK-NEXT:    store i8 0, ptr [[P1:%.*]], align 1
+; CHECK-NEXT:    br label [[END:%.*]]
+; CHECK:       true:
+; CHECK-NEXT:    br label [[END]]
+; CHECK:       end:
+; CHECK-NEXT:    ret void
+;
+  %cmp = icmp eq i32 %x, 0
+  %ext = zext i1 %cmp to i8
+  store i8 %ext, ptr %p0, align 1
+  br i1 %cmp, label %true, label %false
+
+false:
+  store i8 %ext, ptr %p1, align 1
+  br label %end
+
+true:
+  br label %end
+
+end:
+  ret void
+}
+
+; Value unrelated to the branch — must NOT fold.
+define void @unrelated_val_no_fold(ptr writeonly %p, i8 %val, i1 %cond) {
+; CHECK-LABEL: @unrelated_val_no_fold(
+; CHECK-NEXT:    br i1 [[COND:%.*]], label [[TRUE:%.*]], label [[FALSE:%.*]]
+; CHECK:       false:
+; CHECK-NEXT:    store i8 [[VAL:%.*]], ptr [[P:%.*]], align 1
+; CHECK-NEXT:    br label [[END:%.*]]
+; CHECK:       true:
+; CHECK-NEXT:    br label [[END]]
+; CHECK:       end:
+; CHECK-NEXT:    ret void
+;
+  br i1 %cond, label %true, label %false
+
+false:
+  store i8 %val, ptr %p, align 1
+  br label %end
+
+true:
+  br label %end
+
+end:
+  ret void
+}
+
+; Multiple predecessors — isImpliedByDomCondition requires a single predecessor,
+; so no fold should happen here.
+define void @multi_pred_no_fold(ptr %p, i1 %c1, i1 %c2) {
+; CHECK-LABEL: @multi_pred_no_fold(
+; CHECK-NEXT:    br i1 [[C2:%.*]], label [[BB1:%.*]], label [[BB2:%.*]]
+; CHECK:       bb1:
+; CHECK-NEXT:    br label [[MERGE:%.*]]
+; CHECK:       bb2:
+; CHECK-NEXT:    br label [[MERGE]]
+; CHECK:       merge:
+; CHECK-NEXT:    [[EXT:%.*]] = zext i1 [[C1:%.*]] to i8
+; CHECK-NEXT:    store i8 [[EXT]], ptr [[P:%.*]], align 1
+; CHECK-NEXT:    ret void
+;
+  %ext = zext i1 %c1 to i8
+  br i1 %c2, label %bb1, label %bb2
+
+bb1:
+  br label %merge
+
+bb2:
+  br label %merge
+
+merge:
+  store i8 %ext, ptr %p, align 1
+  ret void
+}
