+; CHECK-NEXT:    [[A:%.*]] = add i64 [[Q]], [[Y]]
+; CHECK-NEXT:    [[C:%.*]] = icmp ule i64 [[A]], [[Z]]
+; CHECK-NEXT:    ret i1 [[C]]
