+; PRESERVE-NEXT:    [[VALUE:%.*]] = load i64, ptr [[ADDR]], align 8
+; PRESERVE-NEXT:    ret i64 [[VALUE]]
+;
+; CHECK-LABEL: define i64 @load_same_type(
+; CHECK-SAME: i1 [[COND:%.*]], ptr [[OTHER:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    br i1 [[COND]], label %[[ENTRY_THEN:.*]], label %[[ENTRY_CONT:.*]]
+; CHECK:       [[ENTRY_THEN]]:
+; CHECK-NEXT:    [[VALUE_THEN_VAL:%.*]] = load i64, ptr [[OTHER]], align 8
+; CHECK-NEXT:    br label %[[ENTRY_CONT]]
+; CHECK:       [[ENTRY_CONT]]:
+; CHECK-NEXT:    [[VALUE:%.*]] = phi i64 [ [[VALUE_THEN_VAL]], %[[ENTRY_THEN]] ], [ 0, %[[ENTRY]] ]
+; CHECK-NEXT:    ret i64 [[VALUE]]
+;
+entry:
+  %zero = alloca %pair, align 8
+  store i64 0, ptr %zero, align 8
+  %addr = select i1 %cond, ptr %other, ptr %zero
+  %value = load i64, ptr %addr, align 8
+  ret i64 %value
+}
+
+define i64 @store_same_type(i64 %initial, i64 %value, i1 %cond, ptr %other) {
+; PRESERVE-LABEL: define i64 @store_same_type(
+; PRESERVE:         [[TEMPORARY:%.*]] = alloca [[PAIR:%.*]], align 8
+; PRESERVE-NEXT:    store i64 [[INITIAL:%.*]], ptr [[TEMPORARY]], align 8
+; PRESERVE-NEXT:    [[ADDR:%.*]] = select i1 {{%.*}}, ptr [[TEMPORARY]], ptr [[OTHER:%.*]]
+; PRESERVE-NEXT:    store i64 [[VALUE:%.*]], ptr [[ADDR]], align 8
+; PRESERVE-NEXT:    [[RESULT:%.*]] = load i64, ptr [[TEMPORARY]], align 8
+; PRESERVE-NEXT:    ret i64 [[RESULT]]
+;
+; CHECK-LABEL: define i64 @store_same_type(
+; CHECK-SAME: i64 [[INITIAL:%.*]], i64 [[VALUE:%.*]], i1 [[COND:%.*]], ptr [[OTHER:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    br i1 [[COND]], label %[[ENTRY_THEN:.*]], label %[[ENTRY_ELSE:.*]]
+; CHECK:       [[ENTRY_THEN]]:
+; CHECK-NEXT:    br label %[[ENTRY_CONT:.*]]
+; CHECK:       [[ENTRY_ELSE]]:
+; CHECK-NEXT:    store i64 [[VALUE]], ptr [[OTHER]], align 8
+; CHECK-NEXT:    br label %[[ENTRY_CONT]]
+; CHECK:       [[ENTRY_CONT]]:
+; CHECK-NEXT:    [[TEMPORARY_SROA_0_0:%.*]] = phi i64 [ [[VALUE]], %[[ENTRY_THEN]] ], [ [[INITIAL]], %[[ENTRY_ELSE]] ]
+; CHECK-NEXT:    ret i64 [[TEMPORARY_SROA_0_0]]
