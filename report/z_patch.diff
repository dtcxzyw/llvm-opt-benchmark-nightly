+; CHECK-NEXT:    %iv.next = add nsw i16 %iv, 1
+; CHECK-NEXT:    --> {(1 + %start),+,1}<nsw><%loop> U: full-set S: full-set Exits: 2 LoopDispositions: { %loop: Computable }
+; CHECK-NEXT:    %and = and i1 %c.1, %c.2
