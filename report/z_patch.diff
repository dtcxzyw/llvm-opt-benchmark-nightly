+  %gep.a.2 = getelementptr inbounds [12 x i8], ptr %a, i64 %idx.2
+  %l.a.2 = load float, ptr %gep.a.2, align 4
+  %gep.b.2 = getelementptr inbounds [12 x i8], ptr %b, i64 %idx.2
