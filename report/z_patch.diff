+; SIZE-DAG: minsize_extended_offset T {{[0-9a-f]+}} 20{{$}}
+; SIZE-DAG: narrow_odd_type T {{[0-9a-f]+}} 22{{$}}
+; SIZE-DAG: nonfree_extension T {{[0-9a-f]+}} 35{{$}}
