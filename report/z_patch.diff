+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=sroa -S < %s | FileCheck %s
+
+; Allocas of sub-byte element vectors are promoted as vectors of their own
+; type.
+
+; Byte 1 of a <8 x i4> is overwritten, so lanes 2 and 3 are replaced.
+define void @rmw_b4_n8(ptr %in, ptr %replacement, ptr %out) {
+; CHECK-LABEL: define void @rmw_b4_n8(
+; CHECK-SAME: ptr [[IN:%.*]], ptr [[REPLACEMENT:%.*]], ptr [[OUT:%.*]]) {
+; CHECK-NEXT:    [[V:%.*]] = load <8 x i4>, ptr [[IN]], align 1
+; CHECK-NEXT:    [[X:%.*]] = load <2 x i4>, ptr [[REPLACEMENT]], align 1
+; CHECK-NEXT:    [[A_1_VEC_EXPAND:%.*]] = shufflevector <2 x i4> [[X]], <2 x i4> poison, <8 x i32> <i32 poison, i32 poison, i32 0, i32 1, i32 poison, i32 poison, i32 poison, i32 poison>
+; CHECK-NEXT:    [[A_1_VECBLEND:%.*]] = shufflevector <8 x i4> [[A_1_VEC_EXPAND]], <8 x i4> [[V]], <8 x i32> <i32 8, i32 9, i32 2, i32 3, i32 12, i32 13, i32 14, i32 15>
+; CHECK-NEXT:    store <8 x i4> [[A_1_VECBLEND]], ptr [[OUT]], align 1
+; CHECK-NEXT:    ret void
+;
+  %v = load <8 x i4>, ptr %in, align 1
+  %x = load <2 x i4>, ptr %replacement, align 1
+  %a = alloca <8 x i4>, align 16
+  store <8 x i4> %v, ptr %a, align 16
+  %p = getelementptr inbounds i8, ptr %a, i64 1
+  store <2 x i4> %x, ptr %p, align 1
+  %r = load <8 x i4>, ptr %a, align 16
+  store <8 x i4> %r, ptr %out, align 1
+  ret void
+}
+
+; A memset of bytes 2 to 5 sets lanes 4 to 11 from the splatted bytes.
+define <16 x i4> @memset_bytes(<16 x i4> %v, i8 %c) {
+; CHECK-LABEL: define <16 x i4> @memset_bytes(
+; CHECK-SAME: <16 x i4> [[V:%.*]], i8 [[C:%.*]]) {
+; CHECK-NEXT:    [[A_2_ZEXT:%.*]] = zext i8 [[C]] to i32
+; CHECK-NEXT:    [[A_2_ISPLAT:%.*]] = mul i32 [[A_2_ZEXT]], 16843009
+; CHECK-NEXT:    [[TMP1:%.*]] = bitcast i32 [[A_2_ISPLAT]] to <8 x i4>
+; CHECK-NEXT:    [[A_2_VEC_EXPAND:%.*]] = shufflevector <8 x i4> [[TMP1]], <8 x i4> poison, <16 x i32> <i32 poison, i32 poison, i32 poison, i32 poison, i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 poison, i32 poison, i32 poison, i32 poison>
+; CHECK-NEXT:    [[A_2_VECBLEND:%.*]] = shufflevector <16 x i4> [[A_2_VEC_EXPAND]], <16 x i4> [[V]], <16 x i32> <i32 16, i32 17, i32 18, i32 19, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 28, i32 29, i32 30, i32 31>
+; CHECK-NEXT:    ret <16 x i4> [[A_2_VECBLEND]]
+;
+  %a = alloca <16 x i4>, align 8
+  store <16 x i4> %v, ptr %a, align 8
+  %p = getelementptr inbounds i8, ptr %a, i64 2
+  call void @llvm.memset.p0.i64(ptr align 2 %p, i8 %c, i64 4, i1 false)
+  %r = load <16 x i4>, ptr %a, align 8
+  ret <16 x i4> %r
+}
+
+; A memcpy of two bytes into offset 1 replaces lanes 2 to 5.
+define <8 x i4> @memcpy_bytes(<8 x i4> %v, ptr %src) {
+; CHECK-LABEL: define <8 x i4> @memcpy_bytes(
+; CHECK-SAME: <8 x i4> [[V:%.*]], ptr [[SRC:%.*]]) {
+; CHECK-NEXT:    [[A_1_COPYLOAD:%.*]] = load <4 x i4>, ptr [[SRC]], align 1
+; CHECK-NEXT:    [[A_1_VEC_EXPAND:%.*]] = shufflevector <4 x i4> [[A_1_COPYLOAD]], <4 x i4> poison, <8 x i32> <i32 poison, i32 poison, i32 0, i32 1, i32 2, i32 3, i32 poison, i32 poison>
+; CHECK-NEXT:    [[A_1_VECBLEND:%.*]] = shufflevector <8 x i4> [[A_1_VEC_EXPAND]], <8 x i4> [[V]], <8 x i32> <i32 8, i32 9, i32 2, i32 3, i32 4, i32 5, i32 14, i32 15>
+; CHECK-NEXT:    ret <8 x i4> [[A_1_VECBLEND]]
+;
+  %a = alloca <8 x i4>, align 4
+  store <8 x i4> %v, ptr %a, align 4
+  %p = getelementptr inbounds i8, ptr %a, i64 1
+  call void @llvm.memcpy.p0.p0.i64(ptr align 1 %p, ptr align 1 %src, i64 2, i1 false)
+  %r = load <8 x i4>, ptr %a, align 4
+  ret <8 x i4> %r
+}
+
+; A <64 x i4> written whole and read back in 16-byte halves.
+define void @i4_halves(<64 x i4> %v, ptr %out) {
+; CHECK-LABEL: define void @i4_halves(
+; CHECK-SAME: <64 x i4> [[V:%.*]], ptr [[OUT:%.*]]) {
+; CHECK-NEXT:    [[A_0_VEC_EXTRACT:%.*]] = shufflevector <64 x i4> [[V]], <64 x i4> poison, <32 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15, i32 16, i32 17, i32 18, i32 19, i32 20, i32 21, i32 22, i32 23, i32 24, i32 25, i32 26, i32 27, i32 28, i32 29, i32 30, i32 31>
