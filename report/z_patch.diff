+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes='default<O3>' -S %s | FileCheck %s
+
+; Reduced from C:
+;
+;   long sum_every_other(const long *a, long n) {
+;     if (n <= 0) return 0;
+;     long s = 0, i = 0;
+;     do {
+;       if ((unsigned long)i >= (unsigned long)n) abort();
+;       s += a[i];
+;       i += 2;
+;     } while (i < n);
+;     return s;
+;   }
+;
+; The bounds check is redundant: the loop only comes back round while i + 2 is
+; still below n, so i stays below n. Constraint elimination derives that from
+; the inequality latch on the post-increment, and the call to abort() is gone
+; end to end.
+
+target datalayout = "e-m:o-i64:64-i128:128-n32:64-S128"
+
+declare void @abort() noreturn
+
+define i64 @sum_every_other(ptr %a, i64 %n) {
+; CHECK-LABEL: define i64 @sum_every_other(
+; CHECK-SAME: ptr nofree readonly captures(none) [[A:%.*]], i64 [[N:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i64 [[N]], 1
+; CHECK-NEXT:    br i1 [[CMP]], label %[[RETURN:.*]], label %[[DO_BODY:.*]]
+; CHECK:       [[DO_BODY]]:
+; CHECK-NEXT:    [[S:%.*]] = phi i64 [ [[ADD:%.*]], %[[DO_BODY]] ], [ 0, %[[ENTRY]] ]
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[INEXT:%.*]], %[[DO_BODY]] ], [ 0, %[[ENTRY]] ]
+; CHECK-NEXT:    [[ARRAYIDX:%.*]] = getelementptr inbounds nuw [8 x i8], ptr [[A]], i64 [[I]]
+; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[ARRAYIDX]], align 8
+; CHECK-NEXT:    [[ADD]] = add nsw i64 [[V]], [[S]]
+; CHECK-NEXT:    [[INEXT]] = add nuw nsw i64 [[I]], 2
+; CHECK-NEXT:    [[CMP5:%.*]] = icmp slt i64 [[INEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[CMP5]], label %[[DO_BODY]], label %[[RETURN]]
+; CHECK:       [[RETURN]]:
+; CHECK-NEXT:    [[R:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[ADD]], %[[DO_BODY]] ]
+; CHECK-NEXT:    ret i64 [[R]]
+;
+entry:
+  %cmp = icmp sle i64 %n, 0
+  br i1 %cmp, label %return, label %ph
+
+ph:
+  br label %do.body
+
+do.body:
+  %s = phi i64 [ 0, %ph ], [ %add, %do.cond ]
+  %i = phi i64 [ 0, %ph ], [ %inext, %do.cond ]
+  %oob = icmp uge i64 %i, %n
+  br i1 %oob, label %trap, label %do.cond
+
+do.cond:
+  %arrayidx = getelementptr inbounds i64, ptr %a, i64 %i
+  %v = load i64, ptr %arrayidx, align 8
+  %add = add nsw i64 %s, %v
+  %inext = add nsw i64 %i, 2
+  %cmp5 = icmp slt i64 %inext, %n
+  br i1 %cmp5, label %do.body, label %return
+
+trap:
+  call void @abort()
+  unreachable
+
+return:
+  %r = phi i64 [ 0, %entry ], [ %add, %do.cond ]
+  ret i64 %r
+}
