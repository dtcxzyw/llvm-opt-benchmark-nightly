diff --git a/llvm/lib/Analysis/ScalarEvolution.cpp b/llvm/lib/Analysis/ScalarEvolution.cpp
index 4df043b434b01..0bae3c6c4bdb6 100644
--- a/llvm/lib/Analysis/ScalarEvolution.cpp
+++ b/llvm/lib/Analysis/ScalarEvolution.cpp
@@ -16209,6 +16209,33 @@ void ScalarEvolution::LoopGuards::collectFromBlock(
     }
   }
 
+  // Conditions (A <=u B) and (B <=u A + C) with a constant C bound the
+  // difference B - A, which cannot wrap: B - A <=u C. Add the derived bound,
+  // as trip counts of loops counting from A up to B are expressed in terms of
+  // that difference.
+  SmallDenseSet<std::pair<const SCEV *, const SCEV *>> ULessEqual;
+  for (auto [Pred, LHS, RHS] : GuardsToProcess)
+    if (Pred == ICmpInst::ICMP_ULT || Pred == ICmpInst::ICMP_ULE)
+      ULessEqual.insert({LHS, RHS});
+  for (unsigned I = 0, E = GuardsToProcess.size(); I != E; ++I) {
+    auto [Pred, B, UB] = GuardsToProcess[I];
+    const APInt *C;
+    const SCEV *A;
+    if ((Pred != ICmpInst::ICMP_ULT && Pred != ICmpInst::ICMP_ULE) ||
+        !match(UB, m_scev_Add(m_scev_APInt(C), m_SCEV(A))) ||
+        !ULessEqual.contains({A, B}))
+      continue;
+    APInt Bound = *C;
+    if (Pred == ICmpInst::ICMP_ULT) {
+      // B <u A + 0 contradicts A <=u B, there is no bound to derive.
+      if (Bound.isZero())
+        continue;
+      --Bound;
+    }
+    GuardsToProcess.emplace_back(ICmpInst::ICMP_ULE, SE.getMinusSCEV(B, A),
+                                 SE.getConstant(Bound));
+  }
+
   // Process divisibility guards in reverse order to populate DivGuards early.
   DenseMap<const SCEV *, APInt> Multiples;
   LoopGuards DivGuards(SE);
