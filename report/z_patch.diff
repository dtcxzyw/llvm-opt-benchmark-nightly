+  %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop.latch ]
+  %c.1 = icmp ule i8 %iv, %n
+  call void @use(i1 %c.1)
+  br i1 %c, label %loop.body, label %exit
+
+loop.body:
+  %cmp = icmp ult i8 %iv, %n
+  br i1 %cmp, label %loop.latch, label %exit
+
+loop.latch:
+  %iv.next = add i8 %iv, 1
+  br label %loop.header
+
+exit:
+  ret void
+}
+
+; The loop has two latches. The bound would hold, but this is
+; not handled yet.
+define void @neg_two_latches(i8 %n, i1 %c) {
+;
+;
+; CHECK-LABEL: define void @neg_two_latches(
+; CHECK-SAME: i8 [[N:%.*]], i1 [[C:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
+; CHECK:       [[LOOP_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i8 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LATCH_1:.*]] ], [ [[IV_NEXT]], %[[LATCH_2:.*]] ]
+; CHECK-NEXT:    [[C_1:%.*]] = icmp ule i8 [[IV]], [[N]]
+; CHECK-NEXT:    call void @use(i1 [[C_1]])
+; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i8 [[IV]], [[N]]
+; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP_BODY:.*]], label %[[EXIT:.*]]
+; CHECK:       [[LOOP_BODY]]:
+; CHECK-NEXT:    [[IV_NEXT]] = add i8 [[IV]], 1
+; CHECK-NEXT:    br i1 [[C]], label %[[LATCH_1]], label %[[LATCH_2]]
+; CHECK:       [[LATCH_1]]:
+; CHECK-NEXT:    br label %[[LOOP_HEADER]]
+; CHECK:       [[LATCH_2]]:
+; CHECK-NEXT:    br label %[[LOOP_HEADER]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %loop.header
+
+loop.header:
+  %iv = phi i8 [ 0, %entry ], [ %iv.next, %latch.1 ], [ %iv.next, %latch.2 ]
+  %c.1 = icmp ule i8 %iv, %n
+  call void @use(i1 %c.1)
+  %cmp = icmp ult i8 %iv, %n
+  br i1 %cmp, label %loop.body, label %exit
+
+loop.body:
+  %iv.next = add i8 %iv, 1
+  br i1 %c, label %latch.1, label %latch.2
+
+latch.1:
+  br label %loop.header
+
+latch.2:
+  br label %loop.header
+
+exit:
+  ret void
+}
