+++ b/llvm/test/Transforms/InstCombine/select-lowbit-and.ll
@@ -0,0 +1,112 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
+; RUN: opt -S -passes=instcombine < %s | FileCheck %s
+
+; select ((X & 1) != 0), Y, 0 --> X & Y, if Y is 0 or 1
+
+; Existing fold for the equivalent trunc condition.
+define i8 @trunc_condition(i8 %x, i8 noundef range(i8 0, 2) %y) {
+; CHECK-LABEL: define i8 @trunc_condition(
+; CHECK-SAME: i8 [[X:%.*]], i8 noundef range(i8 0, 2) [[Y:%.*]]) {
+; CHECK-NEXT:    [[RET:%.*]] = and i8 [[X]], [[Y]]
+; CHECK-NEXT:    ret i8 [[RET]]
+;
+  %cond = trunc i8 %x to i1
+  %ret = select i1 %cond, i8 %y, i8 0
+  ret i8 %ret
+}
+
+define i8 @and_icmp_ne_condition(i8 %x, i8 noundef range(i8 0, 2) %y) {
+; CHECK-LABEL: define i8 @and_icmp_ne_condition(
+; CHECK-SAME: i8 [[X:%.*]], i8 noundef range(i8 0, 2) [[Y:%.*]]) {
+; CHECK-NEXT:    [[RET:%.*]] = and i8 [[X]], [[Y]]
+; CHECK-NEXT:    ret i8 [[RET]]
+;
+  %lowbit = and i8 %x, 1
+  %cond = icmp ne i8 %lowbit, 0
+  %ret = select i1 %cond, i8 %y, i8 0
+  ret i8 %ret
+}
+
+define i8 @and_icmp_eq_condition(i8 %x, i8 noundef range(i8 0, 2) %y) {
+; CHECK-LABEL: define i8 @and_icmp_eq_condition(
+; CHECK-SAME: i8 [[X:%.*]], i8 noundef range(i8 0, 2) [[Y:%.*]]) {
+; CHECK-NEXT:    [[RET:%.*]] = and i8 [[X]], [[Y]]
+; CHECK-NEXT:    ret i8 [[RET]]
+;
+  %lowbit = and i8 %x, 1
+  %cond = icmp eq i8 %lowbit, 0
+  %ret = select i1 %cond, i8 0, i8 %y
+  ret i8 %ret
+}
+
+define <2 x i8> @and_icmp_ne_condition_vec(<2 x i8> %x, <2 x i8> noundef range(i8 0, 2) %y) {
+; CHECK-LABEL: define <2 x i8> @and_icmp_ne_condition_vec(
+; CHECK-SAME: <2 x i8> [[X:%.*]], <2 x i8> noundef range(i8 0, 2) [[Y:%.*]]) {
+; CHECK-NEXT:    [[RET:%.*]] = and <2 x i8> [[X]], [[Y]]
+; CHECK-NEXT:    ret <2 x i8> [[RET]]
+;
+  %lowbit = and <2 x i8> %x, splat (i8 1)
+  %cond = icmp ne <2 x i8> %lowbit, zeroinitializer
+  %ret = select <2 x i1> %cond, <2 x i8> %y, <2 x i8> zeroinitializer
+  ret <2 x i8> %ret
+}
+
+; Y may be larger than 1: don't fold.
+define i8 @y_not_bool(i8 %x, i8 noundef range(i8 0, 3) %y) {
+; CHECK-LABEL: define i8 @y_not_bool(
+; CHECK-SAME: i8 [[X:%.*]], i8 noundef range(i8 0, 3) [[Y:%.*]]) {
+; CHECK-NEXT:    [[LOWBIT:%.*]] = and i8 [[X]], 1
+; CHECK-NEXT:    [[COND_NOT:%.*]] = icmp eq i8 [[LOWBIT]], 0
+; CHECK-NEXT:    [[RET:%.*]] = select i1 [[COND_NOT]], i8 0, i8 [[Y]]
+; CHECK-NEXT:    ret i8 [[RET]]
+;
+  %lowbit = and i8 %x, 1
+  %cond = icmp ne i8 %lowbit, 0
+  %ret = select i1 %cond, i8 %y, i8 0
+  ret i8 %ret
+}
+
+; Y may be poison: don't fold.
+define i8 @y_maybe_poison(i8 %x, i8 range(i8 0, 2) %y) {
+; CHECK-LABEL: define i8 @y_maybe_poison(
+; CHECK-SAME: i8 [[X:%.*]], i8 range(i8 0, 2) [[Y:%.*]]) {
+; CHECK-NEXT:    [[LOWBIT:%.*]] = and i8 [[X]], 1
+; CHECK-NEXT:    [[COND_NOT:%.*]] = icmp eq i8 [[LOWBIT]], 0
+; CHECK-NEXT:    [[RET:%.*]] = select i1 [[COND_NOT]], i8 0, i8 [[Y]]
+; CHECK-NEXT:    ret i8 [[RET]]
+;
+  %lowbit = and i8 %x, 1
+  %cond = icmp ne i8 %lowbit, 0
+  %ret = select i1 %cond, i8 %y, i8 0
+  ret i8 %ret
+}
+
+; The mask is not the low bit: don't fold.
+define i8 @mask_not_low_bit(i8 %x, i8 noundef range(i8 0, 2) %y) {
+; CHECK-LABEL: define i8 @mask_not_low_bit(
+; CHECK-SAME: i8 [[X:%.*]], i8 noundef range(i8 0, 2) [[Y:%.*]]) {
+; CHECK-NEXT:    [[BIT:%.*]] = and i8 [[X]], 2
+; CHECK-NEXT:    [[COND_NOT:%.*]] = icmp eq i8 [[BIT]], 0
+; CHECK-NEXT:    [[RET:%.*]] = select i1 [[COND_NOT]], i8 0, i8 [[Y]]
+; CHECK-NEXT:    ret i8 [[RET]]
+;
+  %bit = and i8 %x, 2
+  %cond = icmp ne i8 %bit, 0
+  %ret = select i1 %cond, i8 %y, i8 0
+  ret i8 %ret
+}
+
+; The other arm is not zero: don't fold.
+define i8 @other_arm_not_zero(i8 %x, i8 noundef range(i8 0, 2) %y) {
+; CHECK-LABEL: define i8 @other_arm_not_zero(
+; CHECK-SAME: i8 [[X:%.*]], i8 noundef range(i8 0, 2) [[Y:%.*]]) {
+; CHECK-NEXT:    [[LOWBIT:%.*]] = and i8 [[X]], 1
+; CHECK-NEXT:    [[COND_NOT:%.*]] = icmp eq i8 [[LOWBIT]], 0
+; CHECK-NEXT:    [[RET:%.*]] = select i1 [[COND_NOT]], i8 5, i8 [[Y]]
+; CHECK-NEXT:    ret i8 [[RET]]
+;
+  %lowbit = and i8 %x, 1
+  %cond = icmp ne i8 %lowbit, 0
+  %ret = select i1 %cond, i8 %y, i8 5
+  ret i8 %ret
+}
