--- a/llvm/lib/Analysis/ValueTracking.cpp
+++ b/llvm/lib/Analysis/ValueTracking.cpp
@@ -4116,6 +4116,21 @@ static bool isNonEqualPointersWithRecursiveGEP(const Value *A, const Value *B,
           (StartOffset.sle(OffsetB) && StepOffset.isNegative()));
 }
 
+static bool isNonEqualURemFromDomCondition(const Value *X, const Value *Rem,
+                                           const SimplifyQuery &Q) {
+  // Match Rem as a urem of X and Y.
+  const Value *Y;
+  if (!match(Rem, m_URem(m_Specific(X), m_Value(Y))))
+    return false;
+
+  // For a defined urem, X != X urem Y exactly when X u>= Y.
+  // Check whether a dominating branch condition implies that relationship
+  // between X and Y.
+  std::optional<bool> Implied =
+      isImpliedByDomCondition(ICmpInst::ICMP_UGE, X, Y, Q.CxtI, Q.DL);
+  return Implied && *Implied;
+}
+
 static bool isKnownNonEqualFromContext(const Value *V1, const Value *V2,
                                        const SimplifyQuery &Q, unsigned Depth) {
   if (!Q.CxtI)
@@ -4244,6 +4259,10 @@ static bool isKnownNonEqual(const Value *V1, const Value *V2,
       match(V2, m_PtrToIntSameSize(Q.DL, m_Value(B))))
     return isKnownNonEqual(A, B, DemandedElts, Q, Depth + 1);
 
+  if (isNonEqualURemFromDomCondition(V1, V2, Q) ||
+      isNonEqualURemFromDomCondition(V2, V1, Q))
+    return true;
+
   if (isKnownNonEqualFromContext(V1, V2, Q, Depth))
     return true;
 
