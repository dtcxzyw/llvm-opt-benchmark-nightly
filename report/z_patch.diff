+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[EXT]], [[Z]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
+; CHECK-NEXT:    ret i1 true
+;
+entry:
+  %ext = sext i16 %x to i32
+  %add = add nuw i32 %ext, 4
+  %c = icmp ugt i32 %ext, %z
+  call void @llvm.assume(i1 %c)
+  %t = icmp ugt i32 %add, %z
+  ret i1 %t
+}
+
+; Decomposing %sub requires %x >=u 4, which is unknown.
+define i1 @add_negative_constant_used_as_is(i16 %x, i16 %z) {
+; CHECK-LABEL: define i1 @add_negative_constant_used_as_is(
