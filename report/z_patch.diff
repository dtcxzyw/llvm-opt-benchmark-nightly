+define i1 @gep_const_same_block(ptr align 16 %foo) {
+; CHECK-LABEL: @gep_const_same_block(
+; CHECK-NEXT:    ret i1 true
+;
+  %gep1 = getelementptr i8, ptr %foo, i64 4
