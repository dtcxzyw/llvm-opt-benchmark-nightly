diff --git a/llvm/lib/Transforms/InstCombine/InstCombineCompares.cpp b/llvm/lib/Transforms/InstCombine/InstCombineCompares.cpp
index 70d584740f5b9..cbf8bef66985c 100644
--- a/llvm/lib/Transforms/InstCombine/InstCombineCompares.cpp
+++ b/llvm/lib/Transforms/InstCombine/InstCombineCompares.cpp
@@ -3024,6 +3024,15 @@ Instruction *InstCombinerImpl::foldICmpSubConstant(ICmpInst &Cmp,
   ICmpInst::Predicate Pred = Cmp.getPredicate();
   Type *Ty = Sub->getType();
 
+  // D: (X - (X urem D)) is D*(X/D), a multiple of D, so it is >= D exactly when
+  // X >= D.
+  //   (icmp ugt (sub X, (urem X, D)), D-1) --> (icmp ugt X, D-1)
+  const APInt *D;
+  if (Pred == ICmpInst::ICMP_UGT &&
+      match(Y, m_URem(m_Specific(X), m_APInt(D))) && !D->isZero() &&
+      C == (*D - 1))
+    return new ICmpInst(ICmpInst::ICMP_UGT, X, ConstantInt::get(Ty, C));
+
   // (SubC - Y) == C) --> Y == (SubC - C)
   // (SubC - Y) != C) --> Y != (SubC - C)
   Constant *SubC;
diff --git a/llvm/test/Transforms/InstCombine/icmp-floor-align.ll b/llvm/test/Transforms/InstCombine/icmp-floor-align.ll
new file mode 100644
index 0000000000000..a96a28771324b
--- /dev/null
+++ b/llvm/test/Transforms/InstCombine/icmp-floor-align.ll
@@ -0,0 +1,68 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt -passes=instcombine -S < %s | FileCheck %s
+;
+; (X - (X urem C)) is (X/C)*C, a multiple of C, so it is u>= C exactly when
+; X u>= C. Canonically: icmp ugt (sub X, (urem X, C)), C-1 --> icmp ugt X, C-1.
+; Both the ugt (canonical) and uge (canonicalized to ugt C-1) forms fold.
+
+; UGT form, canonical, non-power-of-2 divisor.
+define i1 @floor_ugt_48(i64 %x) {
+; CHECK-LABEL: @floor_ugt_48(
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i64 [[X:%.*]], 47
+; CHECK-NEXT:    ret i1 [[C]]
+;
+  %r = urem i64 %x, 48
+  %s = sub nuw i64 %x, %r
+  %c = icmp ugt i64 %s, 47
+  ret i1 %c
+}
+
+; UGE form, non-power-of-2 divisor (canonicalized to ugt C-1, then folds).
+define i1 @floor_uge_48(i64 %x) {
+; CHECK-LABEL: @floor_uge_48(
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i64 [[X:%.*]], 47
+; CHECK-NEXT:    ret i1 [[C]]
+;
+  %r = urem i64 %x, 48
+  %s = sub i64 %x, %r
+  %c = icmp uge i64 %s, 48
+  ret i1 %c
+}
+
+; Real bounded_ptr shape: (x / C) * C u>= C via mul/udiv (uge); InstCombine
+; canonicalizes this to the sub/urem form first, then the fold fires.
+define i1 @floor_mul_udiv_uge_48(i32 %x) {
+; CHECK-LABEL: @floor_mul_udiv_uge_48(
+; CHECK-NEXT:    [[X_FR:%.*]] = freeze i32 [[X:%.*]]
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[X_FR]], 47
+; CHECK-NEXT:    ret i1 [[C]]
+;
+  %d = udiv i32 %x, 48
+  %m = mul nuw i32 %d, 48
+  %c = icmp uge i32 %m, 48
+  ret i1 %c
+}
+
+; Power-of-2 divisor, ugt form.
+define i1 @floor_ugt_16(i32 %x) {
+; CHECK-LABEL: @floor_ugt_16(
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[X:%.*]], 15
+; CHECK-NEXT:    ret i1 [[C]]
+;
+  %r = urem i32 %x, 16
+  %s = sub i32 %x, %r
+  %c = icmp ugt i32 %s, 15
+  ret i1 %c
+}
+
+; Power-of-2 divisor, uge form.
+define i1 @floor_uge_16(i32 %x) {
+; CHECK-LABEL: @floor_uge_16(
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i32 [[X:%.*]], 15
+; CHECK-NEXT:    ret i1 [[C]]
+;
+  %r = urem i32 %x, 16
+  %s = sub i32 %x, %r
+  %c = icmp uge i32 %s, 16
+  ret i1 %c
+}
