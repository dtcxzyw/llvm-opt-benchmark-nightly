index 0000000000000..4a78c1210ea8f
--- /dev/null
+++ b/llvm/test/Transforms/ConstraintElimination/decompose-sub-chain-compile-time.ll
@@ -0,0 +1,417 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck --check-prefixes=CHECK,DEFAULT %s
+; RUN: opt -passes=constraint-elimination -constraint-elimination-max-decompose-depth=32 -S %s | FileCheck --check-prefixes=CHECK,DEEP %s
+
+; Decomposing a value decomposes its operands, and looking through an operation
+; requires proving that it does not wrap, a check that decomposes the operands
+; again. The cost of decomposing an expression therefore grows quickly with its
+; depth, and -constraint-elimination-max-decompose-depth bounds it.
+;
+; A chain of 15 subtracts is within the default limit, so the final compare
+; folds.
+
+define i1 @sub_nsw_chain_short(i32 %start, i16 %step) {
+; CHECK-LABEL: @sub_nsw_chain_short(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[STEP_EXT:%.*]] = zext i16 [[STEP:%.*]] to i32
+; CHECK-NEXT:    [[STEP_POS:%.*]] = icmp sgt i32 [[STEP_EXT]], 0
+; CHECK-NEXT:    br i1 [[STEP_POS]], label [[CHAIN_0:%.*]], label [[EXIT:%.*]]
+; CHECK:       chain.0:
+; CHECK-NEXT:    [[C_1:%.*]] = icmp slt i32 [[START:%.*]], 1
+; CHECK-NEXT:    br i1 [[C_1]], label [[EXIT]], label [[CHAIN_1:%.*]]
+; CHECK:       chain.1:
+; CHECK-NEXT:    [[REM_1:%.*]] = sub nsw i32 [[START]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_2:%.*]] = icmp slt i32 [[REM_1]], 1
+; CHECK-NEXT:    br i1 [[C_2]], label [[EXIT]], label [[CHAIN_2:%.*]]
+; CHECK:       chain.2:
+; CHECK-NEXT:    [[REM_2:%.*]] = sub nsw i32 [[REM_1]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_3:%.*]] = icmp slt i32 [[REM_2]], 1
+; CHECK-NEXT:    br i1 [[C_3]], label [[EXIT]], label [[CHAIN_3:%.*]]
+; CHECK:       chain.3:
+; CHECK-NEXT:    [[REM_3:%.*]] = sub nsw i32 [[REM_2]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_4:%.*]] = icmp slt i32 [[REM_3]], 1
+; CHECK-NEXT:    br i1 [[C_4]], label [[EXIT]], label [[CHAIN_4:%.*]]
+; CHECK:       chain.4:
+; CHECK-NEXT:    [[REM_4:%.*]] = sub nsw i32 [[REM_3]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_5:%.*]] = icmp slt i32 [[REM_4]], 1
+; CHECK-NEXT:    br i1 [[C_5]], label [[EXIT]], label [[CHAIN_5:%.*]]
+; CHECK:       chain.5:
+; CHECK-NEXT:    [[REM_5:%.*]] = sub nsw i32 [[REM_4]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_6:%.*]] = icmp slt i32 [[REM_5]], 1
+; CHECK-NEXT:    br i1 [[C_6]], label [[EXIT]], label [[CHAIN_6:%.*]]
+; CHECK:       chain.6:
+; CHECK-NEXT:    [[REM_6:%.*]] = sub nsw i32 [[REM_5]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_7:%.*]] = icmp slt i32 [[REM_6]], 1
+; CHECK-NEXT:    br i1 [[C_7]], label [[EXIT]], label [[CHAIN_7:%.*]]
+; CHECK:       chain.7:
+; CHECK-NEXT:    [[REM_7:%.*]] = sub nsw i32 [[REM_6]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_8:%.*]] = icmp slt i32 [[REM_7]], 1
+; CHECK-NEXT:    br i1 [[C_8]], label [[EXIT]], label [[CHAIN_8:%.*]]
+; CHECK:       chain.8:
+; CHECK-NEXT:    [[REM_8:%.*]] = sub nsw i32 [[REM_7]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_9:%.*]] = icmp slt i32 [[REM_8]], 1
+; CHECK-NEXT:    br i1 [[C_9]], label [[EXIT]], label [[CHAIN_9:%.*]]
+; CHECK:       chain.9:
+; CHECK-NEXT:    [[REM_9:%.*]] = sub nsw i32 [[REM_8]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_10:%.*]] = icmp slt i32 [[REM_9]], 1
+; CHECK-NEXT:    br i1 [[C_10]], label [[EXIT]], label [[CHAIN_10:%.*]]
+; CHECK:       chain.10:
+; CHECK-NEXT:    [[REM_10:%.*]] = sub nsw i32 [[REM_9]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_11:%.*]] = icmp slt i32 [[REM_10]], 1
+; CHECK-NEXT:    br i1 [[C_11]], label [[EXIT]], label [[CHAIN_11:%.*]]
+; CHECK:       chain.11:
+; CHECK-NEXT:    [[REM_11:%.*]] = sub nsw i32 [[REM_10]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_12:%.*]] = icmp slt i32 [[REM_11]], 1
+; CHECK-NEXT:    br i1 [[C_12]], label [[EXIT]], label [[CHAIN_12:%.*]]
+; CHECK:       chain.12:
+; CHECK-NEXT:    [[REM_12:%.*]] = sub nsw i32 [[REM_11]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_13:%.*]] = icmp slt i32 [[REM_12]], 1
+; CHECK-NEXT:    br i1 [[C_13]], label [[EXIT]], label [[CHAIN_13:%.*]]
+; CHECK:       chain.13:
+; CHECK-NEXT:    [[REM_13:%.*]] = sub nsw i32 [[REM_12]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_14:%.*]] = icmp slt i32 [[REM_13]], 1
+; CHECK-NEXT:    br i1 [[C_14]], label [[EXIT]], label [[CHAIN_14:%.*]]
+; CHECK:       chain.14:
+; CHECK-NEXT:    [[REM_14:%.*]] = sub nsw i32 [[REM_13]], [[STEP_EXT]]
+; CHECK-NEXT:    [[C_15:%.*]] = icmp slt i32 [[REM_14]], 1
+; CHECK-NEXT:    br i1 [[C_15]], label [[EXIT]], label [[CHAIN_15:%.*]]
+; CHECK:       chain.15:
