+target triple = "nvptx64-nvidia-cuda"
+
+
+define ptx_kernel void @k(ptr addrspace(1) %src, ptr addrspace(1) %dst, i32 %c) {
+; SM90-LABEL: k(
+; SM90:       {
+; SM90-NEXT:    .reg .pred %p<2>;
+; SM90-NEXT:    .reg .b32 %r<6>;
+; SM90-NEXT:    .reg .b64 %rd<6>;
+; SM90-EMPTY:
+; SM90-NEXT:  // %bb.0: // %entry
+; SM90-NEXT:    ld.param::entry.b64 %rd1, [k_param_1];
+; SM90-NEXT:    ld.param::entry.b64 %rd2, [k_param_0];
+; SM90-NEXT:    ld.global.b32 %r4, [%rd2+24];
+; SM90-NEXT:    ld.global.b64 %rd3, [%rd2+16];
+; SM90-NEXT:    cvt.u32.u64 %r3, %rd3;
+; SM90-NEXT:    ld.global.b64 %rd4, [%rd2+8];
+; SM90-NEXT:    cvt.u32.u64 %r2, %rd4;
+; SM90-NEXT:    ld.global.b64 %rd5, [%rd2];
+; SM90-NEXT:    cvt.u32.u64 %r1, %rd5;
+; SM90-NEXT:    ld.param::entry.b32 %r5, [k_param_2];
+; SM90-NEXT:    setp.ne.b32 %p1, %r5, 0;
+; SM90-NEXT:    @%p1 bra $L__BB0_2;
+; SM90-NEXT:  // %bb.1: // %side
+; SM90-NEXT:    st.volatile.global.b32 [%rd1+256], 0;
+; SM90-NEXT:  $L__BB0_2: // %next
+; SM90-NEXT:    st.global.v4.b32 [%rd1], {%r1, %r2, %r3, %r4};
+; SM90-NEXT:    ret;
+;
+; SM100-LABEL: k(
+; SM100:       {
+; SM100-NEXT:    .reg .pred %p<2>;
+; SM100-NEXT:    .reg .b32 %r<9>;
+; SM100-NEXT:    .reg .b64 %rd<3>;
+; SM100-EMPTY:
+; SM100-NEXT:  // %bb.0: // %entry
+; SM100-NEXT:    ld.param::entry.b64 %rd1, [k_param_1];
+; SM100-NEXT:    ld.param::entry.b64 %rd2, [k_param_0];
+; SM100-NEXT:    ld.global.b32 %r7, [%rd2+24];
+; SM100-NEXT:    ld.global.v2.b32 {%r5, %r6}, [%rd2+16];
+; SM100-NEXT:    ld.global.v2.b32 {%r3, %r4}, [%rd2+8];
+; SM100-NEXT:    ld.global.v2.b32 {%r1, %r2}, [%rd2];
+; SM100-NEXT:    ld.param::entry.b32 %r8, [k_param_2];
+; SM100-NEXT:    setp.ne.b32 %p1, %r8, 0;
+; SM100-NEXT:    @%p1 bra $L__BB0_2;
+; SM100-NEXT:  // %bb.1: // %side
+; SM100-NEXT:    st.volatile.global.b32 [%rd1+256], 0;
+; SM100-NEXT:  $L__BB0_2: // %next
+; SM100-NEXT:    st.global.v4.b32 [%rd1], {%r1, %r3, %r5, %r7};
+; SM100-NEXT:    ret;
+entry:
+  %w = load <8 x i32>, ptr addrspace(1) %src, align 32
+  %a = bitcast <8 x i32> %w to <64 x i4>
+  %v = shufflevector <64 x i4> %a, <64 x i4> poison, <32 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 16, i32 17, i32 18, i32 19, i32 20, i32 21, i32 22, i32 23, i32 32, i32 33, i32 34, i32 35, i32 36, i32 37, i32 38, i32 39, i32 48, i32 49, i32 50, i32 51, i32 52, i32 53, i32 54, i32 55>
