index 0000000000000..900644d2a4089
--- /dev/null
+++ b/llvm/test/Transforms/SROA/integer-widening-memtransfer.ll
@@ -0,0 +1,38 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
+; RUN: opt < %s -passes=sroa -S | FileCheck %s
+
+target datalayout = "e-p:64:64-i64:64-n8:16:32:64"
+
+declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1 immarg)
+
+define void @covering_memcpy_with_partial_memcpys(ptr %source, ptr %dest) {
+; CHECK-LABEL: define void @covering_memcpy_with_partial_memcpys(
+; CHECK-SAME: ptr [[SOURCE:%.*]], ptr [[DEST:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[TMP0:%.*]] = load i32, ptr [[SOURCE]], align 1
+; CHECK-NEXT:    [[TMP1:%.*]] = zext i32 [[TMP0]] to i64
+; CHECK-NEXT:    [[TMP2:%.*]] = and i64 undef, -4294967296
+; CHECK-NEXT:    [[TMP3:%.*]] = or i64 [[TMP2]], [[TMP1]]
+; CHECK-NEXT:    [[TMP4:%.*]] = load i32, ptr [[SOURCE]], align 1
+; CHECK-NEXT:    [[TMP5:%.*]] = zext i32 [[TMP4]] to i64
+; CHECK-NEXT:    [[TMP6:%.*]] = shl i64 [[TMP5]], 32
+; CHECK-NEXT:    [[TMP7:%.*]] = and i64 [[TMP3]], 4294967295
+; CHECK-NEXT:    [[TMP8:%.*]] = or i64 [[TMP7]], [[TMP6]]
+; CHECK-NEXT:    store i64 [[TMP8]], ptr [[DEST]], align 1
+; CHECK-NEXT:    [[TMP9:%.*]] = getelementptr inbounds i8, ptr [[DEST]], i64 8
+; CHECK-NEXT:    store i8 0, ptr [[TMP9]], align 1
+; CHECK-NEXT:    ret void
+;
+entry:
+  %temporary = alloca [9 x i8], align 1
+  call void @llvm.memcpy.p0.p0.i64(ptr align 1 %temporary,
+                                  ptr align 1 %source, i64 4, i1 false)
+  %temporary.4 = getelementptr inbounds i8, ptr %temporary, i64 4
+  call void @llvm.memcpy.p0.p0.i64(ptr align 1 %temporary.4,
+                                  ptr align 1 %source, i64 4, i1 false)
+  %temporary.8 = getelementptr inbounds i8, ptr %temporary, i64 8
+  store i8 0, ptr %temporary.8, align 1
+  call void @llvm.memcpy.p0.p0.i64(ptr align 1 %dest,
+                                  ptr align 1 %temporary, i64 9, i1 false)
+  ret void
+}
