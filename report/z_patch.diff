+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; REQUIRES: x86-registered-target
+; RUN: opt -passes='correlated-propagation<finite-values>,verify' -S %s | FileCheck %s
+; RUN: opt -passes='correlated-propagation<finite-values>,verify' %s -o %t.bc
+; RUN: llc -mtriple=x86_64-unknown-linux-gnu -filetype=obj %t.bc -o %t.o
+; RUN: llvm-nm --print-size --format=posix %t.o | FileCheck %s --check-prefix=SIZE
+; RUN: opt -passes='default<O3>,verify' %s -o %t.o3.bc
+; RUN: llc -mtriple=x86_64-unknown-linux-gnu -filetype=obj %t.o3.bc -o %t.o3.o
+; RUN: llvm-nm --print-size --format=posix %t.o3.o | FileCheck %s --check-prefix=SIZE-O3
+;
+; These cases grew after sharing a common select offset, despite a lower
+; estimated instruction cost. Check both the standalone pass and the O3 pipeline.
+
+; SIZE-DAG: across_call_minsize T {{[0-9a-f]+}} 2e{{$}}
+; SIZE-DAG: across_call_optsize T {{[0-9a-f]+}} 30{{$}}
