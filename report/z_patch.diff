index 0000000000000..d1c295de02ac2
--- /dev/null
+++ b/llvm/test/Analysis/ScalarEvolution/minmax-operand-order.ll
@@ -0,0 +1,150 @@
+; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py
+; RUN: opt -passes='print<scalar-evolution>' -disable-output %s 2>&1 | FileCheck %s
+
+; Commutative SCEV expressions must not depend on the order their operands are
+; passed in, otherwise (a smax b) and (b smax a) become distinct SCEVs that
+; never cancel. Unlike add and mul, min/max expressions are neither flattened
+; nor distributed over, so the duplicates survive.
+
+declare i32 @get(ptr, i32)
+
+define i32 @smax_operand_order_calls_with_different_constants(ptr %p) {
+; CHECK-LABEL: 'smax_operand_order_calls_with_different_constants'
+; CHECK-NEXT:  Classifying expressions for: @smax_operand_order_calls_with_different_constants
+; CHECK-NEXT:    %x = call i32 @get(ptr %p, i32 5)
+; CHECK-NEXT:    --> %x U: full-set S: full-set
+; CHECK-NEXT:    %y = call i32 @get(ptr %p, i32 6)
+; CHECK-NEXT:    --> %y U: full-set S: full-set
+; CHECK-NEXT:    %max.1 = call i32 @llvm.smax.i32(i32 %x, i32 %y)
+; CHECK-NEXT:    --> (%x smax %y) U: full-set S: full-set
+; CHECK-NEXT:    %max.2 = call i32 @llvm.smax.i32(i32 %y, i32 %x)
+; CHECK-NEXT:    --> (%x smax %y) U: full-set S: full-set
+; CHECK-NEXT:    %sub = sub i32 %max.1, %max.2
+; CHECK-NEXT:    --> 0 U: [0,1) S: [0,1)
+; CHECK-NEXT:  Determining loop execution counts for: @smax_operand_order_calls_with_different_constants
+;
+entry:
+  %x = call i32 @get(ptr %p, i32 5)
+  %y = call i32 @get(ptr %p, i32 6)
+  %max.1 = call i32 @llvm.smax.i32(i32 %x, i32 %y)
+  %max.2 = call i32 @llvm.smax.i32(i32 %y, i32 %x)
+  %sub = sub i32 %max.1, %max.2
+  ret i32 %sub
+}
+
+define i32 @umin_operand_order_calls_with_different_constants(ptr %p) {
+; CHECK-LABEL: 'umin_operand_order_calls_with_different_constants'
+; CHECK-NEXT:  Classifying expressions for: @umin_operand_order_calls_with_different_constants
+; CHECK-NEXT:    %x = call i32 @get(ptr %p, i32 5)
+; CHECK-NEXT:    --> %x U: full-set S: full-set
+; CHECK-NEXT:    %y = call i32 @get(ptr %p, i32 6)
+; CHECK-NEXT:    --> %y U: full-set S: full-set
+; CHECK-NEXT:    %min.1 = call i32 @llvm.umin.i32(i32 %x, i32 %y)
+; CHECK-NEXT:    --> (%x umin %y) U: full-set S: full-set
+; CHECK-NEXT:    %min.2 = call i32 @llvm.umin.i32(i32 %y, i32 %x)
+; CHECK-NEXT:    --> (%x umin %y) U: full-set S: full-set
+; CHECK-NEXT:    %sub = sub i32 %min.1, %min.2
+; CHECK-NEXT:    --> 0 U: [0,1) S: [0,1)
+; CHECK-NEXT:  Determining loop execution counts for: @umin_operand_order_calls_with_different_constants
+;
+entry:
+  %x = call i32 @get(ptr %p, i32 5)
+  %y = call i32 @get(ptr %p, i32 6)
+  %min.1 = call i32 @llvm.umin.i32(i32 %x, i32 %y)
+  %min.2 = call i32 @llvm.umin.i32(i32 %y, i32 %x)
+  %sub = sub i32 %min.1, %min.2
+  ret i32 %sub
+}
+
+; Constant operands are ordered by their unsigned value.
+define i32 @smax_operand_order_negative_constant(ptr %p) {
+; CHECK-LABEL: 'smax_operand_order_negative_constant'
+; CHECK-NEXT:  Classifying expressions for: @smax_operand_order_negative_constant
+; CHECK-NEXT:    %x = call i32 @get(ptr %p, i32 5)
+; CHECK-NEXT:    --> %x U: full-set S: full-set
+; CHECK-NEXT:    %y = call i32 @get(ptr %p, i32 -1)
+; CHECK-NEXT:    --> %y U: full-set S: full-set
+; CHECK-NEXT:    %max.1 = call i32 @llvm.smax.i32(i32 %x, i32 %y)
+; CHECK-NEXT:    --> (%x smax %y) U: full-set S: full-set
+; CHECK-NEXT:    %max.2 = call i32 @llvm.smax.i32(i32 %y, i32 %x)
+; CHECK-NEXT:    --> (%x smax %y) U: full-set S: full-set
+; CHECK-NEXT:    %sub = sub i32 %max.1, %max.2
+; CHECK-NEXT:    --> 0 U: [0,1) S: [0,1)
+; CHECK-NEXT:  Determining loop execution counts for: @smax_operand_order_negative_constant
+;
+entry:
+  %x = call i32 @get(ptr %p, i32 5)
+  %y = call i32 @get(ptr %p, i32 -1)
+  %max.1 = call i32 @llvm.smax.i32(i32 %x, i32 %y)
+  %max.2 = call i32 @llvm.smax.i32(i32 %y, i32 %x)
+  %sub = sub i32 %max.1, %max.2
+  ret i32 %sub
+}
+
+; getSignExtendExpr sinks the extend into the min/max, so the widened
+; expression must order its operands the same way as the narrow one.
+define i64 @sext_of_smax_operand_order(ptr %p) {
+; CHECK-LABEL: 'sext_of_smax_operand_order'
+; CHECK-NEXT:  Classifying expressions for: @sext_of_smax_operand_order
+; CHECK-NEXT:    %x = call i32 @get(ptr %p, i32 5)
+; CHECK-NEXT:    --> %x U: full-set S: full-set
+; CHECK-NEXT:    %y = call i32 @get(ptr %p, i32 6)
+; CHECK-NEXT:    --> %y U: full-set S: full-set
+; CHECK-NEXT:    %max.1 = call i32 @llvm.smax.i32(i32 %x, i32 %y)
+; CHECK-NEXT:    --> (%x smax %y) U: full-set S: full-set
+; CHECK-NEXT:    %ext.1 = sext i32 %max.1 to i64
+; CHECK-NEXT:    --> ((sext i32 %x to i64) smax (sext i32 %y to i64)) U: [-2147483648,2147483648) S: [-2147483648,2147483648)
+; CHECK-NEXT:    %x.ext = sext i32 %x to i64
+; CHECK-NEXT:    --> (sext i32 %x to i64) U: [-2147483648,2147483648) S: [-2147483648,2147483648)
+; CHECK-NEXT:    %y.ext = sext i32 %y to i64
+; CHECK-NEXT:    --> (sext i32 %y to i64) U: [-2147483648,2147483648) S: [-2147483648,2147483648)
+; CHECK-NEXT:    %ext.2 = call i64 @llvm.smax.i64(i64 %y.ext, i64 %x.ext)
+; CHECK-NEXT:    --> ((sext i32 %y to i64) smax (sext i32 %x to i64)) U: [-2147483648,2147483648) S: [-2147483648,2147483648)
+; CHECK-NEXT:    %sub = sub i64 %ext.1, %ext.2
+; CHECK-NEXT:    --> ((-1 * ((sext i32 %y to i64) smax (sext i32 %x to i64)))<nsw> + ((sext i32 %x to i64) smax (sext i32 %y to i64))) U: [-4294967295,4294967296) S: [-4294967295,4294967296)
+; CHECK-NEXT:  Determining loop execution counts for: @sext_of_smax_operand_order
+;
+entry:
+  %x = call i32 @get(ptr %p, i32 5)
+  %y = call i32 @get(ptr %p, i32 6)
+  %max.1 = call i32 @llvm.smax.i32(i32 %x, i32 %y)
+  %ext.1 = sext i32 %max.1 to i64
+  %x.ext = sext i32 %x to i64
+  %y.ext = sext i32 %y to i64
+  %ext.2 = call i64 @llvm.smax.i64(i64 %y.ext, i64 %x.ext)
+  %sub = sub i64 %ext.1, %ext.2
+  ret i64 %sub
+}
+
+; Negative test: the constants telling %x and %y apart sit one level deeper
+; than scalar-evolution-max-value-compare-depth allows, so the operands still
+; compare equal and the order is not canonicalized.
+define i32 @smax_operand_order_beyond_compare_depth(ptr %p, i32 %c) {
+; CHECK-LABEL: 'smax_operand_order_beyond_compare_depth'
+; CHECK-NEXT:  Classifying expressions for: @smax_operand_order_beyond_compare_depth
+; CHECK-NEXT:    %a = add i32 %c, 5
+; CHECK-NEXT:    --> (5 + %c) U: full-set S: full-set
+; CHECK-NEXT:    %b = add i32 %c, 6
+; CHECK-NEXT:    --> (6 + %c) U: full-set S: full-set
+; CHECK-NEXT:    %x = call i32 @get(ptr %p, i32 %a)
+; CHECK-NEXT:    --> %x U: full-set S: full-set
+; CHECK-NEXT:    %y = call i32 @get(ptr %p, i32 %b)
+; CHECK-NEXT:    --> %y U: full-set S: full-set
+; CHECK-NEXT:    %max.1 = call i32 @llvm.smax.i32(i32 %x, i32 %y)
+; CHECK-NEXT:    --> (%x smax %y) U: full-set S: full-set
+; CHECK-NEXT:    %max.2 = call i32 @llvm.smax.i32(i32 %y, i32 %x)
+; CHECK-NEXT:    --> (%y smax %x) U: full-set S: full-set
+; CHECK-NEXT:    %sub = sub i32 %max.1, %max.2
+; CHECK-NEXT:    --> ((-1 * (%y smax %x)) + (%x smax %y)) U: full-set S: full-set
+; CHECK-NEXT:  Determining loop execution counts for: @smax_operand_order_beyond_compare_depth
+;
+entry:
+  %a = add i32 %c, 5
+  %b = add i32 %c, 6
+  %x = call i32 @get(ptr %p, i32 %a)
+  %y = call i32 @get(ptr %p, i32 %b)
+  %max.1 = call i32 @llvm.smax.i32(i32 %x, i32 %y)
+  %max.2 = call i32 @llvm.smax.i32(i32 %y, i32 %x)
+  %sub = sub i32 %max.1, %max.2
+  ret i32 %sub
+}
