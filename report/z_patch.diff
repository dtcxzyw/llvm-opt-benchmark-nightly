+; The offsets of the decomposed operands overflow, so decomposing bails out
+; before flagging the constraint as ne. Make sure the retry without
+; decomposition does not add the ne fact as its ule relaxation; %t must not be
+; folded, as it is false for %x = -1, %y = 0.
+define i1 @ne_fact_not_added_as_ule_after_retry(i64 %x, i64 %y) {
+; CHECK-LABEL: define i1 @ne_fact_not_added_as_ule_after_retry(
+; CHECK-SAME: i64 [[X:%.*]], i64 [[Y:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[A:%.*]] = sub nuw i64 [[X]], 4611686018427387904
+; CHECK-NEXT:    [[B:%.*]] = add nuw i64 [[Y]], 4611686018427387904
+; CHECK-NEXT:    [[CMP:%.*]] = icmp ne i64 [[A]], [[B]]
+; CHECK-NEXT:    br i1 [[CMP]], label %[[THEN:.*]], label %[[ELSE:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    [[T:%.*]] = icmp ule i64 [[A]], [[B]]
+; CHECK-NEXT:    ret i1 [[T]]
+; CHECK:       [[ELSE]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %a = sub nuw i64 %x, 4611686018427387904
+  %b = add nuw i64 %y, 4611686018427387904
+  %cmp = icmp ne i64 %a, %b
+  br i1 %cmp, label %then, label %else
+
+then:
+  %t = icmp ule i64 %a, %b
+  ret i1 %t
+
+else:
+  ret i1 false
+}
+
