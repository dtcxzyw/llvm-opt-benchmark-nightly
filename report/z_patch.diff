+; CHECK-NEXT:    call void @use(i1 [[OOBS]])
+; CHECK-NEXT:    br label %[[LATCH]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    [[INEXT]] = add i8 [[I]], 2
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i8 [[INEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label %[[H]], label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %ez = icmp eq i8 %n, 0
+  br i1 %ez, label %exit, label %ph
+
+ph:
+  br label %h
+
+h:
+  %i = phi i8 [ 0, %ph ], [ %inext, %latch ]
+  %oob = icmp ult i8 %i, %n
+  call void @use(i1 %oob)
+  %oobs = icmp slt i8 %i, %n
+  call void @use(i1 %oobs)
+  br label %latch
+
+latch:
+  %inext = add i8 %i, 2
+  %c = icmp slt i8 %inext, %n
+  br i1 %c, label %h, label %exit
+
+exit:
+  ret void
+}
