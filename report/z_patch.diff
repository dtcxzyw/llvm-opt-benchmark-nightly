+; Negative: the surrounding loop's backedge-taken count is expressed in a type
+; (i64, from the %cnt counter) wider than the surrounding IV %j (i32). Extending
+; the count could underestimate the recurrence's last value, so the TooWide
+; guard bails and the clamp is preserved.
+define void @outer_count_wider_than_iv(i64 %m, i32 %s, ptr %p) {
+; CHECK-LABEL: 'outer_count_wider_than_iv'
+; CHECK-NEXT:  Classifying expressions for: @outer_count_wider_than_iv
+; CHECK-NEXT:    %j = phi i32 [ 0, %outer.ph ], [ %j.next, %outer.latch ]
