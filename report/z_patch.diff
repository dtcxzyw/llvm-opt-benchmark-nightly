+; Negative test: the start value is not a constant, so the offset cannot be
+; folded into it.
+define void @trunc_of_iv_plus_const_variable_start(ptr %dst, i64 %n, i64 %start) {
+; CHECK-LABEL: define void @trunc_of_iv_plus_const_variable_start(
+; CHECK-SAME: ptr [[DST:%.*]], i64 [[N:%.*]], i64 [[START:%.*]]) {
