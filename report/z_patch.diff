index 0000000000000..b4215bcc8ae3a
--- /dev/null
+++ b/llvm/test/Analysis/ScalarEvolution/implied-cond-ge-via-gt-minus-one.ll
@@ -0,0 +1,177 @@
+; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -disable-output -passes="print<scalar-evolution>" \
+; RUN:   -scalar-evolution-classify-expressions=0 2>&1 | FileCheck %s
+
+; Tests for proving X >= Y from a guard of the form X > Y - 1. The backedge
+; taken count of a decreasing loop is computed in terms of Start when SCEV can
+; prove Start >= RHS at loop entry; otherwise a min(RHS, Start) is needed.
+
+; Guard: start s> n - 1. Prove start s>= n, so that the BTC is start - n.
+define void @sge_from_sgt_minus_one(i32 %start, i32 %n) {
+; CHECK-LABEL: 'sge_from_sgt_minus_one'
+; CHECK-NEXT:  Determining loop execution counts for: @sge_from_sgt_minus_one
+; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-1 * %n) + %start)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -1
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-1 * %n) + %start)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %n.minus.1 = add i32 %n, -1
+  %guard = icmp sgt i32 %start, %n.minus.1
+  br i1 %guard, label %loop, label %exit
+
+loop:
+  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop ]
+  %iv.next = add nsw i32 %iv, -1
+  %cmp = icmp sgt i32 %iv, %n
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Guard: start u> n - 1. Prove start u>= n, so that the BTC is start - n.
+define void @uge_from_ugt_minus_one(i32 %start, i32 %n) {
+; CHECK-LABEL: 'uge_from_ugt_minus_one'
+; CHECK-NEXT:  Determining loop execution counts for: @uge_from_ugt_minus_one
+; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-1 * %n) + %start)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -1
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-1 * %n) + %start)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %n.minus.1 = add i32 %n, -1
+  %guard = icmp ugt i32 %start, %n.minus.1
+  br i1 %guard, label %loop, label %exit
+
+loop:
+  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop ]
+  %iv.next = add nuw i32 %iv, -1
+  %cmp = icmp ugt i32 %iv, %n
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Guard: x s> z. Prove x s>= z + 1 even though z + 1 may wrap: if it does, z is
+; INT_MAX and the guard cannot hold.
+define void @sge_of_plus_one_from_sgt(i32 %x, i32 %z) {
+; CHECK-LABEL: 'sge_of_plus_one_from_sgt'
+; CHECK-NEXT:  Determining loop execution counts for: @sge_of_plus_one_from_sgt
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (-1 * %z) + %x)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -1
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (-1 * %z) + %x)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %z.plus.1 = add i32 %z, 1
+  %guard = icmp sgt i32 %x, %z
+  br i1 %guard, label %loop, label %exit
+
+loop:
+  %iv = phi i32 [ %x, %entry ], [ %iv.next, %loop ]
+  %iv.next = add nsw i32 %iv, -1
+  %cmp = icmp sgt i32 %iv, %z.plus.1
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Guard: x u> z. Prove x u>= z + 1 even though z + 1 may wrap: if it does, z is
+; UINT_MAX and the guard cannot hold.
+define void @uge_of_plus_one_from_ugt(i32 %x, i32 %z) {
+; CHECK-LABEL: 'uge_of_plus_one_from_ugt'
+; CHECK-NEXT:  Determining loop execution counts for: @uge_of_plus_one_from_ugt
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (-1 * %z) + %x)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -1
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (-1 * %z) + %x)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %z.plus.1 = add i32 %z, 1
+  %guard = icmp ugt i32 %x, %z
+  br i1 %guard, label %loop, label %exit
+
+loop:
+  %iv = phi i32 [ %x, %entry ], [ %iv.next, %loop ]
+  %iv.next = add nuw i32 %iv, -1
+  %cmp = icmp ugt i32 %iv, %z.plus.1
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Negative test: start s> n - 2 does not imply start s>= n.
+define void @sge_from_sgt_minus_two_negative(i32 %start, i32 %n) {
+; CHECK-LABEL: 'sge_from_sgt_minus_two_negative'
+; CHECK-NEXT:  Determining loop execution counts for: @sge_from_sgt_minus_two_negative
+; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-1 * (%start smin %n)) + %start)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -1
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-1 * (%start smin %n)) + %start)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %n.minus.2 = add i32 %n, -2
+  %guard = icmp sgt i32 %start, %n.minus.2
+  br i1 %guard, label %loop, label %exit
+
+loop:
+  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop ]
+  %iv.next = add nsw i32 %iv, -1
+  %cmp = icmp sgt i32 %iv, %n
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Negative test: the guard is on an unrelated value.
+define void @sge_from_sgt_minus_one_unrelated_negative(i32 %start, i32 %other, i32 %n) {
+; CHECK-LABEL: 'sge_from_sgt_minus_one_unrelated_negative'
+; CHECK-NEXT:  Determining loop execution counts for: @sge_from_sgt_minus_one_unrelated_negative
+; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-1 * (%start smin %n)) + %start)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -1
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-1 * (%start smin %n)) + %start)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %n.minus.1 = add i32 %n, -1
+  %guard = icmp sgt i32 %other, %n.minus.1
+  br i1 %guard, label %loop, label %exit
+
+loop:
+  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop ]
+  %iv.next = add nsw i32 %iv, -1
+  %cmp = icmp sgt i32 %iv, %n
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Negative test: a signed guard does not prove the unsigned fact.
+define void @uge_from_sgt_minus_one_negative(i32 %start, i32 %n) {
+; CHECK-LABEL: 'uge_from_sgt_minus_one_negative'
+; CHECK-NEXT:  Determining loop execution counts for: @uge_from_sgt_minus_one_negative
+; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-1 * (%start umin %n)) + %start)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -1
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is ((-1 * (%start umin %n)) + %start)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %n.minus.1 = add i32 %n, -1
+  %guard = icmp sgt i32 %start, %n.minus.1
+  br i1 %guard, label %loop, label %exit
+
+loop:
+  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop ]
+  %iv.next = add nuw i32 %iv, -1
+  %cmp = icmp ugt i32 %iv, %n
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
+}
