+; CHECK:       [[PH]]:
+; CHECK-NEXT:    br label %[[H:.*]]
+; CHECK:       [[H]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[PH]] ], [ [[INEXT:%.*]], %[[LATCH:.*]] ]
+; CHECK-NEXT:    [[OOB:%.*]] = icmp ult i64 [[I]], [[N]]
+; CHECK-NEXT:    call void @use(i1 [[OOB]])
+; CHECK-NEXT:    br label %[[LATCH]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    [[PROBE:%.*]] = add nsw i64 [[I]], 2
+; CHECK-NEXT:    [[INEXT]] = add nsw i64 [[I]], 4
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[PROBE]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label %[[H]], label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
