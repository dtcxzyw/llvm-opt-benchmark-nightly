+define void @no_refine_udiv_unsafe(i16 %x, i16 %y, ptr %p) {
+; CHECK-LABEL: define void @no_refine_udiv_unsafe(
+; CHECK-SAME: i16 [[X:%.*]], i16 [[Y:%.*]], ptr [[P:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[D:%.*]] = udiv i16 [[X]], [[Y]]
+; CHECK-NEXT:    [[CX:%.*]] = icmp ult i16 [[X]], 256
+; CHECK-NEXT:    [[CY:%.*]] = icmp ult i16 [[Y]], 256
+; CHECK-NEXT:    [[OK:%.*]] = and i1 [[CX]], [[CY]]
+; CHECK-NEXT:    br i1 [[OK]], label %[[THEN:.*]], label %[[ELSE:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    store i16 [[D]], ptr [[P]], align 2
+; CHECK-NEXT:    ret void
+; CHECK:       [[ELSE]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %d = udiv i16 %x, %y
+  %cx = icmp ult i16 %x, 256
+  %cy = icmp ult i16 %y, 256
+  %ok = and i1 %cx, %cy
+  br i1 %ok, label %then, label %else
+
+then:
+  store i16 %d, ptr %p
+  ret void
+
+else:
+  ret void
+}
