@@ -9259,6 +9322,9 @@ Instruction *InstCombinerImpl::visitFCmpInst(FCmpInst &I) {
   if (Instruction *R = foldFCmpFAbsFSubIntToFP(I, *this))
     return R;
 
+  if (Instruction *R = foldFCmpTwoIntToFP(I, *this))
