new file mode 100644
index 0000000000000..8901e208892d8
--- /dev/null
+++ b/llvm/test/Transforms/PhaseOrdering/exit-value-nowrap-flags.ll
@@ -0,0 +1,49 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt -O3 -S < %s | FileCheck %s
+
+; Reduced from llvm-opt-benchmark ncnn/deconvolution_x86_fma.bc. The exit value
+; of the counting loop is rewritten to ((%n - 1) & -8) + 8; the recurrence it
+; comes from steps by "add nsw 8", so that add does not signed-wrap either.
+define <8 x float> @exit_value_keeps_nsw(i32 %m, i32 %n, ptr %p, i64 %off) {
+; CHECK-LABEL: @exit_value_keeps_nsw(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[CMP1:%.*]] = icmp sgt i32 [[N:%.*]], 0
+; CHECK-NEXT:    [[TMP0:%.*]] = add nsw i32 [[N]], -1
+; CHECK-NEXT:    [[TMP1:%.*]] = and i32 [[TMP0]], -8
+; CHECK-NEXT:    [[TMP2:%.*]] = add nuw nsw i32 [[TMP1]], 8
+; CHECK-NEXT:    [[IV_LCSSA:%.*]] = select i1 [[CMP1]], i32 [[TMP2]], i32 0
+; CHECK-NEXT:    [[IN_RANGE:%.*]] = icmp slt i32 [[IV_LCSSA]], [[M:%.*]]
+; CHECK-NEXT:    br i1 [[IN_RANGE]], label [[LOAD:%.*]], label [[COMMON_RET:%.*]]
+; CHECK:       common.ret:
+; CHECK-NEXT:    [[COMMON_RET_OP:%.*]] = phi <8 x float> [ [[V:%.*]], [[LOAD]] ], [ zeroinitializer, [[ENTRY:%.*]] ]
+; CHECK-NEXT:    ret <8 x float> [[COMMON_RET_OP]]
+; CHECK:       load:
+; CHECK-NEXT:    [[Q_NEXT_LE:%.*]] = getelementptr [4 x i8], ptr [[P:%.*]], i64 [[OFF:%.*]]
+; CHECK-NEXT:    [[V]] = load <8 x float>, ptr [[Q_NEXT_LE]], align 32
+; CHECK-NEXT:    br label [[COMMON_RET]]
+;
+entry:
+  br label %loop
+
+loop:
+  %iv = phi i32 [ 0, %entry ], [ %iv.next, %latch ]
+  %q = phi ptr [ null, %entry ], [ %q.next, %latch ]
+  %cmp = icmp slt i32 %iv, %n
+  br i1 %cmp, label %latch, label %after
+
+latch:
+  %q.next = getelementptr [4 x i8], ptr %p, i64 %off
+  %iv.next = add nsw i32 %iv, 8
+  br label %loop
+
+after:
+  %in.range = icmp slt i32 %iv, %m
+  br i1 %in.range, label %load, label %exit
+
+load:
+  %v = load <8 x float>, ptr %q, align 32
+  ret <8 x float> %v
+
+exit:
+  ret <8 x float> zeroinitializer
+}
