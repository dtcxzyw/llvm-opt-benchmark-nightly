+define i8 @udiv_udiv_exact(i8 %a, i8 %b, i8 %c) {
+; CHECK-LABEL: @udiv_udiv_exact(
+; CHECK-NEXT:    [[BOK:%.*]] = icmp ult i8 [[B:%.*]], 15
+; CHECK-NEXT:    call void @llvm.assume(i1 [[BOK]])
+; CHECK-NEXT:    [[COK:%.*]] = icmp ult i8 [[C:%.*]], 15
+; CHECK-NEXT:    call void @llvm.assume(i1 [[COK]])
+; CHECK-NEXT:    [[TMP1:%.*]] = mul nuw i8 [[B]], [[C]]
+; CHECK-NEXT:    [[D2:%.*]] = udiv exact i8 [[A:%.*]], [[TMP1]]
+; CHECK-NEXT:    ret i8 [[D2]]
+;
+  %bok = icmp ult i8 %b, 15
+  call void @llvm.assume(i1 %bok)
+  %cok = icmp ult i8 %c, 15
+  call void @llvm.assume(i1 %cok)
+  %d1 = udiv exact i8 %a, %b
+  %d2 = udiv exact i8 %d1, %c
