+bool ConstraintInfo::areBothOperandsTracked(Value *A, Value *B) const {
+  // Constants fold into the offset, so they do not need to be tracked.
+  auto IsTracked = [](const DenseMap<Value *, unsigned> &Value2Index, Value *V) {
+    return isa<ConstantInt>(V) || Value2Index.contains(V);
+  };
+  A = A->stripPointerCastsSameRepresentation();
+  B = B->stripPointerCastsSameRepresentation();
+  const auto &Unsigned = getValue2Index(false);
+  const auto &Signed = getValue2Index(true);
+  return (IsTracked(Unsigned, A) && IsTracked(Unsigned, B)) ||
+         (IsTracked(Signed, A) && IsTracked(Signed, B));
+}
