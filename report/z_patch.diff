@@ -0,0 +1,40 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s
+
+declare void @llvm.assume(i1 noundef)
+
+; Pointer inequality tightening: a u>= b and a != b implies strict a u> b.
+define i1 @test_ptr_tighten_uge_ne(ptr %a, ptr %b) {
+; CHECK-LABEL: define i1 @test_ptr_tighten_uge_ne(
+; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]]) {
+; CHECK-NEXT:    [[C1:%.*]] = icmp uge ptr [[A]], [[B]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C1]])
+; CHECK-NEXT:    [[C2:%.*]] = icmp ne ptr [[A]], [[B]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C2]])
+; CHECK-NEXT:    ret i1 true
+;
+  %c1 = icmp uge ptr %a, %b
+  call void @llvm.assume(i1 %c1)
+  %c2 = icmp ne ptr %a, %b
+  call void @llvm.assume(i1 %c2)
+  %check = icmp ugt ptr %a, %b
+  ret i1 %check
+}
+
+; Pointer inequality tightening: a u<= b and a != b implies strict a u< b.
+define i1 @test_ptr_tighten_ule_ne(ptr %a, ptr %b) {
+; CHECK-LABEL: define i1 @test_ptr_tighten_ule_ne(
+; CHECK-SAME: ptr [[A:%.*]], ptr [[B:%.*]]) {
+; CHECK-NEXT:    [[C1:%.*]] = icmp ule ptr [[A]], [[B]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C1]])
+; CHECK-NEXT:    [[C2:%.*]] = icmp ne ptr [[A]], [[B]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C2]])
+; CHECK-NEXT:    ret i1 true
+;
+  %c1 = icmp ule ptr %a, %b
+  call void @llvm.assume(i1 %c1)
+  %c2 = icmp ne ptr %a, %b
+  call void @llvm.assume(i1 %c2)
+  %check = icmp ult ptr %a, %b
+  ret i1 %check
+}
