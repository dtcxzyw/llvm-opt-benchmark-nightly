+define i32 @fptosi_sat_select_ord(float %a) {
+; CHECK-LABEL: @fptosi_sat_select_ord(
+; CHECK-NEXT:    [[CVT:%.*]] = call i32 @llvm.fptosi.sat.i32.f32(float [[A:%.*]])
