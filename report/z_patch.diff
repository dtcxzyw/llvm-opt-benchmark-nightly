+        LHS = A;
+        RHS = C;
+        return true;
+      }
+      if (IsSigned && isKnownNegative(ZCache, Q)) {
+        LHS = C;
+        RHS = A;
+        return true;
+      }
+      return false;
+    }
+    default:
+      return false;
+    }
