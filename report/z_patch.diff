+entry:
+  %add = add nsw i16 %x, %y
+  %add.10 = add nuw i16 %add, 10
+  %c = icmp ule i16 %add.10, %z
+  call void @llvm.assume(i1 %c)
+  %t = icmp ule i16 %add, %z
+  ret i1 %t
