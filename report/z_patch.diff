+bool CallAnalyzer::canJumpThreadIntoCaller() {
+  if (!SingleReturn)
+    return false;
+
+  // Check if the callee returns an i1
+  auto *RV = SingleReturn->getReturnValue();
+  if (F.getReturnType() != llvm::Type::getInt1Ty(F.getContext()))
+    return false;
+
+  // Check the sink node's predecessors.
+  const auto *RBB = SingleReturn->getParent();
+  bool FoundEntry = false;
+  unsigned SC = 0;
+  for (const auto *P : predecessors(RBB)) {
+    if (P->isEntryBlock())
+      FoundEntry = true;
+    else if (DeadBlocks.contains(P))
+      continue;
+    else if (KnownSuccessors.contains(P) || P->getUniqueSuccessor())
+      // Ensure that any predecessors do not have an extra outgoing edge
+      // that might prevent the callee and caller CFGs from cleanly merging.
+      SC++;
+    else
+      return false;
+  }
+
+  // Check if we're returning a known constant value.
+  if (getSimplifiedValue<Constant>(RV)) {
+    // No further checks needed
+  } else if (auto *PI = dyn_cast<PHINode>(RV)) {
+    // Check if the return value is a PHI of constants.
+    for (unsigned I = 0; I < PI->getNumIncomingValues(); I++) {
+      if (!DeadBlocks.contains(PI->getIncomingBlock(I)) &&
+          !getSimplifiedValue<Constant>(PI->getIncomingValue(I)))
+        return false;
+    }
+  } else if (auto *I = dyn_cast<Instruction>(RV)) {
+    // Check if the return value is defined in the entry block.
+    if (!I->getParent()->isEntryBlock())
+      return false;
+
+    // Only consider cases where the one predecessor is the entry block
+    // and the other (if present) is a block with a single known successor.
+    // This ensures that all paths from the sink to the entry block are
+    // disjoint.
+    if (SC > 1 || !FoundEntry)
+      return false;
+
+    // Check if the return value is used as the condition for a conditional
+    // break instruction inside the entry block.
+    auto *CI = dyn_cast<CondBrInst>(I->getParent()->getTerminator());
+    if (!CI || CI->getCondition() != I)
+      return false;
+  } else {
+    return false;
+  }
+
+  // Check if the caller uses the callee result in a conditional br
+  for (const auto *U : CandidateCall.users()) {
+    // Only scan the call's parent block for conditional breaks
+    if (U->getParent() == CandidateCall.getParent() && isa<CondBrInst>(U))
+      return true;
+  }
+
+  return false;
+}
