+; CHECK-NEXT:    [[TMP18:%.*]] = lshr <4 x i16> [[TMP17]], splat (i16 8)
+; CHECK-NEXT:    [[TMP13:%.*]] = trunc <4 x i16> [[TMP18]] to <4 x i8>
