+void ConstraintSystem::normalize(MutableArrayRef<Entry> R) {
+  // The sum of the variable terms is a multiple of G, so it is <= C iff it is
+  // <= floor(C / G) * G.
+  int64_t G = 0;
+  for (const Entry &E : R) {
+    if (E.Id == 0)
+      continue;
+    if (E.Coefficient == std::numeric_limits<int64_t>::min())
+      return;
+    G = std::gcd(G, E.Coefficient);
+    if (G == 1)
+      return;
+  }
+  if (G == 0)
+    return;
+  for (Entry &E : R)
+    E.Coefficient = E.Id == 0 ? divideFloorSigned(E.Coefficient, G)
+                              : E.Coefficient / G;
+}
