+++ b/llvm/test/Transforms/CorrelatedValuePropagation/range-single-user.ll
@@ -0,0 +1,200 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=correlated-propagation -S < %s | FileCheck %s
+
+; Tests for LazyValueInfo::getConstantRangeAtUse refining the range of a use
+; via facts that hold at the unique undroppable user of the using instruction.
+
+declare void @use.i16(i16)
+declare void @llvm.assume(i1)
+
+; Positive: %add's only undroppable user is the ret in %target, where %a == 93
+; is known. The refined range lets CVP add nuw/nsw to the add. The add is safe
+; to speculatively execute, so applying facts from %target is sound.
+define i8 @refine_add_single_cross_block_user(i8 %a) {
+; CHECK-LABEL: define i8 @refine_add_single_cross_block_user(
+; CHECK-SAME: i8 [[A:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[C:%.*]] = add nuw nsw i8 [[A]], 3
+; CHECK-NEXT:    br label %[[DISPATCH:.*]]
+; CHECK:       [[DISPATCH]]:
+; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i8 [[A]], 93
+; CHECK-NEXT:    br i1 [[CMP]], label %[[TARGET:.*]], label %[[DISPATCH]]
+; CHECK:       [[TARGET]]:
+; CHECK-NEXT:    ret i8 96
+;
+entry:
+  %c = add i8 %a, 3
+  br label %dispatch
+
+dispatch:
+  %cmp = icmp eq i8 %a, 93
+  br i1 %cmp, label %target, label %dispatch
+
+target:
+  ret i8 %c
+}
+
+; Negative (regression): the using instruction is a udiv, which is NOT safe to
+; speculatively execute. Its single user (the store) is in %use, which is only
+; reached when %y < 256. Refining the divisor range using facts from %use and
+; narrowing the udiv to i8 would introduce a division by zero for %y == 256 on
+; the entry path, where the udiv executes unconditionally. The refinement must
+; not fire and the udiv must be left as i16.
+define void @no_refine_udiv_unsafe(i16 %x, i16 %y, ptr %p) {
+; CHECK-LABEL: define void @no_refine_udiv_unsafe(
+; CHECK-SAME: i16 [[X:%.*]], i16 [[Y:%.*]], ptr [[P:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[D:%.*]] = udiv i16 [[X]], [[Y]]
+; CHECK-NEXT:    [[CX:%.*]] = icmp ult i16 [[X]], 256
+; CHECK-NEXT:    [[CY:%.*]] = icmp ult i16 [[Y]], 256
+; CHECK-NEXT:    [[OK:%.*]] = and i1 [[CX]], [[CY]]
+; CHECK-NEXT:    br i1 [[OK]], label %[[USE:.*]], label %[[EXIT:.*]]
+; CHECK:       [[USE]]:
+; CHECK-NEXT:    store i16 [[D]], ptr [[P]], align 2
+; CHECK-NEXT:    ret void
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %d = udiv i16 %x, %y
+  %cx = icmp ult i16 %x, 256
+  %cy = icmp ult i16 %y, 256
+  %ok = and i1 %cx, %cy
+  br i1 %ok, label %use, label %exit
+
+use:
+  store i16 %d, ptr %p
+  ret void
+
+exit:
+  ret void
+}
+
+; Negative (regression): same as above for sdiv, which can also introduce
+; INT_MIN/-1 overflow UB when narrowed based on a downstream-only fact.
+define void @no_refine_sdiv_unsafe(i16 %x, i16 %y, ptr %p) {
+; CHECK-LABEL: define void @no_refine_sdiv_unsafe(
+; CHECK-SAME: i16 [[X:%.*]], i16 [[Y:%.*]], ptr [[P:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[D:%.*]] = sdiv i16 [[X]], [[Y]]
+; CHECK-NEXT:    [[CX:%.*]] = icmp ult i16 [[X]], 100
+; CHECK-NEXT:    [[CY:%.*]] = icmp ult i16 [[Y]], 100
+; CHECK-NEXT:    [[OK:%.*]] = and i1 [[CX]], [[CY]]
+; CHECK-NEXT:    br i1 [[OK]], label %[[USE:.*]], label %[[EXIT:.*]]
+; CHECK:       [[USE]]:
+; CHECK-NEXT:    store i16 [[D]], ptr [[P]], align 2
+; CHECK-NEXT:    ret void
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %d = sdiv i16 %x, %y
+  %cx = icmp ult i16 %x, 100
+  %cy = icmp ult i16 %y, 100
+  %ok = and i1 %cx, %cy
+  br i1 %ok, label %use, label %exit
+
+use:
+  store i16 %d, ptr %p
+  ret void
+
+exit:
+  ret void
+}
+
+; Negative: the add has more than one user, so it has no unique undroppable
+; user and the refinement does not fire (no nuw/nsw added).
+define i8 @no_refine_multiple_users(i8 %a) {
+; CHECK-LABEL: define i8 @no_refine_multiple_users(
+; CHECK-SAME: i8 [[A:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[C:%.*]] = add i8 [[A]], 3
+; CHECK-NEXT:    br label %[[DISPATCH:.*]]
+; CHECK:       [[DISPATCH]]:
+; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i8 [[A]], 93
+; CHECK-NEXT:    br i1 [[CMP]], label %[[TARGET:.*]], label %[[DISPATCH]]
+; CHECK:       [[TARGET]]:
+; CHECK-NEXT:    [[C_EXT:%.*]] = zext nneg i8 [[C]] to i16
+; CHECK-NEXT:    call void @use.i16(i16 [[C_EXT]])
+; CHECK-NEXT:    ret i8 96
+;
+entry:
+  %c = add i8 %a, 3
+  br label %dispatch
+
+dispatch:
+  %cmp = icmp eq i8 %a, 93
+  br i1 %cmp, label %target, label %dispatch
+
+target:
+  %c.ext = zext i8 %c to i16
+  call void @use.i16(i16 %c.ext)
+  ret i8 %c
+}
+
+; Negative: the unique undroppable user is a PHI node, which is skipped to avoid
+; breaking dominance. No nuw/nsw is added.
+define i8 @no_refine_phi_user(i8 %a) {
+; CHECK-LABEL: define range(i8 0, 97) i8 @no_refine_phi_user(
+; CHECK-SAME: i8 [[A:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[C:%.*]] = add i8 [[A]], 3
+; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i8 [[A]], 93
+; CHECK-NEXT:    br i1 [[CMP]], label %[[TARGET:.*]], label %[[EXIT:.*]]
+; CHECK:       [[TARGET]]:
+; CHECK-NEXT:    br label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    [[P:%.*]] = phi i8 [ 96, %[[TARGET]] ], [ 0, %[[ENTRY]] ]
+; CHECK-NEXT:    ret i8 [[P]]
+;
+entry:
+  %c = add i8 %a, 3
+  %cmp = icmp eq i8 %a, 93
+  br i1 %cmp, label %target, label %exit
+
+target:
+  br label %exit
+
+exit:
+  %p = phi i8 [ %c, %target ], [ 0, %entry ]
+  ret i8 %p
+}
+
+; Negative: the unique undroppable user (the ret) is in the same block as the
+; add, so the cross-block refinement guard skips the extra query. Any flags here
+; come from the block-local assume, not the cross-block refinement.
+define i8 @no_refine_same_block_user(i8 %a) {
+; CHECK-LABEL: define i8 @no_refine_same_block_user(
+; CHECK-SAME: i8 [[A:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[C:%.*]] = add nuw nsw i8 [[A]], 3
+; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i8 [[A]], 93
+; CHECK-NEXT:    call void @llvm.assume(i1 [[CMP]])
+; CHECK-NEXT:    ret i8 96
+;
+entry:
+  %c = add i8 %a, 3
+  %cmp = icmp eq i8 %a, 93
+  call void @llvm.assume(i1 %cmp)
+  ret i8 %c
+}
+
+; Negative: the only user other than the ret is a droppable llvm.assume. The
+; assume is droppable, so getUniqueUndroppableUser returns the ret in the same
+; block and the cross-block refinement does not fire (no flags added).
+define i8 @no_refine_droppable_user(i8 %a) {
+; CHECK-LABEL: define i8 @no_refine_droppable_user(
+; CHECK-SAME: i8 [[A:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[C:%.*]] = add i8 [[A]], 3
+; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i8 [[C]], 96
+; CHECK-NEXT:    call void @llvm.assume(i1 [[CMP]])
+; CHECK-NEXT:    ret i8 96
+;
+entry:
+  %c = add i8 %a, 3
+  %cmp = icmp eq i8 %c, 96
+  call void @llvm.assume(i1 %cmp)
+  ret i8 %c
+}
+
