diff --git a/llvm/test/Transforms/InstCombine/and-not-select.ll b/llvm/test/Transforms/InstCombine/and-not-select.ll
new file mode 100644
index 0000000000000..2330e23bf5c6d
--- /dev/null
+++ b/llvm/test/Transforms/InstCombine/and-not-select.ll
@@ -0,0 +1,75 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt < %s -passes=instcombine -S | FileCheck %s
+
+; select (trunc b), 0, (a & 1) -> (a & 1) & ~b
+define i32 @test_select_and_not(i32 %a, i32 %b) {
+; CHECK-LABEL: @test_select_and_not(
+; CHECK-NEXT:    [[AND:%.*]] = and i32 [[A:%.*]], 1
+; CHECK-NEXT:    [[TMP1:%.*]] = xor i32 [[B:%.*]], -1
+; CHECK-NEXT:    [[SEL:%.*]] = and i32 [[AND]], [[TMP1]]
+; CHECK-NEXT:    ret i32 [[SEL]]
+;
+  %trunc = trunc i32 %b to i1
+  %and = and i32 %a, 1
+  %sel = select i1 %trunc, i32 0, i32 %and
+  ret i32 %sel
+}
+
+; Should not transform if mask is not 1 (for now)
+define i32 @test_select_and_not_mask2(i32 %a, i32 %b) {
+; CHECK-LABEL: @test_select_and_not_mask2(
+; CHECK-NEXT:    [[TRUNC:%.*]] = trunc i32 [[B:%.*]] to i1
+; CHECK-NEXT:    [[AND:%.*]] = and i32 [[A:%.*]], 2
+; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[TRUNC]], i32 0, i32 [[AND]]
+; CHECK-NEXT:    ret i32 [[SEL]]
+;
+  %trunc = trunc i32 %b to i1
+  %and = and i32 %a, 2
+  %sel = select i1 %trunc, i32 0, i32 %and
+  ret i32 %sel
+}
+
+; Should not transform if trunc has multiple uses (would increase instruction count)
+define i32 @test_select_and_not_multiuse_trunc(i32 %a, i32 %b) {
+; CHECK-LABEL: @test_select_and_not_multiuse_trunc(
+; CHECK-NEXT:    [[AND:%.*]] = and i32 [[A:%.*]], 1
+; CHECK-NEXT:    [[TMP1:%.*]] = xor i32 [[B:%.*]], -1
+; CHECK-NEXT:    [[SEL:%.*]] = and i32 [[AND]], [[TMP1]]
+; CHECK-NEXT:    [[ZEXT:%.*]] = and i32 [[B]], 1
+; CHECK-NEXT:    [[ADD:%.*]] = or i32 [[SEL]], [[ZEXT]]
+; CHECK-NEXT:    ret i32 [[ADD]]
+;
+  %trunc = trunc i32 %b to i1
+  %and = and i32 %a, 1
+  %sel = select i1 %trunc, i32 0, i32 %and
+  %zext = zext i1 %trunc to i32
+  %add = add i32 %sel, %zext
+  ret i32 %add
+}
+
+; Inverse: select (trunc b), (a & 1), 0 -> (a & 1) & b
+define i32 @test_select_and(i32 %a, i32 %b) {
+; CHECK-LABEL: @test_select_and(
+; CHECK-NEXT:    [[AND:%.*]] = and i32 [[A:%.*]], 1
+; CHECK-NEXT:    [[SEL:%.*]] = and i32 [[AND]], [[B:%.*]]
+; CHECK-NEXT:    ret i32 [[SEL]]
+;
+  %trunc = trunc i32 %b to i1
+  %and = and i32 %a, 1
+  %sel = select i1 %trunc, i32 %and, i32 0
+  ret i32 %sel
+}
+
+; Inverse: should not transform if mask is not 1
+define i32 @test_select_and_mask2(i32 %a, i32 %b) {
+; CHECK-LABEL: @test_select_and_mask2(
+; CHECK-NEXT:    [[TRUNC:%.*]] = trunc i32 [[B:%.*]] to i1
+; CHECK-NEXT:    [[AND:%.*]] = and i32 [[A:%.*]], 2
+; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[TRUNC]], i32 [[AND]], i32 0
+; CHECK-NEXT:    ret i32 [[SEL]]
+;
+  %trunc = trunc i32 %b to i1
+  %and = and i32 %a, 2
+  %sel = select i1 %trunc, i32 %and, i32 0
+  ret i32 %sel
+}
