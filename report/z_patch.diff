+/// Merge a chain of masked stores when their disjoint updates cover a
+/// contiguous bit range and the last store covers the full access. A lone
+/// masked store can be narrowed independently when it replaces a single byte.
+///
+/// Within each basic block, collect stores with a common base and overlapping
+/// accesses. Identify the updated bits using local memory values or a load in
+/// a predecessor proved available by MemorySSA. End chains at interfering
+/// accesses. Split candidates at overlapping updates in program order and at
+/// gaps in address order.
+static bool foldStoreChains(Function &F, AliasAnalysis &AA, DominatorTree &DT) {
+  const DataLayout &DL = F.getDataLayout();
+  StoreChainAnalysis Analysis(AA, DT);
+  SmallVector<StoreChain, 4> Chains;
+
+  for (BasicBlock &BB : F) {
+    if (!DT.isReachableFromEntry(&BB))
+      continue;
+
+    if (llvm::none_of(BB, [](Instruction &I) {
+          auto *SI = dyn_cast<StoreInst>(&I);
+          return SI && match(SI->getValueOperand(),
+                             m_DisjointOr(m_Value(), m_Value()));
+        }))
+      continue;
+
+    SmallVector<StoreChain, 4> CurrentChains, BlockChains;
+    // Track values by access even for loads and stores outside a chain.
+    // Use them to verify the source of preserved bits in later masked stores.
+    SmallVector<PreservationCheckValue, 4> PreservationCheckValues;
+    auto FinishChains = [&] {
+      for (StoreChain &Chain : CurrentChains)
+        finalizeStoreChain(Chain, BlockChains);
+      CurrentChains.clear();
+    };
+    for (Instruction &I : BB) {
+      if (I.isAtomic() || I.isVolatile() || I.maySynchronize() ||
+          !isGuaranteedToTransferExecutionToSuccessor(&I)) {
+        FinishChains();
+        PreservationCheckValues.clear();
+        continue;
+      }
+      if (!I.mayReadOrWriteMemory())
+        continue;
+
+      if (auto *Store = dyn_cast<StoreInst>(&I))
+        collectStoreChain(*Store, DL, Analysis, CurrentChains,
+                          PreservationCheckValues, BlockChains);
+      else
+        processNonStoreAccess(I, DL, CurrentChains, PreservationCheckValues,
+                              Analysis.BatchAA, BlockChains);
+    }
+    FinishChains();
+
+    // An intervening reload may split updates to the same word into separate
+    // chains. Keep the full-width store available for forwarding in that case.
+    for (const StoreChain &Chain : BlockChains) {
+      if (Chain.Ranges.size() != 1 || !matchMaskedByteStore(Chain))
+        continue;
+      MemoryLocation Loc =
+          MemoryLocation::get(Chain.Ranges.front().Store).getWithoutAATags();
+      if (llvm::none_of(BlockChains, [&](const StoreChain &Other) {
+            return &Chain != &Other &&
+                   llvm::any_of(Other.Ranges, [&](const StoreWriteRange &W) {
+                     return !Analysis.BatchAA.isNoAlias(
+                         Loc, MemoryLocation::get(W.Store).getWithoutAATags());
+                   });
+          }))
+        Chains.push_back(Chain);
+    }
+    for (StoreChain &Chain : BlockChains)
+      if (Chain.Ranges.size() > 1)
+        Chains.push_back(std::move(Chain));
+  }
+
+  // Finish clobber queries before applying the store folds.
+  Analysis.MSSA.reset();
+
+  bool Changed = false;
+  // Apply the single-store chains before splitting the remaining chains.
+  llvm::erase_if(Chains, [&](const StoreChain &Chain) {
+    if (Chain.Ranges.size() != 1)
+      return false;
+    auto *Masked =
+        cast<BinaryOperator>(getStoreInsertOperand(Chain.Ranges.front()));
+    Value *Insert = isa<ConstantInt>(Masked->getOperand(1))
+                        ? Masked->getOperand(0)
+                        : Masked->getOperand(1);
+    Changed |= mergeStoreChain(Chain, AA, DL, Insert);
+    return true;
+  });
+  for (const StoreChain &Chain : splitStoreChainsByContiguity(Chains))
+    Changed |= mergeStoreChain(Chain, AA, DL);
+  return Changed;
+}
