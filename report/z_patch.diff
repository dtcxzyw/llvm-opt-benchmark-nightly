diff --git a/llvm/lib/Analysis/ValueTracking.cpp b/llvm/lib/Analysis/ValueTracking.cpp
index 1286130cf5d94..ca035b0381125 100644
--- a/llvm/lib/Analysis/ValueTracking.cpp
+++ b/llvm/lib/Analysis/ValueTracking.cpp
@@ -10048,12 +10048,13 @@ isImpliedCondICmps(CmpPredicate LPred, const Value *L0, const Value *L1,
       return true;
   }
 
-  // a - b == NonZero -> a != b
-  // ptrtoint(a) - ptrtoint(b) == NonZero -> a != b
+  // (a - b) pred C -> a != b, if 0 pred C is false
+  // (ptrtoint(a) - ptrtoint(b)) pred C -> a != b, if 0 pred C is false
   const APInt *L1C;
   Value *A, *B;
-  if (LPred == ICmpInst::ICMP_EQ && ICmpInst::isEquality(RPred) &&
-      match(L1, m_APInt(L1C)) && !L1C->isZero() &&
+  if (ICmpInst::isEquality(RPred) && match(L1, m_APInt(L1C)) &&
+      !ConstantRange::makeExactICmpRegion(LPred, *L1C)
+           .contains(APInt::getZero(L1C->getBitWidth())) &&
       match(L0, m_Sub(m_Value(A), m_Value(B))) &&
       ((A == R0 && B == R1) || (A == R1 && B == R0) ||
        (match(A, m_PtrToIntOrAddr(m_Specific(R0))) &&
@@ -10967,13 +10968,18 @@ void llvm::findValuesAffectedByCondition(
       } else {
         AddCmpOperands(A, B);
         if (HasRHSC) {
+          Value *Y;
           // Handle (A + C1) u< C2, which is the canonical form of
           // A > C3 && A < C4.
           if (match(A, m_AddLike(m_Value(X), m_ConstantInt())))
             AddAffected(X);
+          // X - Y pred C, which implies X != Y if 0 pred C is false.
+          else if (match(A, m_Sub(m_Value(X), m_Value(Y)))) {
+            AddAffected(X);
+            AddAffected(Y);
+          }
 
           if (ICmpInst::isUnsigned(Pred)) {
-            Value *Y;
             // X & Y u> C    -> X >u C && Y >u C
             // X | Y u< C    -> X u< C && Y u< C
             // X nuw+ Y u< C -> X u< C && Y u< C
diff --git a/llvm/test/Transforms/InstCombine/icmp.ll b/llvm/test/Transforms/InstCombine/icmp.ll
index c7bae58a0b197..5382287098149 100644
--- a/llvm/test/Transforms/InstCombine/icmp.ll
+++ b/llvm/test/Transforms/InstCombine/icmp.ll
@@ -6282,3 +6282,200 @@ entry:
   %cmp = icmp ult i8 %p0, %p1
   ret i1 %cmp
 }
+
+; (x - y) pred C implies x != y if 0 pred C is false.
+
+define i1 @diff_ugt_implies_icmp_eq(i64 %x, i64 %y) {
+; CHECK-LABEL: define i1 @diff_ugt_implies_icmp_eq(
+; CHECK-SAME: i64 [[X:%.*]], i64 [[Y:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[DIFF:%.*]] = sub i64 [[X]], [[Y]]
+; CHECK-NEXT:    [[COND:%.*]] = icmp ugt i64 [[DIFF]], 1
+; CHECK-NEXT:    call void @llvm.assume(i1 [[COND]])
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %diff = sub i64 %x, %y
+  %cond = icmp ugt i64 %diff, 1
+  call void @llvm.assume(i1 %cond)
+  %cmp = icmp eq i64 %x, %y
+  ret i1 %cmp
+}
+
+define i1 @diff_ugt_implies_icmp_ne_commuted(i64 %x, i64 %y) {
+; CHECK-LABEL: define i1 @diff_ugt_implies_icmp_ne_commuted(
+; CHECK-SAME: i64 [[X:%.*]], i64 [[Y:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[DIFF:%.*]] = sub i64 [[X]], [[Y]]
+; CHECK-NEXT:    [[COND:%.*]] = icmp ugt i64 [[DIFF]], 1
+; CHECK-NEXT:    call void @llvm.assume(i1 [[COND]])
+; CHECK-NEXT:    ret i1 true
+;
+entry:
+  %diff = sub i64 %x, %y
+  %cond = icmp ugt i64 %diff, 1
+  call void @llvm.assume(i1 %cond)
+  %cmp = icmp ne i64 %y, %x
+  ret i1 %cmp
+}
