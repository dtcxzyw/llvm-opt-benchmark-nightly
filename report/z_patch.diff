+  call void @llvm.memset.p0.i64(ptr %a, i8 1, i64 4, i1 false)
+  call void @callee(ptr %a)
+  %l = load i32, ptr %a
+  ret i32 %l
+}
+
+; The memset after the store defines the value.
+define ptr @store_then_memset(ptr %p) {
+; CHECK-LABEL: define ptr @store_then_memset(
+; CHECK-SAME: ptr [[P:%.*]]) {
+; CHECK-NEXT:    [[A:%.*]] = alloca ptr, align 8
+; CHECK-NEXT:    store ptr [[P]], ptr [[A]], align 8
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 0, i64 8, i1 false)
+; CHECK-NEXT:    call void @callee(ptr [[A]])
+; CHECK-NEXT:    ret ptr null
+;
+  %a = alloca ptr, align 8
+  store ptr %p, ptr %a
+  call void @llvm.memset.p0.i64(ptr %a, i8 0, i64 8, i1 false)
+  call void @callee(ptr %a)
+  %l = load ptr, ptr %a
+  ret ptr %l
+}
+
+; A load before the memset reads the earlier store, a load after it reads 0.
+define i64 @load_before_and_after_memset(i64 %x, ptr %out) {
+; CHECK-LABEL: define i64 @load_before_and_after_memset(
+; CHECK-SAME: i64 [[X:%.*]], ptr [[OUT:%.*]]) {
+; CHECK-NEXT:    [[A:%.*]] = alloca i64, align 8
+; CHECK-NEXT:    store i64 [[X]], ptr [[A]], align 4
+; CHECK-NEXT:    call void @callee(ptr [[A]])
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 0, i64 8, i1 false)
+; CHECK-NEXT:    store i64 [[X]], ptr [[OUT]], align 4
+; CHECK-NEXT:    ret i64 0
+;
+  %a = alloca i64, align 8
+  store i64 %x, ptr %a
+  call void @callee(ptr %a)
+  %l0 = load i64, ptr %a
+  call void @llvm.memset.p0.i64(ptr %a, i8 0, i64 8, i1 false)
+  %l1 = load i64, ptr %a
+  store i64 %l0, ptr %out
+  ret i64 %l1
+}
+
+; Of two memsets, the later one defines the value.
+define i32 @two_memsets() {
+; CHECK-LABEL: define i32 @two_memsets() {
+; CHECK-NEXT:    [[A:%.*]] = alloca i32, align 4
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 1, i64 4, i1 false)
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 2, i64 4, i1 false)
+; CHECK-NEXT:    call void @callee(ptr [[A]])
+; CHECK-NEXT:    ret i32 33686018
+;
+  %a = alloca i32, align 4
+  call void @llvm.memset.p0.i64(ptr %a, i8 1, i64 4, i1 false)
+  call void @llvm.memset.p0.i64(ptr %a, i8 2, i64 4, i1 false)
+  call void @callee(ptr %a)
+  %l = load i32, ptr %a
+  ret i32 %l
+}
+
+define double @memset_zero_double() {
+; CHECK-LABEL: define double @memset_zero_double() {
+; CHECK-NEXT:    [[A:%.*]] = alloca double, align 8
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 0, i64 8, i1 false)
+; CHECK-NEXT:    call void @callee(ptr [[A]])
+; CHECK-NEXT:    ret double 0.000000e+00
+;
+  %a = alloca double, align 8
