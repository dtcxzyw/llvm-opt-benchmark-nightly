+  %gep2 = getelementptr inbounds i8, ptr %dst2, i64 %iv
+  store i8 %v, ptr %gep2, align 1
+  %iv.next = add nuw i64 %iv, 1
+  %ec = icmp eq i64 %iv.next, %n
+  br i1 %ec, label %exit, label %loop
+
+exit:
+  ret void
+}
