@@ -1093,9 +1093,26 @@ void State::addInfoForInductions(BasicBlock &BB) {
   auto IndValue =
       m_Value(A, m_CombineOr(m_Phi(PN), m_c_Add(m_Phi(PN), m_APInt(IncStep))));
 
-  if (!match(BB.getTerminator(),
