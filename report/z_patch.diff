+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=correlated-propagation -S %s | FileCheck %s
+
+; A condition on 'X + C' also bounds X, by shifting the range back by C. The
+; shifted range wraps around unless the add is known not to wrap, so the no-wrap
+; flags of the add have to be taken into account to get the tighter bound.
+
+; %inc >=s 0 only shifts back to %x >=s -1, but the add is nuw, so %inc cannot
+; have wrapped around to 0 and %x >=s 0 holds.
+define i1 @add_nuw_sge(i32 %x) {
+; CHECK-LABEL: define i1 @add_nuw_sge(
+; CHECK-SAME: i32 [[X:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[INC:%.*]] = add nuw i32 [[X]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp sgt i32 [[INC]], -1
+; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    ret i1 true
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %inc = add nuw i32 %x, 1
+  %c = icmp sgt i32 %inc, -1
+  br i1 %c, label %then, label %exit
+
+then:
+  %t = icmp sgt i32 %x, -1
+  ret i1 %t
+
+exit:
+  ret i1 false
+}
+
+; Same, via 'or disjoint', which cannot carry either.
+define i1 @or_disjoint_sge(i32 %x) {
+; CHECK-LABEL: define i1 @or_disjoint_sge(
+; CHECK-SAME: i32 [[X:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[INC:%.*]] = or disjoint i32 [[X]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp sgt i32 [[INC]], -1
+; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    ret i1 true
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %inc = or disjoint i32 %x, 1
+  %c = icmp sgt i32 %inc, -1
+  br i1 %c, label %then, label %exit
+
+then:
+  %t = icmp sgt i32 %x, -1
+  ret i1 %t
+
+exit:
+  ret i1 false
+}
+
+; Negative test: without nuw, %x = -1 makes %inc 0 and %x >=s 0 does not hold.
+define i1 @add_sge(i32 %x) {
+; CHECK-LABEL: define i1 @add_sge(
+; CHECK-SAME: i32 [[X:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[INC:%.*]] = add i32 [[X]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp sgt i32 [[INC]], -1
+; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[EXIT:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    [[T:%.*]] = icmp sgt i32 [[X]], -1
+; CHECK-NEXT:    ret i1 [[T]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %inc = add i32 %x, 1
+  %c = icmp sgt i32 %inc, -1
+  br i1 %c, label %then, label %exit
+
+then:
+  %t = icmp sgt i32 %x, -1
+  ret i1 %t
+
+exit:
+  ret i1 false
+}
+
+; The symmetric direction: the condition is on %x and the queried value is the
+; add. %x >=s 0 shifts to %inc in [1, INT_MAX + 1], which wraps around to
+; INT_MIN; the nsw flag rules that value out. Note that the range of an
+; 'add nuw nsw' on its own is only 'not 0' - the exact range is not
+; representable - so the flags have to be applied to the shifted range here.
+define i1 @phi_of_add_nuw_nsw(i32 %x) {
+; CHECK-LABEL: define i1 @phi_of_add_nuw_nsw(
+; CHECK-SAME: i32 [[X:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[NEG:%.*]] = icmp slt i32 [[X]], 0
+; CHECK-NEXT:    [[INC:%.*]] = add nuw nsw i32 [[X]], 1
+; CHECK-NEXT:    br i1 [[NEG]], label %[[ZERO:.*]], label %[[NONNEG:.*]]
+; CHECK:       [[ZERO]]:
+; CHECK-NEXT:    br label %[[JOIN:.*]]
+; CHECK:       [[NONNEG]]:
+; CHECK-NEXT:    br label %[[JOIN]]
+; CHECK:       [[JOIN]]:
+; CHECK-NEXT:    [[V:%.*]] = phi i32 [ 0, %[[ZERO]] ], [ [[INC]], %[[NONNEG]] ]
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %neg = icmp slt i32 %x, 0
+  %inc = add nuw nsw i32 %x, 1
+  br i1 %neg, label %zero, label %nonneg
+
+zero:
+  br label %join
+
+nonneg:
+  br label %join
+
+join:
+  %v = phi i32 [ 0, %zero ], [ %inc, %nonneg ]
+  %c = icmp slt i32 %v, 0
+  ret i1 %c
+}
+
+define i1 @phi_of_add_nsw(i32 %x) {
+; CHECK-LABEL: define i1 @phi_of_add_nsw(
+; CHECK-SAME: i32 [[X:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[NEG:%.*]] = icmp slt i32 [[X]], 0
+; CHECK-NEXT:    [[INC:%.*]] = add nsw i32 [[X]], 1
+; CHECK-NEXT:    br i1 [[NEG]], label %[[ZERO:.*]], label %[[NONNEG:.*]]
+; CHECK:       [[ZERO]]:
+; CHECK-NEXT:    br label %[[JOIN:.*]]
+; CHECK:       [[NONNEG]]:
+; CHECK-NEXT:    br label %[[JOIN]]
+; CHECK:       [[JOIN]]:
+; CHECK-NEXT:    [[V:%.*]] = phi i32 [ 0, %[[ZERO]] ], [ [[INC]], %[[NONNEG]] ]
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %neg = icmp slt i32 %x, 0
+  %inc = add nsw i32 %x, 1
+  br i1 %neg, label %zero, label %nonneg
+
+zero:
+  br label %join
+
+nonneg:
+  br label %join
+
+join:
+  %v = phi i32 [ 0, %zero ], [ %inc, %nonneg ]
+  %c = icmp slt i32 %v, 0
+  ret i1 %c
+}
+
+; Negative test: nuw alone permits %x == INT_MAX, for which %inc is INT_MIN.
+define i1 @phi_of_add_nuw(i32 %x) {
+; CHECK-LABEL: define i1 @phi_of_add_nuw(
+; CHECK-SAME: i32 [[X:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[NEG:%.*]] = icmp slt i32 [[X]], 0
+; CHECK-NEXT:    [[INC:%.*]] = add nuw i32 [[X]], 1
+; CHECK-NEXT:    br i1 [[NEG]], label %[[ZERO:.*]], label %[[NONNEG:.*]]
+; CHECK:       [[ZERO]]:
+; CHECK-NEXT:    br label %[[JOIN:.*]]
+; CHECK:       [[NONNEG]]:
+; CHECK-NEXT:    br label %[[JOIN]]
+; CHECK:       [[JOIN]]:
+; CHECK-NEXT:    [[V:%.*]] = phi i32 [ 0, %[[ZERO]] ], [ [[INC]], %[[NONNEG]] ]
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[V]], 0
+; CHECK-NEXT:    ret i1 [[C]]
+;
+entry:
+  %neg = icmp slt i32 %x, 0
+  %inc = add nuw i32 %x, 1
+  br i1 %neg, label %zero, label %nonneg
+
+zero:
+  br label %join
+
+nonneg:
+  br label %join
+
+join:
+  %v = phi i32 [ 0, %zero ], [ %inc, %nonneg ]
+  %c = icmp slt i32 %v, 0
+  ret i1 %c
+}
+
+; Negative test: a plain add may wrap to INT_MIN for %x == INT_MAX.
+define i1 @phi_of_add(i32 %x) {
+; CHECK-LABEL: define i1 @phi_of_add(
+; CHECK-SAME: i32 [[X:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[NEG:%.*]] = icmp slt i32 [[X]], 0
+; CHECK-NEXT:    [[INC:%.*]] = add i32 [[X]], 1
+; CHECK-NEXT:    br i1 [[NEG]], label %[[ZERO:.*]], label %[[NONNEG:.*]]
+; CHECK:       [[ZERO]]:
+; CHECK-NEXT:    br label %[[JOIN:.*]]
+; CHECK:       [[NONNEG]]:
+; CHECK-NEXT:    br label %[[JOIN]]
+; CHECK:       [[JOIN]]:
+; CHECK-NEXT:    [[V:%.*]] = phi i32 [ 0, %[[ZERO]] ], [ [[INC]], %[[NONNEG]] ]
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i32 [[V]], 0
+; CHECK-NEXT:    ret i1 [[C]]
+;
+entry:
+  %neg = icmp slt i32 %x, 0
+  %inc = add i32 %x, 1
+  br i1 %neg, label %zero, label %nonneg
+
+zero:
+  br label %join
+
+nonneg:
+  br label %join
+
+join:
+  %v = phi i32 [ 0, %zero ], [ %inc, %nonneg ]
+  %c = icmp slt i32 %v, 0
+  ret i1 %c
+}
+
+; The refined range is only used when it is actually tighter: here the plain
+; shift already excludes 4, while intersecting with the no-wrap region would
+; have to drop that and exclude INT_MAX instead.
+define i1 @clamp_ne_keeps_hole(i32 noundef %a) {
+; CHECK-LABEL: define i1 @clamp_ne_keeps_hole(
+; CHECK-SAME: i32 noundef [[A:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[CMP:%.*]] = icmp sge i32 [[A]], 5
+; CHECK-NEXT:    br i1 [[CMP]], label %[[GUARD:.*]], label %[[OUT:.*]]
+; CHECK:       [[GUARD]]:
+; CHECK-NEXT:    [[SEL_CMP:%.*]] = icmp eq i32 [[A]], 5
+; CHECK-NEXT:    [[DEC:%.*]] = add nsw i32 [[A]], -1
+; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[SEL_CMP]], i32 5, i32 [[DEC]]
+; CHECK-NEXT:    ret i1 false
+; CHECK:       [[OUT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %cmp = icmp sge i32 %a, 5
+  br i1 %cmp, label %guard, label %out
+
+guard:
+  %sel_cmp = icmp eq i32 %a, 5
+  %dec = add nsw i32 %a, -1
+  %sel = select i1 %sel_cmp, i32 5, i32 %dec
+  %res = icmp eq i32 %sel, 4
+  ret i1 %res
+
+out:
+  ret i1 false
+}
