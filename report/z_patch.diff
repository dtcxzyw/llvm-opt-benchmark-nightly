+  store volatile i1 %sge, ptr %out
+  %iv.next = add nsw i64 %iv, -1
+  %ec = icmp eq i64 %iv.next, %n
+  br i1 %ec, label %exit, label %loop
+
+exit:
+  ret void
+}
