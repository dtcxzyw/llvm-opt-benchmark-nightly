+++ b/llvm/test/Transforms/IndVarSimplify/addrec-vs-start-monotonic.ll
@@ -0,0 +1,165 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt -p indvars -S %s | FileCheck %s
+
+; The rule under test is SCEV's IsKnownPredicateViaAddRecMonotonicity: a no-wrap
+; AddRec is never below its own start value. Analysis/ScalarEvolution/
+; addrec-vs-start-monotonic.ll covers it through the min/max folds in the
+; backedge-taken counts, but those only ever ask for ULE/UGE with the recurrence
+; on the left. The strict and the swapped forms need a consumer that asks
+; isKnownPredicate directly, which is what indvars does for these compares.
+
+; With nuw the non-strict predicate is known, so %lt folds to false and %ge to
+; true. The recurrence is equal to %start in the first iteration, so the strict
+; forms %gt and %le must survive.
+define void @nuw_strict_vs_nonstrict(i64 %start, i64 %n, ptr %out) {
+; CHECK-LABEL: @nuw_strict_vs_nonstrict(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[START:%.*]], [[ENTRY:%.*]] ], [ [[IV_NEXT:%.*]], [[LOOP]] ]
+; CHECK-NEXT:    [[GT:%.*]] = icmp ugt i64 [[IV]], [[START]]
+; CHECK-NEXT:    [[LE:%.*]] = icmp ule i64 [[IV]], [[START]]
+; CHECK-NEXT:    store volatile i1 false, ptr [[OUT:%.*]], align 1
+; CHECK-NEXT:    store volatile i1 true, ptr [[OUT]], align 1
+; CHECK-NEXT:    store volatile i1 [[GT]], ptr [[OUT]], align 1
+; CHECK-NEXT:    store volatile i1 [[LE]], ptr [[OUT]], align 1
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw i64 [[IV]], 1
+; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N:%.*]]
+; CHECK-NEXT:    br i1 [[EC]], label [[EXIT:%.*]], label [[LOOP]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %loop
+
+loop:
+  %iv = phi i64 [ %start, %entry ], [ %iv.next, %loop ]
+  %lt = icmp ult i64 %iv, %start
+  %ge = icmp uge i64 %iv, %start
+  %gt = icmp ugt i64 %iv, %start
+  %le = icmp ule i64 %iv, %start
+  store volatile i1 %lt, ptr %out
+  store volatile i1 %ge, ptr %out
+  store volatile i1 %gt, ptr %out
+  store volatile i1 %le, ptr %out
+  %iv.next = add nuw i64 %iv, 1
+  %ec = icmp eq i64 %iv.next, %n
+  br i1 %ec, label %exit, label %loop
+
+exit:
+  ret void
+}
+
+; The same fact with the recurrence on the right-hand side of the compare, which
+; reaches the rule through its (AddRec Pred Start) normalization.
+define void @nuw_addrec_on_rhs(i64 %start, i64 %n, ptr %out) {
+; CHECK-LABEL: @nuw_addrec_on_rhs(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[START:%.*]], [[ENTRY:%.*]] ], [ [[IV_NEXT:%.*]], [[LOOP]] ]
+; CHECK-NEXT:    [[LT:%.*]] = icmp ult i64 [[START]], [[IV]]
+; CHECK-NEXT:    store volatile i1 false, ptr [[OUT:%.*]], align 1
+; CHECK-NEXT:    store volatile i1 true, ptr [[OUT]], align 1
+; CHECK-NEXT:    store volatile i1 [[LT]], ptr [[OUT]], align 1
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw i64 [[IV]], 1
+; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N:%.*]]
+; CHECK-NEXT:    br i1 [[EC]], label [[EXIT:%.*]], label [[LOOP]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %loop
+
+loop:
+  %iv = phi i64 [ %start, %entry ], [ %iv.next, %loop ]
+  %gt = icmp ugt i64 %start, %iv
+  %le = icmp ule i64 %start, %iv
+  %lt = icmp ult i64 %start, %iv
+  store volatile i1 %gt, ptr %out
+  store volatile i1 %le, ptr %out
+  store volatile i1 %lt, ptr %out
+  %iv.next = add nuw i64 %iv, 1
+  %ec = icmp eq i64 %iv.next, %n
+  br i1 %ec, label %exit, label %loop
+
+exit:
+  ret void
+}
+
+; nsw with a step that cannot be negative gives the signed bound only, so %slt
+; folds and the unsigned %ult must survive: a nsw recurrence can cross the
+; unsigned boundary.
+define void @nsw_nonneg_step(i64 %start, i64 %n, i64 %step.raw, ptr %out) {
+; CHECK-LABEL: @nsw_nonneg_step(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[STEP:%.*]] = and i64 [[STEP_RAW:%.*]], 7
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[START:%.*]], [[ENTRY:%.*]] ], [ [[IV_NEXT:%.*]], [[LOOP]] ]
+; CHECK-NEXT:    [[ULT:%.*]] = icmp ult i64 [[IV]], [[START]]
+; CHECK-NEXT:    [[SGT:%.*]] = icmp sgt i64 [[IV]], [[START]]
+; CHECK-NEXT:    store volatile i1 false, ptr [[OUT:%.*]], align 1
+; CHECK-NEXT:    store volatile i1 [[ULT]], ptr [[OUT]], align 1
+; CHECK-NEXT:    store volatile i1 [[SGT]], ptr [[OUT]], align 1
+; CHECK-NEXT:    [[IV_NEXT]] = add nsw i64 [[IV]], [[STEP]]
+; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N:%.*]]
+; CHECK-NEXT:    br i1 [[EC]], label [[EXIT:%.*]], label [[LOOP]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %step = and i64 %step.raw, 7
+  br label %loop
+
+loop:
+  %iv = phi i64 [ %start, %entry ], [ %iv.next, %loop ]
+  %slt = icmp slt i64 %iv, %start
+  %ult = icmp ult i64 %iv, %start
+  %sgt = icmp sgt i64 %iv, %start
+  store volatile i1 %slt, ptr %out
+  store volatile i1 %ult, ptr %out
+  store volatile i1 %sgt, ptr %out
+  %iv.next = add nsw i64 %iv, %step
+  %ec = icmp eq i64 %iv.next, %n
+  br i1 %ec, label %exit, label %loop
+
+exit:
+  ret void
+}
+
+; Negative test: nsw with a step that is known negative. The recurrence does go
+; below %start, so nothing folds. The negative test in the Analysis file only
+; covers a step of unknown sign, which is a weaker check.
+define void @nsw_negative_step(i64 %start, i64 %n, ptr %out) {
+; CHECK-LABEL: @nsw_negative_step(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br label [[LOOP:%.*]]
