+; CHECK-NEXT:    [[C_1:%.*]] = icmp sgt i64 [[J]], 0
+; CHECK-NEXT:    br i1 [[C_1]], label %[[BB_2:.*]], label %[[EXIT]]
+; CHECK:       [[BB_2]]:
