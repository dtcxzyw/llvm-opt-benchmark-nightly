+static Instruction *foldICmpZeroOfCheckLenSelect(ICmpInst &I,
+                                                 IRBuilderBase &Builder) {
+  if (!I.isEquality())
+    return nullptr;
+
+  Value *V;
+  if (match(I.getOperand(1), m_ZeroInt()))
+    V = I.getOperand(0);
+  else if (match(I.getOperand(0), m_ZeroInt()))
+    V = I.getOperand(1);
+  else
+    return nullptr;
+
+  if (!isa<IntegerType>(V->getType()))
+    return nullptr;
+
+  Value *Cond, *TrueVal, *FalseVal;
+  if (!match(V, m_OneUse(m_Select(m_Value(Cond), m_Value(TrueVal),
+                                  m_Value(FalseVal)))))
+    return nullptr;
+
+  const APInt *CapC;
+  if (!match(TrueVal, m_APInt(CapC)) || CapC->isZero())
+    return nullptr;
+
+  Value *Add;
+  const APInt *MinC;
+  if (!match(FalseVal,
+             m_OneUse(m_c_UMin(m_Value(Add), m_APInt(MinC)))) ||
+      *CapC != *MinC)
+    return nullptr;
+
+  CmpPredicate Pred;
+  Value *CmpLHS, *Size;
+  if (!match(Cond, m_OneUse(m_ICmp(Pred, m_Value(CmpLHS),
+                                   m_Value(Size)))) ||
+      Pred != ICmpInst::ICMP_ULT || CmpLHS != Add)
+    return nullptr;
+
+  Value *Max;
+  if (!match(Add, m_c_Add(m_Value(Max), m_Specific(Size))))
+    return nullptr;
+
+  Value *N;
+  if (!match(Max, m_c_UMax(m_Specific(Size), m_Value(N))))
+    return nullptr;
+
+  Value *Or = Builder.CreateOr(Size, N);
+  return new ICmpInst(I.getPredicate(), Or,
+                      Constant::getNullValue(Or->getType()));
+}
