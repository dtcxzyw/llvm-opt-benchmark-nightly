diff --git a/llvm/test/Transforms/CorrelatedValuePropagation/assume-equality-pointers.ll b/llvm/test/Transforms/CorrelatedValuePropagation/assume-equality-pointers.ll
new file mode 100644
index 00000000000000..a831a80135e42b
--- /dev/null
+++ b/llvm/test/Transforms/CorrelatedValuePropagation/assume-equality-pointers.ll
@@ -0,0 +1,117 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -passes=correlated-propagation -S | FileCheck %s
+
+; Ensure the replacement of one pointer with another is subject to the approximations of
+; canReplacePointersInUseIfEqual(). In the following cases, replacing a pointer with an
+; inttoptr constant (which may have non-existent provenance), or with a global ptr (whose
+; provenance is confined to the bounds of its object) would be an invalid refinement.
+
+@g = global i64 0
+
+define ptr @assume_ptr_equality(ptr %x) {
+; CHECK-LABEL: define ptr @assume_ptr_equality(
+; CHECK-SAME: ptr [[X:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[C:%.*]] = icmp eq ptr [[X]], inttoptr (i64 12345678 to ptr)
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
+; CHECK-NEXT:    ret ptr [[X]]
+;
+entry:
+  %c = icmp eq ptr %x, inttoptr (i64 12345678 to ptr)
+  call void @llvm.assume(i1 %c)
+  ret ptr %x
+}
+
+define ptr @assume_ptr_equality_return_value(ptr %p) {
+; CHECK-LABEL: define ptr @assume_ptr_equality_return_value(
+; CHECK-SAME: ptr [[P:%.*]]) {
+; CHECK-NEXT:    [[C:%.*]] = icmp eq ptr [[P]], inttoptr (i64 -1 to ptr)
+; CHECK-NEXT:    br i1 [[C]], label %[[BB_IF:.*]], label %[[BB_ELSE:.*]]
+; CHECK:       [[BB_IF]]:
+; CHECK-NEXT:    ret ptr [[P]]
+; CHECK:       [[BB_ELSE]]:
+; CHECK-NEXT:    ret ptr null
+;
+  %c = icmp eq ptr %p, inttoptr (i64 -1 to ptr)
+  br i1 %c, label %bb.if, label %bb.else
+
+bb.if:
+  ret ptr %p
+
+bb.else:
+  ret ptr null
+}
+
+define ptr @assume_ptr_equality_phi_node(ptr %p) {
+; CHECK-LABEL: define ptr @assume_ptr_equality_phi_node(
+; CHECK-SAME: ptr [[P:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[C:%.*]] = icmp eq ptr [[P]], @g
+; CHECK-NEXT:    br i1 [[C]], label %[[JOIN:.*]], label %[[BB_ELSE:.*]]
+; CHECK:       [[BB_ELSE]]:
+; CHECK-NEXT:    br label %[[JOIN]]
+; CHECK:       [[JOIN]]:
+; CHECK-NEXT:    [[PHI:%.*]] = phi ptr [ [[P]], %[[ENTRY]] ], [ @g, %[[BB_ELSE]] ]
+; CHECK-NEXT:    ret ptr [[PHI]]
+;
+entry:
+  %c = icmp eq ptr %p, @g
+  br i1 %c, label %join, label %bb.else
+
+bb.else:
+  br label %join
+
+join:
+  %phi = phi ptr [ %p, %entry ], [ @g, %bb.else ]
+  ret ptr %phi
+}
+
+define ptr @assume_ptr_equality_common_value_phi_node(ptr %p) {
+; CHECK-LABEL: define ptr @assume_ptr_equality_common_value_phi_node(
+; CHECK-SAME: ptr [[P:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[C:%.*]] = icmp eq ptr [[P]], inttoptr (i64 -1 to ptr)
+; CHECK-NEXT:    br i1 [[C]], label %[[JOIN:.*]], label %[[BB_ELSE:.*]]
+; CHECK:       [[BB_ELSE]]:
+; CHECK-NEXT:    br label %[[JOIN]]
+; CHECK:       [[JOIN]]:
+; CHECK-NEXT:    [[PHI:%.*]] = phi ptr [ inttoptr (i64 -1 to ptr), %[[ENTRY]] ], [ [[P]], %[[BB_ELSE]] ]
+; CHECK-NEXT:    ret ptr [[PHI]]
+;
+entry:
+  %c = icmp eq ptr %p, inttoptr (i64 -1 to ptr)
+  br i1 %c, label %join, label %bb.else
+
+bb.else:
+  br label %join
+
+join:
+  %phi = phi ptr [ inttoptr (i64 -1 to ptr), %entry ], [ %p, %bb.else ]
+  ret ptr %phi
+}
+
+; Replacing the pointer in the last comparison would continue being allowed.
+define i1 @assume_ptr_equality_phi_node_replacement_valid(ptr %p, ptr %q) {
+; CHECK-LABEL: define i1 @assume_ptr_equality_phi_node_replacement_valid(
+; CHECK-SAME: ptr [[P:%.*]], ptr [[Q:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[C:%.*]] = icmp eq ptr [[P]], @g
+; CHECK-NEXT:    br i1 [[C]], label %[[JOIN:.*]], label %[[BB_ELSE:.*]]
+; CHECK:       [[BB_ELSE]]:
+; CHECK-NEXT:    br label %[[JOIN]]
+; CHECK:       [[JOIN]]:
+; CHECK-NEXT:    [[CMP:%.*]] = icmp eq ptr @g, [[Q]]
+; CHECK-NEXT:    ret i1 [[CMP]]
+;
+entry:
+  %c = icmp eq ptr %p, @g
+  br i1 %c, label %join, label %bb.else
+
+bb.else:
+  br label %join
+
+join:
+  %phi = phi ptr [ %p, %entry ], [ @g, %bb.else ]
+  %cmp = icmp eq ptr %phi, %q
+  ret i1 %cmp
+}
