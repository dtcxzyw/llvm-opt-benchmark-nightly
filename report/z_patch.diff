+; Negative test: without the disjoint flag the or can carry, so it is not the
+; sum of its operands and must not be decomposed. Doing so anyway would fold
+; %t.1 to true, which is wrong for %x = 4, %n = 4: (4 | 4) = 4 <=s 4 holds,
+; while 4 <s 4 does not.
+define void @test_or_without_disjoint_not_decomposed(i8 %x, i8 %n) {
+; CHECK-LABEL: define void @test_or_without_disjoint_not_decomposed(
+; CHECK-SAME: i8 [[X:%.*]], i8 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[X_OR_4:%.*]] = or i8 [[X]], 4
+; CHECK-NEXT:    [[C_1:%.*]] = icmp sle i8 [[X_OR_4]], [[N]]
+; CHECK-NEXT:    br i1 [[C_1]], label %[[THEN:.*]], label %[[END:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    [[T_1:%.*]] = icmp slt i8 [[X]], [[N]]
+; CHECK-NEXT:    call void @use(i1 [[T_1]])
+; CHECK-NEXT:    ret void
+; CHECK:       [[END]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %x.or.4 = or i8 %x, 4
+  %c.1 = icmp sle i8 %x.or.4, %n
+  br i1 %c.1, label %then, label %end
+
+then:
+  %t.1 = icmp slt i8 %x, %n
+  call void @use(i1 %t.1)
+  ret void
+
+end:
+  ret void
+}
