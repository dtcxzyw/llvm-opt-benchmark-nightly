+; CHECK-NEXT:    [[COND:%.*]] = xor i1 [[C]], false
+; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i8 3, i8 1
+; CHECK-NEXT:    [[OTHER:%.*]] = select i1 [[COND]], i8 18, i8 16
