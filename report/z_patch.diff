+static bool isAssumedZeroShiftedNotOfMask(Value *Cond, Value *Mask,
+                                          Value *ShAmt, unsigned Depth = 0) {
+  if (Depth == MaxAnalysisRecursionDepth)
+    return false;
+
+  Value *A, *B;
+  if (match(Cond, m_LogicalAnd(m_Value(A), m_Value(B))))
+    return isAssumedZeroShiftedNotOfMask(A, Mask, ShAmt, Depth + 1) ||
+           isAssumedZeroShiftedNotOfMask(B, Mask, ShAmt, Depth + 1);
+
+  CmpPredicate Pred;
+  Value *LHS, *RHS;
+  if (!match(Cond, m_ICmp(Pred, m_Value(LHS), m_Value(RHS))) ||
+      Pred != ICmpInst::ICMP_EQ)
+    return false;
+
+  auto IsMatchingShiftedNot = [Mask, ShAmt](Value *V) {
+    return match(V, m_LShr(m_Not(m_Specific(Mask)), m_Specific(ShAmt)));
+  };
+
+  return (match(RHS, m_Zero()) && IsMatchingShiftedNot(LHS)) ||
+         (match(LHS, m_Zero()) && IsMatchingShiftedNot(RHS));
+}
+
+static bool isMaskKnownToPreserveRightShiftInput(Value *Mask, Value *ShAmt,
+                                                 const SimplifyQuery &Q) {
+  if (!Q.AC || !Q.CxtI || Q.isUndefValue(ShAmt))
+    return false;
+
+  for (AssumptionCache::ResultElem &Elem : Q.AC->assumptionsFor(Mask)) {
+    if (!Elem.Assume || Elem.Index != AssumptionCache::ExprResultIdx)
+      continue;
+
+    auto *Assume = cast<AssumeInst>(Elem.Assume);
+    if (isValidAssumeForContext(Assume, Q) &&
+        isAssumedZeroShiftedNotOfMask(Assume->getArgOperand(0), Mask, ShAmt))
+      return true;
+  }
+
+  return false;
+}
