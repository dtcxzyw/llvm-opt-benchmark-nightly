+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s
+
+; q <=u z - y and z >=u y, so q + y <=u z does not wrap and the compare is
+; true.
+define i1 @add_of_udiv_of_sub(i64 %z, i64 %y, i64 %n) {
+; CHECK-LABEL: define i1 @add_of_udiv_of_sub(
+; CHECK-SAME: i64 [[Z:%.*]], i64 [[Y:%.*]], i64 [[N:%.*]]) {
+; CHECK-NEXT:    [[N_POS:%.*]] = icmp ne i64 [[N]], 0
+; CHECK-NEXT:    call void @llvm.assume(i1 [[N_POS]])
+; CHECK-NEXT:    [[GE:%.*]] = icmp uge i64 [[Z]], [[Y]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[GE]])
+; CHECK-NEXT:    [[D:%.*]] = sub nuw i64 [[Z]], [[Y]]
+; CHECK-NEXT:    [[Q:%.*]] = udiv i64 [[D]], [[N]]
+; CHECK-NEXT:    [[A:%.*]] = add i64 [[Q]], [[Y]]
+; CHECK-NEXT:    ret i1 true
+;
+  %n.nz = icmp ne i64 %n, 0
+  call void @llvm.assume(i1 %n.nz)
+  %ge = icmp uge i64 %z, %y
+  call void @llvm.assume(i1 %ge)
+  %d = sub i64 %z, %y
+  %q = udiv i64 %d, %n
+  %a = add i64 %q, %y
+  %c = icmp ule i64 %a, %z
+  ret i1 %c
+}
+
+define i1 @add_of_lshr_of_sub_commuted(i64 %z, i64 %y) {
+; CHECK-LABEL: define i1 @add_of_lshr_of_sub_commuted(
