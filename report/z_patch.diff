+; CHECK-NEXT:    br label %[[H:.*]]
+; CHECK:       [[H]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[EXIT]] ], [ [[INEXT:%.*]], %[[LATCH:.*]] ]
+; CHECK-NEXT:    call void @use(i1 true)
+; CHECK-NEXT:    br label %[[LATCH]]
+; CHECK:       [[LATCH]]:
+; CHECK-NEXT:    [[INEXT]] = add nsw i64 [[I]], 2
+; CHECK-NEXT:    [[EXITC:%.*]] = icmp sge i64 [[INEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[EXITC]], label %[[PH]], label %[[H]]
+; CHECK:       [[PH]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %g = icmp sgt i64 %n, 0
+  br i1 %g, label %ph, label %exit
+
+ph:
+  br label %h
+
+h:
