+
+define void @align_with_negative_offset(ptr %ptr) {
+; CHECK-LABEL: define void @align_with_negative_offset(
+; CHECK-SAME: ptr [[PTR:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    call void @llvm.assume(i1 true) [ "align"(ptr [[PTR]], i64 8, i64 -5) ]
