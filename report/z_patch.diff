+; CHECK-NEXT:    ret void
+;
+entry:
+  %test = icmp eq i32 %idx, -1
+  br i1 %test, label %done, label %dispatch
+
+dispatch:
+  %is0 = icmp eq i32 %idx, 0
+  %inrange = icmp ult i32 %idx, 2
+  call void @llvm.assume(i1 %inrange)
+  call void @side_effect_free()
+  br i1 %is0, label %call0, label %call1
