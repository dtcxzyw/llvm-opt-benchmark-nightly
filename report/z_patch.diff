+; CHECK-LABEL: define void @add_rec_decreasing_wraps_no_upper_bound() {
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br label [[LOOP_HEADER:%.*]]
+; CHECK:       loop.header:
