diff --git a/llvm/test/Transforms/ConstraintElimination/unsigned-query-signed-system.ll b/llvm/test/Transforms/ConstraintElimination/unsigned-query-signed-system.ll
new file mode 100644
index 0000000000000..614ce658a14c9
--- /dev/null
+++ b/llvm/test/Transforms/ConstraintElimination/unsigned-query-signed-system.ll
@@ -0,0 +1,130 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s
+
+declare void @llvm.trap()
+
+; For non-negative operands the signed and unsigned orderings coincide, so an
+; unsigned query can be answered by the signed system. Here `sub nsw %a, %b`
+; is decomposable in the signed system, while the unsigned system can only
+; look through a `sub` with `nuw` or a proven `%b ule %a` precondition, so on
+; its own it cannot prove the `ult` check.
+define void @ult_query_via_signed_system(i64 %a, i64 %b, i64 %n) {
+; CHECK-LABEL: define void @ult_query_via_signed_system(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]], i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[NA:%.*]] = icmp sgt i64 [[A]], -1
+; CHECK-NEXT:    br i1 [[NA]], label %[[C1:.*]], label %[[OUT:.*]]
+; CHECK:       [[C1]]:
+; CHECK-NEXT:    [[NB:%.*]] = icmp sgt i64 [[B]], -1
+; CHECK-NEXT:    br i1 [[NB]], label %[[C2:.*]], label %[[OUT]]
+; CHECK:       [[C2]]:
+; CHECK-NEXT:    [[NN:%.*]] = icmp sgt i64 [[N]], -1
+; CHECK-NEXT:    br i1 [[NN]], label %[[C3:.*]], label %[[OUT]]
+; CHECK:       [[C3]]:
+; CHECK-NEXT:    [[S:%.*]] = sub nsw i64 [[A]], [[B]]
+; CHECK-NEXT:    [[NS:%.*]] = icmp sgt i64 [[S]], -1
+; CHECK-NEXT:    br i1 [[NS]], label %[[C4:.*]], label %[[OUT]]
+; CHECK:       [[C4]]:
+; CHECK-NEXT:    [[LT:%.*]] = icmp slt i64 [[A]], [[N]]
+; CHECK-NEXT:    br i1 [[LT]], label %[[C5:.*]], label %[[OUT]]
+; CHECK:       [[C5]]:
+; CHECK-NEXT:    br i1 true, label %[[OUT]], label %[[TRAP:.*]]
+; CHECK:       [[TRAP]]:
+; CHECK-NEXT:    call void @llvm.trap()
+; CHECK-NEXT:    unreachable
+; CHECK:       [[OUT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %na = icmp sgt i64 %a, -1
+  br i1 %na, label %c1, label %out
+
+c1:
+  %nb = icmp sgt i64 %b, -1
+  br i1 %nb, label %c2, label %out
+
+c2:
+  %nn = icmp sgt i64 %n, -1
+  br i1 %nn, label %c3, label %out
+
+c3:
+  %s = sub nsw i64 %a, %b
+  %ns = icmp sgt i64 %s, -1
+  br i1 %ns, label %c4, label %out
+
+c4:
+  %lt = icmp slt i64 %a, %n
+  br i1 %lt, label %c5, label %out
+
+c5:
+  %ok = icmp ult i64 %s, %n
+  br i1 %ok, label %out, label %trap
+
+trap:
+  call void @llvm.trap()
+  unreachable
+
+out:
+  ret void
+}
+
+; Negative test: without the non-negativity precondition the signed fact must
+; not be used for the unsigned query. With %a = -1 and %b = 0 the guard
+; `%a s< %b` holds while `%a u< %b` is false.
+define i1 @no_fold_operands_may_be_negative(i64 %a, i64 %b) {
+; CHECK-LABEL: define i1 @no_fold_operands_may_be_negative(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[A]], [[B]]
+; CHECK-NEXT:    br i1 [[C]], label %[[T:.*]], label %[[F:.*]]
+; CHECK:       [[T]]:
+; CHECK-NEXT:    [[Q:%.*]] = icmp ult i64 [[A]], [[B]]
+; CHECK-NEXT:    ret i1 [[Q]]
+; CHECK:       [[F]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %c = icmp slt i64 %a, %b
+  br i1 %c, label %t, label %f
+
+t:
+  %q = icmp ult i64 %a, %b
+  ret i1 %q
+
+f:
+  ret i1 false
+}
+
+; Negative test: non-negativity of a single operand is not enough. With
+; %a = -1 and %b = 0 the guards `%b s>= 0` and `%a s< %b` hold, but `%a u< %b`
+; is false.
+define i1 @no_fold_only_rhs_non_negative(i64 %a, i64 %b) {
+; CHECK-LABEL: define i1 @no_fold_only_rhs_non_negative(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[NN:%.*]] = icmp sgt i64 [[B]], -1
+; CHECK-NEXT:    br i1 [[NN]], label %[[G:.*]], label %[[F:.*]]
+; CHECK:       [[G]]:
+; CHECK-NEXT:    [[C:%.*]] = icmp slt i64 [[A]], [[B]]
+; CHECK-NEXT:    br i1 [[C]], label %[[T:.*]], label %[[F]]
+; CHECK:       [[T]]:
+; CHECK-NEXT:    [[Q:%.*]] = icmp ult i64 [[A]], [[B]]
+; CHECK-NEXT:    ret i1 [[Q]]
+; CHECK:       [[F]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %nn = icmp sgt i64 %b, -1
+  br i1 %nn, label %g, label %f
+
+g:
+  %c = icmp slt i64 %a, %b
+  br i1 %c, label %t, label %f
+
+t:
+  %q = icmp ult i64 %a, %b
+  ret i1 %q
+
+f:
+  ret i1 false
+}
