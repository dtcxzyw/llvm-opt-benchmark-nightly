+    ret i32 %CxtI
+  })");
+
+    auto *F = M->getFunction("test");
+    const DataLayout &DL = M->getDataLayout();
+    AssumptionCache AC(*F);
+    DominatorTree DT(*F);
+
+    Value *LHS = F->getArg(0);
