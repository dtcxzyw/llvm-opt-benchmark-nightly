--- /dev/null
+++ b/llvm/test/Transforms/IndVarSimplify/exit-value-nowrap-flags-missed.ll
@@ -0,0 +1,53 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt -O3 -S < %s | FileCheck %s
+
+; Missed optimisations in the IR the exit-value rewrite produces, checked at the
+; IR level so that the flags are visible as instruction flags. Both flags below
+; are valid; SCEV just does not attach them. See
+; exit-value-nowrap-flags-missed.ll in Analysis/, and
+; exit-value-nowrap-flags.ll for the shapes that do work.
+
+; FIXME: %{{.*}} = mul i64 %{{.*}}, 24 should be "mul nuw": it is the
+; (backedge-taken count * step) term of a nuw pointer recurrence's exit value,
+; and only the sum around it gets a flag.
+define ptr @exit_value_mul_drops_nuw(ptr %first, ptr %last) {
+; CHECK-LABEL: @exit_value_mul_drops_nuw(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[C0:%.*]] = icmp ult ptr [[FIRST:%.*]], [[LAST:%.*]]
+; CHECK-NEXT:    br i1 [[C0]], label [[LOOP_PREHEADER:%.*]], label [[COMMON_RET:%.*]]
+; CHECK:       loop.preheader:
+; CHECK-NEXT:    [[LAST1:%.*]] = ptrtoaddr ptr [[LAST]] to i64
+; CHECK-NEXT:    [[FIRST2:%.*]] = ptrtoaddr ptr [[FIRST]] to i64
+; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[FIRST2]], 24
+; CHECK-NEXT:    [[UMAX:%.*]] = tail call i64 @llvm.umax.i64(i64 [[LAST1]], i64 [[TMP0]])
+; CHECK-NEXT:    [[TMP1:%.*]] = add i64 [[UMAX]], -24
+; CHECK-NEXT:    [[TMP2:%.*]] = icmp ne i64 [[TMP1]], [[FIRST2]]
+; CHECK-NEXT:    [[UMIN:%.*]] = zext i1 [[TMP2]] to i64
+; CHECK-NEXT:    [[TMP3:%.*]] = add i64 [[FIRST2]], [[UMIN]]
+; CHECK-NEXT:    [[TMP4:%.*]] = sub i64 [[TMP1]], [[TMP3]]
+; CHECK-NEXT:    [[TMP5:%.*]] = udiv i64 [[TMP4]], 24
+; CHECK-NEXT:    [[TMP6:%.*]] = add nuw nsw i64 [[TMP5]], [[UMIN]]
+; CHECK-NEXT:    [[TMP7:%.*]] = mul i64 [[TMP6]], 24
+; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr nuw i8, ptr [[FIRST]], i64 [[TMP7]]
+; CHECK-NEXT:    br label [[COMMON_RET]]
+; CHECK:       common.ret:
+; CHECK-NEXT:    [[COMMON_RET_OP:%.*]] = phi ptr [ [[FIRST]], [[ENTRY:%.*]] ], [ [[SCEVGEP]], [[LOOP_PREHEADER]] ]
+; CHECK-NEXT:    ret ptr [[COMMON_RET_OP]]
+;
+entry:
+  %c0 = icmp ult ptr %first, %last
+  br i1 %c0, label %loop, label %done
+
+loop:
+  %p = phi ptr [ %first, %entry ], [ %p.next, %loop ]
+  %p.next = getelementptr inbounds nuw i8, ptr %p, i64 24
+  %c = icmp ult ptr %p.next, %last
+  br i1 %c, label %loop, label %exit
+
+exit:
+  %lc = phi ptr [ %p, %loop ]
+  ret ptr %lc
+
+done:
+  ret ptr %first
+}
diff --git a/llvm/test/Transforms/IndVarSimplify/exit-value-nowrap-flags.ll b/llvm/test/Transforms/IndVarSimplify/exit-value-nowrap-flags.ll
new file mode 100644
index 0000000000000..c27d8993d5407
--- /dev/null
+++ b/llvm/test/Transforms/IndVarSimplify/exit-value-nowrap-flags.ll
@@ -0,0 +1,349 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt -passes=indvars -S < %s | FileCheck %s
+
+target datalayout = "n8:16:32:64"
+
+; The no-wrap flags of a recurrence carry over to the closed form of its exit
+; value, Start + BTC * Step, as use-specific flags. They only do so for that
+; exact shape: if anything folds, the resulting expression is a different
+; computation, and SCEVExpander would stamp the flags on sub-expressions the
+; recurrence's flags say nothing about.
+
+; The backedge-taken count is a bare value here, so neither the multiply nor the
+; sum folds and both carry the flag.
+define i32 @nuw_kept(i32 %start, i32 %step, i32 %n) {
+; CHECK-LABEL: @nuw_kept(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    br i1 true, label [[EXIT:%.*]], label [[LATCH:%.*]]
+; CHECK:       latch:
+; CHECK-NEXT:    br label [[LOOP]]
+; CHECK:       exit:
+; CHECK-NEXT:    [[TMP0:%.*]] = mul i32 [[N:%.*]], [[STEP:%.*]]
+; CHECK-NEXT:    [[TMP1:%.*]] = add nuw i32 [[START:%.*]], [[TMP0]]
+; CHECK-NEXT:    ret i32 [[TMP1]]
+;
+entry:
+  br label %loop
+
+loop:
+  %v = phi i32 [ %start, %entry ], [ %v.next, %latch ]
+  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
+  %done = icmp eq i32 %i, %n
+  br i1 %done, label %exit, label %latch
+
+latch:
+  %v.next = add nuw i32 %v, %step
+  %i.next = add i32 %i, 1
+  br label %loop
+
+exit:
+  ret i32 %v
+}
+
+; Same, for a signed recurrence: Start and Step are both known non-negative, so
+; BTC * Step is representable and the sum stays in the signed range.
+define i32 @nsw_kept_same_sign(i32 %start.in, i32 %step.in, i32 %n) {
+; CHECK-LABEL: @nsw_kept_same_sign(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[START:%.*]] = and i32 [[START_IN:%.*]], 1023
+; CHECK-NEXT:    [[STEP:%.*]] = and i32 [[STEP_IN:%.*]], 1023
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    br i1 true, label [[EXIT:%.*]], label [[LATCH:%.*]]
+; CHECK:       latch:
+; CHECK-NEXT:    br label [[LOOP]]
+; CHECK:       exit:
+; CHECK-NEXT:    [[TMP0:%.*]] = mul i32 [[N:%.*]], [[STEP]]
+; CHECK-NEXT:    [[TMP1:%.*]] = add nuw nsw i32 [[TMP0]], [[START]]
+; CHECK-NEXT:    ret i32 [[TMP1]]
+;
+entry:
+  %start = and i32 %start.in, 1023
+  %step = and i32 %step.in, 1023
+  br label %loop
+
+loop:
+  %v = phi i32 [ %start, %entry ], [ %v.next, %latch ]
+  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
+  %done = icmp eq i32 %i, %n
+  br i1 %done, label %exit, label %latch
+
+latch:
+  %v.next = add nsw i32 %v, %step
+  %i.next = add i32 %i, 1
+  br label %loop
+
+exit:
+  ret i32 %v
+}
+
+; Start is non-negative but Step is negative, so BTC * Step is only bounded by
+; 2^(W-1) - Start and can leave the signed range. No nsw.
+define i32 @nsw_dropped_mixed_signs(i32 %start.in, i32 %step.in, i32 %n) {
+; CHECK-LABEL: @nsw_dropped_mixed_signs(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[START:%.*]] = and i32 [[START_IN:%.*]], 1023
+; CHECK-NEXT:    [[STEP_POS:%.*]] = and i32 [[STEP_IN:%.*]], 1023
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    br i1 true, label [[EXIT:%.*]], label [[LATCH:%.*]]
+; CHECK:       latch:
+; CHECK-NEXT:    br label [[LOOP]]
+; CHECK:       exit:
+; CHECK-NEXT:    [[TMP0:%.*]] = mul i32 [[N:%.*]], [[STEP_POS]]
+; CHECK-NEXT:    [[TMP1:%.*]] = sub i32 [[START]], [[TMP0]]
+; CHECK-NEXT:    ret i32 [[TMP1]]
+;
+entry:
+  %start = and i32 %start.in, 1023
+  %step.pos = and i32 %step.in, 1023
+  %step = sub nsw i32 0, %step.pos
+  br label %loop
+
+loop:
+  %v = phi i32 [ %start, %entry ], [ %v.next, %latch ]
+  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
+  %done = icmp eq i32 %i, %n
+  br i1 %done, label %exit, label %latch
+
+latch:
+  %v.next = add nsw i32 %v, %step
+  %i.next = add i32 %i, 1
+  br label %loop
+
+exit:
+  ret i32 %v
+}
+
+; The exit count is (-1 + %n) and Start is 0, so the sum folds away completely
+; and the closed form is the exit count itself. `%n + -1` is not the sum the
+; recurrence's nuw is about - it wraps for every %n != 0 - so no flag.
+define i32 @nuw_dropped_sum_folded_away(i32 %n) {
+; CHECK-LABEL: @nuw_dropped_sum_folded_away(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    br i1 true, label [[EXIT:%.*]], label [[LOOP]]
+; CHECK:       exit:
+; CHECK-NEXT:    [[TMP0:%.*]] = add i32 [[N:%.*]], -1
+; CHECK-NEXT:    ret i32 [[TMP0]]
+;
+entry:
+  br label %loop
+
+loop:
+  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
+  %i.next = add nuw i32 %i, 1
+  %c = icmp eq i32 %i.next, %n
+  br i1 %c, label %exit, label %loop
+
+exit:
+  ret i32 %i
+}
+
+; Start is a sum, so getAddExpr flattens it into the closed form. `%a + %b` is
+; not covered by the recurrence's nuw - only its wrapped value is the start - so
+; the flattened sum gets no flag.
+define i32 @nuw_dropped_sum_flattened(i32 %a, i32 %b, i32 %n) {
+; CHECK-LABEL: @nuw_dropped_sum_flattened(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    br i1 true, label [[EXIT:%.*]], label [[LATCH:%.*]]
+; CHECK:       latch:
+; CHECK-NEXT:    br label [[LOOP]]
+; CHECK:       exit:
+; CHECK-NEXT:    [[TMP0:%.*]] = add i32 [[N:%.*]], [[B:%.*]]
+; CHECK-NEXT:    [[TMP1:%.*]] = add i32 [[TMP0]], [[A:%.*]]
+; CHECK-NEXT:    ret i32 [[TMP1]]
+;
+entry:
+  %start = add i32 %a, %b
+  br label %loop
+
+loop:
+  %v = phi i32 [ %start, %entry ], [ %v.next, %latch ]
+  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
+  %done = icmp eq i32 %i, %n
+  br i1 %done, label %exit, label %latch
+
+latch:
+  %v.next = add nuw i32 %v, 1
+  %i.next = add i32 %i, 1
+  br label %loop
+
+exit:
+  ret i32 %v
+}
+
+; Step is a product, so getMulExpr flattens it into BTC * Step. `%s1 * %s2` may
+; wrap - only its wrapped value is the step - so the flattened product gets no
+; flag, and neither does the sum built from it.
+define i32 @nuw_dropped_product_flattened(i32 %s1, i32 %s2, i32 %n) {
+; CHECK-LABEL: @nuw_dropped_product_flattened(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    br i1 true, label [[EXIT:%.*]], label [[LATCH:%.*]]
+; CHECK:       latch:
+; CHECK-NEXT:    br label [[LOOP]]
+; CHECK:       exit:
+; CHECK-NEXT:    [[TMP0:%.*]] = mul i32 [[N:%.*]], [[S2:%.*]]
+; CHECK-NEXT:    [[TMP1:%.*]] = mul i32 [[TMP0]], [[S1:%.*]]
+; CHECK-NEXT:    ret i32 [[TMP1]]
+;
+entry:
+  %step = mul i32 %s1, %s2
+  br label %loop
+
+loop:
+  %v = phi i32 [ 0, %entry ], [ %v.next, %latch ]
+  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
+  %done = icmp eq i32 %i, %n
+  br i1 %done, label %exit, label %latch
+
+latch:
+  %v.next = add nuw i32 %v, %step
+  %i.next = add i32 %i, 1
+  br label %loop
+
+exit:
+  ret i32 %v
+}
+
+; LFTR computes the limit for one exit of a multi-exit loop. %n is the count for
+; the latch exit alone; the loop can leave through the %iv2 == 20 exit first, so
+; that iteration is not necessarily reached and the limit must not be flagged.
+; The limit is computed in the preheader and feeds a branch condition, so a
+; poison value here would be UB, not just a poisoned result.
+@A = external global i32
+
+define void @lftr_limit_multi_exit(i32 %n) {
+; CHECK-LABEL: @lftr_limit_multi_exit(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[TMP0:%.*]] = add i32 [[N:%.*]], 1
+; CHECK-NEXT:    br label [[OUTER:%.*]]
+; CHECK:       outer:
+; CHECK-NEXT:    [[IV1:%.*]] = phi i32 [ 0, [[ENTRY:%.*]] ], [ [[IV1_NEXT:%.*]], [[OUTER_LATCH:%.*]] ]
+; CHECK-NEXT:    store volatile i32 [[IV1]], ptr @A, align 4
+; CHECK-NEXT:    [[IV1_NEXT]] = add nuw nsw i32 [[IV1]], 1
+; CHECK-NEXT:    br label [[INNER:%.*]]
+; CHECK:       inner:
+; CHECK-NEXT:    [[IV2:%.*]] = phi i32 [ 0, [[OUTER]] ], [ [[IV2_NEXT:%.*]], [[INNER_LATCH:%.*]] ]
+; CHECK-NEXT:    store volatile i32 [[IV2]], ptr @A, align 4
+; CHECK-NEXT:    [[IV2_NEXT]] = add nuw nsw i32 [[IV2]], 1
+; CHECK-NEXT:    [[EXITCOND:%.*]] = icmp ne i32 [[IV2]], 20
+; CHECK-NEXT:    br i1 [[EXITCOND]], label [[INNER_LATCH]], label [[EXIT_LOOPEXIT:%.*]]
+; CHECK:       inner_latch:
+; CHECK-NEXT:    [[EXITCOND2:%.*]] = icmp ne i32 [[IV2_NEXT]], [[TMP0]]
+; CHECK-NEXT:    br i1 [[EXITCOND2]], label [[INNER]], label [[OUTER_LATCH]]
+; CHECK:       outer_latch:
+; CHECK-NEXT:    [[EXITCOND3:%.*]] = icmp ne i32 [[IV1_NEXT]], 21
+; CHECK-NEXT:    br i1 [[EXITCOND3]], label [[OUTER]], label [[EXIT_LOOPEXIT1:%.*]]
+; CHECK:       exit.loopexit:
+; CHECK-NEXT:    br label [[EXIT:%.*]]
+; CHECK:       exit.loopexit1:
+; CHECK-NEXT:    br label [[EXIT]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %outer
+
+outer:
+  %iv1 = phi i32 [ 0, %entry ], [ %iv1.next, %outer_latch ]
+  store volatile i32 %iv1, ptr @A
+  %iv1.next = add i32 %iv1, 1
+  br label %inner
+
+inner:
+  %iv2 = phi i32 [ 0, %outer ], [ %iv2.next, %inner_latch ]
+  store volatile i32 %iv2, ptr @A
+  %iv2.next = add i32 %iv2, 1
+  %innertest = icmp ult i32 %iv2, 20
+  br i1 %innertest, label %inner_latch, label %exit
+
+inner_latch:
+  %innertestb = icmp ult i32 %iv2, %n
+  br i1 %innertestb, label %inner, label %outer_latch
+
+outer_latch:
+  %outertest = icmp ult i32 %iv1, 20
+  br i1 %outertest, label %outer, label %exit
+
+exit:
+  ret void
+}
+
+; The at-scope value of loop %b's udiv carries %b's nuw as a use flag on the
+; udiv's operand. Loop %a has the same closed-form exit value but its increment
+; is not nuw, so it must not pick that flag up: `add nuw i32 %n, %start` is
+; poison at %start = -1, %n = 2, where %a's exit value is a well-defined 1.
+; The flagged operand makes %b's udiv a distinct expression from %a's, so the
+; two carry their own flags - %b keeps the nuw and %a gets none.
+define i32 @no_flag_leak_through_shared_udiv(i32 %start, i32 %n, i1 %c) {
+; CHECK-LABEL: @no_flag_leak_through_shared_udiv(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br i1 [[C:%.*]], label [[A_PH:%.*]], label [[B_PH:%.*]]
+; CHECK:       a.ph:
+; CHECK-NEXT:    br label [[A:%.*]]
+; CHECK:       a:
+; CHECK-NEXT:    br i1 true, label [[A_EXIT:%.*]], label [[A_LATCH:%.*]]
+; CHECK:       a.latch:
+; CHECK-NEXT:    br label [[A]]
+; CHECK:       a.exit:
+; CHECK-NEXT:    [[TMP0:%.*]] = add i32 [[N:%.*]], [[START:%.*]]
+; CHECK-NEXT:    [[TMP1:%.*]] = udiv i32 [[TMP0]], 3
+; CHECK-NEXT:    ret i32 [[TMP1]]
+; CHECK:       b.ph:
+; CHECK-NEXT:    br label [[B:%.*]]
+; CHECK:       b:
+; CHECK-NEXT:    br i1 true, label [[B_EXIT:%.*]], label [[B_LATCH:%.*]]
+; CHECK:       b.latch:
+; CHECK-NEXT:    br label [[B]]
+; CHECK:       b.exit:
+; CHECK-NEXT:    [[TMP2:%.*]] = add nuw i32 [[N]], [[START]]
+; CHECK-NEXT:    [[TMP3:%.*]] = udiv i32 [[TMP2]], 3
+; CHECK-NEXT:    ret i32 [[TMP3]]
+;
+entry:
+  br i1 %c, label %a.ph, label %b.ph
+
+a.ph:
+  br label %a
+
+a:
+  %v = phi i32 [ %start, %a.ph ], [ %v.next, %a.latch ]
+  %i = phi i32 [ 0, %a.ph ], [ %i.next, %a.latch ]
+  %dv = udiv i32 %v, 3
+  %done = icmp eq i32 %i, %n
+  br i1 %done, label %a.exit, label %a.latch
+
+a.latch:
+  %v.next = add i32 %v, 1
+  %i.next = add i32 %i, 1
+  br label %a
+
+a.exit:
+  ret i32 %dv
+
+b.ph:
+  br label %b
+
+b:
+  %v2 = phi i32 [ %start, %b.ph ], [ %v2.next, %b.latch ]
+  %i2 = phi i32 [ 0, %b.ph ], [ %i2.next, %b.latch ]
+  %dv2 = udiv i32 %v2, 3
+  %done2 = icmp eq i32 %i2, %n
+  br i1 %done2, label %b.exit, label %b.latch
+
+b.latch:
+  %v2.next = add nuw i32 %v2, 1
+  %i2.next = add i32 %i2, 1
+  br label %b
+
+b.exit:
+  ret i32 %dv2
+}
