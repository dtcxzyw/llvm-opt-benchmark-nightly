diff --git a/llvm/test/Transforms/InstCombine/icmp-dom-expr.ll b/llvm/test/Transforms/InstCombine/icmp-dom-expr.ll
new file mode 100644
index 0000000000000..c58bf1e88745f
--- /dev/null
+++ b/llvm/test/Transforms/InstCombine/icmp-dom-expr.ll
@@ -0,0 +1,78 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -passes=instcombine -S | FileCheck %s
+define i1 @test(i64 %len) {
+; CHECK-LABEL: define i1 @test(
+; CHECK-SAME: i64 [[LEN:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[REM:%.*]] = and i64 [[LEN]], 15
+; CHECK-NEXT:    [[ALIGNED:%.*]] = icmp eq i64 [[REM]], 0
+; CHECK-NEXT:    br i1 [[ALIGNED]], label %[[ALIGNED_PATH:.*]], label %[[UNALIGNED_PATH:.*]]
+; CHECK:       [[UNALIGNED_PATH]]:
+; CHECK-NEXT:    ret i1 false
+; CHECK:       [[ALIGNED_PATH]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %rem = and i64 %len, 15
+  %aligned = icmp eq i64 %rem, 0
+  br i1 %aligned, label %aligned.path, label %unaligned.path
+
+unaligned.path:
+  %is16 = icmp eq i64 %len, 16
+  ret i1 %is16
+
+aligned.path:
+  ret i1 false
+}
+
+define i1 @test_ne(i64 %len) {
+; CHECK-LABEL: define i1 @test_ne(
+; CHECK-SAME: i64 [[LEN:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[REM:%.*]] = and i64 [[LEN]], 15
+; CHECK-NEXT:    [[ALIGNED:%.*]] = icmp eq i64 [[REM]], 0
+; CHECK-NEXT:    br i1 [[ALIGNED]], label %[[ALIGNED_PATH:.*]], label %[[UNALIGNED_PATH:.*]]
+; CHECK:       [[UNALIGNED_PATH]]:
+; CHECK-NEXT:    ret i1 true
+; CHECK:       [[ALIGNED_PATH]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %rem = and i64 %len, 15
+  %aligned = icmp eq i64 %rem, 0
+  br i1 %aligned, label %aligned.path, label %unaligned.path
+
+unaligned.path:
+  %isnot16 = icmp ne i64 %len, 16
+  ret i1 %isnot16
+
+aligned.path:
+  ret i1 false
+}
+
+
+define i1 @test_no_fold(i64 %len) {
+; CHECK-LABEL: define i1 @test_no_fold(
+; CHECK-SAME: i64 [[LEN:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[REM:%.*]] = and i64 [[LEN]], 15
+; CHECK-NEXT:    [[ALIGNED:%.*]] = icmp eq i64 [[REM]], 0
+; CHECK-NEXT:    br i1 [[ALIGNED]], label %[[ALIGNED_PATH:.*]], label %[[UNALIGNED_PATH:.*]]
+; CHECK:       [[ALIGNED_PATH]]:
+; CHECK-NEXT:    [[IS16:%.*]] = icmp eq i64 [[LEN]], 16
+; CHECK-NEXT:    ret i1 [[IS16]]
+; CHECK:       [[UNALIGNED_PATH]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %rem = and i64 %len, 15
+  %aligned = icmp eq i64 %rem, 0
+  br i1 %aligned, label %aligned.path, label %unaligned.path
+
+aligned.path:
+  %is16 = icmp eq i64 %len, 16
+  ret i1 %is16
+
+unaligned.path:
+  ret i1 false
+}
