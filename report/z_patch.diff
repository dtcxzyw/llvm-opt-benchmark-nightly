+; CHECK-NEXT:    [[RV:%.*]] = icmp eq ptr [[P]], [[Q:%.*]]
+; CHECK-NEXT:    ret i1 [[RV]]
+;
+entry:
+  %c = icmp eq ptr %p, @g
+  br i1 %c, label %join, label %else
+
+else:
+  br label %join
+
+join:
+  %phi = phi ptr [ @g, %entry ], [ %p, %else ]
