index 37cea287284cd..1f62e5a270b6e 100644
--- a/llvm/lib/Analysis/MemorySSAUpdater.cpp
+++ b/llvm/lib/Analysis/MemorySSAUpdater.cpp
@@ -1495,8 +1495,8 @@ void MemorySSAUpdater::removeBlocks(
