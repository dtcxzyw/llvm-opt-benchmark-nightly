+define void @guard_before_merge_in_outer_loop(ptr %p, i32 %k, i1 %c) {
+; CHECK-LABEL: 'guard_before_merge_in_outer_loop'
+; CHECK-NEXT:  Determining loop execution counts for: @guard_before_merge_in_outer_loop
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-2 + %n)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -2
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-2 + %n)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+; CHECK-NEXT:  Loop %outer.header: backedge-taken count is (-1 + %k)
+; CHECK-NEXT:  Loop %outer.header: constant max backedge-taken count is i32 -1
+; CHECK-NEXT:  Loop %outer.header: symbolic max backedge-taken count is (-1 + %k)
+; CHECK-NEXT:  Loop %outer.header: Trip multiple is 1
+;
+entry:
+  %n = load i32, ptr %p, align 4
+  br label %outer.header
+
+outer.header:
+  %j = phi i32 [ 0, %entry ], [ %j.next, %outer.latch ]
+  %guard = icmp ugt i32 %n, 1
+  br i1 %guard, label %split, label %outer.latch
+
+split:
+  br i1 %c, label %then, label %else
+
+then:
+  br label %ph
+
+else:
+  br label %ph
+
+ph:
+  %m = add i32 %n, -1
+  br label %loop
+
+loop:
+  %i = phi i32 [ 0, %ph ], [ %iv.next, %loop ]
+  store i32 %i, ptr %p, align 4
+  %iv.next = add nuw i32 %i, 1
+  %ec = icmp ult i32 %iv.next, %m
+  br i1 %ec, label %loop, label %outer.latch
+
+outer.latch:
+  %j.next = add i32 %j, 1
+  %ec.outer = icmp eq i32 %j.next, %k
+  br i1 %ec.outer, label %exit, label %outer.header
+
+exit:
+  ret void
+}
