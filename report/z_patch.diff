+  %cmp3 = icmp slt i32 %z, 0
+  %or.cond5 = select i1 %or.cond, i1 true, i1 %cmp3
+  %or.cond5.not = xor i1 %or.cond5, true
+  call void @llvm.assume(i1 %or.cond5.not)
