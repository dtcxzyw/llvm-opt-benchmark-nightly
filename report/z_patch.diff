+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -passes=instsimplify -S | FileCheck %s
+
+; Must NOT fold: fsub may quiet an sNaN.
+define half @copysign_fsub_negzero(half %x) {
+; CHECK-LABEL: define half @copysign_fsub_negzero(
+; CHECK-SAME: half [[X:%.*]]) {
+; CHECK-NEXT:    [[NEGX:%.*]] = fsub half -0.000000e+00, [[X]]
+; CHECK-NEXT:    [[R:%.*]] = call half @llvm.copysign.f16(half [[X]], half [[NEGX]])
+; CHECK-NEXT:    ret half [[R]]
+;
+  %negx = fsub half -0.0, %x
+  %r = call half @llvm.copysign.f16(half %x, half %negx)
+  ret half %r
+}
+
+; Still folds with a real fneg.
+define half @copysign_fneg(half %x) {
+; CHECK-LABEL: define half @copysign_fneg(
+; CHECK-SAME: half [[X:%.*]]) {
+; CHECK-NEXT:    [[NEGX:%.*]] = fneg half [[X]]
+; CHECK-NEXT:    ret half [[NEGX]]
+;
+  %negx = fneg half %x
+  %r = call half @llvm.copysign.f16(half %x, half %negx)
+  ret half %r
+}
+
+declare half @llvm.copysign.f16(half, half)
