diff --git a/llvm/test/Analysis/ScalarEvolution/samesign-exit-limit.ll b/llvm/test/Analysis/ScalarEvolution/samesign-exit-limit.ll
new file mode 100644
index 00000000000000..3de10f4a32381d
--- /dev/null
+++ b/llvm/test/Analysis/ScalarEvolution/samesign-exit-limit.ll
@@ -0,0 +1,134 @@
+; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 5
+; RUN: opt -disable-output -passes='print<scalar-evolution>' \
+; RUN:   -scalar-evolution-classify-expressions=0 < %s 2>&1 | FileCheck %s
+
+declare void @use(i32)
+declare void @use64(i64)
+
+; Keep the unsigned exact count without smin, but use the signed constant max.
+define void @countdown(i32 %n) {
+; CHECK-LABEL: 'countdown'
+; CHECK-NEXT:  Determining loop execution counts for: @countdown
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-2 + %n)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 2147483645
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-2 + %n)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %enter = icmp ugt i32 %n, 2
+  br i1 %enter, label %loop, label %exit
+
+loop:
+  %i = phi i32 [ %n, %entry ], [ %next, %loop ]
+  call void @use(i32 %i)
+  %next = add i32 %i, -1
+  %continue = icmp samesign ugt i32 %i, 2
+  br i1 %continue, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Without samesign, the signed bound does not apply.
+define void @countdown_without_samesign(i32 %n) {
+; CHECK-LABEL: 'countdown_without_samesign'
+; CHECK-NEXT:  Determining loop execution counts for: @countdown_without_samesign
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-2 + %n)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 -3
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-2 + %n)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %enter = icmp ugt i32 %n, 2
+  br i1 %enter, label %loop, label %exit
+
+loop:
+  %i = phi i32 [ %n, %entry ], [ %next, %loop ]
+  call void @use(i32 %i)
+  %next = add i32 %i, -1
+  %continue = icmp ugt i32 %i, 2
+  br i1 %continue, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Keep the unsigned exact count without smax, but use the signed constant max.
+define void @countup(i32 %n) {
+; CHECK-LABEL: 'countup'
+; CHECK-NEXT:  Determining loop execution counts for: @countup
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + %n)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i32 2147483646
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + %n)
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %enter = icmp ugt i32 %n, 1
+  br i1 %enter, label %loop, label %exit
+
+loop:
+  %i = phi i32 [ 0, %entry ], [ %next, %loop ]
+  call void @use(i32 %i)
+  %next = add i32 %i, 1
+  %continue = icmp samesign ult i32 %next, %n
+  br i1 %continue, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; A zero signed maximum must also make the exact and symbolic counts zero.
+define void @zero_max(i8 %n) {
+; CHECK-LABEL: 'zero_max'
+; CHECK-NEXT:  Determining loop execution counts for: @zero_max
+; CHECK-NEXT:  Loop %loop: backedge-taken count is i1 false
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i1 false
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is i1 false
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  br label %loop
+
+loop:
+  %i = phi i8 [ %n, %entry ], [ %next, %loop ]
+  %next = add i8 %i, -1
+  %continue = icmp samesign ugt i8 %i, 127
+  br i1 %continue, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Do not mix results requiring runtime predicates. The mask can wrap before
+; the exit, so the signed count and its no-wrap predicate remain paired.
+define void @predicated_masked_count(i64 %n) {
+; CHECK-LABEL: 'predicated_masked_count'
+; CHECK-NEXT:  Determining loop execution counts for: @predicated_masked_count
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: Unpredictable constant max backedge-taken count.
+; CHECK-NEXT:  Loop %loop: Unpredictable symbolic max backedge-taken count.
+; CHECK-NEXT:  Loop %loop: Predicated backedge-taken count is (-1 + (1 smax %n))<nsw>
+; CHECK-NEXT:   Predicates:
+; CHECK-NEXT:      {1,+,1}<%loop> Added Flags: <nusw>
+; CHECK-NEXT:  Loop %loop: Predicated constant max backedge-taken count is i64 9223372036854775806
+; CHECK-NEXT:   Predicates:
+; CHECK-NEXT:      {1,+,1}<%loop> Added Flags: <nusw>
+; CHECK-NEXT:  Loop %loop: Predicated symbolic max backedge-taken count is (-1 + (1 smax %n))<nsw>
+; CHECK-NEXT:   Predicates:
+; CHECK-NEXT:      {1,+,1}<%loop> Added Flags: <nusw>
+;
+entry:
+  %enter = icmp ugt i64 %n, 1
+  br i1 %enter, label %loop, label %exit
+
+loop:
+  %i = phi i64 [ 0, %entry ], [ %next, %loop ]
+  call void @use64(i64 %i)
+  %next = add i64 %i, 1
+  %masked = and i64 %next, 4294967295
+  %continue = icmp samesign ugt i64 %n, %masked
+  br i1 %continue, label %loop, label %exit
+
+exit:
+  ret void
+}
diff --git a/llvm/test/Transforms/IndVarSimplify/samesign-exit-nowrap.ll b/llvm/test/Transforms/IndVarSimplify/samesign-exit-nowrap.ll
new file mode 100644
index 00000000000000..61538cf026abac
--- /dev/null
+++ b/llvm/test/Transforms/IndVarSimplify/samesign-exit-nowrap.ll
@@ -0,0 +1,35 @@
+; RUN: opt -passes='loop(indvars)' -S < %s | FileCheck %s --check-prefix=INDVARS
+; RUN: opt -disable-output -passes='print<scalar-evolution>' < %s 2>&1 | FileCheck %s --check-prefix=SCEV
+
+; The latch compare is a samesign unsigned comparison against a positive
+; constant, so for every well-defined execution %remaining is non-negative.
+; Deriving the exit limit from the equivalent signed predicate bounds the trip
+; count by i32 signed range (2^24 - 1 for a step of 128) instead of the
+; unsigned one (2^25 - 1), which is exactly what allows the parallel
+; offset IV to be proven non-wrapping.
+
+declare void @use(i32)
+
+define void @countdown_with_offset(i32 %remaining.start) {
+; INDVARS-LABEL: @countdown_with_offset(
+; INDVARS:       loop:
+; INDVARS:         %offset.next = add nuw i32 %offset, 128
+;
+; SCEV-LABEL: Determining loop execution counts for: @countdown_with_offset
+; SCEV-NEXT:  Loop %loop: backedge-taken count is ((127 + (-1 * (128 umin %remaining.start))<nsw> + %remaining.start) /u 128)
+; SCEV-NEXT:  Loop %loop: constant max backedge-taken count is i32 16777215
+entry:
+  br label %loop
+
+loop:
+  %remaining = phi i32 [ %remaining.start, %entry ], [ %remaining.next, %loop ]
+  %offset = phi i32 [ 0, %entry ], [ %offset.next, %loop ]
+  call void @use(i32 %offset)
+  %remaining.next = add i32 %remaining, -128
+  %offset.next = add i32 %offset, 128
+  %continue = icmp samesign ugt i32 %remaining, 128
+  br i1 %continue, label %loop, label %exit
+
+exit:
+  ret void
+}
