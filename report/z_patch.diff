+; CHECK-NEXT:    [[SHR:%.*]] = zext <4 x i1> [[TMP1]] to <4 x i32>
+; CHECK-NEXT:    ret <4 x i32> [[SHR]]
+;
+  %shr = lshr <4 x i32> <i32 1, i32 1, i32 1, i32 1>, %x
+  ret <4 x i32> %shr
+}
+
+; Negative test: constant is not 1
+define i32 @lshr_two_i32(i32 %x) {
