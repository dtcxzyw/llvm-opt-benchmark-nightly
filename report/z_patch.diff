+
+define { i32, i32 } @shared_select_cond_insertvalue(i1 %c, { i32, i32 } %a, { i32, i32 } %b, { i32, i32 } %d) {
+; CHECK-LABEL: define { i32, i32 } @shared_select_cond_insertvalue(
