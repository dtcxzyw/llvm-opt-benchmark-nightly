+; Negative test: %k is replaced by a PHI node and takes the iterations in the
+; reverse order, so `g` is not the same function on every application.
+define i32 @test_neg_variable_operand(i32 %x, i32 %k) {
+; CHECK-LABEL: define i32 @test_neg_variable_operand(
+; CHECK-SAME: i32 [[X:%.*]], i32 [[K:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[CMP:%.*]] = icmp eq i32 [[X]], 0
+; CHECK-NEXT:    br i1 [[CMP]], label %[[BASE:.*]], label %[[IF_END:.*]]
+; CHECK:       [[BASE]]:
+; CHECK-NEXT:    ret i32 7
+; CHECK:       [[IF_END]]:
+; CHECK-NEXT:    [[SUB:%.*]] = add nsw i32 [[X]], -1
+; CHECK-NEXT:    [[DEC:%.*]] = add nsw i32 [[K]], -1
+; CHECK-NEXT:    [[CALL:%.*]] = tail call i32 @test_neg_variable_operand(i32 [[SUB]], i32 [[DEC]])
+; CHECK-NEXT:    [[RES:%.*]] = sdiv i32 [[CALL]], [[K]]
+; CHECK-NEXT:    ret i32 [[RES]]
+;
+entry:
+  %cmp = icmp eq i32 %x, 0
+  br i1 %cmp, label %base, label %if.end
+
+base:
+  ret i32 7
+
+if.end:
+  %sub = add nsw i32 %x, -1
+  %dec = add nsw i32 %k, -1
+  %call = tail call i32 @test_neg_variable_operand(i32 %sub, i32 %dec)
+  %res = sdiv i32 %call, %k
+  ret i32 %res
+}
