+; CHECK:       [[LOOP_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[START]], %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
+; CHECK-NEXT:    [[T:%.*]] = icmp ult i32 [[IV]], [[N]]
+; CHECK-NEXT:    br i1 [[T]], label %[[LOOP_LATCH]], label %[[EXIT:.*]]
