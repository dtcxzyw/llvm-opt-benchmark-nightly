diff --git a/llvm/lib/Analysis/ScalarEvolution.cpp b/llvm/lib/Analysis/ScalarEvolution.cpp
index 61420334b51b9..dd5890d17993f 100644
--- a/llvm/lib/Analysis/ScalarEvolution.cpp
+++ b/llvm/lib/Analysis/ScalarEvolution.cpp
@@ -16330,8 +16330,15 @@ const SCEV *ScalarEvolution::LoopGuards::rewrite(const SCEV *Expr) const {
              Bitwidth > Op->getType()->getScalarSizeInBits()) {
         Type *NarrowTy = IntegerType::get(SE.getContext(), Bitwidth);
         auto *NarrowExt = SE.getZeroExtendExpr(Op, NarrowTy);
-        if (const SCEV *S = Map.lookup(NarrowExt))
+        if (const SCEV *S = Map.lookup(NarrowExt)) {
+          // S is equal to NarrowExt, but may have a wider range. Bound it by
+          // the maximum value of Op.
+          APInt OpMax = APInt::getLowBitsSet(
+              Bitwidth, Op->getType()->getScalarSizeInBits());
+          if (SE.getUnsignedRangeMax(S).ugt(OpMax))
+            S = SE.getUMinExpr(S, SE.getConstant(OpMax));
           return SE.getZeroExtendExpr(S, Ty);
+        }
         Bitwidth = Bitwidth / 2;
       }
 
