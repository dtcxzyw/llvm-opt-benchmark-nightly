+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %len = load i32, ptr %p, !range !0
+  %c = icmp ult i32 %start, %len
+  br i1 %c, label %loop, label %exit
+loop:
+  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
+  %neg = icmp slt i32 %start, 0
