+  ret i64 %l
+}
+
+define i32 @memset_volatile() {
+; CHECK-LABEL: define i32 @memset_volatile() {
+; CHECK-NEXT:    [[A:%.*]] = alloca i32, align 4
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 0, i64 4, i1 true)
+; CHECK-NEXT:    call void @callee(ptr [[A]])
+; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[A]], align 4
+; CHECK-NEXT:    ret i32 [[L]]
+;
+  %a = alloca i32, align 4
+  call void @llvm.memset.p0.i64(ptr %a, i8 0, i64 4, i1 true)
+  call void @callee(ptr %a)
+  %l = load i32, ptr %a
+  ret i32 %l
+}
+
+; A non-zero byte pattern can't be materialized as a pointer constant.
+define ptr @memset_nonzero_ptr() {
+; CHECK-LABEL: define ptr @memset_nonzero_ptr() {
+; CHECK-NEXT:    [[A:%.*]] = alloca ptr, align 8
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 1, i64 8, i1 false)
+; CHECK-NEXT:    call void @callee(ptr [[A]])
+; CHECK-NEXT:    [[L:%.*]] = load ptr, ptr [[A]], align 8
+; CHECK-NEXT:    ret ptr [[L]]
+;
+  %a = alloca ptr, align 8
+  call void @llvm.memset.p0.i64(ptr %a, i8 1, i64 8, i1 false)
+  call void @callee(ptr %a)
+  %l = load ptr, ptr %a
+  ret ptr %l
+}
+
+define i32 @memset_variable_value(i8 %v) {
+; CHECK-LABEL: define i32 @memset_variable_value(
+; CHECK-SAME: i8 [[V:%.*]]) {
+; CHECK-NEXT:    [[A:%.*]] = alloca i32, align 4
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 [[V]], i64 4, i1 false)
+; CHECK-NEXT:    call void @callee(ptr [[A]])
+; CHECK-NEXT:    [[L:%.*]] = load i32, ptr [[A]], align 4
+; CHECK-NEXT:    ret i32 [[L]]
+;
+  %a = alloca i32, align 4
+  call void @llvm.memset.p0.i64(ptr %a, i8 %v, i64 4, i1 false)
+  call void @callee(ptr %a)
+  %l = load i32, ptr %a
+  ret i32 %l
+}
