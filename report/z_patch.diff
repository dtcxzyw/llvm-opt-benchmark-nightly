+; CHECK-NEXT:    [[RES2:%.*]] = call ptr @callee_global_gep()
+; CHECK-NEXT:    [[RES3:%.*]] = call i32 @callee_subcall()
+; CHECK-NEXT:    ret i32 [[RES3]]
