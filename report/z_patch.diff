diff --git a/llvm/test/Transforms/ConstraintElimination/strengthen-flags-at-uses.ll b/llvm/test/Transforms/ConstraintElimination/strengthen-flags-at-uses.ll
new file mode 100644
index 0000000000000..ab7a9859546f5
--- /dev/null
+++ b/llvm/test/Transforms/ConstraintElimination/strengthen-flags-at-uses.ll
@@ -0,0 +1,81 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s
+
+; The sub is hoisted above the branch establishing %a >=u %b, but its only use
+; is guarded by that branch, so nuw can still be inferred.
+define i64 @sub_hoisted_single_use(i64 %a, i64 %b) {
+; CHECK-LABEL: define i64 @sub_hoisted_single_use(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[C:%.*]] = icmp uge i64 [[A]], [[B]]
+; CHECK-NEXT:    [[SUB:%.*]] = sub nuw i64 [[A]], [[B]]
+; CHECK-NEXT:    br i1 [[C]], label %[[IF_END:.*]], label %[[EXIT:.*]]
+; CHECK:       [[IF_END]]:
+; CHECK-NEXT:    ret i64 [[SUB]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i64 0
+;
+entry:
+  %c = icmp uge i64 %a, %b
+  %sub = sub i64 %a, %b
+  br i1 %c, label %if.end, label %exit
+
+if.end:
+  ret i64 %sub
+
+exit:
+  ret i64 0
+}
+
+; Same, but with a second use that is not guarded, so no flag can be added.
+define i64 @sub_hoisted_use_outside(i64 %a, i64 %b) {
+; CHECK-LABEL: define i64 @sub_hoisted_use_outside(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[C:%.*]] = icmp uge i64 [[A]], [[B]]
+; CHECK-NEXT:    [[SUB:%.*]] = sub i64 [[A]], [[B]]
+; CHECK-NEXT:    br i1 [[C]], label %[[IF_END:.*]], label %[[EXIT:.*]]
+; CHECK:       [[IF_END]]:
+; CHECK-NEXT:    ret i64 [[SUB]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i64 [[SUB]]
+;
+entry:
+  %c = icmp uge i64 %a, %b
+  %sub = sub i64 %a, %b
+  br i1 %c, label %if.end, label %exit
+
+if.end:
+  ret i64 %sub
+
+exit:
+  ret i64 %sub
+}
+
+; The uses are all in %mid, so the check is anchored at the first of them. The
+; assume is queued as a fact at its own position (rather than on entry to %mid)
+; because @barrier may not return, so the anchor must be ordered after it.
+define i64 @sub_anchored_after_assume(i64 %a, i64 %b) {
+; CHECK-LABEL: define i64 @sub_anchored_after_assume(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[SUB:%.*]] = sub nuw i64 [[A]], [[B]]
+; CHECK-NEXT:    br label %[[MID:.*]]
+; CHECK:       [[MID]]:
+; CHECK-NEXT:    call void @barrier()
+; CHECK-NEXT:    [[C:%.*]] = icmp uge i64 [[A]], [[B]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
+; CHECK-NEXT:    ret i64 [[SUB]]
+;
+entry:
+  %sub = sub i64 %a, %b
+  br label %mid
+
+mid:
+  call void @barrier()
+  %c = icmp uge i64 %a, %b
+  call void @llvm.assume(i1 %c)
+  ret i64 %sub
+}
+
+declare void @barrier()
