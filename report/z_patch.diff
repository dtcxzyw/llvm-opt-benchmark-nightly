+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=sroa -S %s | FileCheck %s
+
+; A constant memset that fully covers a slice range defines that range when
+; SROA forwards stored values out of an alloca that escapes only into read-only
+; uses.
+
+declare void @callee(ptr captures(none) readonly %p)
+
+; A zero memset covering two pointer fields defines both of them.
+define ptr @memset_two_fields(ptr %p) {
+; CHECK-LABEL: define ptr @memset_two_fields(
+; CHECK-SAME: ptr [[P:%.*]]) {
+; CHECK-NEXT:    [[A:%.*]] = alloca { ptr, ptr }, align 8
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 0, i64 16, i1 false)
+; CHECK-NEXT:    [[B:%.*]] = getelementptr i8, ptr [[A]], i64 8
+; CHECK-NEXT:    store ptr [[P]], ptr [[B]], align 8
+; CHECK-NEXT:    call void @callee(ptr [[A]])
+; CHECK-NEXT:    [[C:%.*]] = icmp eq ptr null, null
+; CHECK-NEXT:    [[R:%.*]] = select i1 [[C]], ptr [[P]], ptr null
+; CHECK-NEXT:    ret ptr [[R]]
+;
+  %a = alloca { ptr, ptr }, align 8
+  call void @llvm.memset.p0.i64(ptr %a, i8 0, i64 16, i1 false)
+  %b = getelementptr i8, ptr %a, i64 8
+  store ptr %p, ptr %b
+  call void @callee(ptr %a)
+  %l1 = load ptr, ptr %a
+  %l2 = load ptr, ptr %b
+  %c = icmp eq ptr %l1, null
+  %r = select i1 %c, ptr %l2, ptr null
+  ret ptr %r
+}
+
+; Fields cleared by a memset and conditionally overwritten get a phi.
+define ptr @memset_cond_store(i1 %cond, ptr %p) {
+; CHECK-LABEL: define ptr @memset_cond_store(
+; CHECK-SAME: i1 [[COND:%.*]], ptr [[P:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[A:%.*]] = alloca { ptr, i64, ptr }, align 8
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 0, i64 8, i1 false)
+; CHECK-NEXT:    [[F2:%.*]] = getelementptr i8, ptr [[A]], i64 16
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[F2]], i8 0, i64 8, i1 false)
+; CHECK-NEXT:    br i1 [[COND]], label %[[THEN:.*]], label %[[JOIN:.*]]
+; CHECK:       [[THEN]]:
+; CHECK-NEXT:    store ptr [[P]], ptr [[F2]], align 8
+; CHECK-NEXT:    br label %[[JOIN]]
+; CHECK:       [[JOIN]]:
+; CHECK-NEXT:    [[P1:%.*]] = phi ptr [ [[P]], %[[THEN]] ], [ null, %[[ENTRY]] ]
+; CHECK-NEXT:    call void @callee(ptr [[A]])
+; CHECK-NEXT:    ret ptr [[P1]]
+;
+entry:
+  %a = alloca { ptr, i64, ptr }, align 8
+  call void @llvm.memset.p0.i64(ptr %a, i8 0, i64 8, i1 false)
+  %f2 = getelementptr i8, ptr %a, i64 16
+  call void @llvm.memset.p0.i64(ptr %f2, i8 0, i64 8, i1 false)
+  br i1 %cond, label %then, label %join
+
+then:
+  store ptr %p, ptr %f2
+  br label %join
+
+join:
+  call void @callee(ptr %a)
+  %l = load ptr, ptr %f2
+  ret ptr %l
+}
+
+define i32 @memset_nonzero_int() {
+; CHECK-LABEL: define i32 @memset_nonzero_int() {
+; CHECK-NEXT:    [[A:%.*]] = alloca i32, align 4
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 1, i64 4, i1 false)
+; CHECK-NEXT:    call void @callee(ptr [[A]])
+; CHECK-NEXT:    ret i32 16843009
+;
