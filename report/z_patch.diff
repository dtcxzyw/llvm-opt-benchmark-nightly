+define void @livein_outer_phi(ptr noalias %p, ptr noalias %q, i64 %n, i32 %m) {
+; CHECK-LABEL: define void @livein_outer_phi(
+; CHECK-SAME: ptr noalias [[P:%.*]], ptr noalias [[Q:%.*]], i64 [[N:%.*]], i32 [[M:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    br label %[[ITER_CHECK:.*]]
