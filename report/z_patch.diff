+  %c.0 = icmp ule i64 %add, 100
+  call void @llvm.assume(i1 %c.0)
+  %gep = getelementptr nuw i8, ptr %p, i64 %add
+  %gep.4 = getelementptr nuw i8, ptr %gep, i64 4
+  %t = icmp ugt ptr %gep.4, %gep
