+; CHECK-NEXT:  Determining loop execution counts for: @outer_count_wider_than_iv
+; CHECK-NEXT:  Loop %countdown: backedge-taken count is ((-1 * ({0,+,1}<nuw><nsw><%outer> smin %s)) + %s)
+; CHECK-NEXT:  Loop %countdown: constant max backedge-taken count is i32 2147483647
+; CHECK-NEXT:  Loop %countdown: symbolic max backedge-taken count is ((-1 * ({0,+,1}<nuw><nsw><%outer> smin %s)) + %s)
+; CHECK-NEXT:  Loop %countdown: Trip multiple is 1
+; CHECK-NEXT:  Loop %outer: backedge-taken count is (-1 + %m)
+; CHECK-NEXT:  Loop %outer: constant max backedge-taken count is i64 -2
+; CHECK-NEXT:  Loop %outer: symbolic max backedge-taken count is (-1 + %m)
+; CHECK-NEXT:  Loop %outer: Trip multiple is 1
+;
+entry:
+  %pos = icmp ugt i64 %m, 0
+  br i1 %pos, label %guard, label %exit
+
+guard:
+  %g = icmp sge i32 %s, 2000000000
+  br i1 %g, label %outer.ph, label %exit
+
+outer.ph:
+  br label %outer
+
+outer:
+  %j = phi i32 [ 0, %outer.ph ], [ %j.next, %outer.latch ]
+  %cnt = phi i64 [ 0, %outer.ph ], [ %cnt.next, %outer.latch ]
+  br label %countdown
+
+countdown:
+  %k = phi i32 [ %s, %outer ], [ %k.next, %countdown ]
+  %k.next = add nsw i32 %k, -1
+  store i32 %k.next, ptr %p, align 4
+  %gt = icmp sgt i32 %k, %j
+  br i1 %gt, label %countdown, label %outer.latch
+
+outer.latch:
+  %j.next = add nsw i32 %j, 1
+  %cnt.next = add nsw i64 %cnt, 1
+  %done = icmp eq i64 %cnt.next, %m
+  br i1 %done, label %exit, label %outer
+
+exit:
