         // Drop assume if we can prove nonnull without it
@@ -3987,6 +3992,7 @@ Instruction *InstCombinerImpl::visitCallInst(CallInst &CI) {
       }
 
       case BundleAttr::NoUndef: {
+        ShouldMoveAssume = true;
