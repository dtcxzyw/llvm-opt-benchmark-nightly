+; RUN: opt -passes='print<access-info>' -disable-output %s 2>&1 | FileCheck %s
+
+; %data cannot alias the non-escaping %buf, so no runtime checks are needed.
+define void @nested_loop_arg_vs_local(ptr %data, i64 %n) {
+; CHECK-LABEL: 'nested_loop_arg_vs_local'
+; CHECK-NEXT:    inner:
+; CHECK-NEXT:      Memory dependences are safe
+; CHECK-NEXT:      Dependences:
+; CHECK-NEXT:      Run-time memory checks:
+; CHECK-NEXT:      Grouped accesses:
+; CHECK-EMPTY:
+; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
+; CHECK-NEXT:      SCEV assumptions:
+; CHECK-EMPTY:
+; CHECK-NEXT:      Expressions re-written:
+; CHECK-NEXT:    outer:
+; CHECK-NEXT:      Report: loop is not the innermost loop
+; CHECK-NEXT:      Dependences:
+; CHECK-NEXT:      Run-time memory checks:
+; CHECK-NEXT:      Grouped accesses:
+; CHECK-EMPTY:
+; CHECK-NEXT:      Non vectorizable stores to invariant address were not found in loop.
+; CHECK-NEXT:      SCEV assumptions:
+; CHECK-EMPTY:
+; CHECK-NEXT:      Expressions re-written:
+;
+entry:
+  %buf = alloca [16 x i8]
+  br label %outer
+
+outer:
+  %outer.iv = phi i64 [ 0, %entry ], [ %outer.iv.next, %outer.latch ]
+  %data.outer = phi ptr [ %data, %entry ], [ %data.next.lcssa, %outer.latch ]
+  br label %inner
+
+inner:
+  %iv = phi i64 [ 0, %outer ], [ %iv.next, %inner ]
+  %data.inner = phi ptr [ %data.outer, %outer ], [ %data.next, %inner ]
+  %buf.gep = getelementptr inbounds nuw i8, ptr %buf, i64 %iv
+  %b = load i8, ptr %buf.gep
+  store i8 %b, ptr %data.inner
+  %data.next = getelementptr inbounds nuw i8, ptr %data.inner, i64 1
+  %iv.next = add nuw nsw i64 %iv, 1
+  %ec = icmp eq i64 %iv.next, 16
+  br i1 %ec, label %outer.latch, label %inner
+
+outer.latch:
+  %data.next.lcssa = phi ptr [ %data.next, %inner ]
+  %outer.iv.next = add nuw i64 %outer.iv, 1
+  %outer.ec = icmp eq i64 %outer.iv.next, %n
+  br i1 %outer.ec, label %exit, label %outer
+
+exit:
+  ret void
+}
