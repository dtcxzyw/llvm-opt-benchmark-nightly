+  %c.0 = icmp sgt i16 %i, %j
+  br i1 %c.0, label %bb.1, label %exit
+
+bb.1:
+  %c.1 = icmp sgt i16 %j, 0
+  br i1 %c.1, label %bb.2, label %exit
+
+bb.2:
