diff --git a/llvm/lib/Transforms/InstCombine/InstCombineShifts.cpp b/llvm/lib/Transforms/InstCombine/InstCombineShifts.cpp
index 7e32abcd6e9ba..57cbc8e4137b1 100644
--- a/llvm/lib/Transforms/InstCombine/InstCombineShifts.cpp
+++ b/llvm/lib/Transforms/InstCombine/InstCombineShifts.cpp
@@ -1413,6 +1413,27 @@ Instruction *InstCombinerImpl::visitLShr(BinaryOperator &I) {
   const APInt *C;
   unsigned BitWidth = Ty->getScalarSizeInBits();
 
+  // lshr C1, (add X, -C2) -> lshr (C1 << C2), X
+  {
+    const APInt *C1, *C2;
+    Value *X;
+    if (match(Op0, m_APInt(C1)) &&
+        match(Op1, m_Add(m_Value(X), m_APInt(C2))) && C2->isNegative()) {
+      APInt NegC2 = -(*C2);
+      if (NegC2.ult(BitWidth) && C1->countLeadingZeros() >= NegC2.getZExtValue()) {
+        KnownBits Known = computeKnownBits(X, &I);
+        if (Known.getMaxValue().ult(BitWidth)) {
+          APInt NewC1 = C1->shl(NegC2);
+          Constant *NewC1Const = ConstantInt::get(Ty->getScalarType(), NewC1);
+          if (auto *VecTy = dyn_cast<VectorType>(Ty))
+            NewC1Const = ConstantVector::getSplat(VecTy->getElementCount(), NewC1Const);
+
+         return BinaryOperator::CreateLShr(NewC1Const, X);
+        }
+      }
+    }
+  }
+
   // lshr 1, X --> zext (X == 0)
   if (match(Op0, m_One()))
     return new ZExtInst(Builder.CreateIsNull(Op1), Ty);
diff --git a/llvm/test/Transforms/InstCombine/lshr-sub.ll b/llvm/test/Transforms/InstCombine/lshr-sub.ll
new file mode 100644
index 0000000000000..e5b3ea44ab00c
--- /dev/null
+++ b/llvm/test/Transforms/InstCombine/lshr-sub.ll
@@ -0,0 +1,43 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt < %s -passes=instcombine -S | FileCheck %s
+
+define i32 @lshr_sub_const(i32 %x) {
+; CHECK-LABEL: @lshr_sub_const(
+; CHECK-NEXT:    [[S:%.*]] = add i32 [[X:%.*]], -3
+; CHECK-NEXT:    [[R:%.*]] = lshr i32 64, [[S]]
+; CHECK-NEXT:    ret i32 [[R]]
+;
+  %s = sub i32 %x, 3
+  %r = lshr i32 64, %s
+  ret i32 %r
+}
+
+define i32 @from_sub_issue222281(i8 %x) {
+; CHECK-LABEL: @from_sub_issue222281(
+; CHECK-NEXT:    [[M:%.*]] = and i8 [[X:%.*]], 120
+; CHECK-NEXT:    [[V:%.*]] = or disjoint i8 [[M]], -128
+; CHECK-NEXT:    [[TZ:%.*]] = call range(i8 3, 8) i8 @llvm.cttz.i8(i8 [[V]], i1 true)
+; CHECK-NEXT:    [[Z:%.*]] = zext nneg i8 [[TZ]] to i32
+; CHECK-NEXT:    [[R:%.*]] = lshr exact i32 512, [[Z]]
+; CHECK-NEXT:    ret i32 [[R]]
+;
+  %m = and i8 %x, -8
+  %v = or i8 %m, -128
+  %tz = call i8 @llvm.cttz.i8(i8 %v, i1 true)
+  %z = zext nneg i8 %tz to i32
+  %s = sub nuw nsw i32 %z, 3
+  %r = lshr i32 64, %s
+  ret i32 %r
+}
+
+; Negative test: 64 << 28 overflows 32-bit integer, so this should NOT fold
+define i32 @lshr_sub_overflow(i32 %x) {
+; CHECK-LABEL: @lshr_sub_overflow(
+; CHECK-NEXT:    [[S:%.*]] = add i32 [[X:%.*]], -28
+; CHECK-NEXT:    [[R:%.*]] = lshr i32 64, [[S]]
+; CHECK-NEXT:    ret i32 [[R]]
+;
+  %s = sub i32 %x, 28
+  %r = lshr i32 64, %s
+  ret i32 %r
+}
