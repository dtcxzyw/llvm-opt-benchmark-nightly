+; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -disable-output "-passes=print<scalar-evolution>" -scalar-evolution-classify-expressions=0 2>&1 | FileCheck %s
+
+; The trip count of these unknown-stride loops can only be computed by
+; assuming that the loop is finite, i.e. that it is mustprogress and has no
+; side effects. Droppable intrinsics such as llvm.assume and llvm.pseudoprobe
+; only model a write to inaccessible memory to keep them in place, so they
+; must not count as side effects for that purpose.
+
+target datalayout = "e-m:e-p:32:32-f64:32:64-f80:32-n8:16:32-S128"
+
+define void @assume_in_loop(ptr nocapture %A, i32 %n, i32 %s) mustprogress {
+; CHECK-LABEL: 'assume_in_loop'
+; CHECK-NEXT:  Determining loop execution counts for: @assume_in_loop
+; CHECK-NEXT:  Loop %for.body: backedge-taken count is ((((-1 * (1 umin ((-1 * %s) + (%n smax %s))))<nuw><nsw> + (-1 * %s) + (%n smax %s)) /u (1 umax %s)) + (1 umin ((-1 * %s) + (%n smax %s))))
+; CHECK-NEXT:  Loop %for.body: constant max backedge-taken count is i32 -1
+; CHECK-NEXT:  Loop %for.body: symbolic max backedge-taken count is ((((-1 * (1 umin ((-1 * %s) + (%n smax %s))))<nuw><nsw> + (-1 * %s) + (%n smax %s)) /u (1 umax %s)) + (1 umin ((-1 * %s) + (%n smax %s))))
+; CHECK-NEXT:  Loop %for.body: Trip multiple is 1
+;
+entry:
+  br label %for.body
+
+for.body:
+  %i.05 = phi i32 [ %add, %for.body ], [ 0, %entry ]
+  %arrayidx = getelementptr inbounds i32, ptr %A, i32 %i.05
+  %0 = load i32, ptr %arrayidx, align 4
+  %nonneg = icmp sge i32 %0, 0
+  call void @llvm.assume(i1 %nonneg)
+  %add = add nsw i32 %i.05, %s
+  %cmp = icmp slt i32 %add, %n
+  br i1 %cmp, label %for.body, label %for.end
+
+for.end:
+  ret void
+}
+
