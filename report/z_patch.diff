+left:
+  br label %merge
+
+right:
+  br label %merge
+
+merge:
+  %lo = phi <2 x float> [ %a0, %left ], [ %a1, %right ]
+  %hi = phi <2 x float> [ %b0, %left ], [ %b1, %right ]
