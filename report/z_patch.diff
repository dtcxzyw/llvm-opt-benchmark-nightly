+; Keep the original calculation for a bitwise consumer.
+define i32 @bitwise_consumer_i32(i1 noundef %c, i32 noundef %v, i32 %d, i32 %e, ptr %out, ptr %out2) optsize "target-cpu"="x86-64" {
