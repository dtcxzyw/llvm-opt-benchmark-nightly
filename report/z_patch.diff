+    ; CHECK-LABEL: name: remove_redundant_spill_reload
+    ; CHECK:      $rax = MOV64rm $rsp, 1, $noreg, 32, $noreg :: (load (s64) from %stack.0)
+    ; CHECK-NEXT: $rcx = MOV64ri 1
+    ; CHECK-NEXT: MOV64mr $rsp, 1, $noreg, 40, $noreg, $rax :: (store (s64) into %stack.1)
+    ; CHECK-NEXT: RET64
