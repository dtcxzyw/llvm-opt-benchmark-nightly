+void ScheduleDAGDependencyBuilder::UnanalyzableFrontier::clear() {
+  SequencingStore = nullptr;
+  SeenSequencingLoad = false;
+  BaseObjects.clear();
+  Stores.clear();
+  Loads.clear();
+}
