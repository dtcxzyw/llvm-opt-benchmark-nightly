+  br i1 %t, label %side, label %next
+side:
+  %ps = getelementptr i8, ptr addrspace(1) %dst, i64 256
+  store volatile i32 0, ptr addrspace(1) %ps, align 4
+  br label %next
+next:
+  %b = bitcast <32 x i4> %v to <16 x i8>
+  store <16 x i8> %b, ptr addrspace(1) %dst, align 16
+  ret void
+}
