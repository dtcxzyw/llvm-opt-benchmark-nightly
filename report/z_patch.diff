+
+bb2:
+  br label %exit
+
+default:
+  br label %exit
+
+exit:
+  %r = phi i8 [ %v0, %entry ], [ 3, %lookup ], [ 3, %lookup ], [ 3, %lookup ], [ 10, %bb1 ], [ 9, %bb2 ], [ %v, %default ]
