       if (!isGuaranteedNotToBePoison(&I))
@@ -1916,6 +1920,30 @@ static bool checkAndReplaceMinMax(MinMaxIntrinsic *MinMax, ConstraintInfo &Info,
   return false;
 }
 
+/// Try to replace \p USub by a plain subtract, if \p Info proves it cannot
+/// saturate. Returns true if \p USub was replaced.
+static bool checkAndReplaceUSubSat(SaturatingInst *USub, ConstraintInfo &Info,
+                                   SmallVectorImpl<Instruction *> &ToRemove) {
+  Value *A = USub->getLHS();
+  Value *B = USub->getRHS();
+  // usub.sat(A, B) saturates exactly when A <u B. For non-negative operands
+  // the signed and unsigned orders agree, so a signed proof carries over.
+  bool IsNonNegA = Info.isKnownNonNegative(A);
+  if (!Info.doesHold(CmpInst::ICMP_UGE, A, B) &&
+      !(IsNonNegA && Info.isKnownNonNegative(B) &&
+        Info.doesHold(CmpInst::ICMP_SGE, A, B)))
+    return false;
+
+  auto *Sub = BinaryOperator::CreateNUWSub(A, B, USub->getName(),
+                                           USub->getIterator());
+  Sub->setDebugLoc(USub->getDebugLoc());
+  // The difference is in [0, A], so it is in signed range whenever A is.
+  Sub->setHasNoSignedWrap(IsNonNegA);
+  USub->replaceAllUsesWith(Sub);
+  ToRemove.push_back(USub);
+  return true;
+}
+
 static bool checkAndReplaceCmp(CmpIntrinsic *I, ConstraintInfo &Info,
                                SmallVectorImpl<Instruction *> &ToRemove) {
   Value *LHS = I->getOperand(0);
@@ -2311,6 +2339,9 @@ static bool eliminateConstraints(Function &F, DominatorTree &DT, LoopInfo &LI,
         Changed |= checkAndReplaceMinMax(MinMax, Info, ToRemove);
       } else if (auto *CmpIntr = dyn_cast<CmpIntrinsic>(Inst)) {
         Changed |= checkAndReplaceCmp(CmpIntr, Info, ToRemove);
+      } else if (auto *USub = dyn_cast<SaturatingInst>(Inst)) {
+        if (USub->getIntrinsicID() == Intrinsic::usub_sat)
+          Changed |= checkAndReplaceUSubSat(USub, Info, ToRemove);
       }
       continue;
     }
diff --git a/llvm/test/Transforms/ConstraintElimination/usub-sat-signed.ll b/llvm/test/Transforms/ConstraintElimination/usub-sat-signed.ll
new file mode 100644
index 0000000000000..962bc332f400e
--- /dev/null
+++ b/llvm/test/Transforms/ConstraintElimination/usub-sat-signed.ll
@@ -0,0 +1,174 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s
+
+; Tests for rewriting llvm.usub.sat to a plain sub when the constraint systems
+; prove it cannot saturate. usub.sat(a, b) is max(a - b, 0), so it is exactly
+; a - b when a >=u b. The resulting sub is nuw, and additionally nsw when a is
+; non-negative, because the difference then lies in [0, a].
+;
+; InstCombine already covers the case where the no-saturation precondition is
+; unsigned. What needs the constraint systems is a precondition that only holds
+; in the signed system: for non-negative operands the signed and unsigned orders
+; agree, so `a >=s b` gives `a >=u b`. That is the shape Swift produces for a
+; span offset - `usub.sat(count, base)` bounded entirely by signed guards.
+
+declare i64 @llvm.usub.sat.i64(i64, i64)
+declare void @llvm.assume(i1)
+
+; The no-saturation precondition proven in the signed system: a >=s 0, b >=s 0
+; and a >=s b give a >=u b, so usub.sat(a, b) is a - b.
+define i64 @usub_sat_signed_precondition(i64 %a, i64 %b) {
+; CHECK-LABEL: define i64 @usub_sat_signed_precondition(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:    [[A_NNEG:%.*]] = icmp sge i64 [[A]], 0
+; CHECK-NEXT:    call void @llvm.assume(i1 [[A_NNEG]])
+; CHECK-NEXT:    [[B_NNEG:%.*]] = icmp sge i64 [[B]], 0
+; CHECK-NEXT:    call void @llvm.assume(i1 [[B_NNEG]])
+; CHECK-NEXT:    [[PRE:%.*]] = icmp sge i64 [[A]], [[B]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[SUB1:%.*]] = sub nuw nsw i64 [[A]], [[B]]
+; CHECK-NEXT:    ret i64 [[SUB1]]
+;
+  %a.nneg = icmp sge i64 %a, 0
+  call void @llvm.assume(i1 %a.nneg)
+  %b.nneg = icmp sge i64 %b, 0
+  call void @llvm.assume(i1 %b.nneg)
+  %pre = icmp sge i64 %a, %b
+  call void @llvm.assume(i1 %pre)
+  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b)
+  ret i64 %sub
+}
+
+; The Swift span shape: count >=s 0, base >=s 0, n >=s 0 and base <=s count - n
+; give usub.sat(count, base) >=s n. This is the hoisted preheader check of a
+; loop over `span[base + i]` for i in 0..<n.
+define i1 @usub_sat_span_offset(i64 %count, i64 %base, i64 %n) {
+; CHECK-LABEL: define i1 @usub_sat_span_offset(
+; CHECK-SAME: i64 [[COUNT:%.*]], i64 [[BASE:%.*]], i64 [[N:%.*]]) {
+; CHECK-NEXT:    [[COUNT_NNEG:%.*]] = icmp sge i64 [[COUNT]], 0
+; CHECK-NEXT:    call void @llvm.assume(i1 [[COUNT_NNEG]])
+; CHECK-NEXT:    [[BASE_NNEG:%.*]] = icmp sge i64 [[BASE]], 0
+; CHECK-NEXT:    call void @llvm.assume(i1 [[BASE_NNEG]])
+; CHECK-NEXT:    [[N_NNEG:%.*]] = icmp sge i64 [[N]], 0
+; CHECK-NEXT:    call void @llvm.assume(i1 [[N_NNEG]])
+; CHECK-NEXT:    [[REM:%.*]] = sub nsw i64 [[COUNT]], [[N]]
+; CHECK-NEXT:    [[FITS:%.*]] = icmp sge i64 [[REM]], [[BASE]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[FITS]])
+; CHECK-NEXT:    [[AVAIL1:%.*]] = sub nuw nsw i64 [[COUNT]], [[BASE]]
+; CHECK-NEXT:    ret i1 true
+;
+  %count.nneg = icmp sge i64 %count, 0
+  call void @llvm.assume(i1 %count.nneg)
+  %base.nneg = icmp sge i64 %base, 0
+  call void @llvm.assume(i1 %base.nneg)
+  %n.nneg = icmp sge i64 %n, 0
+  call void @llvm.assume(i1 %n.nneg)
+  %rem = sub nsw i64 %count, %n
+  %fits = icmp sge i64 %rem, %base
+  call void @llvm.assume(i1 %fits)
+  %avail = call i64 @llvm.usub.sat.i64(i64 %count, i64 %base)
+  %t = icmp sge i64 %avail, %n
+  ret i1 %t
+}
+
+; Negative test: a >=s b alone does not give a >=u b when b may be negative
+; (a = 0, b = -1 saturates to 0, not to 1), so this must not be rewritten.
+define i64 @usub_sat_no_nonneg_rhs(i64 %a, i64 %b) {
+; CHECK-LABEL: define i64 @usub_sat_no_nonneg_rhs(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:    [[A_NNEG:%.*]] = icmp sge i64 [[A]], 0
+; CHECK-NEXT:    call void @llvm.assume(i1 [[A_NNEG]])
+; CHECK-NEXT:    [[PRE:%.*]] = icmp sge i64 [[A]], [[B]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[SUB:%.*]] = call i64 @llvm.usub.sat.i64(i64 [[A]], i64 [[B]])
+; CHECK-NEXT:    ret i64 [[SUB]]
+;
+  %a.nneg = icmp sge i64 %a, 0
+  call void @llvm.assume(i1 %a.nneg)
+  %pre = icmp sge i64 %a, %b
+  call void @llvm.assume(i1 %pre)
+  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b)
+  ret i64 %sub
+}
+
+; Negative test: b >=s 0 alone gives neither a >=s b nor a >=u b.
+define i64 @usub_sat_no_precondition(i64 %a, i64 %b) {
+; CHECK-LABEL: define i64 @usub_sat_no_precondition(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:    [[B_NNEG:%.*]] = icmp sge i64 [[B]], 0
+; CHECK-NEXT:    call void @llvm.assume(i1 [[B_NNEG]])
+; CHECK-NEXT:    [[SUB:%.*]] = call i64 @llvm.usub.sat.i64(i64 [[A]], i64 [[B]])
+; CHECK-NEXT:    ret i64 [[SUB]]
+;
+  %b.nneg = icmp sge i64 %b, 0
+  call void @llvm.assume(i1 %b.nneg)
+  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b)
+  ret i64 %sub
+}
+
+; An unsigned precondition is enough to rewrite, but with a possibly-negative
+; LHS the difference need not be in signed range, so only nuw may be added.
+define i64 @usub_sat_no_nonneg_lhs(i64 %a, i64 %b) {
+; CHECK-LABEL: define i64 @usub_sat_no_nonneg_lhs(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:    [[PRE:%.*]] = icmp uge i64 [[A]], [[B]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[SUB1:%.*]] = sub nuw i64 [[A]], [[B]]
+; CHECK-NEXT:    ret i64 [[SUB1]]
+;
+  %pre = icmp uge i64 %a, %b
+  call void @llvm.assume(i1 %pre)
+  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b)
+  ret i64 %sub
+}
+
+; The rewrite feeds the unsigned system too: after `usub.sat(a, b)` becomes
+; `sub nuw`, the unsigned decomposition of a plain sub proves a - b + b >=u a.
+; Decomposing the intrinsic in the signed system alone cannot fold this.
+define i1 @usub_sat_unsigned_query(i64 %a, i64 %b) {
+; CHECK-LABEL: define i1 @usub_sat_unsigned_query(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:    [[PRE:%.*]] = icmp uge i64 [[A]], [[B]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[SUB1:%.*]] = sub nuw i64 [[A]], [[B]]
+; CHECK-NEXT:    [[BACK:%.*]] = add nuw i64 [[SUB1]], [[B]]
+; CHECK-NEXT:    ret i1 true
+;
+  %pre = icmp uge i64 %a, %b
+  call void @llvm.assume(i1 %pre)
+  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b)
+  %back = add nuw i64 %sub, %b
+  %t = icmp uge i64 %back, %a
+  ret i1 %t
+}
+
+; Negative test: the intrinsic is not dominated by the guard, so it must not be
+; rewritten even though a use of it is guarded.
+define i64 @usub_sat_not_dominated(i64 %a, i64 %b, i1 %c) {
+; CHECK-LABEL: define i64 @usub_sat_not_dominated(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[B:%.*]], i1 [[C:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[SUB:%.*]] = call i64 @llvm.usub.sat.i64(i64 [[A]], i64 [[B]])
+; CHECK-NEXT:    br i1 [[C]], label %[[GUARDED:.*]], label %[[UNGUARDED:.*]]
+; CHECK:       [[GUARDED]]:
+; CHECK-NEXT:    [[PRE:%.*]] = icmp uge i64 [[A]], [[B]]
+; CHECK-NEXT:    br i1 [[PRE]], label %[[USE:.*]], label %[[UNGUARDED]]
+; CHECK:       [[USE]]:
+; CHECK-NEXT:    ret i64 [[SUB]]
+; CHECK:       [[UNGUARDED]]:
+; CHECK-NEXT:    ret i64 [[SUB]]
+;
+entry:
+  %sub = call i64 @llvm.usub.sat.i64(i64 %a, i64 %b)
+  br i1 %c, label %guarded, label %unguarded
+
+guarded:
+  %pre = icmp uge i64 %a, %b
+  br i1 %pre, label %use, label %unguarded
+
+use:
+  ret i64 %sub
+
+unguarded:
+  ret i64 %sub
+}
