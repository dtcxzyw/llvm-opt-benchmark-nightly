+; Latch-tested iv != %n with a symbolic start: iv u<= %n if %start u<= %n, and
+; iv s<= %n if %start s<= %n.
+define void @latch_tested_ne(i8 %start, i8 %n) {
+; CHECK-LABEL: @latch_tested_ne(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[PRE_U:%.*]] = icmp ule i8 [[START:%.*]], [[N:%.*]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE_U]])
+; CHECK-NEXT:    [[PRE_S:%.*]] = icmp sle i8 [[START]], [[N]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE_S]])
+; CHECK-NEXT:    br label [[LOOP_HEADER:%.*]]
+; CHECK:       loop.header:
+; CHECK-NEXT:    [[IV:%.*]] = phi i8 [ [[START]], [[ENTRY:%.*]] ], [ [[IV_NEXT:%.*]], [[LOOP_LATCH:%.*]] ]
+; CHECK-NEXT:    call void @use(i1 true)
+; CHECK-NEXT:    call void @use(i1 true)
+; CHECK-NEXT:    [[C_1:%.*]] = icmp ult i8 [[IV]], [[N]]
+; CHECK-NEXT:    call void @use(i1 [[C_1]])
+; CHECK-NEXT:    br label [[LOOP_LATCH]]
+; CHECK:       loop.latch:
+; CHECK-NEXT:    [[IV_NEXT]] = add i8 [[IV]], 1
+; CHECK-NEXT:    [[EC:%.*]] = icmp eq i8 [[IV]], [[N]]
+; CHECK-NEXT:    br i1 [[EC]], label [[EXIT:%.*]], label [[LOOP_HEADER]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %pre.u = icmp ule i8 %start, %n
+  call void @llvm.assume(i1 %pre.u)
+  %pre.s = icmp sle i8 %start, %n
+  call void @llvm.assume(i1 %pre.s)
+  br label %loop.header
+
+loop.header:
+  %iv = phi i8 [ %start, %entry ], [ %iv.next, %loop.latch ]
+  %t.1 = icmp ule i8 %iv, %n
+  call void @use(i1 %t.1)
+  %t.2 = icmp sle i8 %iv, %n
+  call void @use(i1 %t.2)
+  %c.1 = icmp ult i8 %iv, %n
+  call void @use(i1 %c.1)
+  br label %loop.latch
+
+loop.latch:
+  %iv.next = add i8 %iv, 1
+  %ec = icmp eq i8 %iv, %n
+  br i1 %ec, label %exit, label %loop.header
+
+exit:
+  ret void
+}
