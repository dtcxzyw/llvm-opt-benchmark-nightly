+; CHECK-NEXT:    [[P_COPY_FCA_0_1_INSERT:%.*]] = insertvalue { [2 x i64] } [[P_COPY_FCA_0_0_INSERT]], i64 [[P_COPY_FCA_0_1_LOAD_SROA_SPECULATED]], 0, 1
