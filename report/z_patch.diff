index 0000000000000..c5bb489177f4a
--- /dev/null
+++ b/llvm/test/Transforms/ConstraintElimination/induction-symbolic-start-postinc.ll
@@ -0,0 +1,463 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -p constraint-elimination -S %s | FileCheck %s
+
+declare i1 @cond()
+
+; When the latch tests the post-increment, the precondition is the strict
+; `Start < B`. Because B - Start is a multiple of the step, that already
+; implies Start + Step <= B without wrapping, so Start need not be a constant.
+
+define i1 @postinc_symbolic_start_ult_bound(i32 %start, i32 %n) {
+; CHECK-LABEL: define i1 @postinc_symbolic_start_ult_bound(
+; CHECK-SAME: i32 [[START:%.*]], i32 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[PRE:%.*]] = icmp ult i32 [[START]], [[N]]
+; CHECK-NEXT:    br i1 [[PRE]], label %[[LOOP_HEADER:.*]], label %[[EXIT:.*]]
+; CHECK:       [[LOOP_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[START]], %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
+; CHECK-NEXT:    br i1 true, label %[[LOOP_LATCH]], label %[[EXIT]]
+; CHECK:       [[LOOP_LATCH]]:
+; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 1
+; CHECK-NEXT:    [[EC:%.*]] = icmp eq i32 [[IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT]], label %[[LOOP_HEADER]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %pre = icmp ult i32 %start, %n
+  br i1 %pre, label %loop.header, label %exit
+
+loop.header:
+  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop.latch ]
+  %t = icmp ult i32 %iv, %n
+  br i1 %t, label %loop.latch, label %exit
+
+loop.latch:
+  %iv.next = add i32 %iv, 1
+  %ec = icmp eq i32 %iv.next, %n
+  br i1 %ec, label %exit, label %loop.header
+
+exit:
+  ret i1 false
+}
+
+; The signed precondition gives the signed facts. Also checks the lower bound
+; PN >=s Start, which needs the signed precondition too.
+define i1 @postinc_symbolic_start_slt_bound(i32 %start, i32 %n) {
+; CHECK-LABEL: define i1 @postinc_symbolic_start_slt_bound(
+; CHECK-SAME: i32 [[START:%.*]], i32 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i32 [[START]], [[N]]
+; CHECK-NEXT:    br i1 [[PRE]], label %[[LOOP_HEADER:.*]], label %[[EXIT:.*]]
+; CHECK:       [[LOOP_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[START]], %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
+; CHECK-NEXT:    br i1 true, label %[[LOOP_BODY:.*]], label %[[EXIT]]
+; CHECK:       [[LOOP_BODY]]:
+; CHECK-NEXT:    br i1 true, label %[[LOOP_LATCH]], label %[[EXIT]]
+; CHECK:       [[LOOP_LATCH]]:
+; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 1
+; CHECK-NEXT:    [[EC:%.*]] = icmp eq i32 [[IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT]], label %[[LOOP_HEADER]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %pre = icmp slt i32 %start, %n
+  br i1 %pre, label %loop.header, label %exit
+
+loop.header:
+  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop.latch ]
+  %t = icmp slt i32 %iv, %n
+  br i1 %t, label %loop.body, label %exit
+
+loop.body:
+  %t2 = icmp sge i32 %iv, %start
+  br i1 %t2, label %loop.latch, label %exit
+
+loop.latch:
+  %iv.next = add i32 %iv, 1
+  %ec = icmp eq i32 %iv.next, %n
+  br i1 %ec, label %exit, label %loop.header
+
+exit:
+  ret i1 false
+}
+
+; The induction also never steps below its symbolic start value.
+define i1 @postinc_symbolic_start_uge_start(i32 %start, i32 %n) {
+; CHECK-LABEL: define i1 @postinc_symbolic_start_uge_start(
+; CHECK-SAME: i32 [[START:%.*]], i32 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[PRE:%.*]] = icmp ult i32 [[START]], [[N]]
+; CHECK-NEXT:    br i1 [[PRE]], label %[[LOOP_HEADER:.*]], label %[[EXIT:.*]]
+; CHECK:       [[LOOP_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[START]], %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
+; CHECK-NEXT:    br i1 true, label %[[LOOP_LATCH]], label %[[EXIT]]
+; CHECK:       [[LOOP_LATCH]]:
+; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 1
+; CHECK-NEXT:    [[EC:%.*]] = icmp eq i32 [[IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT]], label %[[LOOP_HEADER]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %pre = icmp ult i32 %start, %n
+  br i1 %pre, label %loop.header, label %exit
+
+loop.header:
+  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop.latch ]
+  %t = icmp uge i32 %iv, %start
+  br i1 %t, label %loop.latch, label %exit
+
+loop.latch:
+  %iv.next = add i32 %iv, 1
+  %ec = icmp eq i32 %iv.next, %n
+  br i1 %ec, label %exit, label %loop.header
+
+exit:
+  ret i1 false
+}
+
+; Step 4 with a symbolic start. B - Start is 8, a multiple of the step, so the
+; induction reaches B exactly and `Start <u B` is enough.
+define i1 @postinc_symbolic_start_step4(i32 %start) {
+; CHECK-LABEL: define i1 @postinc_symbolic_start_step4(
+; CHECK-SAME: i32 [[START:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[B:%.*]] = add nuw i32 [[START]], 8
+; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
+; CHECK:       [[LOOP_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[START]], %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
+; CHECK-NEXT:    br i1 true, label %[[LOOP_LATCH]], label %[[EXIT:.*]]
+; CHECK:       [[LOOP_LATCH]]:
+; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 4
+; CHECK-NEXT:    [[EC:%.*]] = icmp eq i32 [[IV_NEXT]], [[B]]
+; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT]], label %[[LOOP_HEADER]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %b = add nuw i32 %start, 8
+  br label %loop.header
+
+loop.header:
+  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop.latch ]
+  %t = icmp ult i32 %iv, %b
+  br i1 %t, label %loop.latch, label %exit
+
+loop.latch:
+  %iv.next = add i32 %iv, 4
+  %ec = icmp eq i32 %iv.next, %b
+  br i1 %ec, label %exit, label %loop.header
+
+exit:
+  ret i1 false
+}
+
+; The fact added to the loop's dedicated exit blocks (A u<= B) uses the same
+; precondition. %exit is shared with an exit that leaves the loop earlier.
+define i1 @postinc_symbolic_start_exit_block(i32 %start) {
+; CHECK-LABEL: define i1 @postinc_symbolic_start_exit_block(
+; CHECK-SAME: i32 [[START:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[B:%.*]] = add nuw i32 [[START]], 8
+; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
+; CHECK:       [[LOOP_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[START]], %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
+; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 4
+; CHECK-NEXT:    [[EC:%.*]] = icmp eq i32 [[IV_NEXT]], [[B]]
+; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP_BODY:.*]]
+; CHECK:       [[LOOP_BODY]]:
+; CHECK-NEXT:    [[C:%.*]] = call i1 @cond()
+; CHECK-NEXT:    br i1 [[C]], label %[[EXIT]], label %[[LOOP_LATCH]]
+; CHECK:       [[LOOP_LATCH]]:
+; CHECK-NEXT:    br label %[[LOOP_HEADER]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 true
+;
+entry:
+  %b = add nuw i32 %start, 8
+  br label %loop.header
+
+loop.header:
+  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop.latch ]
+  %iv.next = add i32 %iv, 4
+  %ec = icmp eq i32 %iv.next, %b
+  br i1 %ec, label %exit, label %loop.body
+
+loop.body:
+  %c = call i1 @cond()
+  br i1 %c, label %exit, label %loop.latch
+
+loop.latch:
+  br label %loop.header
+
+exit:
+  %t = icmp ule i32 %iv.next, %b
+  ret i1 %t
+}
+
+; A constant start with a step > 1 is affected too: the old precondition was
+; the non-derivable `ConstantInt(Start + Step) <=u B`, the new one is exactly
+; the guard the caller tests.
+define i1 @postinc_constant_start_step4(i8 %k0) {
+; CHECK-LABEL: define i1 @postinc_constant_start_step4(
+; CHECK-SAME: i8 [[K0:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[K:%.*]] = and i8 [[K0]], 12
+; CHECK-NEXT:    [[N:%.*]] = add i8 [[K]], 4
+; CHECK-NEXT:    [[PRE:%.*]] = icmp ult i8 4, [[N]]
+; CHECK-NEXT:    br i1 [[PRE]], label %[[LOOP_HEADER:.*]], label %[[EXIT:.*]]
+; CHECK:       [[LOOP_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i8 [ 4, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
+; CHECK-NEXT:    br i1 true, label %[[LOOP_LATCH]], label %[[EXIT]]
+; CHECK:       [[LOOP_LATCH]]:
+; CHECK-NEXT:    [[IV_NEXT]] = add i8 [[IV]], 4
+; CHECK-NEXT:    [[EC:%.*]] = icmp eq i8 [[IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT]], label %[[LOOP_HEADER]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %k = and i8 %k0, 12
+  %n = add i8 %k, 4
+  %pre = icmp ult i8 4, %n
+  br i1 %pre, label %loop.header, label %exit
+
+loop.header:
+  %iv = phi i8 [ 4, %entry ], [ %iv.next, %loop.latch ]
+  %t = icmp ult i8 %iv, %n
+  br i1 %t, label %loop.latch, label %exit
+
+loop.latch:
+  %iv.next = add i8 %iv, 4
+  %ec = icmp eq i8 %iv.next, %n
+  br i1 %ec, label %exit, label %loop.header
+
+exit:
+  ret i1 false
+}
+
+; Negative test: without a precondition the induction may wrap past the bound.
+define i1 @postinc_symbolic_start_no_precondition(i32 %start, i32 %n) {
+; CHECK-LABEL: define i1 @postinc_symbolic_start_no_precondition(
+; CHECK-SAME: i32 [[START:%.*]], i32 [[N:%.*]]) {
