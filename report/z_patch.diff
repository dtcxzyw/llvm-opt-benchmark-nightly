+  %fl = call float @llvm.floor.f32(float %x)
+  %sub = fsub nsz float %x, %fl
+  %isnan = fcmp uno float %x, 0.0
+  %cond = select i1 %isnan, float %x, float %sub
+  %fa = call float @llvm.fabs.f32(float %x)
+  %isinf = fcmp oeq float %fa, +inf
+  %fraczero = fcmp oeq float %cond, 0.0
+  %r = or i1 %isinf, %fraczero
+  ret i1 %r
+}
+
