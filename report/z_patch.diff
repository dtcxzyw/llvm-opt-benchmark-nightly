+; CHECK-NEXT:    [[P_PHI:%.*]] = phi ptr [ [[Q]], %[[ENTRY]] ], [ [[P]], %[[LOOKUP]] ], [ [[P]], %[[LOOKUP]] ], [ [[P]], %[[LOOKUP]] ], [ [[P]], %[[SW_BB1]] ], [ [[P]], %[[SW_BB2]] ], [ [[P]], %[[DEFAULT]] ]
