+; Missed optimization: we could emit two memsets here.
+;
+; The first loop in `LoopIdiomRecognize::processLoopStores` only considers
+; stores pair-wise, and so when it sees `(1, undef)` and then `(undef, 2)` it
+; links both and creates a chain of `(1, 1, undef, 2, 2)`. The second loop
+; avoid generating a memset for it, but it could create two memsets.
+define void @undef_mid_missed_optimization(ptr %p, i64 %n) {
+; CHECK-LABEL: define void @undef_mid_missed_optimization(
+; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
+; CHECK-NEXT:    [[I0:%.*]] = getelementptr inbounds [5 x i8], ptr [[P]], i64 [[I]], i64 0
+; CHECK-NEXT:    [[I1:%.*]] = getelementptr inbounds [5 x i8], ptr [[P]], i64 [[I]], i64 1
+; CHECK-NEXT:    [[I2:%.*]] = getelementptr inbounds [5 x i8], ptr [[P]], i64 [[I]], i64 2
+; CHECK-NEXT:    [[I3:%.*]] = getelementptr inbounds [5 x i8], ptr [[P]], i64 [[I]], i64 3
+; CHECK-NEXT:    [[I4:%.*]] = getelementptr inbounds [5 x i8], ptr [[P]], i64 [[I]], i64 4
+; CHECK-NEXT:    store i8 1, ptr [[I0]], align 1
+; CHECK-NEXT:    store i8 1, ptr [[I1]], align 1
+; CHECK-NEXT:    store i8 undef, ptr [[I2]], align 1
+; CHECK-NEXT:    store i8 2, ptr [[I3]], align 1
+; CHECK-NEXT:    store i8 2, ptr [[I4]], align 1
+; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
+; CHECK-NEXT:    [[CMP:%.*]] = icmp ne i64 [[I_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %loop
+
+loop:
+  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
+  %i0 = getelementptr inbounds [5 x i8], ptr %p, i64 %i, i64 0
+  %i1 = getelementptr inbounds [5 x i8], ptr %p, i64 %i, i64 1
+  %i2 = getelementptr inbounds [5 x i8], ptr %p, i64 %i, i64 2
+  %i3 = getelementptr inbounds [5 x i8], ptr %p, i64 %i, i64 3
+  %i4 = getelementptr inbounds [5 x i8], ptr %p, i64 %i, i64 4
+  store i8 1, ptr %i0
+  store i8 1, ptr %i1
+  store i8 undef, ptr %i2
+  store i8 2, ptr %i3
+  store i8 2, ptr %i4
+  %i.next = add nuw nsw i64 %i, 1
+  %cmp = icmp ne i64 %i.next, %n
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  ret void
