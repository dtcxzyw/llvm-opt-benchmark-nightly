+
+; nw on the pre-inc does not imply nsuw on the sext.
+; The sext-addrec should not fold.
+define void @sext.nsuw.nw.pre.inc(ptr %buf, i32 %n) mustprogress {
+; CHECK-LABEL: 'sext.nsuw.nw.pre.inc'
+; CHECK-NEXT:  Classifying expressions for: @sext.nsuw.nw.pre.inc
+; CHECK-NEXT:    %i = phi i32 [ -1, %entry ], [ %i.next, %loop ]
+; CHECK-NEXT:    --> {-1,+,-2}<nw><%loop> U: full-set S: full-set Exits: <<Unknown>> LoopDispositions: { %loop: Computable }
