+    auto *CxtI = findInstructionByNameOrNull(F, "CxtI");
+
+    SimplifyQuery SQ(DL, &DT, &AC, CxtI);
+    EXPECT_FALSE(haveNoCommonBitsSet(LHS, RHS, SQ));
+    EXPECT_EQ(NoCommonBitsSetResult::Unknown,
