+; Immediate UB cannot be masked the way a poison result can be.
+define i32 @masked_remainder_ub(i1 noundef %cond) {
+; CHECK-LABEL: define i32 @masked_remainder_ub(
+; CHECK-SAME: i1 noundef [[COND:%.*]]) {
+; CHECK-NEXT:    [[X:%.*]] = select i1 [[COND]], i32 -1, i32 1
+; CHECK-NEXT:    [[R:%.*]] = call i32 @masked_remainder(i32 [[X]])
+; CHECK-NEXT:    ret i32 [[R]]
+;
+; O3-LABEL: define noundef i32 @masked_remainder_ub(
+; O3-SAME: i1 noundef [[COND:%.*]]) local_unnamed_addr #[[ATTR0]] {
+; O3-NEXT:    ret i32 7
+;
+  %x = select i1 %cond, i32 -1, i32 1
+  %r = call i32 @masked_remainder(i32 %x)
+  ret i32 %r
+}
+
+define internal i32 @masked_remainder(i32 %x) {
+; CHECK-LABEL: define internal range(i32 -2147483647, 8) i32 @masked_remainder(
+; CHECK-SAME: i32 [[X:%.*]]) {
+; CHECK-NEXT:    [[R:%.*]] = srem i32 -2147483648, [[X]]
+; CHECK-NEXT:    [[MASKED:%.*]] = select i1 true, i32 7, i32 [[R]]
+; CHECK-NEXT:    ret i32 [[MASKED]]
+;
+  %r = srem i32 -2147483648, %x
+  %masked = select i1 true, i32 7, i32 %r
+  ret i32 %masked
+}
+
+declare i32 @unknown(i32)
+declare void @throw_invalid() noreturn
+declare i8 @llvm.vector.reduce.or.v8i8(<8 x i8>)
