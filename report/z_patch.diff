diff --git a/llvm/test/Transforms/AggressiveInstCombine/trunc_umin_umax.ll b/llvm/test/Transforms/AggressiveInstCombine/trunc_umin_umax.ll
new file mode 100644
index 0000000000000..637f1589a9ce5
--- /dev/null
+++ b/llvm/test/Transforms/AggressiveInstCombine/trunc_umin_umax.ll
@@ -0,0 +1,122 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt < %s -passes=aggressive-instcombine -S | FileCheck %s
+
+target datalayout = "n8:16:32:64"
+
+define i8 @umin_straight(i8 %a) {
+; CHECK-LABEL: @umin_straight(
+; CHECK-NEXT:    [[MIN:%.*]] = call i8 @llvm.umin.i8(i8 [[A:%.*]], i8 -1)
+; CHECK-NEXT:    ret i8 [[MIN]]
+;
+  %ext = zext i8 %a to i32;
+  %min = call i32 @llvm.umin.i32(i32 %ext, i32 255)
+  %ret = trunc i32 %min to i8
+  ret i8 %ret
+}
+
+define i8 @umax_straight(i8 %a) {
+; CHECK-LABEL: @umax_straight(
+; CHECK-NEXT:    [[MIN:%.*]] = call i8 @llvm.umax.i8(i8 [[A:%.*]], i8 10)
+; CHECK-NEXT:    ret i8 [[MIN]]
+;
+  %ext = zext i8 %a to i32;
+  %max = call i32 @llvm.umax.i32(i32 %ext, i32 10)
+  %ret = trunc i32 %max to i8
+  ret i8 %ret
+}
+
+define i8 @clamp_straight(i8 %a) {
+; CHECK-LABEL: @clamp_straight(
+; CHECK-NEXT:    [[MIN:%.*]] = call i8 @llvm.umin.i8(i8 -1, i8 [[A:%.*]])
+; CHECK-NEXT:    [[MAX:%.*]] = call i8 @llvm.umax.i8(i8 10, i8 [[MIN]])
+; CHECK-NEXT:    ret i8 [[MAX]]
+;
+  %ext = zext i8 %a to i32;
+  %min = call i32 @llvm.umin.i32(i32 255, i32 %ext)
+  %max = call i32 @llvm.umax.i32(i32 10, i32 %min)
+  %ret = trunc i32 %max to i8
+  ret i8 %ret
+}
+
+; Check narrowing the type to a larger type than the `trunc`s target.
+; This requires the `datalayout` declaration as when selecting the smallest
+; type that we only consider legal types.
+; (The "smallest legal type" check is not umin/umax specific)
+define i8 @clamp_straight_larger_than_trunc(i8 %a) {
+; CHECK-LABEL: @clamp_straight_larger_than_trunc(
+; CHECK-NEXT:    [[MIN:%.*]] = call i8 @llvm.umin.i8(i8 -1, i8 [[A:%.*]])
+; CHECK-NEXT:    [[MAX:%.*]] = call i8 @llvm.umax.i8(i8 10, i8 [[MIN]])
+; CHECK-NEXT:    ret i8 [[MAX]]
+;
+  %ext = zext i8 %a to i32;
+  %min = call i32 @llvm.umin.i32(i32 255, i32 %ext)
+  %max = call i32 @llvm.umax.i32(i32 10, i32 %min)
+  %ret = trunc i32 %max to i8
+  ret i8 %ret
+}
+
+define i8 @umin_loop(ptr %src) {
+; CHECK-LABEL: @umin_loop(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    [[R:%.*]] = phi i8 [ -1, [[ENTRY:%.*]] ], [ [[IV_NEXT:%.*]], [[LOOP]] ]
+; CHECK-NEXT:    [[IDX:%.*]] = phi i64 [ 0, [[ENTRY]] ], [ [[IDX_NEXT:%.*]], [[LOOP]] ]
+; CHECK-NEXT:    [[LOAD:%.*]] = load i8, ptr [[SRC:%.*]], align 1
+; CHECK-NEXT:    [[IV_NEXT]] = call i8 @llvm.umin.i8(i8 [[R]], i8 [[LOAD]])
+; CHECK-NEXT:    [[IDX_NEXT]] = add i64 [[IDX]], 1
+; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[IDX_NEXT]], 10
+; CHECK-NEXT:    br i1 [[CMP]], label [[LOOP]], label [[EXIT:%.*]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret i8 [[R]]
+;
+entry:
+  br label %loop
+
+loop:
+  %iv = phi i64 [ 255, %entry ], [ %iv.next, %loop ]
+  %idx = phi i64 [ 0, %entry ], [ %idx.next, %loop ]
+  %load = load i8, ptr %src
+  %load.ext = zext i8 %load to i64
+  %iv.next = call i64 @llvm.umin.i64(i64 %iv, i64 %load.ext)
+  %idx.next = add i64 %idx, 1
+  %cmp = icmp ult i64 %idx.next, 10
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  %r = trunc i64 %iv to i8
+  ret i8 %r
+}
+
+define i8 @umax_loop(ptr %src) {
+; CHECK-LABEL: @umax_loop(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    [[IV:%.*]] = phi i8 [ 0, [[ENTRY:%.*]] ], [ [[IV_NEXT:%.*]], [[LOOP]] ]
+; CHECK-NEXT:    [[IDX:%.*]] = phi i64 [ 0, [[ENTRY]] ], [ [[IDX_NEXT:%.*]], [[LOOP]] ]
+; CHECK-NEXT:    [[LOAD:%.*]] = load i8, ptr [[SRC:%.*]], align 1
+; CHECK-NEXT:    [[IV_NEXT]] = call i8 @llvm.umax.i8(i8 [[IV]], i8 [[LOAD]])
+; CHECK-NEXT:    [[IDX_NEXT]] = add i64 [[IDX]], 1
+; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i64 [[IDX_NEXT]], 10
+; CHECK-NEXT:    br i1 [[CMP]], label [[LOOP]], label [[EXIT:%.*]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret i8 [[IV]]
+;
+entry:
+  br label %loop
+
+loop:
+  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
+  %idx = phi i64 [ 0, %entry ], [ %idx.next, %loop ]
+  %load = load i8, ptr %src
+  %load.ext = zext i8 %load to i64
+  %iv.next = call i64 @llvm.umax.i64(i64 %iv, i64 %load.ext)
+  %idx.next = add i64 %idx, 1
+  %cmp = icmp ult i64 %idx.next, 10
+  br i1 %cmp, label %loop, label %exit
+
+exit:
+  %r = trunc i64 %iv to i8
+  ret i8 %r
+}
