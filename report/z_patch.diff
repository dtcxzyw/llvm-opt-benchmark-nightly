              m_Select(m_Value(Cond), m_Constant(TrueC), m_Constant(FalseC))))
     return nullptr;
 
+  // If this fold is primarily for enabling ConstantFoldLoadFromConstPtr,
+  // then we want to check the same conditions used there for both the true and
+  // false constants.
+  if (Sel->hasNUsesOrMore(3)) {
+    auto *GV = dyn_cast<GlobalVariable>(getUnderlyingObject(TrueC));
+    if (!GV || !GV->isConstant() || !GV->hasDefinitiveInitializer())
+      return nullptr;
+
+    GV = dyn_cast<GlobalVariable>(getUnderlyingObject(FalseC));
+    if (!GV || !GV->isConstant() || !GV->hasDefinitiveInitializer())
+      return nullptr;
+  }
+
   // gep (select Cond, TrueC, FalseC), IndexC --> select Cond, TrueC', FalseC'
   // Propagate 'inbounds' and metadata from existing instructions.
