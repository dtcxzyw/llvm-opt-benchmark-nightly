+define void @goal_extra_pred(i32 %idx) {
+; CHECK-LABEL: define void @goal_extra_pred(
+; CHECK-SAME: i32 [[IDX:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
