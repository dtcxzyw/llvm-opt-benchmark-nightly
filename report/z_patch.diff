+
+; The memset only covers half of the loaded bytes.
+define i64 @memset_partial() {
+; CHECK-LABEL: define i64 @memset_partial() {
+; CHECK-NEXT:    [[A:%.*]] = alloca i64, align 8
+; CHECK-NEXT:    call void @llvm.memset.p0.i64(ptr [[A]], i8 0, i64 4, i1 false)
+; CHECK-NEXT:    call void @callee(ptr [[A]])
+; CHECK-NEXT:    [[L:%.*]] = load i64, ptr [[A]], align 4
+; CHECK-NEXT:    ret i64 [[L]]
+;
+  %a = alloca i64, align 8
+  call void @llvm.memset.p0.i64(ptr %a, i8 0, i64 4, i1 false)
