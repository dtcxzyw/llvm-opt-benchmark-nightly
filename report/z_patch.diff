+; CHECK-NEXT:    [[C:%.*]] = icmp ult i8 [[A]], 4
+; CHECK-NEXT:    br i1 [[C]], label [[IF:%.*]], label [[EXIT:%.*]]
+; CHECK:       if:
+; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i8 [[X]], 4
+; CHECK-NEXT:    ret i1 [[CMP]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret i1 false
+;
+  %a = add i8 %x, -1
+  store i8 %a, ptr %p, align 1
+  %c = icmp ult i8 %a, 4
+  br i1 %c, label %if, label %exit
+
+if:
+  %cmp = icmp ult i8 %x, 4
+  ret i1 %cmp
+
+exit:
+  ret i1 false
+}
