+++ b/llvm/test/Analysis/ScalarEvolution/exit-count-ne-nowrap.ll
@@ -0,0 +1,590 @@
+; NOTE: Assertions have been autogenerated by utils/update_analyze_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -disable-output "-passes=print<scalar-evolution>" -scalar-evolution-classify-expressions=0 < %s 2>&1 | FileCheck %s
+
+; Constant max backedge-taken counts of `IV != RHS` exits of unit-stride IVs.
+; If IV starts at or below RHS, it reaches RHS before it can wrap, so the exit
+; is taken on the same iteration as `IV < RHS` would be, and the ne exit can
+; use the same bound. IV must be known to start at or below RHS on loop entry,
+; or the exit must be the only one and starting above RHS must be UB: the IV
+; cannot wrap and every iteration completes, i.e. the loop has no abnormal
+; exits and no inner cycles.
+
+declare void @may_throw()
+
+; Guard on the pre-incremented IV (%start < %S), exit on the post-incremented
+; IV.
+define void @ne_nsw_guarded(ptr %A, i64 %n, i64 range(i64 0, 4) %start) {
+;
+; CHECK-LABEL: 'ne_nsw_guarded'
+; CHECK-NEXT:  Determining loop execution counts for: @ne_nsw_guarded
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (-1 * %start)<nsw> + (4 smin %n))
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 3
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (-1 * %start)<nsw> + (4 smin %n))
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %S = call i64 @llvm.smin.i64(i64 %n, i64 4)
+  %g = icmp slt i64 %start, %S
+  br i1 %g, label %loop, label %exit
+
+loop:
+  %iv = phi i64 [ %start, %entry ], [ %iv.next, %loop ]
+  %gep = getelementptr i64, ptr %A, i64 %iv
+  store i64 %iv, ptr %gep
+  %iv.next = add nsw i64 %iv, 1
+  %c = icmp ne i64 %iv.next, %S
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Same with slt: the bound the ne exit should match.
+define void @slt_nsw_guarded(ptr %A, i64 %n, i64 range(i64 0, 4) %start) {
+;
+; CHECK-LABEL: 'slt_nsw_guarded'
+; CHECK-NEXT:  Determining loop execution counts for: @slt_nsw_guarded
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (-1 * %start)<nsw> + (4 smin %n))
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 3
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (-1 * %start)<nsw> + (4 smin %n))
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %S = call i64 @llvm.smin.i64(i64 %n, i64 4)
+  %g = icmp slt i64 %start, %S
+  br i1 %g, label %loop, label %exit
+
+loop:
+  %iv = phi i64 [ %start, %entry ], [ %iv.next, %loop ]
+  %gep = getelementptr i64, ptr %A, i64 %iv
+  store i64 %iv, ptr %gep
+  %iv.next = add nsw i64 %iv, 1
+  %c = icmp slt i64 %iv.next, %S
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; No wrap flags needed: starting at or below %S, the IV reaches %S first.
+define void @ne_no_flags_guarded(ptr %A, i64 %n, i64 range(i64 0, 4) %start) {
+;
+; CHECK-LABEL: 'ne_no_flags_guarded'
+; CHECK-NEXT:  Determining loop execution counts for: @ne_no_flags_guarded
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (-1 * %start)<nsw> + (4 smin %n))
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 3
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (-1 * %start)<nsw> + (4 smin %n))
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
+entry:
+  %S = call i64 @llvm.smin.i64(i64 %n, i64 4)
+  %g = icmp slt i64 %start, %S
+  br i1 %g, label %loop, label %exit
+
+loop:
+  %iv = phi i64 [ %start, %entry ], [ %iv.next, %loop ]
+  %gep = getelementptr i64, ptr %A, i64 %iv
+  store i64 %iv, ptr %gep
+  %iv.next = add i64 %iv, 1
+  %c = icmp ne i64 %iv.next, %S
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+define void @ne_nuw_guarded_ult(ptr %A, i64 %n, i64 range(i64 0, 4) %start) {
+;
+; CHECK-LABEL: 'ne_nuw_guarded_ult'
+; CHECK-NEXT:  Determining loop execution counts for: @ne_nuw_guarded_ult
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (-1 * %start)<nsw> + (4 umin %n))
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i64 3
+; CHECK-NEXT:  Loop %loop: symbolic max backedge-taken count is (-1 + (-1 * %start)<nsw> + (4 umin %n))
+; CHECK-NEXT:  Loop %loop: Trip multiple is 1
+;
