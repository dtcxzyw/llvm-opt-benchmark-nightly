diff --git a/llvm/test/Transforms/JumpTableToSwitch/select.ll b/llvm/test/Transforms/JumpTableToSwitch/select.ll
new file mode 100644
index 00000000000000..9626fbf4814e93
--- /dev/null
+++ b/llvm/test/Transforms/JumpTableToSwitch/select.ll
@@ -0,0 +1,44 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -passes=jump-table-to-switch -verify-dom-info -S | FileCheck %s
+
+define i32 @f0() {
+; CHECK-LABEL: define i32 @f0() {
+; CHECK-NEXT:    ret i32 0
+;
+  ret i32 0
+}
+
+define i32 @f1() {
+; CHECK-LABEL: define i32 @f1() {
+; CHECK-NEXT:    ret i32 1
+;
+  ret i32 1
+}
+
+define i32 @select_of_functions(i1 %c) {
+; CHECK-LABEL: define i32 @select_of_functions(
+; CHECK-SAME: i1 [[C:%.*]]) {
+; CHECK-NEXT:    [[FPTR:%.*]] = select i1 [[C]], ptr @f1, ptr @f0
+; CHECK-NEXT:    switch i1 [[C]], label %[[DEFAULT_SWITCH_CASE_UNREACHABLE:.*]] [
+; CHECK-NEXT:      i1 false, label %[[CALL_0:.*]]
+; CHECK-NEXT:      i1 true, label %[[CALL_1:.*]]
+; CHECK-NEXT:    ], !prof [[PROF0:![0-9]+]]
+; CHECK:       [[DEFAULT_SWITCH_CASE_UNREACHABLE]]:
+; CHECK-NEXT:    unreachable
+; CHECK:       [[CALL_0]]:
+; CHECK-NEXT:    [[TMP1:%.*]] = call i32 @f0()
+; CHECK-NEXT:    br label %[[DOTTAIL:.*]]
+; CHECK:       [[CALL_1]]:
+; CHECK-NEXT:    [[TMP2:%.*]] = call i32 @f1()
+; CHECK-NEXT:    br label %[[DOTTAIL]]
+; CHECK:       [[DOTTAIL]]:
+; CHECK-NEXT:    [[TMP3:%.*]] = phi i32 [ [[TMP1]], %[[CALL_0]] ], [ [[TMP2]], %[[CALL_1]] ]
+; CHECK-NEXT:    ret i32 [[TMP3]]
+;
+  %fptr = select i1 %c, ptr @f1, ptr @f0
+  %result = call i32 %fptr()
+  ret i32 %result
+}
+;.
+; CHECK: [[PROF0]] = !{!"unknown", !"jump-table-to-switch"}
+;.
