diff --git a/llvm/lib/Transforms/Vectorize/VectorCombine.cpp b/llvm/lib/Transforms/Vectorize/VectorCombine.cpp
index ff507918b782d6..eec329b4231b87 100644
--- a/llvm/lib/Transforms/Vectorize/VectorCombine.cpp
+++ b/llvm/lib/Transforms/Vectorize/VectorCombine.cpp
@@ -124,6 +124,7 @@ class VectorCombine {
   bool foldBitOpOfCastops(Instruction &I);
   bool foldBitOpOfCastConstant(Instruction &I);
   bool foldBitcastShuffle(Instruction &I);
+  bool foldStoreOfShuffle(Instruction &I);
   bool scalarizeOpOrCmp(Instruction &I);
   bool foldExtractedCmps(Instruction &I);
   bool foldSelectsFromBitcast(Instruction &I);
@@ -1178,6 +1179,122 @@ bool VectorCombine::foldBitcastShuffle(Instruction &I) {
   return true;
 }
 
+// Try to widen the lane-type of a shuffle by combining adjacent groups of
+// smaller elements. For example, the following selects every other 4-bytes:
+//
+// load <64 x i4>
+// shuffle [0..7, 16..23, 32..39, 48..55]
+// store <32 x i4>
+//
+// But this won't lead to good codegen for a target that doesn't support a
+// native i4. SelectionDAG lowers to individual i4 extract_elements. Try to
+// fold this to:
+
+// load <8 x i32>
+// shuffle [0, 2, 4, 6]
+// store <4 x i32>
+bool VectorCombine::foldStoreOfShuffle(Instruction &I) {
+  auto *Store = cast<StoreInst>(&I);
+  if (!Store->isSimple())
+    return false;
+
+  Value *V0, *V1;
+  ArrayRef<int> Mask;
+  auto Load = m_OneUse(m_LoadSimple(m_Value()));
+  auto LoadOrUndef = m_CombineOr(Load, m_UndefValue());
+  // Selecting a store(shuffle(load)) sequence.
+  if (!match(Store->getValueOperand(),
+             m_OneUse(m_Shuffle(m_Value(V0, Load), m_Value(V1, LoadOrUndef),
+                                m_Mask(Mask)))))
+    return false;
+  auto *SrcTy = dyn_cast<FixedVectorType>(V0->getType());
+  if (!SrcTy || !SrcTy->getElementType()->isIntegerTy())
+    return false;
+
+  bool IsUnary = isa<UndefValue>(V1);
+  SmallVector<LoadInst *, 2> Loads = {cast<LoadInst>(V0)};
+  if (!IsUnary)
+    Loads.push_back(cast<LoadInst>(V1));
+
+  auto *DstTy = cast<FixedVectorType>(Store->getValueOperand()->getType());
+  TTI::ShuffleKind SK =
+      IsUnary ? TTI::SK_PermuteSingleSrc : TTI::SK_PermuteTwoSrc;
+  // Get the target's cost of the store(shuffle(load)) sequence, given vector
+  // types and a shuffle mask.
+  auto getCost = [&](VectorType *LoadedTy, VectorType *StoredTy,
+                     ArrayRef<int> ShuffleMask) {
+    InstructionCost Cost =
+        TTI.getMemoryOpCost(Instruction::Store, StoredTy, Store->getAlign(),
+                            Store->getPointerAddressSpace(), CostKind);
+    for (LoadInst *Load : Loads)
+      Cost += TTI.getMemoryOpCost(Instruction::Load, LoadedTy, Load->getAlign(),
+                                  Load->getPointerAddressSpace(), CostKind);
+    return Cost +
+           TTI.getShuffleCost(SK, StoredTy, LoadedTy, CostKind, ShuffleMask);
+  };
+
+  InstructionCost BestCost = getCost(SrcTy, DstTy, Mask);
+  if (!BestCost.isValid())
+    return false;
+
+  unsigned EltBits = SrcTy->getScalarSizeInBits();
+  FixedVectorType *WideSrcTy = nullptr;
+  SmallVector<int, 16> WideMask;
+
+  // Now try to widen the element type, starting at the largest legal integer
+  // type for the target, and decreasing. The new element type size must have a
+  // whole-byte width, contain a whole number of original elements, and divide
+  // both the source and dest vectors' total bit width.
+  for (unsigned Bits = DL->getLargestLegalIntTypeSizeInBits();
+       Bits >= 8 && Bits > EltBits; Bits /= 2) {
+    if (Bits % 8 || Bits % EltBits || SrcTy->getPrimitiveSizeInBits() % Bits ||
+        DstTy->getPrimitiveSizeInBits() % Bits)
+      continue;
+    // The new element type must be legal.
+    auto *EltTy = IntegerType::get(I.getContext(), Bits);
+    if (!TTI.isTypeLegal(EltTy))
+      continue;
+    // Make sure the shuffle can operate on the larger element type.
+    SmallVector<int, 16> NewMask;
+    if (!widenShuffleMaskElts(Bits / EltBits, Mask, NewMask))
+      continue;
+    auto *NewSrcTy =
+        FixedVectorType::get(EltTy, SrcTy->getPrimitiveSizeInBits() / Bits);
+    auto *NewDstTy = FixedVectorType::get(EltTy, NewMask.size());
+    // Is performing the store(shuffle(load)) on the wider element type cheaper?
+    InstructionCost NewCost = getCost(NewSrcTy, NewDstTy, NewMask);
+    if (!NewCost.isValid() || NewCost >= BestCost)
+      continue;
+    BestCost = NewCost;
+    WideSrcTy = NewSrcTy;
+    WideMask = std::move(NewMask);
+  }
+  if (!WideSrcTy)
+    return false;
+
+  SmallVector<Value *, 2> WideLoads;
+  for (LoadInst *Load : Loads) {
+    IRBuilderBase::InsertPointGuard Guard(Builder);
+    Builder.SetInsertPoint(Load);
+    auto *WideLoad = Builder.CreateLoad(WideSrcTy, Load->getPointerOperand(),
+                                        Load->getProperties());
+    copyMetadataForLoad(*WideLoad, *Load);
+    WideLoad->takeName(Load);
+    WideLoads.push_back(WideLoad);
+  }
+  // Preserve undef versus poison when retyping the second operand.
+  if (IsUnary)
+    WideLoads.push_back(Builder.CreateBitCast(V1, WideSrcTy));
+  Value *WideShuffle =
+      Builder.CreateShuffleVector(WideLoads[0], WideLoads[1], WideMask);
+  auto *OldShuffle = cast<Instruction>(Store->getValueOperand());
+  if (auto *NewShuffle = dyn_cast<Instruction>(WideShuffle))
+    NewShuffle->takeName(OldShuffle);
+  Store->setOperand(0, WideShuffle);
+  Worklist.push(OldShuffle);
+  return true;
+}
+
 /// Match a vector op/compare/intrinsic with at least one
 /// inserted scalar operand and convert to scalar op/cmp/intrinsic followed
 /// by insertelement.
@@ -7061,6 +7178,10 @@ bool VectorCombine::run() {
     if (TryEarlyFoldsOnly)
       return false;
 
+    if (Opcode == Instruction::Store)
+      if (foldStoreOfShuffle(I))
+        return true;
+
     if (Opcode == Instruction::Call)
       if (foldBitOrderReverseAndSwap(I))
         return true;
diff --git a/llvm/test/CodeGen/NVPTX/shuffle-packed.ll b/llvm/test/CodeGen/NVPTX/shuffle-packed.ll
new file mode 100644
index 00000000000000..d1fad3060ad655
--- /dev/null
+++ b/llvm/test/CodeGen/NVPTX/shuffle-packed.ll
@@ -0,0 +1,70 @@
+; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
+; RUN: opt -O3 -mtriple=nvptx64 -mcpu=sm_90 < %s | llc -mcpu=sm_90 -mattr=+ptx87 -verify-machineinstrs | FileCheck %s --check-prefix=SM90
+; RUN: opt -O3 -mtriple=nvptx64 -mcpu=sm_100 < %s | llc -mcpu=sm_100 -mattr=+ptx88 -verify-machineinstrs | FileCheck %s --check-prefix=SM100
+
+target datalayout = "e-p:64:64:64-p3:32:32:32-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-i128:128:128-f32:32:32-f64:64:64-v16:16:16-v32:32:32-v64:64:64-v128:128:128-n16:32:64"
+target triple = "nvptx64-nvidia-cuda"
+
+
+define ptx_kernel void @k(ptr addrspace(1) %src, ptr addrspace(1) %dst, i32 %c) {
+; SM90-LABEL: k(
+; SM90:       {
+; SM90-NEXT:    .reg .pred %p<2>;
+; SM90-NEXT:    .reg .b32 %r<6>;
+; SM90-NEXT:    .reg .b64 %rd<6>;
+; SM90-EMPTY:
+; SM90-NEXT:  // %bb.0: // %entry
+; SM90-NEXT:    ld.param::entry.b64 %rd1, [k_param_1];
+; SM90-NEXT:    ld.param::entry.b64 %rd2, [k_param_0];
+; SM90-NEXT:    ld.global.b32 %r4, [%rd2+24];
+; SM90-NEXT:    ld.global.b64 %rd3, [%rd2+16];
+; SM90-NEXT:    cvt.u32.u64 %r3, %rd3;
+; SM90-NEXT:    ld.global.b64 %rd4, [%rd2+8];
+; SM90-NEXT:    cvt.u32.u64 %r2, %rd4;
+; SM90-NEXT:    ld.global.b64 %rd5, [%rd2];
+; SM90-NEXT:    cvt.u32.u64 %r1, %rd5;
+; SM90-NEXT:    ld.param::entry.b32 %r5, [k_param_2];
+; SM90-NEXT:    setp.ne.b32 %p1, %r5, 0;
+; SM90-NEXT:    @%p1 bra $L__BB0_2;
+; SM90-NEXT:  // %bb.1: // %side
+; SM90-NEXT:    st.volatile.global.b32 [%rd1+256], 0;
+; SM90-NEXT:  $L__BB0_2: // %next
+; SM90-NEXT:    st.global.v4.b32 [%rd1], {%r1, %r2, %r3, %r4};
+; SM90-NEXT:    ret;
+;
+; SM100-LABEL: k(
+; SM100:       {
+; SM100-NEXT:    .reg .pred %p<2>;
+; SM100-NEXT:    .reg .b32 %r<9>;
+; SM100-NEXT:    .reg .b64 %rd<3>;
+; SM100-EMPTY:
+; SM100-NEXT:  // %bb.0: // %entry
+; SM100-NEXT:    ld.param::entry.b64 %rd1, [k_param_1];
+; SM100-NEXT:    ld.param::entry.b64 %rd2, [k_param_0];
+; SM100-NEXT:    ld.global.b32 %r7, [%rd2+24];
+; SM100-NEXT:    ld.global.v2.b32 {%r5, %r6}, [%rd2+16];
+; SM100-NEXT:    ld.global.v2.b32 {%r3, %r4}, [%rd2+8];
+; SM100-NEXT:    ld.global.v2.b32 {%r1, %r2}, [%rd2];
+; SM100-NEXT:    ld.param::entry.b32 %r8, [k_param_2];
+; SM100-NEXT:    setp.ne.b32 %p1, %r8, 0;
+; SM100-NEXT:    @%p1 bra $L__BB0_2;
+; SM100-NEXT:  // %bb.1: // %side
+; SM100-NEXT:    st.volatile.global.b32 [%rd1+256], 0;
+; SM100-NEXT:  $L__BB0_2: // %next
+; SM100-NEXT:    st.global.v4.b32 [%rd1], {%r1, %r3, %r5, %r7};
+; SM100-NEXT:    ret;
+entry:
+  %w = load <8 x i32>, ptr addrspace(1) %src, align 32
+  %a = bitcast <8 x i32> %w to <64 x i4>
+  %v = shufflevector <64 x i4> %a, <64 x i4> poison, <32 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 16, i32 17, i32 18, i32 19, i32 20, i32 21, i32 22, i32 23, i32 32, i32 33, i32 34, i32 35, i32 36, i32 37, i32 38, i32 39, i32 48, i32 49, i32 50, i32 51, i32 52, i32 53, i32 54, i32 55>
+  %t = icmp eq i32 %c, 0
+  br i1 %t, label %side, label %next
+side:
+  %ps = getelementptr i8, ptr addrspace(1) %dst, i64 256
+  store volatile i32 0, ptr addrspace(1) %ps, align 4
+  br label %next
+next:
+  %b = bitcast <32 x i4> %v to <16 x i8>
+  store <16 x i8> %b, ptr addrspace(1) %dst, align 16
+  ret void
+}
