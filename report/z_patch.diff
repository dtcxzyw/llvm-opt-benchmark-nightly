index 0000000000000..78e4552ec85b8
--- /dev/null
+++ b/llvm/test/Transforms/SimplifyCFG/X86/switch-to-lookup-unsigned-range.ll
@@ -0,0 +1,289 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --check-globals
+; RUN: opt < %s -passes='simplifycfg<switch-to-lookup>' -S -mtriple=x86_64-unknown-linux-gnu | FileCheck %s
+
+target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v64:64:64-v128:128:128-a0:0:64-s0:64:64-f80:128:128-n8:16:32:64-S128"
+target triple = "x86_64-unknown-linux-gnu"
+
+; A switch only compares its condition for equality, so a lookup table can be
+; laid out over the unsigned range of the case values whenever that is narrower
+; than the signed one. This happens once the switch condition has been narrowed
+; to the smallest type holding all case values (InstCombine does this), which
+; wraps the top of a contiguous unsigned range around to the negative side of
+; the narrowed type. The i4 switches below stand in for the narrowed condition.
+
+; A contiguous unsigned range starting at zero indexes the table directly,
+; rather than through an offset of the signed minimum.
+;.
+; CHECK: @switch.table.contiguous_from_zero = private unnamed_addr constant [10 x i8] c"\02\0C$J~\C0\15s\DF^", align 4
+; CHECK: @switch.table.keep_covering_signed_range = private unnamed_addr constant [16 x i8] c"\E0_******\03\0D%K\7F\C1\16t", align 4
+; CHECK: @switch.table.unsigned_range_straddles_sign_boundary = private unnamed_addr constant [8 x i8] c"\04\0E&L\80\C2\17u", align 4
+; CHECK: @switch.table.unsigned_range_unreachable_default = private unnamed_addr constant [8 x i8] c"\05\0F'M\81\C3\18v", align 4
+; CHECK: @switch.table.signed_range_is_narrower = private unnamed_addr constant [8 x i8] c"\06\10(N\82\C4\19w", align 4
+;.
+define i32 @contiguous_from_zero(i4 %c) {
+; CHECK-LABEL: @contiguous_from_zero(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[TMP0:%.*]] = zext i4 [[C:%.*]] to i64
+; CHECK-NEXT:    [[SWITCH_GEP:%.*]] = getelementptr inbounds [10 x i8], ptr @switch.table.contiguous_from_zero, i64 0, i64 [[TMP0]]
+; CHECK-NEXT:    [[SWITCH_LOAD:%.*]] = load i8, ptr [[SWITCH_GEP]], align 1
+; CHECK-NEXT:    [[SWITCH_EXT:%.*]] = zext i8 [[SWITCH_LOAD]] to i32
+; CHECK-NEXT:    ret i32 [[SWITCH_EXT]]
+;
+entry:
+  switch i4 %c, label %sw.default [
+  i4 0, label %sw.bb0
+  i4 1, label %sw.bb1
+  i4 2, label %sw.bb2
+  i4 3, label %sw.bb3
+  i4 4, label %sw.bb4
+  i4 5, label %sw.bb5
+  i4 6, label %sw.bb6
+  i4 7, label %sw.bb7
+  i4 -8, label %sw.bb8
+  i4 -7, label %sw.bb9
+  ]
+
+sw.bb0:
+  br label %return
+sw.bb1:
+  br label %return
+sw.bb2:
+  br label %return
+sw.bb3:
+  br label %return
+sw.bb4:
+  br label %return
+sw.bb5:
+  br label %return
+sw.bb6:
+  br label %return
+sw.bb7:
+  br label %return
+sw.bb8:
+  br label %return
+sw.bb9:
+  br label %return
+
+sw.default:
+  unreachable
+
+return:
+  %retval = phi i32 [ 2, %sw.bb0 ], [ 12, %sw.bb1 ], [ 36, %sw.bb2 ], [ 74, %sw.bb3 ], [ 126, %sw.bb4 ], [ 192, %sw.bb5 ], [ 21, %sw.bb6 ], [ 115, %sw.bb7 ], [ 223, %sw.bb8 ], [ 94, %sw.bb9 ]
+  ret i32 %retval
+}
+
+; Same case values, but with a reachable default: the wider signed range
+; covers every value of the condition's type and so needs no range check,
+; which is worth more than the smaller table.
+define i32 @keep_covering_signed_range(i4 %c) {
+; CHECK-LABEL: @keep_covering_signed_range(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[SWITCH_TABLEIDX:%.*]] = sub i4 [[C:%.*]], -8
+; CHECK-NEXT:    [[TMP0:%.*]] = zext i4 [[SWITCH_TABLEIDX]] to i64
+; CHECK-NEXT:    [[SWITCH_GEP:%.*]] = getelementptr inbounds [16 x i8], ptr @switch.table.keep_covering_signed_range, i64 0, i64 [[TMP0]]
+; CHECK-NEXT:    [[SWITCH_LOAD:%.*]] = load i8, ptr [[SWITCH_GEP]], align 1
+; CHECK-NEXT:    [[SWITCH_EXT:%.*]] = zext i8 [[SWITCH_LOAD]] to i32
+; CHECK-NEXT:    ret i32 [[SWITCH_EXT]]
+;
+entry:
+  switch i4 %c, label %sw.default [
+  i4 0, label %sw.bb0
+  i4 1, label %sw.bb1
+  i4 2, label %sw.bb2
+  i4 3, label %sw.bb3
+  i4 4, label %sw.bb4
+  i4 5, label %sw.bb5
+  i4 6, label %sw.bb6
+  i4 7, label %sw.bb7
+  i4 -8, label %sw.bb8
+  i4 -7, label %sw.bb9
+  ]
+
+sw.bb0:
+  br label %return
+sw.bb1:
+  br label %return
+sw.bb2:
+  br label %return
+sw.bb3:
+  br label %return
+sw.bb4:
+  br label %return
+sw.bb5:
+  br label %return
+sw.bb6:
+  br label %return
+sw.bb7:
+  br label %return
+sw.bb8:
+  br label %return
+sw.bb9:
+  br label %return
+
+sw.default:
+  br label %return
+
+return:
+  %retval = phi i32 [ 3, %sw.bb0 ], [ 13, %sw.bb1 ], [ 37, %sw.bb2 ], [ 75, %sw.bb3 ], [ 127, %sw.bb4 ], [ 193, %sw.bb5 ], [ 22, %sw.bb6 ], [ 116, %sw.bb7 ], [ 224, %sw.bb8 ], [ 95, %sw.bb9 ], [ 42, %sw.default ]
+  ret i32 %retval
+}
+
+; An unsigned range straddling the sign boundary is offset by its unsigned
+; minimum. The signed range would span all 256 values and be too sparse to
+; be worth a table at all.
+define i32 @unsigned_range_straddles_sign_boundary(i8 %c) {
+; CHECK-LABEL: @unsigned_range_straddles_sign_boundary(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[SWITCH_TABLEIDX:%.*]] = sub i8 [[C:%.*]], 124
+; CHECK-NEXT:    [[TMP0:%.*]] = icmp ult i8 [[SWITCH_TABLEIDX]], 8
+; CHECK-NEXT:    br i1 [[TMP0]], label [[SWITCH_LOOKUP:%.*]], label [[RETURN:%.*]]
+; CHECK:       switch.lookup:
+; CHECK-NEXT:    [[TMP1:%.*]] = zext nneg i8 [[SWITCH_TABLEIDX]] to i64
+; CHECK-NEXT:    [[SWITCH_GEP:%.*]] = getelementptr inbounds [8 x i8], ptr @switch.table.unsigned_range_straddles_sign_boundary, i64 0, i64 [[TMP1]]
+; CHECK-NEXT:    [[SWITCH_LOAD:%.*]] = load i8, ptr [[SWITCH_GEP]], align 1
+; CHECK-NEXT:    [[SWITCH_EXT:%.*]] = zext i8 [[SWITCH_LOAD]] to i32
+; CHECK-NEXT:    br label [[RETURN]]
+; CHECK:       return:
+; CHECK-NEXT:    [[RETVAL:%.*]] = phi i32 [ [[SWITCH_EXT]], [[SWITCH_LOOKUP]] ], [ 42, [[ENTRY:%.*]] ]
+; CHECK-NEXT:    ret i32 [[RETVAL]]
+;
+entry:
+  switch i8 %c, label %sw.default [
+  i8 124, label %sw.bb0
+  i8 125, label %sw.bb1
+  i8 126, label %sw.bb2
+  i8 127, label %sw.bb3
+  i8 -128, label %sw.bb4
+  i8 -127, label %sw.bb5
+  i8 -126, label %sw.bb6
+  i8 -125, label %sw.bb7
+  ]
+
+sw.bb0:
+  br label %return
+sw.bb1:
+  br label %return
+sw.bb2:
+  br label %return
+sw.bb3:
+  br label %return
+sw.bb4:
+  br label %return
+sw.bb5:
+  br label %return
+sw.bb6:
+  br label %return
+sw.bb7:
+  br label %return
+
+sw.default:
+  br label %return
+
+return:
+  %retval = phi i32 [ 4, %sw.bb0 ], [ 14, %sw.bb1 ], [ 38, %sw.bb2 ], [ 76, %sw.bb3 ], [ 128, %sw.bb4 ], [ 194, %sw.bb5 ], [ 23, %sw.bb6 ], [ 117, %sw.bb7 ], [ 42, %sw.default ]
+  ret i32 %retval
+}
+
+; With an unreachable default the condition is known to be u>= the unsigned
+; minimum, so the offsetting subtraction gets nuw.
+define i32 @unsigned_range_unreachable_default(i8 %c) {
+; CHECK-LABEL: @unsigned_range_unreachable_default(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[SWITCH_TABLEIDX:%.*]] = sub nuw i8 [[C:%.*]], 124
+; CHECK-NEXT:    [[TMP0:%.*]] = zext nneg i8 [[SWITCH_TABLEIDX]] to i64
+; CHECK-NEXT:    [[SWITCH_GEP:%.*]] = getelementptr inbounds [8 x i8], ptr @switch.table.unsigned_range_unreachable_default, i64 0, i64 [[TMP0]]
+; CHECK-NEXT:    [[SWITCH_LOAD:%.*]] = load i8, ptr [[SWITCH_GEP]], align 1
+; CHECK-NEXT:    [[SWITCH_EXT:%.*]] = zext i8 [[SWITCH_LOAD]] to i32
+; CHECK-NEXT:    ret i32 [[SWITCH_EXT]]
+;
+entry:
+  switch i8 %c, label %sw.default [
+  i8 124, label %sw.bb0
+  i8 125, label %sw.bb1
+  i8 126, label %sw.bb2
+  i8 127, label %sw.bb3
+  i8 -128, label %sw.bb4
+  i8 -127, label %sw.bb5
+  i8 -126, label %sw.bb6
+  i8 -125, label %sw.bb7
+  ]
+
+sw.bb0:
+  br label %return
+sw.bb1:
+  br label %return
+sw.bb2:
+  br label %return
+sw.bb3:
+  br label %return
+sw.bb4:
+  br label %return
+sw.bb5:
+  br label %return
+sw.bb6:
+  br label %return
+sw.bb7:
+  br label %return
+
+sw.default:
+  unreachable
+
+return:
+  %retval = phi i32 [ 5, %sw.bb0 ], [ 15, %sw.bb1 ], [ 39, %sw.bb2 ], [ 77, %sw.bb3 ], [ 129, %sw.bb4 ], [ 195, %sw.bb5 ], [ 24, %sw.bb6 ], [ 118, %sw.bb7 ]
+  ret i32 %retval
+}
+
+; The signed range is the narrower one here, so the table stays laid out over
+; it.
+define i32 @signed_range_is_narrower(i8 %c) {
+; CHECK-LABEL: @signed_range_is_narrower(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[SWITCH_TABLEIDX:%.*]] = sub i8 [[C:%.*]], -4
+; CHECK-NEXT:    [[TMP0:%.*]] = icmp ult i8 [[SWITCH_TABLEIDX]], 8
+; CHECK-NEXT:    br i1 [[TMP0]], label [[SWITCH_LOOKUP:%.*]], label [[RETURN:%.*]]
+; CHECK:       switch.lookup:
+; CHECK-NEXT:    [[TMP1:%.*]] = zext nneg i8 [[SWITCH_TABLEIDX]] to i64
+; CHECK-NEXT:    [[SWITCH_GEP:%.*]] = getelementptr inbounds [8 x i8], ptr @switch.table.signed_range_is_narrower, i64 0, i64 [[TMP1]]
+; CHECK-NEXT:    [[SWITCH_LOAD:%.*]] = load i8, ptr [[SWITCH_GEP]], align 1
+; CHECK-NEXT:    [[SWITCH_EXT:%.*]] = zext i8 [[SWITCH_LOAD]] to i32
+; CHECK-NEXT:    br label [[RETURN]]
+; CHECK:       return:
+; CHECK-NEXT:    [[RETVAL:%.*]] = phi i32 [ [[SWITCH_EXT]], [[SWITCH_LOOKUP]] ], [ 42, [[ENTRY:%.*]] ]
+; CHECK-NEXT:    ret i32 [[RETVAL]]
+;
+entry:
+  switch i8 %c, label %sw.default [
+  i8 -4, label %sw.bb0
+  i8 -3, label %sw.bb1
+  i8 -2, label %sw.bb2
+  i8 -1, label %sw.bb3
+  i8 0, label %sw.bb4
+  i8 1, label %sw.bb5
+  i8 2, label %sw.bb6
+  i8 3, label %sw.bb7
+  ]
+
+sw.bb0:
+  br label %return
+sw.bb1:
+  br label %return
+sw.bb2:
+  br label %return
+sw.bb3:
+  br label %return
+sw.bb4:
+  br label %return
+sw.bb5:
+  br label %return
+sw.bb6:
+  br label %return
+sw.bb7:
+  br label %return
+
+sw.default:
+  br label %return
+
+return:
+  %retval = phi i32 [ 6, %sw.bb0 ], [ 16, %sw.bb1 ], [ 40, %sw.bb2 ], [ 78, %sw.bb3 ], [ 130, %sw.bb4 ], [ 196, %sw.bb5 ], [ 25, %sw.bb6 ], [ 119, %sw.bb7 ], [ 42, %sw.default ]
