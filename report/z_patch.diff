+/// Clone the instructions \p Insts of \p BB into \p Succs, the unique
+/// successors of \p BB, which must only be reachable through \p BB.
+///
+/// \p Insts must be generated by `blockCheapToDupliateInSuccessors` so that we
+/// know that it includes all of the cloned block except pseudo probes and the
+/// condition variable and we can clone all of the debug records. Debug records
+/// of the dropped instructions are added to the next instruction cloned, or at
+/// the end of the BB if they're at the end.
+static void cloneInstsIntoSuccessors(BasicBlock *BB,
+                                     ArrayRef<BasicBlock *> Succs,
+                                     ArrayRef<Instruction *> Insts,
+                                     AssumptionCache *AC) {
+  Module *M = BB->getModule();
+  for (BasicBlock *Succ : Succs) {
+    assert(Succ->getUniquePredecessor() == BB &&
+           "Successor is reachable without going through BB");
+    ValueToValueMapTy VMap;
+    BasicBlock::iterator InsertPt = Succ->getFirstInsertionPt();
+    BasicBlock::iterator DbgCursor = BB->begin();
+    auto RemapRecords = [&](iterator_range<DbgRecord::self_iterator> Records) {
+      RemapDbgRecordRange(M, Records, VMap,
+                          RF_NoModuleLevelChanges | RF_IgnoreMissingLocals);
+    };
+    for (Instruction *I : Insts) {
+      Instruction *NewI = I->clone();
+      NewI->insertInto(Succ, InsertPt);
+      NewI->setName(I->getName());
+      if (const DebugLoc &DL = I->getDebugLoc())
+        mapAtomInstance(DL, VMap);
+      RemapInstruction(NewI, VMap,
+                       RF_NoModuleLevelChanges | RF_IgnoreMissingLocals);
+      for (; &*DbgCursor != I; ++DbgCursor)
+        RemapRecords(NewI->cloneDebugInfoFrom(&*DbgCursor));
+      RemapRecords(NewI->cloneDebugInfoFrom(I));
+      DbgCursor = std::next(DbgCursor);
+      VMap[I] = NewI;
+      if (auto *Assume = dyn_cast<AssumeInst>(NewI))
+        if (AC)
+          AC->registerAssumption(Assume);
+    }
+    // Clone debug records after the last cloned instruction until the end of
+    // the block.
+    for (auto It = BB->end(); It != DbgCursor;) {
+      --It;
+      RemapRecords(InsertPt->cloneDebugInfoFrom(&*It, std::nullopt,
+                                                /*InsertAtHead=*/true));
+    }
+  }
+
+  uint64_t NumCloned = Insts.size() * Succs.size();
+  ++NumFoldValueComparisonEphemeralClones;
+  NumFoldValueComparisonEphemeralInstsCloned += NumCloned;
+}
