+  auto Trunc = DAG->getNode(ISD::TRUNCATE, Loc, MVT::i16, High);
+  EXPECT_EQ(DAG->ComputeNumSignBits(Trunc), 16u);
+  auto Min = DAG->getNode(ISD::UMIN, Loc, MVT::i32, Small, Y);
+  EXPECT_EQ(DAG->ComputeNumSignBits(Min), 24u);
+}
