diff --git a/llvm/lib/Transforms/InstCombine/InstCombineAndOrXor.cpp b/llvm/lib/Transforms/InstCombine/InstCombineAndOrXor.cpp
index b6f4a55c07e8a..b950b24f636b6 100644
--- a/llvm/lib/Transforms/InstCombine/InstCombineAndOrXor.cpp
+++ b/llvm/lib/Transforms/InstCombine/InstCombineAndOrXor.cpp
@@ -4673,6 +4673,16 @@ Instruction *InstCombinerImpl::visitOr(BinaryOperator &I) {
   if (Value *Res = FoldOrOfSelectSmaxToAbs(I, Builder))
     return replaceInstUsesWith(I, Res);
 
+  // zext(X) | sext(X) --> sext(X)
+  {
+    Value *X = nullptr;
+    if (match(&I, m_c_Or(m_ZExt(m_Value(X)), m_SExt(m_Deferred(X))))) {
+      if (match(Op0, m_SExt(m_Specific(X))))
+        return replaceInstUsesWith(I, Op0);
+      return replaceInstUsesWith(I, Op1);
+    }
+  }
+
   // signum: or (ashr X, BW-1), zext (icmp ne|sgt X, 0) --> scmp(X, 0)
   // The ashr already supplies -1 for negative X, so any predicate that
   // produces 1 for positive X and 0 for X == 0 yields the same result here.
