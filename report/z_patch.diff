+                            m_Deferred(X), m_AnyZeroFP())))
+      return replaceOperand(*II, 0, X);
+
+    // select (fcmp uno X, 0.0), +-0.0, X --> X
+    if (match(Src, m_Select(m_SpecificFCmp(FCmpInst::FCMP_UNO, m_Value(X),
+                                           m_AnyZeroFP()),
+                            m_AnyZeroFP(), m_Deferred(X))))
+      return replaceOperand(*II, 0, X);
     break;
+  }
