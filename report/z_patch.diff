+; sub nuw %x, %y with %x <=u 63 --> the difference is at most 63.
+define i1 @usub_range_from_lhs(i32 %a, i32 %y) {
+; CHECK-LABEL: define i1 @usub_range_from_lhs(
+; CHECK-SAME: i32 [[A:%.*]], i32 [[Y:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[X:%.*]] = and i32 [[A]], 63
+; CHECK-NEXT:    [[WO:%.*]] = call { i32, i1 } @llvm.usub.with.overflow.i32(i32 [[X]], i32 [[Y]])
+; CHECK-NEXT:    [[OV:%.*]] = extractvalue { i32, i1 } [[WO]], 1
+; CHECK-NEXT:    br i1 [[OV]], label %[[ERR:.*]], label %[[OK:.*]]
+; CHECK:       [[OK]]:
+; CHECK-NEXT:    [[V:%.*]] = extractvalue { i32, i1 } [[WO]], 0
+; CHECK-NEXT:    call void @use(i32 [[V]])
+; CHECK-NEXT:    ret i1 false
+; CHECK:       [[ERR]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %x = and i32 %a, 63
+  %wo = call { i32, i1 } @llvm.usub.with.overflow.i32(i32 %x, i32 %y)
+  %ov = extractvalue { i32, i1 } %wo, 1
+  br i1 %ov, label %err, label %ok
+
+ok:
+  %v = extractvalue { i32, i1 } %wo, 0
+  call void @use(i32 %v)
+  %c = icmp ugt i32 %v, 63
+  ret i1 %c
+
+err:
+  ret i1 false
+}
