+; CHECK-NEXT:    br i1 [[PRE]], label %[[EXIT:.*]], label %[[LOOP_PREHEADER:.*]]
+; CHECK:       [[LOOP_PREHEADER]]:
+; CHECK-NEXT:    [[TMP0:%.*]] = add i16 [[START]], 1
+; CHECK-NEXT:    [[TMP1:%.*]] = tail call i16 @llvm.smax.i16(i16 [[N]], i16 [[TMP0]])
+; CHECK-NEXT:    [[TMP2:%.*]] = xor i16 [[START]], -1
+; CHECK-NEXT:    [[TMP3:%.*]] = add i16 [[TMP1]], [[TMP2]]
+; CHECK-NEXT:    [[TMP4:%.*]] = zext i16 [[TMP3]] to i32
+; CHECK-NEXT:    [[TMP5:%.*]] = add nuw nsw i32 [[TMP4]], 1
+; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i16 [[TMP3]], 11
+; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[LOOP_PREHEADER1:.*]], label %[[VECTOR_SCEVCHECK:.*]]
+; CHECK:       [[VECTOR_SCEVCHECK]]:
+; CHECK-NEXT:    [[TMP6:%.*]] = add i16 [[START]], 1
+; CHECK-NEXT:    [[SMAX:%.*]] = tail call i16 @llvm.smax.i16(i16 [[N]], i16 [[TMP6]])
+; CHECK-NEXT:    [[TMP7:%.*]] = sub i16 [[START]], [[V]]
+; CHECK-NEXT:    [[TMP8:%.*]] = sub i16 [[START]], [[SMAX]]
+; CHECK-NEXT:    [[TMP9:%.*]] = icmp ugt i16 [[TMP7]], [[TMP8]]
+; CHECK-NEXT:    br i1 [[TMP9]], label %[[LOOP_PREHEADER1]], label %[[VECTOR_PH:.*]]
+; CHECK:       [[VECTOR_PH]]:
+; CHECK-NEXT:    [[N_VEC:%.*]] = and i32 [[TMP5]], 131068
+; CHECK-NEXT:    [[TMP10:%.*]] = trunc i32 [[N_VEC]] to i16
+; CHECK-NEXT:    [[TMP11:%.*]] = add i16 [[START]], [[TMP10]]
+; CHECK-NEXT:    [[INVARIANT_OP:%.*]] = sub i16 [[START]], [[V]]
+; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
+; CHECK:       [[VECTOR_BODY]]:
+; CHECK-NEXT:    [[INDEX:%.*]] = phi i32 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
+; CHECK-NEXT:    [[TMP12:%.*]] = trunc i32 [[INDEX]] to i16
+; CHECK-NEXT:    [[DOTREASS:%.*]] = add i16 [[TMP12]], [[INVARIANT_OP]]
+; CHECK-NEXT:    [[TMP13:%.*]] = zext nneg i16 [[DOTREASS]] to i64
+; CHECK-NEXT:    [[TMP14:%.*]] = getelementptr inbounds nuw i8, ptr [[A]], i64 [[TMP13]]
+; CHECK-NEXT:    store <4 x i8> splat (i8 1), ptr [[TMP14]], align 1
+; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i32 [[INDEX]], 4
+; CHECK-NEXT:    [[TMP15:%.*]] = icmp eq i32 [[INDEX_NEXT]], [[N_VEC]]
+; CHECK-NEXT:    br i1 [[TMP15]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP0:![0-9]+]]
+; CHECK:       [[MIDDLE_BLOCK]]:
+; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i32 [[TMP5]], [[N_VEC]]
+; CHECK-NEXT:    br i1 [[CMP_N]], label %[[EXIT]], label %[[LOOP_PREHEADER1]]
+; CHECK:       [[LOOP_PREHEADER1]]:
+; CHECK-NEXT:    [[IV_PH:%.*]] = phi i16 [ [[START]], %[[VECTOR_SCEVCHECK]] ], [ [[START]], %[[LOOP_PREHEADER]] ], [ [[TMP11]], %[[MIDDLE_BLOCK]] ]
+; CHECK-NEXT:    br label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i16 [ [[IV_NEXT:%.*]], %[[LOOP]] ], [ [[IV_PH]], %[[LOOP_PREHEADER1]] ]
+; CHECK-NEXT:    [[OFF:%.*]] = sub nsw i16 [[IV]], [[V]]
+; CHECK-NEXT:    [[EXT:%.*]] = zext nneg i16 [[OFF]] to i64
+; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw i8, ptr [[A]], i64 [[EXT]]
+; CHECK-NEXT:    store i8 1, ptr [[GEP]], align 1
+; CHECK-NEXT:    [[IV_NEXT]] = add nsw i16 [[IV]], 1
+; CHECK-NEXT:    [[EC:%.*]] = icmp slt i16 [[IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP]], label %[[EXIT]], !llvm.loop [[LOOP3:![0-9]+]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %pre = icmp slt i16 %start, %v
+  br i1 %pre, label %exit, label %loop
+
+loop:
+  %iv = phi i16 [ %start, %entry ], [ %iv.next, %loop ]
+  %off = sub nsw i16 %iv, %v
+  %ext = sext i16 %off to i64
+  %mask = and i64 %ext, 4294967295
+  %gep = getelementptr inbounds i8, ptr %A, i64 %mask
+  store i8 1, ptr %gep, align 1
+  %iv.next = add nsw i16 %iv, 1
+  %ec = icmp slt i16 %iv.next, %n
+  br i1 %ec, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; The i32 index does not need to be widened to i64 with sext-based address
+; arithmetic: 3 sext and 4 instructions in total are gone.
+define void @index_not_widened(ptr %A, i32 %start, i32 %v, i32 %n) {
+; CHECK-LABEL: define void @index_not_widened(
+; CHECK-SAME: ptr nofree writeonly captures(none) [[A:%.*]], i32 [[START:%.*]], i32 [[V:%.*]], i32 [[N:%.*]]) local_unnamed_addr #[[ATTR0]] {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i32 [[START]], [[V]]
+; CHECK-NEXT:    br i1 [[PRE]], label %[[EXIT:.*]], label %[[LOOP:.*]]
+; CHECK:       [[LOOP]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ [[IV_NEXT:%.*]], %[[LOOP]] ], [ [[START]], %[[ENTRY]] ]
+; CHECK-NEXT:    [[OFF:%.*]] = sub nsw i32 [[IV]], [[V]]
+; CHECK-NEXT:    [[TMP0:%.*]] = zext nneg i32 [[OFF]] to i64
+; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw [4 x i8], ptr [[A]], i64 [[TMP0]]
+; CHECK-NEXT:    store i32 [[IV]], ptr [[GEP]], align 4
+; CHECK-NEXT:    [[IV_NEXT]] = add nsw i32 [[IV]], 1
+; CHECK-NEXT:    [[EC:%.*]] = icmp slt i32 [[IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP]], label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %pre = icmp slt i32 %start, %v
+  br i1 %pre, label %exit, label %loop
+
+loop:
+  %iv = phi i32 [ %start, %entry ], [ %iv.next, %loop ]
+  %off = sub nsw i32 %iv, %v
+  %gep = getelementptr inbounds i32, ptr %A, i32 %off
+  store i32 %iv, ptr %gep, align 4
+  %iv.next = add nsw i32 %iv, 1
+  %ec = icmp slt i32 %iv.next, %n
+  br i1 %ec, label %loop, label %exit
+
+exit:
+  ret void
+}
