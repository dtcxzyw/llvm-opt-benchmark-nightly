+          if (!CastInst::castIsValid(Instruction::BitCast, SI->getType(),
+                                     SI->getType()))
+            continue;
+
+          PredicateSelect *PS = new (Allocator)
+              PredicateSelect(SI, BranchBB, Succ, Cond, TakenEdge, SI);
+          addInfoFor(OpsToRename, SI, PS);
+        }
+      }
     }
   }
 }
