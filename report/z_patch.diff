+; The first nine bits in address order come from the high nine bits of %x.
+define void @low_nine_bits(ptr %p, ptr noalias %q, i16 %x) {
+; CHECK-LABEL: define void @low_nine_bits(
+; CHECK-SAME: ptr [[P:%.*]], ptr noalias [[Q:%.*]], i16 [[X:%.*]]) {
+; CHECK-NEXT:    [[OLD:%.*]] = load i16, ptr [[P]], align 2
