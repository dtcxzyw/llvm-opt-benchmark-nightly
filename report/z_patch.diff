+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i16 [[ADD]], [[Z]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
+; CHECK-NEXT:    ret i1 true
+;
+entry:
+  %add = add nsw i16 %x, %y
+  %add.3 = add nuw i16 %add, 3
+  %c = icmp ugt i16 %add, %z
+  call void @llvm.assume(i1 %c)
+  %t = icmp ugt i16 %add.3, %z
+  ret i1 %t
+}
+
+; Same as @outer_offset_retained, but with the opaque expression nested deeper
