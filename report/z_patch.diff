diff --git a/llvm/test/Transforms/SimplifyCFG/thread-loop-header-latch-to-exit.ll b/llvm/test/Transforms/SimplifyCFG/thread-loop-header-latch-to-exit.ll
new file mode 100644
index 00000000000000..0fcc18614b7972
--- /dev/null
+++ b/llvm/test/Transforms/SimplifyCFG/thread-loop-header-latch-to-exit.ll
@@ -0,0 +1,62 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -passes=simplifycfg -simplifycfg-require-and-preserve-domtree=1 --keep-loops="true" -S | FileCheck %s
+
+; Threading the latch edge to %exit does not bypass the header.
+define void @trip_count_one(ptr %p) {
+; CHECK-LABEL: define void @trip_count_one(
+; CHECK-SAME: ptr [[P:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    store i32 0, ptr [[P]], align 4
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %header
+
+header:
+  %first = phi i1 [ true, %entry ], [ false, %latch ]
+  br i1 %first, label %body, label %exit
+
+body:
+  store i32 0, ptr %p, align 4
+  br label %latch
+
+latch:
+  br label %header
+
+exit:
+  ret void
+}
+
+; %inner reaches %latch without going through %header, so threading %latch to
+; %inner would form a cycle bypassing %header.
+define void @latch_to_body(ptr %p, i1 %a, i1 %c) {
+; CHECK-LABEL: define void @latch_to_body(
+; CHECK-SAME: ptr [[P:%.*]], i1 [[A:%.*]], i1 [[C:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    br label %[[HEADER:.*]]
+; CHECK:       [[HEADER]]:
+; CHECK-NEXT:    [[V:%.*]] = phi i1 [ [[A]], %[[ENTRY]] ], [ false, %[[INNER:.*]] ]
+; CHECK-NEXT:    br i1 [[V]], label %[[EXIT:.*]], label %[[INNER]]
+; CHECK:       [[INNER]]:
+; CHECK-NEXT:    store i32 0, ptr [[P]], align 4
+; CHECK-NEXT:    br i1 [[C]], label %[[HEADER]], label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %header
+
+header:
+  %v = phi i1 [ %a, %entry ], [ false, %latch ]
+  br i1 %v, label %exit, label %inner
+
+inner:
+  store i32 0, ptr %p, align 4
+  br i1 %c, label %latch, label %exit
+
+latch:
+  br label %header
+
+exit:
+  ret void
+}
