+; RUN: opt -p loop-vectorize -enable-early-exit-vectorization-with-speculative-loads -force-vector-width=4 -S %s | FileCheck %s
+
+; The alloc sizes of i16 and double are larger than their store sizes, so
+; consecutive elements are not contiguous in memory. Make sure loops with such
+; potentially faulting loads are not vectorized using speculative loads.
+
+target datalayout = "e-i16:32-f64:128-n32:64"
+target triple = "arm64-apple-macosx"
+
