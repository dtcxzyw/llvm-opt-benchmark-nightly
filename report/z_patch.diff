+  auto Low = DAG->getNode(ISD::AND, Loc, MVT::i32, X,
+                          DAG->getConstant(127, Loc, MVT::i32));
+  auto Bit = DAG->getNode(ISD::AND, Loc, MVT::i32, Y,
