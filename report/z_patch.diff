+    const VPRecipeBase *R = Current->getDefiningRecipe();
+    const VPBasicBlock *VPBB = R ? R->getParent() : nullptr;
+    const VPlan *Plan = VPBB ? VPBB->getPlan() : nullptr;
+    if (VPBB &&
