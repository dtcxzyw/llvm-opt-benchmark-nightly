+; CHECK-NEXT:  Loop %inner: backedge-taken count is (-1 + %start)
+; CHECK-NEXT:  Loop %inner: constant max backedge-taken count is i32 2
+; CHECK-NEXT:  Loop %inner: symbolic max backedge-taken count is (-1 + %start)
+; CHECK-NEXT:  Loop %inner: Trip multiple is 1
+; CHECK-NEXT:  Loop %outer.header: backedge-taken count is ((-1 * %start) + (4 smax %start))
+; CHECK-NEXT:  Loop %outer.header: constant max backedge-taken count is i32 -2147483644
+; CHECK-NEXT:  Loop %outer.header: symbolic max backedge-taken count is ((-1 * %start) + (4 smax %start))
+; CHECK-NEXT:  Loop %outer.header: Trip multiple is 1
+;
+entry:
+  br label %outer.header
+
+outer.header:
+  %iv = phi i32 [ %start, %entry ], [ %iv.next, %outer.latch ]
+  %c = icmp slt i32 %iv, 4
+  br i1 %c, label %inner.ph, label %exit
+
+inner.ph:
+  %positive = icmp sgt i32 %start, 0
+  br i1 %positive, label %inner, label %outer.latch
+
+inner:
+  %i = phi i32 [ 0, %inner.ph ], [ %i.next, %inner ]
+  %i.next = add nsw i32 %i, 1
