diff --git a/llvm/test/Transforms/SimplifyCFG/sink-common-code-inner-diamond.ll b/llvm/test/Transforms/SimplifyCFG/sink-common-code-inner-diamond.ll
new file mode 100644
index 00000000000000..ca29cb2d34e370
--- /dev/null
+++ b/llvm/test/Transforms/SimplifyCFG/sink-common-code-inner-diamond.ll
@@ -0,0 +1,40 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -passes='simplifycfg<sink-common-insts>' -S | FileCheck %s
+
+declare void @g()
+
+; %end is shared with %other, so sink the store from just the diamond's arms.
+define void @inner_diamond(i1 %c1, i1 %c2, ptr %p, i32 %x, i32 %y) {
+; CHECK-LABEL: define void @inner_diamond(
+; CHECK-SAME: i1 [[A:%.*]], i1 [[B:%.*]], ptr [[P:%.*]], i32 [[X:%.*]], i32 [[Y:%.*]]) {
+; CHECK-NEXT:    br i1 [[A]], label %[[OTHER:.*]], label %[[IF:.*]]
+; CHECK:       [[OTHER]]:
+; CHECK-NEXT:    call void @g()
+; CHECK-NEXT:    br label %[[END:.*]]
+; CHECK:       [[IF]]:
+; CHECK-NEXT:    [[X_Y:%.*]] = select i1 [[B]], i32 [[X]], i32 [[Y]]
+; CHECK-NEXT:    store i32 [[X_Y]], ptr [[P]], align 4
+; CHECK-NEXT:    br label %[[END]]
+; CHECK:       [[END]]:
+; CHECK-NEXT:    ret void
+;
+  br i1 %c1, label %other, label %if
+
+other:
+  call void @g()
+  br label %end
+
+if:
+  br i1 %c2, label %then, label %else
+
+then:
+  store i32 %x, ptr %p
+  br label %end
+
+else:
+  store i32 %y, ptr %p
+  br label %end
+
+end:
+  ret void
+}
