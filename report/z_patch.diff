@@ -929,6 +929,83 @@ Instruction *InstCombinerImpl::tryFoldInstWithCtpopWithNot(Instruction *I) {
   return replaceInstUsesWith(*I, R);
 }
 
+// Factor the smaller shift amount out of an OR of two shifted values,
+// optionally ORed with an accumulator. Removing a one-use add that computes
+// the larger shift amount pays for the new constant shift.
+static Instruction *foldOrOfDisplacedShifts(BinaryOperator &I,
+                                            InstCombiner::BuilderTy &Builder) {
+  if (I.getOpcode() != Instruction::Or || !I.getType()->isIntegerTy())
+    return nullptr;
+
+  unsigned BitWidth = I.getType()->getScalarSizeInBits();
+  auto GetOffset = [&](Value *High, Value *Low, APInt &Offset) {
+    if (!isa<Instruction>(High) || !High->hasOneUse())
+      return false;
+    ConstantInt *C0, *C1;
+    Value *Base;
+    if (match(High, m_c_Add(m_Specific(Low), m_ConstantInt(C1)))) {
+      Offset = C1->getValue();
+    } else if (match(High, m_c_Add(m_Value(Base), m_ConstantInt(C1))) &&
+               match(Low, m_c_Add(m_Specific(Base), m_ConstantInt(C0)))) {
+      Offset = C1->getValue() - C0->getValue();
+    } else {
+      return false;
+    }
+    return !Offset.isZero() && Offset.ult(BitWidth);
+  };
+
+  for (unsigned Op : {0u, 1u}) {
+    Value *X, *Y, *SX, *SY, *ShiftedX;
+    Value *Acc = nullptr;
+    Value *ShiftedY = I.getOperand(Op);
+    if (!isa<Instruction>(ShiftedY) ||
+        !match(ShiftedY, m_OneUse(m_Shl(m_Value(Y), m_Value(SY)))))
+      continue;
+
+    Value *Other = I.getOperand(1 - Op);
+    if (match(Other, m_OneUse(m_Shl(m_Value(X), m_Value(SX))))) {
+      ShiftedX = Other;
+    } else if (!isa<Instruction>(Other) ||
+               !match(Other,
+                      m_OneUse(m_c_Or(
+                          m_CombineAnd(m_OneUse(m_Shl(m_Value(X), m_Value(SX))),
+                                       m_Value(ShiftedX)),
+                          m_Value(Acc))))) {
+      continue;
+    }
+
+    if (!isa<Instruction>(ShiftedX))
+      continue;
+    APInt Offset(BitWidth, 0);
+    if (!GetOffset(SY, SX, Offset)) {
+      if (!GetOffset(SX, SY, Offset))
+        continue;
+      std::swap(X, Y);
+      std::swap(SX, SY);
+    }
+    if (isa<Constant>(SX))
+      continue;
+
+    // Avoid adding a dependent shift to a variable extraction chain.
+    if (auto *Extract = dyn_cast<BinaryOperator>(Y);
+        Extract &&
+        (Extract->getOpcode() == Instruction::LShr ||
+         Extract->getOpcode() == Instruction::AShr) &&
+        !isa<ConstantInt>(Extract->getOperand(1)))
+      continue;
+
+    Value *Shifted =
+        Builder.CreateShl(Y, ConstantInt::get(I.getType(), Offset));
+    Value *Packed = Builder.CreateOr(X, Shifted);
+    if (!Acc)
+      return BinaryOperator::CreateShl(Packed, SX);
+
+    Value *Result = Builder.CreateShl(Packed, SX);
+    return BinaryOperator::CreateOr(Result, Acc);
+  }
+  return nullptr;
+}
