+; CHECK-NEXT:    [[DATA_OUTER:%.*]] = phi ptr [ [[DATA]], %[[ENTRY]] ], [ [[DATA_NEXT_LCSSA:%.*]], %[[OUTER_LATCH]] ]
+; CHECK-NEXT:    [[P:%.*]] = load ptr, ptr [[PP]], align 8
+; CHECK-NEXT:    [[START:%.*]] = select i1 [[C]], ptr [[DATA_OUTER]], ptr [[P]]
+; CHECK-NEXT:    br label %[[INNER:.*]]
+; CHECK:       [[INNER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[OUTER]] ], [ [[IV_NEXT:%.*]], %[[INNER]] ]
+; CHECK-NEXT:    [[DATA_INNER:%.*]] = phi ptr [ [[START]], %[[OUTER]] ], [ [[DATA_NEXT:%.*]], %[[INNER]] ]
+; CHECK-NEXT:    [[BUF_GEP:%.*]] = getelementptr inbounds i8, ptr [[BUF]], i64 [[IV]]
+; CHECK-NEXT:    [[L:%.*]] = load i8, ptr [[DATA_INNER]], align 1
+; CHECK-NEXT:    store i8 [[L]], ptr [[BUF_GEP]], align 1
+; CHECK-NEXT:    [[DATA_NEXT]] = getelementptr inbounds i8, ptr [[DATA_INNER]], i64 1
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
+; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], 16
+; CHECK-NEXT:    br i1 [[EC]], label %[[OUTER_LATCH]], label %[[INNER]]
+; CHECK:       [[OUTER_LATCH]]:
+; CHECK-NEXT:    [[DATA_NEXT_LCSSA]] = phi ptr [ [[DATA_NEXT]], %[[INNER]] ]
+; CHECK-NEXT:    [[OUTER_IV_NEXT]] = add nuw i64 [[OUTER_IV]], 1
+; CHECK-NEXT:    [[OUTER_EC:%.*]] = icmp eq i64 [[OUTER_IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[OUTER_EC]], label %[[EXIT:.*]], label %[[OUTER]]
+; CHECK:       [[EXIT]]:
