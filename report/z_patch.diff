index 0000000000000..24b02d6d478dc
--- /dev/null
+++ b/llvm/test/Transforms/IndVarSimplify/maxvalue-trap-elim.ll
@@ -0,0 +1,170 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt < %s -passes=indvars -S | FileCheck %s
+
+; isKnownPredicateViaMaxIterationValue bounds a nuw induction by its value at the
+; max backedge-taken count, capturing this while the nuw is present -- so the
+; later ULE(AR<nuw>, X) -> ULT(AR-1, X) rewrite that drops the nuw does not lose it.
+
+declare void @llvm.trap()
+
+; Bounds check (i+1)*4 > n*4 is dead: max (i+1)*4 = n*4 = the bound.
+define void @maxiter_trap_elim(ptr %p, i64 %n) {
+; CHECK-LABEL: @maxiter_trap_elim(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[Z:%.*]] = icmp eq i64 [[N:%.*]], 0
+; CHECK-NEXT:    br i1 [[Z]], label [[EXIT:%.*]], label [[LOOP_PREHEADER:%.*]]
+; CHECK:       loop.preheader:
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[INC:%.*]], [[LATCH:%.*]] ], [ 0, [[LOOP_PREHEADER]] ]
+; CHECK-NEXT:    br i1 false, label [[TRAP:%.*]], label [[LATCH]]
+; CHECK:       trap:
+; CHECK-NEXT:    call void @llvm.trap()
+; CHECK-NEXT:    unreachable
+; CHECK:       latch:
+; CHECK-NEXT:    [[PTR:%.*]] = getelementptr i32, ptr [[P:%.*]], i64 [[I]]
+; CHECK-NEXT:    store i32 0, ptr [[PTR]], align 4
+; CHECK-NEXT:    [[INC]] = add nuw nsw i64 [[I]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp ult i64 [[INC]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label [[LOOP]], label [[EXIT_LOOPEXIT:%.*]]
+; CHECK:       exit.loopexit:
+; CHECK-NEXT:    br label [[EXIT]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %z = icmp eq i64 %n, 0
+  br i1 %z, label %exit, label %loop
+
+loop:
+  %i = phi i64 [ 0, %entry ], [ %inc, %latch ]
+  %mul = mul nuw i64 %i, 4
+  %end = add nuw i64 %mul, 4
+  %limit = mul nuw i64 %n, 4
+  %ovf = icmp ugt i64 %end, %limit
+  br i1 %ovf, label %trap, label %latch
+
+trap:
+  call void @llvm.trap()
+  unreachable
+
+latch:
+  %ptr = getelementptr i32, ptr %p, i64 %i
+  store i32 0, ptr %ptr
+  %inc = add nuw nsw i64 %i, 1
+  %c = icmp ult i64 %inc, %n
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Same fold with a larger step.
+define void @maxiter_trap_elim_step8(ptr %p, i64 %n) {
+; CHECK-LABEL: @maxiter_trap_elim_step8(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[Z:%.*]] = icmp eq i64 [[N:%.*]], 0
+; CHECK-NEXT:    br i1 [[Z]], label [[EXIT:%.*]], label [[LOOP_PREHEADER:%.*]]
+; CHECK:       loop.preheader:
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[INC:%.*]], [[LATCH:%.*]] ], [ 0, [[LOOP_PREHEADER]] ]
+; CHECK-NEXT:    br i1 false, label [[TRAP:%.*]], label [[LATCH]]
+; CHECK:       trap:
+; CHECK-NEXT:    call void @llvm.trap()
+; CHECK-NEXT:    unreachable
+; CHECK:       latch:
+; CHECK-NEXT:    [[PTR:%.*]] = getelementptr i8, ptr [[P:%.*]], i64 [[I]]
+; CHECK-NEXT:    store i8 0, ptr [[PTR]], align 1
+; CHECK-NEXT:    [[INC]] = add nuw nsw i64 [[I]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp ult i64 [[INC]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label [[LOOP]], label [[EXIT_LOOPEXIT:%.*]]
+; CHECK:       exit.loopexit:
+; CHECK-NEXT:    br label [[EXIT]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %z = icmp eq i64 %n, 0
+  br i1 %z, label %exit, label %loop
+
+loop:
+  %i = phi i64 [ 0, %entry ], [ %inc, %latch ]
+  %mul = mul nuw i64 %i, 8
+  %end = add nuw i64 %mul, 8
+  %limit = mul nuw i64 %n, 8
+  %ovf = icmp ugt i64 %end, %limit
+  br i1 %ovf, label %trap, label %latch
+
+trap:
+  call void @llvm.trap()
+  unreachable
+
+latch:
+  %ptr = getelementptr i8, ptr %p, i64 %i
+  store i8 0, ptr %ptr
+  %inc = add nuw nsw i64 %i, 1
+  %c = icmp ult i64 %inc, %n
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Negative: max (i+1)*4 = n*4 exceeds the bound n*4-1, so the trap must stay.
+define void @maxiter_no_fold(ptr %p, i64 %n) {
+; CHECK-LABEL: @maxiter_no_fold(
+; CHECK-NEXT:  entry:
+; CHECK-NEXT:    [[Z:%.*]] = icmp eq i64 [[N:%.*]], 0
+; CHECK-NEXT:    br i1 [[Z]], label [[EXIT:%.*]], label [[LOOP_PREHEADER:%.*]]
+; CHECK:       loop.preheader:
+; CHECK-NEXT:    br label [[LOOP:%.*]]
+; CHECK:       loop:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[INC:%.*]], [[LATCH:%.*]] ], [ 0, [[LOOP_PREHEADER]] ]
+; CHECK-NEXT:    [[MUL:%.*]] = mul nuw i64 [[I]], 4
+; CHECK-NEXT:    [[END:%.*]] = add nuw i64 [[MUL]], 4
+; CHECK-NEXT:    [[N4:%.*]] = mul nuw i64 [[N]], 4
+; CHECK-NEXT:    [[LIMIT:%.*]] = sub i64 [[N4]], 1
+; CHECK-NEXT:    [[OVF:%.*]] = icmp ugt i64 [[END]], [[LIMIT]]
+; CHECK-NEXT:    br i1 [[OVF]], label [[TRAP:%.*]], label [[LATCH]]
+; CHECK:       trap:
+; CHECK-NEXT:    call void @llvm.trap()
+; CHECK-NEXT:    unreachable
+; CHECK:       latch:
+; CHECK-NEXT:    [[PTR:%.*]] = getelementptr i8, ptr [[P:%.*]], i64 [[I]]
+; CHECK-NEXT:    store i8 0, ptr [[PTR]], align 1
+; CHECK-NEXT:    [[INC]] = add nuw nsw i64 [[I]], 1
+; CHECK-NEXT:    [[C:%.*]] = icmp ult i64 [[INC]], [[N]]
+; CHECK-NEXT:    br i1 [[C]], label [[LOOP]], label [[EXIT_LOOPEXIT:%.*]]
+; CHECK:       exit.loopexit:
+; CHECK-NEXT:    br label [[EXIT]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret void
+;
+entry:
+  %z = icmp eq i64 %n, 0
+  br i1 %z, label %exit, label %loop
+
+loop:
+  %i = phi i64 [ 0, %entry ], [ %inc, %latch ]
+  %mul = mul nuw i64 %i, 4
+  %end = add nuw i64 %mul, 4
+  %n4 = mul nuw i64 %n, 4
+  %limit = sub i64 %n4, 1
+  %ovf = icmp ugt i64 %end, %limit
+  br i1 %ovf, label %trap, label %latch
+
+trap:
+  call void @llvm.trap()
+  unreachable
+
+latch:
+  %ptr = getelementptr i8, ptr %p, i64 %i
+  store i8 0, ptr %ptr
+  %inc = add nuw nsw i64 %i, 1
+  %c = icmp ult i64 %inc, %n
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
