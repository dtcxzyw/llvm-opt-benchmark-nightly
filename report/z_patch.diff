+/// Returns true if \p I is missing a poison-generating flag that may be implied
+/// by the constraint systems. Only cases that need the relational reasoning of
+/// the systems are considered; flags that follow from the ranges of the operands
+/// alone are added by CorrelatedValuePropagation and InstCombine already.
+static bool canStrengthenFlags(Instruction *I) {
+  if (!MaterializeFlags)
+    return false;
+
+  switch (I->getOpcode()) {
+  case Instruction::SExt:
+    // Can be replaced by zext nneg, if the operand is non-negative.
+    return I->getType()->isIntegerTy();
+  case Instruction::Sub:
+    // A - B does not wrap unsigned, if A >=u B. Constant operands are handled
+    // by CorrelatedValuePropagation using ranges.
+    return I->getType()->isIntegerTy() &&
+           !cast<OverflowingBinaryOperator>(I)->hasNoUnsignedWrap() &&
+           !isa<Constant>(I->getOperand(1));
+  case Instruction::GetElementPtr: {
+    // nuw is implied by nusw together with non-negative offsets.
+    GEPNoWrapFlags NW = cast<GEPOperator>(I)->getNoWrapFlags();
+    return NW.hasNoUnsignedSignedWrap() && !NW.hasNoUnsignedWrap();
+  }
+  default:
+    return false;
+  }
+}
+
+/// The systems hold facts that are not explicit in the IR, in particular facts
+/// implied by conditions this pass then removes. Later passes cannot re-derive
+/// those facts. Try to materialize them as poison-generating flags on \p I,
+/// which remain valid independently of the conditions they were derived from.
+/// Returns true if \p I was modified.
+static bool tryToStrengthenFlags(Instruction *I, ConstraintInfo &Info,
+                                 SmallVectorImpl<Instruction *> &ToRemove) {
+  // Nothing is implied if there are no facts in scope.
+  if (Info.getCS(/*Signed=*/false).size() == 0 &&
+      Info.getCS(/*Signed=*/true).size() == 0)
+    return false;
+
+  const DataLayout &DL = I->getDataLayout();
+  // Returns true if the systems imply that \p V is non-negative. Cases known
+  // via ValueTracking are skipped, as flags for those are added by other
+  // passes.
+  auto NeedsSystemToProveNonNegative = [&Info, &DL](Value *V) {
+    return !isKnownNonNegative(V, DL) &&
+           Info.doesHold(CmpInst::ICMP_SGE, V,
+                         ConstantInt::getNullValue(V->getType()));
+  };
+
+  switch (I->getOpcode()) {
+  case Instruction::SExt: {
+    Value *Op = I->getOperand(0);
+    if (!NeedsSystemToProveNonNegative(Op))
+      return false;
+    LLVM_DEBUG(dbgs() << "Replacing sext by zext nneg: " << *I << "\n");
+    // Replace sext by zext nneg, which keeps the information that Op is
+    // non-negative available in the IR.
+    auto *ZExt =
+        CastInst::CreateZExtOrBitCast(Op, I->getType(), "", I->getIterator());
+    ZExt->setNonNeg();
+    ZExt->takeName(I);
+    ZExt->setDebugLoc(I->getDebugLoc());
+    I->replaceAllUsesWith(ZExt);
+    ToRemove.push_back(I);
+    ++NumSExtConverted;
+    return true;
+  }
+  case Instruction::Sub: {
+    auto *BO = cast<BinaryOperator>(I);
+    // Op0 - Op1 does not wrap unsigned, if Op0 >=u Op1.
+    if (!Info.doesHold(CmpInst::ICMP_UGE, BO->getOperand(0),
+                       BO->getOperand(1)))
+      return false;
+    LLVM_DEBUG(dbgs() << "Adding nuw to " << *I << "\n");
+    BO->setHasNoUnsignedWrap();
+    ++NumNoWrapAdded;
+    return true;
+  }
+  case Instruction::GetElementPtr: {
+    auto *GEP = cast<GetElementPtrInst>(I);
+    // A GEP with nusw whose offsets are all non-negative also does not wrap in
+    // the unsigned sense: for non-negative offsets, the signed and unsigned
+    // interpretation of each step agree.
+    bool NeedsSystem = false;
+    for (gep_type_iterator GTI = gep_type_begin(GEP), GTE = gep_type_end(GEP);
+         GTI != GTE; ++GTI) {
+      // Struct member offsets are always non-negative.
+      if (GTI.getStructTypeOrNull())
+        continue;
+      // Bail out if the offset is not a multiple of a fixed size.
+      if (!DL.getTypeAllocSize(GTI.getIndexedType()).isFixed())
+        return false;
+      Value *Idx = GTI.getOperand();
+      if (!Idx->getType()->isIntegerTy())
+        return false;
+      if (isKnownNonNegative(Idx, DL))
+        continue;
+      if (!Info.doesHold(CmpInst::ICMP_SGE, Idx,
+                         ConstantInt::getNullValue(Idx->getType())))
+        return false;
+      NeedsSystem = true;
+    }
+    // If all indices are known to be non-negative without the systems, adding
+    // the flag is left to other passes.
+    if (!NeedsSystem)
+      return false;
+    LLVM_DEBUG(dbgs() << "Adding nuw to " << *I << "\n");
+    GEP->setNoWrapFlags(GEP->getNoWrapFlags() |
+                        GEPNoWrapFlags::noUnsignedWrap());
+    ++NumNoWrapAdded;
+    return true;
+  }
+  default:
+    return false;
+  }
+}
