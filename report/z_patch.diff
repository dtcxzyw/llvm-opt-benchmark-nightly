+/// Returns true if \p I is a candidate whose poison-generating flags may be
+/// strengthened using the constraint systems.
+static bool canStrengthenFlags(Instruction *I) {
+  switch (I->getOpcode()) {
+  case Instruction::SExt:
+    // Can be replaced by zext nneg, if the operand is non-negative.
+    return I->getType()->isIntegerTy();
+  case Instruction::Sub:
+    // A - B does not wrap unsigned, if A >=u B. Constant operands are handled
+    // by CorrelatedValuePropagation using ranges.
+    return I->getType()->isIntegerTy() && !I->hasNoUnsignedWrap() &&
+           !isa<Constant>(I->getOperand(1));
+  case Instruction::GetElementPtr: {
+    // nuw is implied by nusw together with non-negative offsets.
+    GEPNoWrapFlags NW = cast<GetElementPtrInst>(I)->getNoWrapFlags();
+    return NW.hasNoUnsignedSignedWrap() && !NW.hasNoUnsignedWrap();
+  }
+  default:
+    return false;
+  }
+}
+
+
+/// The systems hold facts that are not explicit in the IR, in particular facts
+/// implied by conditions this pass then removes. Later passes cannot re-derive
+/// those facts. Try to materialize them as poison-generating flags on \p I,
+/// which remain valid independently of the conditions they were derived from.
+/// Returns true if \p I was modified.
+static bool tryToStrengthenFlags(Instruction *I, ConstraintInfo &Info,
+                                 SmallVectorImpl<Instruction *> &ToRemove) {
+  assert(canStrengthenFlags(I) && "not a candidate for flag strengthening");
+
+  switch (I->getOpcode()) {
+  case Instruction::SExt: {
+    Value *Op = I->getOperand(0);
+    if (!Op->getType()->isIntegerTy() ||
+        !preconditionHolds(Info, CmpInst::ICMP_SGE, Op, 0))
+      return false;
+    LLVM_DEBUG(dbgs() << "Replacing sext by zext nneg: " << *I << "\n");
+    auto *ZExt = CastInst::Create(Instruction::ZExt, Op, I->getType(), "",
+                                  I->getIterator());
+    ZExt->setNonNeg();
+    ZExt->takeName(I);
+    ZExt->setDebugLoc(I->getDebugLoc());
+    I->replaceAllUsesWith(ZExt);
+    ToRemove.push_back(I);
+    ++NumSExtConverted;
+    return true;
+  }
+  case Instruction::Sub: {
+    // Op0 - Op1 does not wrap unsigned, if Op0 >=u Op1.
+    if (!Info.doesHold(CmpInst::ICMP_UGE, I->getOperand(0), I->getOperand(1)))
+      return false;
+    LLVM_DEBUG(dbgs() << "Adding nuw to " << *I << "\n");
+    I->setHasNoUnsignedWrap();
+    ++NumSubNUW;
+    return true;
+  }
+  case Instruction::GetElementPtr: {
+    auto &DL = I->getParent()->getDataLayout();
+    auto *GEP = cast<GetElementPtrInst>(I);
+    // A GEP with nusw all of whose steps have a non-negative offset also does
+    // not wrap in the unsigned sense: for a non-negative offset, the signed and
+    // unsigned interpretation of the step agree, so nusw's guarantees carry over
+    // to nuw. The offsets are computed in the pointer index type, so it is not
+    // sufficient for the indices to be non-negative; the stride of each step
+    // must be non-negative in the index type as well.
+    unsigned IndexTypeBits = DL.getIndexTypeSizeInBits(GEP->getType());
+    auto IsNonNegativeStride = [IndexTypeBits](uint64_t Stride) {
+      return !APInt(IndexTypeBits, Stride, /*isSigned=*/false,
+                    /*implicitTrunc=*/true)
+                  .isNegative();
+    };
+
+    for (gep_type_iterator GTI = gep_type_begin(GEP), GTE = gep_type_end(GEP);
+         GTI != GTE; ++GTI) {
+      // A struct member is indexed by a constant, so its offset is the stride
+      // of the step. Note that it may still be negative in the index type.
+      if (StructType *STy = GTI.getStructTypeOrNull()) {
+        unsigned Field = cast<ConstantInt>(GTI.getOperand())->getZExtValue();
+        if (!IsNonNegativeStride(
+                DL.getStructLayout(STy)->getElementOffset(Field)))
+          return false;
+        continue;
+      }
+      // Bail out if the stride is not fixed, as the sign of a scalable stride
+      // in the index type is unknown.
+      TypeSize Stride = DL.getTypeAllocSize(GTI.getIndexedType());
+      if (!Stride.isFixed() || !IsNonNegativeStride(Stride.getFixedValue()))
+        return false;
+    if (!GTI.getOperand()->getType()->isIntegerTy() ||
+        !preconditionHolds(Info, CmpInst::ICMP_SGE, GTI.getOperand(), 0))
+        return false;
+    }
+    LLVM_DEBUG(dbgs() << "Adding nuw to " << *I << "\n");
+    GEP->setNoWrapFlags(GEP->getNoWrapFlags() |
+                        GEPNoWrapFlags::noUnsignedWrap());
+    ++NumGEPNUW;
+    return true;
+  }
+  default:
+    return false;
+  }
+}
