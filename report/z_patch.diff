+; Test single phi of constants return
+define i1 @test_phi_simple(i32 %a) {
+; CHECK-LABEL: define i1 @test_phi_simple(
+; CHECK-SAME: i32 [[A:%.*]]) {
+; CHECK-NEXT:    call void @work()
+; CHECK-NEXT:    [[COND:%.*]] = icmp eq i32 [[A]], 31
+; CHECK-NEXT:    br i1 [[COND]], label %[[B_A:.*]], label %[[B_B:.*]]
+; CHECK:       [[B_A]]:
+; CHECK-NEXT:    br label %[[EXIT:.*]]
+; CHECK:       [[B_B]]:
+; CHECK-NEXT:    br label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    [[R:%.*]] = phi i1 [ false, %[[B_A]] ], [ true, %[[B_B]] ]
+; CHECK-NEXT:    ret i1 [[R]]
+;
+  call void @work()
+  %cond = icmp eq i32 %a, 31
+  br i1 %cond, label %b.a, label %b.b
+b.a:
+  br label %exit
+b.b:
+  br label %exit
+exit:
+  %r = phi i1 [ false, %b.a ], [ true, %b.b ]
+  ret i1 %r
+}
+
+define void @caller_phi_simple(i32 %a) {
+; CHECK-LABEL: define void @caller_phi_simple(
