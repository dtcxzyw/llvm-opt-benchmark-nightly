+  SDLoc Loc;
+  auto X = DAG->getRegister(0, MVT::i32);
+  auto Y = DAG->getRegister(1, MVT::i32);
+  for (auto [Mask, SignBits] :
+       {std::pair{255u, 16u}, {32767u, 2u}, {1073741824u, 32u}}) {
+    auto C = DAG->getConstant(Mask, Loc, MVT::i32);
