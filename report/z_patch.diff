diff --git a/llvm/test/Transforms/ConstraintElimination/no-wrap-type-limit-witness.ll b/llvm/test/Transforms/ConstraintElimination/no-wrap-type-limit-witness.ll
new file mode 100644
index 00000000000000..23824bb5bb0ed2
--- /dev/null
+++ b/llvm/test/Transforms/ConstraintElimination/no-wrap-type-limit-witness.ll
@@ -0,0 +1,305 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s
+
+; Every value in a constraint system is in the range of its type, but the
+; systems do not contain those bounds. A bound `Op + Slack <= W` on some other
+; value W of the system therefore proves `Op <= SMAX - Slack` (and the mirrored
+; form proves `Op >= SMIN + Slack`) even though the solver cannot derive it.
+
+declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)
+declare { i8, i1 } @llvm.uadd.with.overflow.i8(i8, i8)
+declare void @llvm.assume(i1)
+declare void @use(i8)
+
+; A s< W (W a variable, hence W s<= SMAX) proves A + 1 does not overflow.
+define i1 @sadd_one_witness_slt(i64 %a, i64 %w) {
+; CHECK-LABEL: define i1 @sadd_one_witness_slt(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[W:%.*]]) {
+; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i64 [[A]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    ret i1 false
+;
+  %pre = icmp slt i64 %a, %w
+  call void @llvm.assume(i1 %pre)
+  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 1)
+  %o = extractvalue { i64, i1 } %s, 1
+  ret i1 %o
+}
+
+; A s> W (W a variable, hence W s>= SMIN) proves A + (-1) does not overflow.
+define i1 @sadd_negone_witness_sgt(i64 %a, i64 %w) {
+; CHECK-LABEL: define i1 @sadd_negone_witness_sgt(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[W:%.*]]) {
+; CHECK-NEXT:    [[PRE:%.*]] = icmp sgt i64 [[A]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    ret i1 false
+;
+  %pre = icmp sgt i64 %a, %w
+  call void @llvm.assume(i1 %pre)
+  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 -1)
+  %o = extractvalue { i64, i1 } %s, 1
+  ret i1 %o
+}
+
+; A non-strict bound A s<= W does not prove A + 1 is in range (A and W could
+; both be SMAX), so the overflow check must be kept.
+define i1 @neg_sadd_one_witness_sle(i64 %a, i64 %w) {
+; CHECK-LABEL: define i1 @neg_sadd_one_witness_sle(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[W:%.*]]) {
+; CHECK-NEXT:    [[PRE:%.*]] = icmp sle i64 [[A]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[S:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[A]], i64 1)
+; CHECK-NEXT:    [[O:%.*]] = extractvalue { i64, i1 } [[S]], 1
+; CHECK-NEXT:    ret i1 [[O]]
+;
+  %pre = icmp sle i64 %a, %w
+  call void @llvm.assume(i1 %pre)
+  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 1)
+  %o = extractvalue { i64, i1 } %s, 1
+  ret i1 %o
+}
+
+; A s< W only gives A s<= SMAX - 1, which does not cover an addend of 2.
+define i1 @neg_sadd_two_witness_slt(i64 %a, i64 %w) {
+; CHECK-LABEL: define i1 @neg_sadd_two_witness_slt(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[W:%.*]]) {
+; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i64 [[A]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[S:%.*]] = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 [[A]], i64 2)
+; CHECK-NEXT:    [[O:%.*]] = extractvalue { i64, i1 } [[S]], 1
+; CHECK-NEXT:    ret i1 [[O]]
+;
+  %pre = icmp slt i64 %a, %w
+  call void @llvm.assume(i1 %pre)
+  %s = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %a, i64 2)
+  %o = extractvalue { i64, i1 } %s, 1
+  ret i1 %o
+}
+
+; The same reasoning strengthens the flags of a plain add.
+define i64 @add_one_nsw_witness_slt(i64 %a, i64 %w) {
+; CHECK-LABEL: define i64 @add_one_nsw_witness_slt(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[W:%.*]]) {
+; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i64 [[A]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[ADD:%.*]] = add nsw i64 [[A]], 1
+; CHECK-NEXT:    ret i64 [[ADD]]
+;
+  %pre = icmp slt i64 %a, %w
+  call void @llvm.assume(i1 %pre)
+  %add = add i64 %a, 1
+  ret i64 %add
+}
+
+; Narrower types are affected in the same way: the limit itself is
+; representable, but the system still does not know that W is at most SMAX.
+define i32 @add_one_nsw_witness_slt_i32(i32 %a, i32 %w) {
+; CHECK-LABEL: define i32 @add_one_nsw_witness_slt_i32(
+; CHECK-SAME: i32 [[A:%.*]], i32 [[W:%.*]]) {
+; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i32 [[A]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[ADD:%.*]] = add nsw i32 [[A]], 1
+; CHECK-NEXT:    ret i32 [[ADD]]
+;
+  %pre = icmp slt i32 %a, %w
+  call void @llvm.assume(i1 %pre)
+  %add = add i32 %a, 1
+  ret i32 %add
+}
+
+; A s> W proves A s>= SMIN + 1, so A - 1 does not wrap.
+define i64 @sub_one_nsw_witness_sgt(i64 %a, i64 %w) {
+; CHECK-LABEL: define i64 @sub_one_nsw_witness_sgt(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[W:%.*]]) {
+; CHECK-NEXT:    [[PRE:%.*]] = icmp sgt i64 [[A]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[SUB:%.*]] = sub nsw i64 [[A]], 1
+; CHECK-NEXT:    ret i64 [[SUB]]
+;
+  %pre = icmp sgt i64 %a, %w
+  call void @llvm.assume(i1 %pre)
+  %sub = sub i64 %a, 1
+  ret i64 %sub
+}
+
+; The unsigned system has the same gap: A u< W proves A u<= UMAX - 1.
+define i64 @add_one_nuw_witness_ult(i64 %a, i64 %w) {
+; CHECK-LABEL: define i64 @add_one_nuw_witness_ult(
+; CHECK-SAME: i64 [[A:%.*]], i64 [[W:%.*]]) {
+; CHECK-NEXT:    [[PRE:%.*]] = icmp ult i64 [[A]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[ADD:%.*]] = add nuw i64 [[A]], 1
+; CHECK-NEXT:    ret i64 [[ADD]]
+;
+  %pre = icmp ult i64 %a, %w
+  call void @llvm.assume(i1 %pre)
+  %add = add i64 %a, 1
+  ret i64 %add
+}
+
+; A witness bound with a larger gap discharges a larger addend: A + 4 s< W
+; gives A s<= SMAX - 5.
+define void @add_witness_slack_5(i8 %a, i8 %w) {
+; CHECK-LABEL: define void @add_witness_slack_5(
+; CHECK-SAME: i8 [[A:%.*]], i8 [[W:%.*]]) {
+; CHECK-NEXT:    [[OFF:%.*]] = add nsw i8 [[A]], 4
+; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i8 [[OFF]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[ADD:%.*]] = add nsw i8 [[A]], 5
+; CHECK-NEXT:    call void @use(i8 [[ADD]])
+; CHECK-NEXT:    ret void
+;
+  %off = add nsw i8 %a, 4
+  %pre = icmp slt i8 %off, %w
+  call void @llvm.assume(i1 %pre)
+  %add = add i8 %a, 5
+  call void @use(i8 %add)
+  ret void
+}
+
+; ... but not an addend beyond that gap.
+define void @neg_add_witness_slack_6(i8 %a, i8 %w) {
+; CHECK-LABEL: define void @neg_add_witness_slack_6(
+; CHECK-SAME: i8 [[A:%.*]], i8 [[W:%.*]]) {
+; CHECK-NEXT:    [[OFF:%.*]] = add nsw i8 [[A]], 4
+; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i8 [[OFF]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[ADD:%.*]] = add i8 [[A]], 6
+; CHECK-NEXT:    call void @use(i8 [[ADD]])
+; CHECK-NEXT:    ret void
+;
+  %off = add nsw i8 %a, 4
+  %pre = icmp slt i8 %off, %w
+  call void @llvm.assume(i1 %pre)
+  %add = add i8 %a, 6
+  call void @use(i8 %add)
+  ret void
+}
+
+; A uadd.with.overflow with a larger addend, discharged by an unsigned witness.
+define i1 @uadd_witness_slack_3(i8 %a, i8 %w) {
+; CHECK-LABEL: define i1 @uadd_witness_slack_3(
+; CHECK-SAME: i8 [[A:%.*]], i8 [[W:%.*]]) {
+; CHECK-NEXT:    [[OFF:%.*]] = add nuw i8 [[A]], 2
+; CHECK-NEXT:    [[PRE:%.*]] = icmp ult i8 [[OFF]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    ret i1 false
+;
+  %off = add nuw i8 %a, 2
+  %pre = icmp ult i8 %off, %w
+  call void @llvm.assume(i1 %pre)
+  %s = call { i8, i1 } @llvm.uadd.with.overflow.i8(i8 %a, i8 3)
+  %o = extractvalue { i8, i1 } %s, 1
+  ret i1 %o
+}
+
+; The motivating shape: a checked increment of an induction variable that is
+; strictly below a *variable* loop bound.
+define void @loop_checked_increment(i64 %n, ptr %p) {
+; CHECK-LABEL: define void @loop_checked_increment(
+; CHECK-SAME: i64 [[N:%.*]], ptr [[P:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
+; CHECK:       [[LOOP_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[TMP0:%.*]], %[[LOOP_LATCH:.*]] ]
+; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i64 [[IV]], [[N]]
+; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP_LATCH]], label %[[EXIT:.*]]
+; CHECK:       [[LOOP_LATCH]]:
+; CHECK-NEXT:    store i8 0, ptr [[P]], align 1
+; CHECK-NEXT:    [[TMP0]] = add nsw i64 [[IV]], 1
+; CHECK-NEXT:    br i1 false, label %[[TRAP:.*]], label %[[LOOP_HEADER]]
+; CHECK:       [[TRAP]]:
+; CHECK-NEXT:    unreachable
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %loop.header
+
+loop.header:
+  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
+  %cmp = icmp slt i64 %iv, %n
+  br i1 %cmp, label %loop.latch, label %exit
+
+loop.latch:
+  store i8 0, ptr %p
+  %ovf = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 %iv, i64 1)
+  %iv.next = extractvalue { i64, i1 } %ovf, 0
+  %o = extractvalue { i64, i1 } %ovf, 1
+  br i1 %o, label %trap, label %loop.header
+
+trap:
+  unreachable
+
+exit:
+  ret void
+}
+
+; The same loop with a plain increment gets nsw.
+define void @loop_increment_nsw(i64 %n, ptr %p) {
+; CHECK-LABEL: define void @loop_increment_nsw(
+; CHECK-SAME: i64 [[N:%.*]], ptr [[P:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    br label %[[LOOP_HEADER:.*]]
+; CHECK:       [[LOOP_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP_LATCH:.*]] ]
+; CHECK-NEXT:    [[CMP:%.*]] = icmp slt i64 [[IV]], [[N]]
+; CHECK-NEXT:    br i1 [[CMP]], label %[[LOOP_LATCH]], label %[[EXIT:.*]]
+; CHECK:       [[LOOP_LATCH]]:
+; CHECK-NEXT:    store i8 0, ptr [[P]], align 1
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
+; CHECK-NEXT:    br label %[[LOOP_HEADER]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %loop.header
+
+loop.header:
+  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop.latch ]
+  %cmp = icmp slt i64 %iv, %n
+  br i1 %cmp, label %loop.latch, label %exit
+
+loop.latch:
+  store i8 0, ptr %p
+  %iv.next = add i64 %iv, 1
+  br label %loop.header
+
+exit:
+  ret void
+}
+
+; A witness wider than A does not bound A by A's own limit: the fact is
+; A s< W over i64, and W may be SMAX32 + 1 while A is SMAX32.
+define i32 @neg_witness_wider_than_op(i32 %a, i64 %w) {
+; CHECK-LABEL: define i32 @neg_witness_wider_than_op(
+; CHECK-SAME: i32 [[A:%.*]], i64 [[W:%.*]]) {
+; CHECK-NEXT:    [[SA:%.*]] = sext i32 [[A]] to i64
+; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i64 [[SA]], [[W]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[ADD:%.*]] = add i32 [[A]], 1
+; CHECK-NEXT:    ret i32 [[ADD]]
+;
+  %sa = sext i32 %a to i64
+  %pre = icmp slt i64 %sa, %w
+  call void @llvm.assume(i1 %pre)
+  %add = add i32 %a, 1
+  ret i32 %add
+}
+
+; The same fact narrowed to A's type does prove the bound.
+define i64 @witness_narrower_than_op(i64 %a, i32 %w) {
+; CHECK-LABEL: define i64 @witness_narrower_than_op(
+; CHECK-SAME: i64 [[A:%.*]], i32 [[W:%.*]]) {
+; CHECK-NEXT:    [[SW:%.*]] = sext i32 [[W]] to i64
+; CHECK-NEXT:    [[PRE:%.*]] = icmp slt i64 [[A]], [[SW]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[PRE]])
+; CHECK-NEXT:    [[ADD:%.*]] = add nsw i64 [[A]], 1
+; CHECK-NEXT:    ret i64 [[ADD]]
+;
+  %sw = sext i32 %w to i64
+  %pre = icmp slt i64 %a, %sw
+  call void @llvm.assume(i1 %pre)
+  %add = add i64 %a, 1
+  ret i64 %add
+}
