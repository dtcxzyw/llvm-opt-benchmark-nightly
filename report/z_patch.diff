diff --git a/llvm/test/Transforms/InstCombine/and-not-select.ll b/llvm/test/Transforms/InstCombine/and-not-select.ll
new file mode 100644
index 0000000000000..16586ad226175
--- /dev/null
+++ b/llvm/test/Transforms/InstCombine/and-not-select.ll
@@ -0,0 +1,43 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
+; RUN: opt < %s -passes=instcombine -S | FileCheck %s
+
+; (a & 1) & ~b -> select (trunc b), 0, (a & 1)
+define i32 @test_and_not_select(i32 %a, i32 %b) {
+; CHECK-LABEL: @test_and_not_select(
+; CHECK-NEXT:    [[TMP1:%.*]] = trunc i32 [[B:%.*]] to i1
+; CHECK-NEXT:    [[AND:%.*]] = and i32 [[A:%.*]], 1
+; CHECK-NEXT:    [[AND1:%.*]] = select i1 [[TMP1]], i32 0, i32 [[AND]]
+; CHECK-NEXT:    ret i32 [[AND1]]
+;
+  %xor = xor i32 %b, -1
+  %and = and i32 %a, 1
+  %and1 = and i32 %and, %xor
+  ret i32 %and1
+}
+
+define i32 @test_and_not_select_commuted(i32 %a, i32 %b) {
+; CHECK-LABEL: @test_and_not_select_commuted(
+; CHECK-NEXT:    [[TMP1:%.*]] = trunc i32 [[B:%.*]] to i1
+; CHECK-NEXT:    [[AND:%.*]] = and i32 [[A:%.*]], 1
+; CHECK-NEXT:    [[AND1:%.*]] = select i1 [[TMP1]], i32 0, i32 [[AND]]
+; CHECK-NEXT:    ret i32 [[AND1]]
+;
+  %xor = xor i32 %b, -1
+  %and = and i32 %a, 1
+  %and1 = and i32 %xor, %and
+  ret i32 %and1
+}
+
+; Should not transform if mask is not 1 (for now)
+define i32 @test_and_not_select_mask2(i32 %a, i32 %b) {
+; CHECK-LABEL: @test_and_not_select_mask2(
+; CHECK-NEXT:    [[XOR:%.*]] = xor i32 [[B:%.*]], -1
+; CHECK-NEXT:    [[AND:%.*]] = and i32 [[A:%.*]], 2
+; CHECK-NEXT:    [[AND1:%.*]] = and i32 [[AND]], [[XOR]]
+; CHECK-NEXT:    ret i32 [[AND1]]
+;
+  %xor = xor i32 %b, -1
+  %and = and i32 %a, 2
+  %and1 = and i32 %and, %xor
+  ret i32 %and1
+}
