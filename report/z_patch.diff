+; CHECK-NEXT:    [[MUL:%.*]] = fmul float [[X]], 0.000000e+00
+; CHECK-NEXT:    [[SEL:%.*]] = select nnan i1 [[CMP]], float [[X]], float [[MUL]]
+; CHECK-NEXT:    ret float [[SEL]]
+;
+  %cmp = fcmp olt float %x, 0.0
+  %mul = fmul float %x, 0.0
+  %sel = select nnan i1 %cmp, float %x, float %mul
+  ret float %sel
+}
