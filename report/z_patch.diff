+; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP_HEADER]], label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    [[RES:%.*]] = phi i1 [ [[NEG]], %[[LOOP_HEADER]] ], [ [[NEG]], %[[LOOP_LATCH]] ]
+; CHECK-NEXT:    ret i1 [[RES]]
+;
+entry:
+  br label %loop.header
+
+loop.header:
+  %iv = phi i64 [ %start, %entry ], [ %iv.next, %loop.latch ]
+  %neg = icmp slt i64 %iv, 0
+  br i1 %neg, label %exit, label %loop.latch
+
+loop.latch:
+  %gep = getelementptr inbounds i8, ptr %p, i64 %iv
+  store i8 0, ptr %gep
+  %iv.next = add nsw i64 %iv, 1
+  %ec = icmp slt i64 %iv.next, %n
+  br i1 %ec, label %loop.header, label %exit
+
+exit:
+  %res = phi i1 [ %neg, %loop.header ], [ %neg, %loop.latch ]
+  ret i1 %res
+}
+
+; The compare of the outer IV is in the inner loop.header; it is hoisted to the
+; preheader of the outer loop.header.
+define i8 @cmp_in_subloop(ptr %p, i64 %n, i64 %m, i64 %start) {
+; CHECK-LABEL: define i8 @cmp_in_subloop(
+; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]], i64 [[M:%.*]], i64 [[START:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[NEG:%.*]] = icmp slt i64 [[START]], 0
+; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
+; CHECK:       [[OUTER_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[START]], %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
+; CHECK-NEXT:    br label %[[INNER_HEADER:.*]]
+; CHECK:       [[INNER_HEADER]]:
+; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[OUTER_HEADER]] ], [ [[J_NEXT:%.*]], %[[INNER_LATCH:.*]] ]
+; CHECK-NEXT:    br i1 [[NEG]], label %[[EXIT_1:.*]], label %[[INNER_LATCH]]
+; CHECK:       [[INNER_LATCH]]:
+; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 [[J]]
+; CHECK-NEXT:    store i8 0, ptr [[GEP]], align 1
+; CHECK-NEXT:    [[J_NEXT]] = add nuw i64 [[J]], 1
+; CHECK-NEXT:    [[INNER_EC:%.*]] = icmp ult i64 [[J_NEXT]], [[M]]
+; CHECK-NEXT:    br i1 [[INNER_EC]], label %[[INNER_HEADER]], label %[[OUTER_LATCH]]
+; CHECK:       [[OUTER_LATCH]]:
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
+; CHECK-NEXT:    [[OUTER_EC:%.*]] = icmp slt i64 [[IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[OUTER_EC]], label %[[OUTER_HEADER]], label %[[EXIT:.*]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i8 0
+; CHECK:       [[EXIT_1]]:
+; CHECK-NEXT:    ret i8 1
+;
+entry:
+  br label %outer.header
+
+outer.header:
+  %iv = phi i64 [ %start, %entry ], [ %iv.next, %outer.latch ]
+  br label %inner.header
+
+inner.header:
+  %j = phi i64 [ 0, %outer.header ], [ %j.next, %inner.latch ]
+  %neg = icmp slt i64 %iv, 0
+  br i1 %neg, label %exit.1, label %inner.latch
+
+inner.latch:
+  %gep = getelementptr inbounds i8, ptr %p, i64 %j
+  store i8 0, ptr %gep
+  %j.next = add nuw i64 %j, 1
+  %inner.ec = icmp ult i64 %j.next, %m
+  br i1 %inner.ec, label %inner.header, label %outer.latch
+
+outer.latch:
+  %iv.next = add nsw i64 %iv, 1
+  %outer.ec = icmp slt i64 %iv.next, %n
+  br i1 %outer.ec, label %outer.header, label %exit
+
+exit:
+  ret i8 0
+
+exit.1:
+  ret i8 1
+}
+
+; The compare made invariant in the inner loop is also invariant in the outer
+; loop and is hoisted to the outer preheader.
+define i8 @cmp_invariant_in_outer_loop(ptr %p, i64 %n, i64 %m, i64 %start) {
+; CHECK-LABEL: define i8 @cmp_invariant_in_outer_loop(
+; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]], i64 [[M:%.*]], i64 [[START:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[NEG:%.*]] = icmp slt i64 [[START]], 0
+; CHECK-NEXT:    br label %[[OUTER_HEADER:.*]]
+; CHECK:       [[OUTER_HEADER]]:
+; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
+; CHECK-NEXT:    br label %[[INNER_HEADER:.*]]
+; CHECK:       [[INNER_HEADER]]:
+; CHECK-NEXT:    [[J:%.*]] = phi i64 [ [[START]], %[[OUTER_HEADER]] ], [ [[J_NEXT:%.*]], %[[INNER_LATCH:.*]] ]
+; CHECK-NEXT:    br i1 [[NEG]], label %[[EXIT_1:.*]], label %[[INNER_LATCH]]
+; CHECK:       [[INNER_LATCH]]:
+; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds i8, ptr [[P]], i64 [[J]]
+; CHECK-NEXT:    store i8 0, ptr [[GEP]], align 1
+; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
+; CHECK-NEXT:    [[INNER_EC:%.*]] = icmp slt i64 [[J_NEXT]], [[M]]
+; CHECK-NEXT:    br i1 [[INNER_EC]], label %[[INNER_HEADER]], label %[[OUTER_LATCH]]
+; CHECK:       [[OUTER_LATCH]]:
+; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
+; CHECK-NEXT:    [[OUTER_EC:%.*]] = icmp slt i64 [[IV_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[OUTER_EC]], label %[[OUTER_HEADER]], label %[[EXIT:.*]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i8 0
+; CHECK:       [[EXIT_1]]:
+; CHECK-NEXT:    ret i8 1
+;
+entry:
+  br label %outer.header
+
+outer.header:
+  %iv = phi i64 [ 0, %entry ], [ %iv.next, %outer.latch ]
+  br label %inner.header
+
+inner.header:
+  %j = phi i64 [ %start, %outer.header ], [ %j.next, %inner.latch ]
+  %neg = icmp slt i64 %j, 0
+  br i1 %neg, label %exit.1, label %inner.latch
+
+inner.latch:
+  %gep = getelementptr inbounds i8, ptr %p, i64 %j
+  store i8 0, ptr %gep
+  %j.next = add nsw i64 %j, 1
+  %inner.ec = icmp slt i64 %j.next, %m
+  br i1 %inner.ec, label %inner.header, label %outer.latch
+
+outer.latch:
+  %iv.next = add nsw i64 %iv, 1
+  %outer.ec = icmp slt i64 %iv.next, %n
+  br i1 %outer.ec, label %outer.header, label %exit
+
+exit:
+  ret i8 0
+
+exit.1:
+  ret i8 1
+}
+
+; The predicated exit condition of the inner loop is invariant in the outer
+; loop and is hoisted to the outer preheader.
+define void @predicated_exit_invariant_in_outer_loop(ptr %p, i64 %n, i64 %m, i64 %k) {
+; CHECK-LABEL: define void @predicated_exit_invariant_in_outer_loop(
+; CHECK-SAME: ptr [[P:%.*]], i64 [[N:%.*]], i64 [[M:%.*]], i64 [[K:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[ENTER_OUTER:%.*]] = icmp sgt i64 [[N]], 0
+; CHECK-NEXT:    [[ENTER_INNER:%.*]] = icmp sgt i64 [[M]], 0
+; CHECK-NEXT:    [[ENTER:%.*]] = and i1 [[ENTER_OUTER]], [[ENTER_INNER]]
+; CHECK-NEXT:    br i1 [[ENTER]], label %[[OUTER_PREHEADER:.*]], label %[[EXIT:.*]]
+; CHECK:       [[OUTER_PREHEADER]]:
+; CHECK-NEXT:    [[SMAX:%.*]] = call i64 @llvm.smax.i64(i64 [[K]], i64 0)
+; CHECK-NEXT:    [[TMP0:%.*]] = add i64 [[M]], -1
+; CHECK-NEXT:    [[UMIN:%.*]] = call i64 @llvm.umin.i64(i64 [[SMAX]], i64 [[TMP0]])
+; CHECK-NEXT:    [[TMP1:%.*]] = icmp eq i64 [[SMAX]], [[UMIN]]
+; CHECK-NEXT:    br label %[[OUTER:.*]]
+; CHECK:       [[OUTER]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ], [ 0, %[[OUTER_PREHEADER]] ]
+; CHECK-NEXT:    [[ROW:%.*]] = mul i64 [[I]], [[M]]
+; CHECK-NEXT:    br label %[[INNER_BODY:.*]]
+; CHECK:       [[INNER_BODY]]:
+; CHECK-NEXT:    [[J:%.*]] = phi i64 [ 0, %[[OUTER]] ], [ [[J_NEXT:%.*]], %[[INNER_LATCH:.*]] ]
+; CHECK-NEXT:    br i1 [[TMP1]], label %[[TRAP:.*]], label %[[INNER_LATCH]]
+; CHECK:       [[INNER_LATCH]]:
+; CHECK-NEXT:    [[IDX:%.*]] = add i64 [[ROW]], [[J]]
+; CHECK-NEXT:    [[GEP:%.*]] = getelementptr i8, ptr [[P]], i64 [[IDX]]
+; CHECK-NEXT:    store i8 0, ptr [[GEP]], align 1
+; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
+; CHECK-NEXT:    [[MORE:%.*]] = icmp slt i64 [[J_NEXT]], [[M]]
+; CHECK-NEXT:    br i1 [[MORE]], label %[[INNER_BODY]], label %[[OUTER_LATCH]]
+; CHECK:       [[OUTER_LATCH]]:
+; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
+; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT_LOOPEXIT:.*]], label %[[OUTER]]
+; CHECK:       [[EXIT_LOOPEXIT]]:
+; CHECK-NEXT:    br label %[[EXIT]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+; CHECK:       [[TRAP]]:
+; CHECK-NEXT:    call void @llvm.trap()
+; CHECK-NEXT:    unreachable
+;
+entry:
+  %enter.outer = icmp sgt i64 %n, 0
+  %enter.inner = icmp sgt i64 %m, 0
+  %enter = and i1 %enter.outer, %enter.inner
+  br i1 %enter, label %outer, label %exit
+
+outer:
+  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
+  %row = mul i64 %i, %m
+  br label %inner.body
+
+inner.body:
+  %j = phi i64 [ 0, %outer ], [ %j.next, %inner.latch ]
+  %oob = icmp sge i64 %j, %k
+  br i1 %oob, label %trap, label %inner.latch
+
+inner.latch:
+  %idx = add i64 %row, %j
+  %gep = getelementptr i8, ptr %p, i64 %idx
+  store i8 0, ptr %gep
+  %j.next = add nuw nsw i64 %j, 1
+  %more = icmp slt i64 %j.next, %m
+  br i1 %more, label %inner.body, label %outer.latch
+
+outer.latch:
+  %i.next = add i64 %i, 1
+  %done = icmp eq i64 %i.next, %n
+  br i1 %done, label %exit, label %outer
+
+exit:
+  ret void
+
+trap:
+  call void @llvm.trap()
+  unreachable
+}
