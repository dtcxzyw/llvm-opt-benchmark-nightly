+; CHECK-NEXT:    [[COND:%.*]] = xor i1 [[C]], false
+; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i32 21, i32 13
+; CHECK-NEXT:    [[OTHER:%.*]] = select i1 [[COND]], i32 136, i32 128
+; CHECK-NEXT:    [[SUM:%.*]] = add nuw nsw i32 [[OTHER]], [[BITS]]
