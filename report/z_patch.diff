+        AccessAlign = LI->getAlign();
+      } else if (auto *SI = dyn_cast<StoreInst>(U)) {
+        // Storing the pointer (into GV) is not an access to the allocation.
+        if (VUse.getOperandNo() != SI->getPointerOperandIndex())
+          continue;
+        AccessAlign = SI->getAlign();
