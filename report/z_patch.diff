+; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
+; CHECK-NEXT:    [[O:%.*]] = or i8 [[X]], 32
+; CHECK-NEXT:    [[CMP:%.*]] = icmp ult i8 [[O]], 40
+; CHECK-NEXT:    ret i1 [[CMP]]
+;
+  %c = icmp uge i8 %x, 8
+  call void @llvm.assume(i1 %c)
+  %o = or i8 %x, 32
+  %cmp = icmp ult i8 %o, 40
+  ret i1 %cmp
+}
