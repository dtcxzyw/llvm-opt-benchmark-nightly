+; CHECK-NEXT:  Loop %outer: constant max backedge-taken count is i64 -1
+; CHECK-NEXT:  Loop %outer: symbolic max backedge-taken count is (-1 + %b)
+; CHECK-NEXT:  Loop %outer: Trip multiple is 1
