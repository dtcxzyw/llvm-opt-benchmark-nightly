diff --git a/llvm/test/Analysis/ScalarEvolution/max-backedge-taken-count-correlated-end.ll b/llvm/test/Analysis/ScalarEvolution/max-backedge-taken-count-correlated-end.ll
new file mode 100644
index 0000000000000..3a47cf8dbbcd7
--- /dev/null
+++ b/llvm/test/Analysis/ScalarEvolution/max-backedge-taken-count-correlated-end.ll
@@ -0,0 +1,140 @@
+; RUN: opt < %s -disable-output "-passes=print<scalar-evolution>" 2>&1 | FileCheck %s
+
+; The maximum backedge-taken count is derived from the ranges of Start, End and
+; Stride read independently. For the "i = A; i < A + N" shape that on its own
+; loses the correlation between the two ends, so the range of the difference
+; (A + N) - A is used as well.
+
+define void @lt_end_is_start_plus_bounded_n(i8 %nraw, i8 %a) {
+; CHECK-LABEL: 'lt_end_is_start_plus_bounded_n'
+; CHECK:       Determining loop execution counts for: @lt_end_is_start_plus_bounded_n
+; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-1 * %a) + (((zext i3 (trunc i8 %nraw to i3) to i8) + %a) umax %a))
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 7
+;
+entry:
+  %n = and i8 %nraw, 7
+  %end = add i8 %a, %n
+  br label %loop
+
+loop:
+  %iv = phi i8 [ %a, %entry ], [ %iv.next, %loop ]
+  %iv.next = add i8 %iv, 1
+  %c = icmp ult i8 %iv, %end
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+define void @slt_end_is_start_plus_bounded_n(i8 %nraw, i8 %a) {
+; CHECK-LABEL: 'slt_end_is_start_plus_bounded_n'
+; CHECK:       Determining loop execution counts for: @slt_end_is_start_plus_bounded_n
+; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-1 * %a) + (((zext i3 (trunc i8 %nraw to i3) to i8) + %a)<nsw> smax %a))
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 7
+;
+entry:
+  %n = and i8 %nraw, 7
+  %end = add nsw i8 %a, %n
+  br label %loop
+
+loop:
+  %iv = phi i8 [ %a, %entry ], [ %iv.next, %loop ]
+  %iv.next = add nsw i8 %iv, 1
+  %c = icmp slt i8 %iv, %end
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; The bounded distance is divided by the stride.
+
+define void @lt_end_is_start_plus_bounded_n_stride_3(i8 %nraw, i8 %a) {
+; CHECK-LABEL: 'lt_end_is_start_plus_bounded_n_stride_3'
+; CHECK:       Determining loop execution counts for: @lt_end_is_start_plus_bounded_n_stride_3
+; CHECK:       Loop %loop: constant max backedge-taken count is i8 3
+;
+entry:
+  %n = and i8 %nraw, 7
+  %end = add nuw nsw i8 %a, %n
+  br label %loop
+
+loop:
+  %iv = phi i8 [ %a, %entry ], [ %iv.next, %loop ]
+  %iv.next = add nuw nsw i8 %iv, 3
+  %c = icmp ult i8 %iv, %end
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Negative test: the exit test is on %iv.next, so Start is A + 1 and the
+; difference End - Start is N - 1, which wraps for N == 0.
+
+define void @lt_difference_may_wrap(i8 %nraw, i8 %a) {
+; CHECK-LABEL: 'lt_difference_may_wrap'
+; CHECK:       Determining loop execution counts for: @lt_difference_may_wrap
+; CHECK-NEXT:  Loop %loop: backedge-taken count is (-1 + (-1 * %a) + ((1 + %a) umax ((zext i3 (trunc i8 %nraw to i3) to i8) + %a)))
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 -1
+;
+entry:
+  %n = and i8 %nraw, 7
+  %end = add i8 %a, %n
+  br label %loop
+
+loop:
+  %iv = phi i8 [ %a, %entry ], [ %iv.next, %loop ]
+  %iv.next = add i8 %iv, 1
+  %c = icmp ult i8 %iv.next, %end
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; Negative test: N is unbounded, so the difference says nothing.
+
+define void @lt_end_is_start_plus_unbounded_n(i8 %n, i8 %a) {
+; CHECK-LABEL: 'lt_end_is_start_plus_unbounded_n'
+; CHECK:       Determining loop execution counts for: @lt_end_is_start_plus_unbounded_n
+; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-1 * %a) + ((%n + %a) umax %a))
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 -1
+;
+entry:
+  %end = add i8 %a, %n
+  br label %loop
+
+loop:
+  %iv = phi i8 [ %a, %entry ], [ %iv.next, %loop ]
+  %iv.next = add i8 %iv, 1
+  %c = icmp ult i8 %iv, %end
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+; The "i = A; i > A - N" mirror. howManyGreaterThans open-codes its own maximum,
+; so it does not benefit yet.
+
+define void @gt_end_is_start_minus_bounded_n(i8 %nraw, i8 %a) {
+; CHECK-LABEL: 'gt_end_is_start_minus_bounded_n'
+; CHECK:       Determining loop execution counts for: @gt_end_is_start_minus_bounded_n
+; CHECK-NEXT:  Loop %loop: backedge-taken count is ((-1 * (((-1 * (zext i3 (trunc i8 %nraw to i3) to i8))<nsw> + %a) umin %a)) + %a)
+; CHECK-NEXT:  Loop %loop: constant max backedge-taken count is i8 -1
+;
+entry:
+  %n = and i8 %nraw, 7
+  %end = sub i8 %a, %n
+  br label %loop
+
+loop:
+  %iv = phi i8 [ %a, %entry ], [ %iv.next, %loop ]
+  %iv.next = sub i8 %iv, 1
+  %c = icmp ugt i8 %iv, %end
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
