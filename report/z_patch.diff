+; CHECK:       common.ret:
+; CHECK-NEXT:    ret void
+; CHECK:       normal:
+; CHECK-NEXT:    [[CLAMP:%.*]] = or i64 [[Y:%.*]], 1
+; CHECK-NEXT:    [[MIN:%.*]] = call i64 @llvm.umin.i64(i64 [[ADD]], i64 [[CLAMP]])
+; CHECK-NEXT:    call void @use(i64 [[MIN]])
+; CHECK-NEXT:    call void @sink_nonzero()
+; CHECK-NEXT:    br label [[COMMON_RET]]
