+; CHECK-NEXT:      i8 12, label %[[EXIT]]
+; CHECK-NEXT:      i8 11, label %[[EXIT]]
+; CHECK-NEXT:      i8 18, label %[[SW_BB1:.*]]
+; CHECK-NEXT:      i8 17, label %[[SW_BB2:.*]]
