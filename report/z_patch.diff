+declare void @escape(ptr)
+
+; %buf only escapes after the loops, so the loaded pointer cannot be based on it.
+define void @load_escape_after_loop(ptr %data, ptr %pp, i1 %c, i64 %n) {
+; CHECK-LABEL: define void @load_escape_after_loop(
+; CHECK-SAME: ptr [[DATA:%.*]], ptr [[PP:%.*]], i1 [[C:%.*]], i64 [[N:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    [[BUF:%.*]] = alloca [16 x i8], align 1
+; CHECK-NEXT:    br label %[[OUTER:.*]]
+; CHECK:       [[OUTER]]:
