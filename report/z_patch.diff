+/// Reconstruct shuffle results from their selected source lanes. Inputs may be
+/// existing vectors or concats of adjacent loads; the masks follow from the
+/// lane mapping rather than a particular type, width or interleave pattern.
+bool VectorCombine::foldShuffleTree(Instruction &I, bool RequireConcat) {
+  auto *Root = cast<ShuffleVectorInst>(&I);
+  if (Root->use_empty() || none_of(Root->operands(), [](Value *V) {
+        return isa<ShuffleVectorInst>(V);
+      }))
+    return false;
+
+  // A null second value denotes an existing input; otherwise concatenate them.
+  using Input = std::pair<Value *, Value *>;
+  struct Plan {
+    ShuffleVectorInst *Root;
+    FixedVectorType *InputTy;
+    SmallVector<Input, 2> Inputs;
+    SmallVector<int, 16> Mask;
+  };
+  SmallPtrSet<ShuffleVectorInst *, 16> Visited;
+  auto Analyze = [&](ShuffleVectorInst *R, Plan &P) {
+    P.Root = R;
+    // Bound the walk before tracing individual lanes through the same DAG.
+    SmallVector<ShuffleVectorInst *, 16> Pending{R};
+    while (!Pending.empty()) {
+      auto *S = Pending.pop_back_val();
+      if (!Visited.insert(S).second)
+        continue;
+      if (S->getParent() != Root->getParent() ||
+          Visited.size() > Opts.vector_combine_max_scan_instrs)
+        return false;
+      for (Value *V : S->operands())
+        if (auto *Op = dyn_cast<ShuffleVectorInst>(V))
+          Pending.push_back(Op);
+    }
+
+    SmallVector<InstLane> Lanes;
+    SmallVector<Value *, 4> Sources;
+    for (unsigned Lane = 0, E = R->getShuffleMask().size(); Lane != E; ++Lane) {
+      auto IL = lookThroughShuffles(R, Lane);
+      if (isa_and_nonnull<PoisonValue>(IL.first))
+        IL = {nullptr, PoisonMaskElem};
+      if (IL.first) {
+        if (isa<UndefValue>(IL.first))
+          return false;
+        if (!is_contained(Sources, IL.first))
+          Sources.push_back(IL.first);
+      }
+      Lanes.push_back(IL);
+    }
+    if (Sources.empty())
+      return false;
+    auto *Ty = dyn_cast<FixedVectorType>(Sources.front()->getType());
+    if (!Ty || any_of(Sources, [&](Value *V) { return V->getType() != Ty; }))
+      return false;
+    P.InputTy = Ty;
+    if (Sources.size() <= R->getNumOperands()) {
+      for (Value *V : Sources)
+        P.Inputs.emplace_back(V, nullptr);
+    } else {
+      struct LoadInfo {
+        LoadInst *Load;
+        Value *Base;
+        int64_t Offset;
+      };
+      SmallVector<LoadInfo, 4> Loads;
+      for (Value *V : Sources) {
+        auto *LI = dyn_cast<LoadInst>(V);
+        if (!LI || !LI->isSimple() || LI->getParent() != R->getParent())
+          return false;
+        int64_t Offset;
+        Value *Base = GetPointerBaseWithConstantOffset(LI->getPointerOperand(),
+                                                       Offset, *DL);
+        Loads.push_back({LI, Base, Offset});
+      }
+      // Group each address stream in memory order, independent of lane order.
+      while (!Loads.empty()) {
+        auto First = Loads.begin();
+        for (auto It = std::next(First); It != Loads.end(); ++It)
+          if (It->Base == First->Base && It->Offset < First->Offset)
+            First = It;
+        LoadInfo Low = *First;
+        Loads.erase(First);
+        auto Next = find_if(Loads, [&](const LoadInfo &L) {
+          return L.Base == Low.Base &&
+                 uint64_t(L.Offset) - uint64_t(Low.Offset) ==
+                     DL->getTypeStoreSize(Ty);
+        });
+        if (Next == Loads.end())
+          return false;
+        P.Inputs.emplace_back(Low.Load, Next->Load);
+        Loads.erase(Next);
+        if (P.Inputs.size() > R->getNumOperands())
+          return false;
+      }
+      P.InputTy = FixedVectorType::getDoubleElementsVectorType(Ty);
+      if (!TTI.isTypeLegal(P.InputTy))
+        return false;
+    }
+
+    for (auto [V, Lane] : Lanes) {
+      int M = PoisonMaskElem;
+      if (V) {
+        for (auto [Index, In] : enumerate(P.Inputs)) {
+          if (V == In.first)
+            M = Index * P.InputTy->getNumElements() + Lane;
+          else if (V == In.second)
+            M = Index * P.InputTy->getNumElements() + Ty->getNumElements() +
+                Lane;
+        }
+        assert(M != PoisonMaskElem && "Unmapped source lane");
+      }
+      P.Mask.push_back(M);
+    }
+    return true;
+  };
+
+  SmallVector<Plan, 2> Plans(1);
+  if (!Analyze(Root, Plans.front()))
+    return false;
+  if (RequireConcat &&
+      none_of(Plans.front().Inputs, [](Input In) { return In.second; }))
+    return false;
+  auto GetCosts = [&]() -> std::pair<InstructionCost, InstructionCost> {
+    SmallPtrSet<Value *, 16> Dead;
+    SmallVector<ShuffleVectorInst *, 16> Removed;
+    for (auto &P : Plans) {
+      Dead.insert(P.Root);
+      Removed.push_back(P.Root);
+    }
+    InstructionCost OldCost = 0, NewCost = 0;
+    // Credit an ancestor only after every user will be removed. In particular,
+    // shared ancestors are counted once, rather than once per output.
+    for (unsigned Index = 0; Index != Removed.size(); ++Index) {
+      auto *S = Removed[Index];
+      OldCost += TTI.getInstructionCost(S, CostKind);
+      for (Value *V : S->operands())
+        if (auto *Op = dyn_cast<ShuffleVectorInst>(V);
+            Op && !Dead.contains(Op) &&
+            all_of(Op->users(), [&](User *U) { return Dead.contains(U); })) {
+          Dead.insert(Op);
+          Removed.push_back(Op);
+        }
+    }
+    SmallVector<Input, 4> Concats;
+    for (auto &P : Plans) {
+      for (auto In : P.Inputs) {
+        if (!In.second || is_contained(Concats, In))
+          continue;
+        // A load retained by other users cannot participate in load combining.
+        if (any_of(In.first->users(),
+                   [&](User *U) { return !Dead.contains(U); }) ||
+            any_of(In.second->users(),
+                   [&](User *U) { return !Dead.contains(U); }))
+          return {OldCost, InstructionCost::getInvalid()};
+        Concats.push_back(In);
+        SmallVector<int, 16> Mask(P.InputTy->getNumElements());
+        std::iota(Mask.begin(), Mask.end(), 0);
+        InstructionCost ConcatCost = TTI.getShuffleCost(
+            TTI::SK_PermuteTwoSrc, P.InputTy,
+            cast<VectorType>(In.first->getType()), CostKind, Mask);
+        if (CostKind == TTI::TCK_CodeSize && ConcatCost != 0) {
+          // A paid concat may retain separate loads and insertions. Do not
+          // speculate on folding it into a wider load when that access is slow
+          // or unsupported; the shuffle costs do not account for this choice.
+          auto *Low = cast<LoadInst>(In.first);
+          auto *High = cast<LoadInst>(In.second);
+          uint64_t WideSize = DL->getTypeStoreSize(P.InputTy);
+          if (WideSize != DL->getTypeStoreSize(Low->getType()) +
+                              DL->getTypeStoreSize(High->getType()) ||
+              Low->getPointerAddressSpace() != High->getPointerAddressSpace())
+            return {OldCost, InstructionCost::getInvalid()};
+          unsigned Fast = 0;
+          if (Low->getAlign().value() < WideSize &&
+              (!TTI.allowsMisalignedMemoryAccesses(
+                   I.getContext(), DL->getTypeSizeInBits(P.InputTy),
+                   Low->getPointerAddressSpace(), Low->getAlign(), &Fast) ||
+               !Fast))
+            return {OldCost, InstructionCost::getInvalid()};
+          auto *First = Low, *Last = High;
+          if (Last->comesBefore(First))
+            std::swap(First, Last);
+          MemoryLocation Loc(Low->getPointerOperand(),
+                             LocationSize::precise(WideSize));
+          auto Begin = std::next(First->getIterator());
+          auto End = Last->getIterator();
+          if (isMemModifiedBetween(Opts, Begin, End, Loc, AA))
+            return {OldCost, InstructionCost::getInvalid()};
+          // Even a readonly call can prevent load folding across the call's
+          // register clobbers. Only free intrinsics are transparent here.
+          if (any_of(make_range(Begin, End), [&](Instruction &Inst) {
+                return isa<CallBase>(Inst) &&
+                       (!isa<IntrinsicInst>(Inst) ||
+                        TTI.getInstructionCost(&Inst, CostKind) != 0);
+              }))
+            return {OldCost, InstructionCost::getInvalid()};
+        }
+        NewCost += ConcatCost;
+      }
+      if (ShuffleVectorInst::isIdentityMask(P.Mask,
+                                            P.InputTy->getNumElements()))
+        continue;
+      SmallVector<const Value *, 2> Args;
+      if (none_of(P.Inputs, [](Input In) { return In.second != nullptr; })) {
+        Args.push_back(P.Inputs.front().first);
+        Args.push_back(P.Inputs.size() == 1 ? PoisonValue::get(P.InputTy)
+                                            : P.Inputs.back().first);
+      }
+      NewCost += TTI.getShuffleCost(
+          P.Inputs.size() == 1 ? TTI::SK_PermuteSingleSrc
+                               : TTI::SK_PermuteTwoSrc,
+          P.Root->getType(), P.InputTy, CostKind, P.Mask, 0, nullptr, Args);
+    }
+    return {OldCost, NewCost};
+  };
+  auto [OldCost, NewCost] = GetCosts();
+  if (!NewCost.isValid() || !OldCost.isValid() || NewCost >= OldCost) {
+    // A single output may not pay for retaining its shared inputs. Retry the
+    // complete set of shuffle users of the same inputs as one replacement.
+    auto *A = dyn_cast<ShuffleVectorInst>(Root->getOperand(0));
+    auto *B = dyn_cast<ShuffleVectorInst>(Root->getOperand(1));
+    if (!A || !B || A == B)
+      return false;
+    SmallPtrSet<Value *, 4> Outputs{Root};
+    for (User *U : A->users()) {
+      auto *Other = dyn_cast<ShuffleVectorInst>(U);
+      if (!Other || Other->use_empty() ||
+          !((Other->getOperand(0) == A && Other->getOperand(1) == B) ||
+            (Other->getOperand(0) == B && Other->getOperand(1) == A)))
+        return false;
+      if (Outputs.insert(Other).second) {
+        Plans.emplace_back();
+        if (!Analyze(Other, Plans.back()))
+          return false;
+      }
+    }
+    if (Plans.size() == 1 ||
+        any_of(B->users(), [&](User *U) { return !Outputs.contains(U); }))
+      return false;
+    std::tie(OldCost, NewCost) = GetCosts();
+    if (!NewCost.isValid() || !OldCost.isValid() || NewCost >= OldCost)
+      return false;
+  }
+
+  LLVM_DEBUG(dbgs() << "Reconstructing " << Plans.size() << " shuffle results: "
+                    << I << "\n  OldCost: " << OldCost
+                    << " vs NewCost: " << NewCost << "\n");
+  sort(Plans, [](const Plan &A, const Plan &B) {
+    return A.Root->comesBefore(B.Root);
+  });
+  DenseMap<Input, Value *> Concats;
+  SmallVector<std::pair<Instruction *, Value *>, 2> Replacements;
+  for (auto &P : Plans) {
+    Builder.SetInsertPoint(P.Root);
+    Builder.SetCurrentDebugLocation(P.Root->getDebugLoc());
+    SmallVector<Value *, 2> Args;
+    for (auto In : P.Inputs) {
+      Value *V = In.first;
+      if (In.second) {
+        auto [It, Inserted] = Concats.try_emplace(In, nullptr);
+        if (Inserted) {
+          SmallVector<int, 16> Mask(P.InputTy->getNumElements());
+          std::iota(Mask.begin(), Mask.end(), 0);
+          It->second = Builder.CreateShuffleVector(In.first, In.second, Mask);
+        }
+        V = It->second;
+      }
+      Args.push_back(V);
+    }
+    if (Args.size() == 1)
+      Args.push_back(PoisonValue::get(P.InputTy));
+    Replacements.emplace_back(
+        P.Root, Builder.CreateShuffleVector(Args.front(), Args.back(), P.Mask));
+  }
+  // A sibling may be the next instruction in the forward scan. Defer erasure
+  // to the worklist, as in foldSelectShuffle.
+  for (auto [Old, New] : Replacements)
+    replaceValue(*Old, *New, /*Erase=*/false);
+  return true;
+}
