+; Changing the value preserved across a call can require another move.
+define i64 @across_call_optsize(i1 noundef %cond, i64 %x, i64 %y, ptr %out) optsize "target-cpu"="x86-64" {
+; CHECK-LABEL: define range(i64 16384, 4194305) i64 @across_call_optsize(
+; CHECK-SAME: i1 noundef [[COND:%.*]], i64 [[X:%.*]], i64 [[Y:%.*]], ptr [[OUT:%.*]]) #[[ATTR0]] {
+; CHECK-NEXT:    [[BITS:%.*]] = select i1 [[COND]], i64 23, i64 15
+; CHECK-NEXT:    [[OTHER:%.*]] = select i1 [[COND]], i64 4, i64 -4
+; CHECK-NEXT:    [[LEFT:%.*]] = add i64 [[BITS]], [[X]]
+; CHECK-NEXT:    [[RIGHT:%.*]] = sub i64 [[OTHER]], [[Y]]
