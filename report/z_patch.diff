+; CHECK-NEXT:    [[IV_NEXT]] = add nsw i8 [[IV]], 1
+; CHECK-NEXT:    [[EC:%.*]] = call i1 @cond()
+; CHECK-NEXT:    br i1 [[EC]], label [[LOOP]], label [[EXIT:%.*]]
+; CHECK:       exit:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %loop
+loop:
+  %iv = phi i8 [ -1, %entry ], [ %iv.next, %loop ]
+  %must.not.fold = icmp uge i8 %iv, -1
+  call void @use(i1 %must.not.fold)
+  %may.fold = icmp sge i8 %iv, -1
+  call void @use(i1 %may.fold)
+  %iv.next = add nsw i8 %iv, 1
+  %ec = call i1 @cond()
+  br i1 %ec, label %loop, label %exit
+exit:
+  ret void
+}
+
+; A negative step must give no lower bound in either sense.
+define void @negative_step_must_not_fold() {
+; CHECK-LABEL: @negative_step_must_not_fold(
