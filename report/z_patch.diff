+  %is.max = icmp eq i8 %n, 127
+  br i1 %is.max, label %exit, label %loop
+
+loop:
+  %iv = phi i8 [ 0, %entry ], [ %iv.next, %loop ]
+  %iv.next = add i8 %iv, 2
+  %c = icmp slt i8 %iv.next, %n.plus.one
+  br i1 %c, label %loop, label %exit
+
+exit:
+  ret void
+}
+
+define void @ptr_iv_stride2(ptr %start, ptr %end) {
+; CHECK-LABEL: 'ptr_iv_stride2'
+; CHECK-NEXT:  Determining loop execution counts for: @ptr_iv_stride2
+; CHECK-NEXT:  Loop %loop: Unpredictable backedge-taken count.
+; CHECK-NEXT:  Loop %loop: Unpredictable constant max backedge-taken count.
+; CHECK-NEXT:  Loop %loop: Unpredictable symbolic max backedge-taken count.
+;
+entry:
