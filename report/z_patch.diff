diff --git a/llvm/test/Transforms/ConstraintElimination/retry-without-decomposition.ll b/llvm/test/Transforms/ConstraintElimination/retry-without-decomposition.ll
new file mode 100644
index 0000000000000..55ad13bba8581
--- /dev/null
+++ b/llvm/test/Transforms/ConstraintElimination/retry-without-decomposition.ll
@@ -0,0 +1,46 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=constraint-elimination -S %s | FileCheck %s
+
+
+; %add = add nsw %x, %y decomposes to %x + %y, which requires %x >=s 0 and
+; %y >=s 0. Those preconditions are unknown here, but %t can be proven without
+; decomposition.
+define i1 @retry_recovers_uge(i16 %x, i16 %y, i16 %z) {
+; CHECK-LABEL: define i1 @retry_recovers_uge(
+; CHECK-SAME: i16 [[X:%.*]], i16 [[Y:%.*]], i16 [[Z:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[ADD:%.*]] = add nsw i16 [[X]], [[Y]]
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i16 [[ADD]], [[Z]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
+; CHECK-NEXT:    [[T:%.*]] = icmp uge i16 [[ADD]], [[Z]]
+; CHECK-NEXT:    ret i1 [[T]]
+;
+entry:
+  %add = add nsw i16 %x, %y
+  %c = icmp ugt i16 %add, %z
+  call void @llvm.assume(i1 %c)
+  %t = icmp uge i16 %add, %z
+  ret i1 %t
+}
+
+; Same as @retry_recovers_uge, but with preconditions holding.
+define i1 @decompose_used_when_precondition_holds(i16 %x, i16 %y, i16 %z) {
+; CHECK-LABEL: define i1 @decompose_used_when_precondition_holds(
+; CHECK-SAME: i16 [[X:%.*]], i16 [[Y:%.*]], i16 [[Z:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[X_POS:%.*]] = and i16 [[X]], 127
+; CHECK-NEXT:    [[Y_POS:%.*]] = and i16 [[Y]], 127
+; CHECK-NEXT:    [[ADD:%.*]] = add nsw i16 [[X_POS]], [[Y_POS]]
+; CHECK-NEXT:    [[C:%.*]] = icmp ugt i16 [[ADD]], [[Z]]
+; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
+; CHECK-NEXT:    ret i1 true
+;
+entry:
+  %x.pos = and i16 %x, 127
+  %y.pos = and i16 %y, 127
+  %add = add nsw i16 %x.pos, %y.pos
+  %c = icmp ugt i16 %add, %z
+  call void @llvm.assume(i1 %c)
+  %t = icmp uge i16 %add, %z
+  ret i1 %t
+}
