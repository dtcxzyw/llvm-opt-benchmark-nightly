diff --git a/llvm/lib/Transforms/Scalar/ConstraintElimination.cpp b/llvm/lib/Transforms/Scalar/ConstraintElimination.cpp
index 7f9afe1be6e0e..df0ab8d96df18 100644
--- a/llvm/lib/Transforms/Scalar/ConstraintElimination.cpp
+++ b/llvm/lib/Transforms/Scalar/ConstraintElimination.cpp
@@ -662,6 +662,17 @@ static Decomposition decompose(Value *V,
     return V;
   }
 
+  // A `sub nsw Op0, Op1` equals Op0 - Op1 in the unsigned system as long as the
+  // result is non-negative (Op1 <= Op0), which is recorded as a precondition.
+  if (match(V, m_NSWSub(m_Value(Op0), m_Value(Op1)))) {
+    Preconditions.emplace_back(CmpInst::ICMP_ULE, Op1, Op0);
+    auto ResA = decompose(Op0, Preconditions, IsSigned, DL);
+    auto ResB = decompose(Op1, Preconditions, IsSigned, DL);
+    if (!ResA.sub(ResB))
+      return ResA;
+    return V;
+  }
+
   return V;
 }
 
diff --git a/llvm/test/Transforms/ConstraintElimination/sub-nsw-unsigned.ll b/llvm/test/Transforms/ConstraintElimination/sub-nsw-unsigned.ll
new file mode 100644
index 0000000000000..f2c967a00c676
--- /dev/null
+++ b/llvm/test/Transforms/ConstraintElimination/sub-nsw-unsigned.ll
@@ -0,0 +1,80 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt < %s -passes=constraint-elimination -S | FileCheck %s
+
+; Tests the unsigned decompose() of `sub nsw a, b` -> `a - b` in
+; ConstraintElimination, valid only under the recorded precondition `b u<= a`.
+; A bounds-check `icmp ule (sub nsw len, b), len` folds to true only when a
+; dominating guard establishes `b u<= len`; 
+
+; POSITIVE: dominating guard `b u<= len` establishes the precondition,
+; bounds check folds to true.
+define i1 @sub_nsw_inbounds(i64 %len, i64 %b) {
+; CHECK-LABEL: define i1 @sub_nsw_inbounds(
+; CHECK-SAME: i64 [[LEN:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[VALID:%.*]] = icmp ule i64 [[B]], [[LEN]]
+; CHECK-NEXT:    br i1 [[VALID]], label %[[USE:.*]], label %[[EXIT:.*]]
+; CHECK:       [[USE]]:
+; CHECK-NEXT:    [[OFF:%.*]] = sub nsw i64 [[LEN]], [[B]]
+; CHECK-NEXT:    ret i1 true
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %valid = icmp ule i64 %b, %len
+  br i1 %valid, label %use, label %exit
+
+use:
+  %off = sub nsw i64 %len, %b
+  %inbounds = icmp ule i64 %off, %len
+  ret i1 %inbounds
+
+exit:
+  ret i1 false
+}
+
+; NEGATIVE: no dominating guard, so `b` is unconstrained and the precondition
+; `b u<= len` cannot be established. 
+; bounds check is preserved.
+define i1 @no_precondition(i64 %len, i64 %b) {
+; CHECK-LABEL: define i1 @no_precondition(
+; CHECK-SAME: i64 [[LEN:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[OFF:%.*]] = sub nsw i64 [[LEN]], [[B]]
+; CHECK-NEXT:    [[INBOUNDS:%.*]] = icmp ule i64 [[OFF]], [[LEN]]
+; CHECK-NEXT:    ret i1 [[INBOUNDS]]
+;
+entry:
+  %off = sub nsw i64 %len, %b
+  %inbounds = icmp ule i64 %off, %len
+  ret i1 %inbounds
+}
+
+; NEGATIVE: same guarded shape as the positive case but the subtraction has no
+; nsw flag, so it is not matched by m_NSWSub and stays opaque; the bounds check
+; is preserved.
+define i1 @plain_sub(i64 %len, i64 %b) {
+; CHECK-LABEL: define i1 @plain_sub(
+; CHECK-SAME: i64 [[LEN:%.*]], i64 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    [[VALID:%.*]] = icmp ule i64 [[B]], [[LEN]]
+; CHECK-NEXT:    br i1 [[VALID]], label %[[USE:.*]], label %[[EXIT:.*]]
+; CHECK:       [[USE]]:
+; CHECK-NEXT:    [[OFF:%.*]] = sub i64 [[LEN]], [[B]]
+; CHECK-NEXT:    [[INBOUNDS:%.*]] = icmp ule i64 [[OFF]], [[LEN]]
+; CHECK-NEXT:    ret i1 [[INBOUNDS]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret i1 false
+;
+entry:
+  %valid = icmp ule i64 %b, %len
+  br i1 %valid, label %use, label %exit
+
+use:
+  %off = sub i64 %len, %b
+  %inbounds = icmp ule i64 %off, %len
+  ret i1 %inbounds
+
+exit:
+  ret i1 false
+}
