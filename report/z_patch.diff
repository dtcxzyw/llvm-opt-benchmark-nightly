--- /dev/null
+++ b/llvm/test/Transforms/LoopVectorize/runtime-check-bounds-hoisted-out-of-outer-loop.ll
@@ -0,0 +1,148 @@
+; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
+; RUN: opt -passes=loop-vectorize -force-vector-width=4 -force-vector-interleave=1 -S %s | FileCheck %s
+
+; Bounds for the memory runtime checks are loop-invariant with respect to the
+; enclosing outer loop. They must not be materialized inside vector.memcheck,
+; which is part of the outer loop: that recomputes them on every outer
+; iteration. SCEVExpander hoisted them all the way to the function entry.
+
+
+; Inner loop reading through several pointers derived from one base with
+; different byte offsets, nested in an outer loop.  LAA groups them, so the
+; runtime check needs one bound per group, but the bound *addresses* are
+; loop-invariant w.r.t. the outer loop.
+define void @nested_many_bounds(ptr %dst, ptr %src, i64 %n, i64 %stride) {
+; CHECK-LABEL: define void @nested_many_bounds(
+; CHECK-SAME: ptr [[DST:%.*]], ptr [[SRC:%.*]], i64 [[N:%.*]], i64 [[STRIDE:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*]]:
+; CHECK-NEXT:    br label %[[OUTER:.*]]
+; CHECK:       [[OUTER]]:
+; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[OUTER_LATCH:.*]] ]
+; CHECK-NEXT:    [[OFF:%.*]] = mul nsw i64 [[I]], [[STRIDE]]
+; CHECK-NEXT:    [[S_ROW:%.*]] = getelementptr inbounds i8, ptr [[SRC]], i64 [[OFF]]
+; CHECK-NEXT:    [[D_ROW:%.*]] = getelementptr inbounds i8, ptr [[DST]], i64 [[OFF]]
+; CHECK-NEXT:    [[MIN_ITERS_CHECK:%.*]] = icmp ult i64 [[N]], 4
+; CHECK-NEXT:    br i1 [[MIN_ITERS_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_MEMCHECK:.*]]
+; CHECK:       [[VECTOR_MEMCHECK]]:
+; CHECK-NEXT:    [[TMP0:%.*]] = mul i64 [[STRIDE]], 99
+; CHECK-NEXT:    [[TMP1:%.*]] = shl i64 [[N]], 2
+; CHECK-NEXT:    [[TMP2:%.*]] = add i64 [[TMP0]], [[TMP1]]
+; CHECK-NEXT:    [[TMP3:%.*]] = getelementptr i8, ptr [[DST]], i64 [[TMP2]]
+; CHECK-NEXT:    [[TMP4:%.*]] = add i64 [[TMP2]], 12
+; CHECK-NEXT:    [[TMP5:%.*]] = getelementptr i8, ptr [[SRC]], i64 [[TMP4]]
+; CHECK-NEXT:    [[BOUND0:%.*]] = icmp ult ptr [[DST]], [[TMP5]]
+; CHECK-NEXT:    [[BOUND1:%.*]] = icmp ult ptr [[SRC]], [[TMP3]]
+; CHECK-NEXT:    [[FOUND_CONFLICT:%.*]] = and i1 [[BOUND0]], [[BOUND1]]
+; CHECK-NEXT:    [[STRIDE_CHECK:%.*]] = icmp slt i64 [[STRIDE]], 0
+; CHECK-NEXT:    [[TMP6:%.*]] = or i1 [[FOUND_CONFLICT]], [[STRIDE_CHECK]]
+; CHECK-NEXT:    br i1 [[TMP6]], label %[[SCALAR_PH]], label %[[VECTOR_PH:.*]]
+; CHECK:       [[VECTOR_PH]]:
+; CHECK-NEXT:    [[N_MOD_VF:%.*]] = and i64 [[N]], 3
+; CHECK-NEXT:    [[N_VEC:%.*]] = sub i64 [[N]], [[N_MOD_VF]]
+; CHECK-NEXT:    br label %[[VECTOR_BODY:.*]]
+; CHECK:       [[VECTOR_BODY]]:
+; CHECK-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
+; CHECK-NEXT:    [[TMP7:%.*]] = getelementptr inbounds i32, ptr [[S_ROW]], i64 [[INDEX]]
+; CHECK-NEXT:    [[WIDE_LOAD:%.*]] = load <4 x i32>, ptr [[TMP7]], align 4, !alias.scope [[META0:![0-9]+]]
+; CHECK-NEXT:    [[TMP8:%.*]] = add nuw nsw i64 [[INDEX]], 1
+; CHECK-NEXT:    [[TMP9:%.*]] = getelementptr inbounds i32, ptr [[S_ROW]], i64 [[TMP8]]
+; CHECK-NEXT:    [[WIDE_LOAD2:%.*]] = load <4 x i32>, ptr [[TMP9]], align 4, !alias.scope [[META0]]
+; CHECK-NEXT:    [[TMP10:%.*]] = add nuw nsw i64 [[INDEX]], 2
+; CHECK-NEXT:    [[TMP11:%.*]] = getelementptr inbounds i32, ptr [[S_ROW]], i64 [[TMP10]]
+; CHECK-NEXT:    [[WIDE_LOAD3:%.*]] = load <4 x i32>, ptr [[TMP11]], align 4, !alias.scope [[META0]]
+; CHECK-NEXT:    [[TMP12:%.*]] = add nuw nsw i64 [[INDEX]], 3
+; CHECK-NEXT:    [[TMP13:%.*]] = getelementptr inbounds i32, ptr [[S_ROW]], i64 [[TMP12]]
+; CHECK-NEXT:    [[WIDE_LOAD4:%.*]] = load <4 x i32>, ptr [[TMP13]], align 4, !alias.scope [[META0]]
+; CHECK-NEXT:    [[TMP14:%.*]] = add <4 x i32> [[WIDE_LOAD]], [[WIDE_LOAD2]]
+; CHECK-NEXT:    [[TMP15:%.*]] = add <4 x i32> [[WIDE_LOAD3]], [[WIDE_LOAD4]]
+; CHECK-NEXT:    [[TMP16:%.*]] = add <4 x i32> [[TMP14]], [[TMP15]]
+; CHECK-NEXT:    [[TMP17:%.*]] = getelementptr inbounds i32, ptr [[D_ROW]], i64 [[INDEX]]
+; CHECK-NEXT:    store <4 x i32> [[TMP16]], ptr [[TMP17]], align 4, !alias.scope [[META3:![0-9]+]], !noalias [[META0]]
+; CHECK-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 4
+; CHECK-NEXT:    [[TMP18:%.*]] = icmp eq i64 [[INDEX_NEXT]], [[N_VEC]]
+; CHECK-NEXT:    br i1 [[TMP18]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP5:![0-9]+]]
+; CHECK:       [[MIDDLE_BLOCK]]:
+; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
+; CHECK-NEXT:    br i1 [[CMP_N]], label %[[OUTER_LATCH]], label %[[SCALAR_PH]]
+; CHECK:       [[SCALAR_PH]]:
+; CHECK-NEXT:    [[BC_RESUME_VAL:%.*]] = phi i64 [ [[N_VEC]], %[[MIDDLE_BLOCK]] ], [ 0, %[[OUTER]] ], [ 0, %[[VECTOR_MEMCHECK]] ]
+; CHECK-NEXT:    br label %[[INNER:.*]]
+; CHECK:       [[INNER]]:
+; CHECK-NEXT:    [[J:%.*]] = phi i64 [ [[BC_RESUME_VAL]], %[[SCALAR_PH]] ], [ [[J_NEXT:%.*]], %[[INNER]] ]
+; CHECK-NEXT:    [[P0:%.*]] = getelementptr inbounds i32, ptr [[S_ROW]], i64 [[J]]
+; CHECK-NEXT:    [[V0:%.*]] = load i32, ptr [[P0]], align 4
+; CHECK-NEXT:    [[J1:%.*]] = add nuw nsw i64 [[J]], 1
+; CHECK-NEXT:    [[P1:%.*]] = getelementptr inbounds i32, ptr [[S_ROW]], i64 [[J1]]
+; CHECK-NEXT:    [[V1:%.*]] = load i32, ptr [[P1]], align 4
+; CHECK-NEXT:    [[J2:%.*]] = add nuw nsw i64 [[J]], 2
+; CHECK-NEXT:    [[P2:%.*]] = getelementptr inbounds i32, ptr [[S_ROW]], i64 [[J2]]
+; CHECK-NEXT:    [[V2:%.*]] = load i32, ptr [[P2]], align 4
+; CHECK-NEXT:    [[J3:%.*]] = add nuw nsw i64 [[J]], 3
+; CHECK-NEXT:    [[P3:%.*]] = getelementptr inbounds i32, ptr [[S_ROW]], i64 [[J3]]
+; CHECK-NEXT:    [[V3:%.*]] = load i32, ptr [[P3]], align 4
+; CHECK-NEXT:    [[A:%.*]] = add i32 [[V0]], [[V1]]
+; CHECK-NEXT:    [[B:%.*]] = add i32 [[V2]], [[V3]]
+; CHECK-NEXT:    [[C:%.*]] = add i32 [[A]], [[B]]
+; CHECK-NEXT:    [[Q:%.*]] = getelementptr inbounds i32, ptr [[D_ROW]], i64 [[J]]
+; CHECK-NEXT:    store i32 [[C]], ptr [[Q]], align 4
+; CHECK-NEXT:    [[J_NEXT]] = add nuw nsw i64 [[J]], 1
+; CHECK-NEXT:    [[EC_INNER:%.*]] = icmp eq i64 [[J_NEXT]], [[N]]
+; CHECK-NEXT:    br i1 [[EC_INNER]], label %[[OUTER_LATCH]], label %[[INNER]], !llvm.loop [[LOOP8:![0-9]+]]
+; CHECK:       [[OUTER_LATCH]]:
+; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
+; CHECK-NEXT:    [[EC_OUTER:%.*]] = icmp eq i64 [[I_NEXT]], 100
+; CHECK-NEXT:    br i1 [[EC_OUTER]], label %[[EXIT:.*]], label %[[OUTER]]
+; CHECK:       [[EXIT]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br label %outer
+
+outer:
+  %i = phi i64 [ 0, %entry ], [ %i.next, %outer.latch ]
+  %off = mul nsw i64 %i, %stride
+  %s.row = getelementptr inbounds i8, ptr %src, i64 %off
+  %d.row = getelementptr inbounds i8, ptr %dst, i64 %off
+  br label %inner
+
+inner:
+  %j = phi i64 [ 0, %outer ], [ %j.next, %inner ]
+  %p0 = getelementptr inbounds i32, ptr %s.row, i64 %j
+  %v0 = load i32, ptr %p0, align 4
+  %j1 = add nuw nsw i64 %j, 1
+  %p1 = getelementptr inbounds i32, ptr %s.row, i64 %j1
+  %v1 = load i32, ptr %p1, align 4
+  %j2 = add nuw nsw i64 %j, 2
+  %p2 = getelementptr inbounds i32, ptr %s.row, i64 %j2
+  %v2 = load i32, ptr %p2, align 4
+  %j3 = add nuw nsw i64 %j, 3
+  %p3 = getelementptr inbounds i32, ptr %s.row, i64 %j3
+  %v3 = load i32, ptr %p3, align 4
+  %a = add i32 %v0, %v1
+  %b = add i32 %v2, %v3
+  %c = add i32 %a, %b
+  %q = getelementptr inbounds i32, ptr %d.row, i64 %j
+  store i32 %c, ptr %q, align 4
+  %j.next = add nuw nsw i64 %j, 1
+  %ec.inner = icmp eq i64 %j.next, %n
+  br i1 %ec.inner, label %outer.latch, label %inner
+
