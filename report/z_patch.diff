+
+    User *Usr = U->getUser();
+    if (isa<LifetimeIntrinsic>(Usr) || isa<DbgInfoIntrinsic>(Usr))
+      continue;
+
+    if (!isa<MemIntrinsic>(Usr))
+      return nullptr;
+  }
+
