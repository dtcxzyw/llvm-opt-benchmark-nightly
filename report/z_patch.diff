+; Negative test: the assume is fed by a phi, which can't be cloned.
+define void @phi_feeding_assume(ptr %storage, i32 %idx, i1 %c, i32 %a, i32 %b) {
+; CHECK-LABEL: define void @phi_feeding_assume(
+; CHECK-SAME: ptr [[STORAGE:%.*]], i32 [[IDX:%.*]], i1 [[C:%.*]], i32 [[A:%.*]], i32 [[B:%.*]]) {
+; CHECK-NEXT:  [[ENTRY:.*:]]
+; CHECK-NEXT:    br i1 [[C]], label %[[PRED1:.*]], label %[[PRED2:.*]]
+; CHECK:       [[PRED1]]:
+; CHECK-NEXT:    [[VALUELESS1:%.*]] = icmp eq i32 [[IDX]], -1
+; CHECK-NEXT:    br i1 [[VALUELESS1]], label %[[DONE:.*]], label %[[DISPATCH:.*]]
+; CHECK:       [[PRED2]]:
+; CHECK-NEXT:    [[VALUELESS2:%.*]] = icmp eq i32 [[IDX]], 5
+; CHECK-NEXT:    br i1 [[VALUELESS2]], label %[[DONE]], label %[[DISPATCH]]
+; CHECK:       [[DISPATCH]]:
+; CHECK-NEXT:    [[PHI:%.*]] = phi i32 [ [[A]], %[[PRED1]] ], [ [[B]], %[[PRED2]] ]
+; CHECK-NEXT:    [[IS0:%.*]] = icmp eq i32 [[IDX]], 0
+; CHECK-NEXT:    [[INRANGE:%.*]] = icmp ult i32 [[PHI]], 2
+; CHECK-NEXT:    call void @llvm.assume(i1 [[INRANGE]])
+; CHECK-NEXT:    br i1 [[IS0]], label %[[CALL0:.*]], label %[[CALL1:.*]]
+; CHECK:       [[CALL0]]:
+; CHECK-NEXT:    call void @fun0(ptr [[STORAGE]], i32 [[IDX]])
+; CHECK-NEXT:    br label %[[DONE]]
+; CHECK:       [[CALL1]]:
+; CHECK-NEXT:    call void @fun1(ptr [[STORAGE]], i32 [[IDX]])
+; CHECK-NEXT:    br label %[[DONE]]
+; CHECK:       [[DONE]]:
+; CHECK-NEXT:    ret void
+;
+entry:
+  br i1 %c, label %pred1, label %pred2
+
+pred1:
+  %valueless1 = icmp eq i32 %idx, -1
+  br i1 %valueless1, label %done, label %dispatch
+
+pred2:
+  %valueless2 = icmp eq i32 %idx, 5
+  br i1 %valueless2, label %done, label %dispatch
+
+dispatch:
+  %phi = phi i32 [ %a, %pred1 ], [ %b, %pred2 ]
+  %is0 = icmp eq i32 %idx, 0
+  %inrange = icmp ult i32 %phi, 2
+  call void @llvm.assume(i1 %inrange)
+  br i1 %is0, label %call0, label %call1
+
+call0:
+  call void @fun0(ptr %storage, i32 %idx)
+  br label %done
+
+call1:
+  call void @fun1(ptr %storage, i32 %idx)
+  br label %done
+
+done:
+  ret void
+}
