+
+; A pointer copied through a <16 x b4> slot in halves and rebuilt.
+define ptr @b4_pointer_rebuild(ptr %p) {
+; CHECK-LABEL: define ptr @b4_pointer_rebuild(
+; CHECK-SAME: ptr [[P:%.*]]) {
+; CHECK-NEXT:    [[V:%.*]] = bitcast ptr [[P]] to <16 x b4>
+; CHECK-NEXT:    [[A_0_VEC_EXTRACT:%.*]] = shufflevector <16 x b4> [[V]], <16 x b4> poison, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
+; CHECK-NEXT:    [[A_4_VEC_EXTRACT:%.*]] = shufflevector <16 x b4> [[V]], <16 x b4> poison, <8 x i32> <i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
+; CHECK-NEXT:    [[W:%.*]] = shufflevector <8 x b4> [[A_0_VEC_EXTRACT]], <8 x b4> [[A_4_VEC_EXTRACT]], <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
